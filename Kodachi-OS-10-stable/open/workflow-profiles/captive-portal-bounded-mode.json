{
  "schema_version": "1.1",
  "id": "captive-portal-bounded-mode",
  "name": "captive-portal-bounded-mode",
  "description": "Allow a time-limited direct captive-portal session, then return to protected routing.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo routing-switch disconnect --force --clean-firewall",
      "description": "Disconnect the current proxy connection and restore normal routing",
      "condition": {
        "type": "always"
      },
      "timeout": 240,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Disconnect the current proxy connection and restore normal routing",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.routing-switch.disconnect",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "disconnect",
        "--force",
        "--clean-firewall"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo dns-switch fallback",
      "description": "Switch to the embedded emergency fallback DNS servers. Use --no-action to preview without changing DNS",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Switch to the embedded emergency fallback DNS servers. Use --no-action to preview without changing DNS",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 2,
      "command_id": "rust.dns-switch.fallback",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "fallback"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control unblock-internet --method nftables",
      "description": "Unblock internet traffic",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Unblock internet traffic",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 3,
      "command_id": "rust.health-control.unblock-internet",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "unblock-internet",
        "--method",
        "nftables"
      ]
    },
    {
      "type": "pause",
      "message": "Complete captive portal login before the visible countdown expires.",
      "description": "Manual captive-portal login checkpoint",
      "condition": {
        "type": "always"
      },
      "timeout": 300,
      "confirm": false,
      "nice_level": 0,
      "id": 4
    },
    {
      "type": "command",
      "cmd": "sudo health-control block-internet --method nftables --allow-local",
      "description": "Block all internet traffic",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Block all internet traffic",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 5,
      "command_id": "rust.health-control.block-internet",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "block-internet",
        "--method",
        "nftables",
        "--allow-local"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo routing-switch auto-select",
      "description": "Use routing-switch's built-in static score table to pick the highest-ranked eligible protocol and connect. This step does not consume a preceding benchmark result. Requires authentication",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Use routing-switch's built-in static score table to pick the highest-ranked eligible protocol and connect. This step does not consume a preceding benchmark result. Requires authentication",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 6,
      "command_id": "rust.routing-switch.auto-select",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "auto-select"
      ]
    },
    {
      "type": "command",
      "cmd": "dns-switch verify-no-leaks --json",
      "description": "Report any interface with DNS servers different from the expected system DNS (per-interface leak detection)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 7,
      "command_id": "rust.dns-switch.verify-no-leaks",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "verify-no-leaks",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "ip-fetch fetch",
      "description": "Fetch IP geolocation information (default command)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 8,
      "command_id": "rust.ip-fetch.fetch",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "fetch"
      ]
    }
  ]
}
