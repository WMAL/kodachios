{
  "schema_version": "1.1",
  "id": "privacy-public-wifi-safe-start",
  "name": "privacy-public-wifi-safe-start",
  "description": "Establish a public-WiFi session with randomized local identity, authenticated routing, and leak verification.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "prerequisites": {
    "required": [
      {
        "check": "state.authenticated",
        "expect": true,
        "error": "Authenticate before automatic route selection"
      }
    ],
    "on_failure": "abort"
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo online-auth check-login",
      "description": "Check if currently logged in",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.online-auth.check-login",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/online-auth",
        "check-login"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control mac-change-all",
      "description": "Change all MAC addresses",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Change all MAC addresses",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 2,
      "command_id": "rust.health-control.mac-change-all",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "mac-change-all"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control set-random-hostname",
      "description": "Set a random hostname",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Set a random hostname",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 3,
      "command_id": "rust.health-control.set-random-hostname",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "set-random-hostname"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo routing-switch auto-select",
      "description": "Use routing-switch's built-in static score table to pick the highest-ranked eligible protocol and connect. This step does not consume a preceding benchmark result. Requires authentication",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Use routing-switch's built-in static score table to pick the highest-ranked eligible protocol and connect. This step does not consume a preceding benchmark result. Requires authentication",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 4,
      "command_id": "rust.routing-switch.auto-select",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "auto-select"
      ]
    },
    {
      "type": "command",
      "cmd": "dns-switch verify-no-leaks",
      "description": "Report any interface with DNS servers different from the expected system DNS (per-interface leak detection)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 5,
      "command_id": "rust.dns-switch.verify-no-leaks",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "verify-no-leaks"
      ]
    },
    {
      "type": "command",
      "cmd": "dns-leak test",
      "description": "Run DNS leak test on specified interface or all interfaces (requires prior online-auth authentication; this is also what a bare `dns-leak` runs)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 6,
      "command_id": "rust.dns-leak.test",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-leak",
        "test"
      ]
    },
    {
      "type": "command",
      "cmd": "ip-fetch fetch",
      "description": "Fetch IP geolocation information (default command)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 7,
      "command_id": "rust.ip-fetch.fetch",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "fetch"
      ]
    }
  ]
}
