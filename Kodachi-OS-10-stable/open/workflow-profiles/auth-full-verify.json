        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.online-auth.get-ids",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/online-auth",
        "get-ids"
      ],
      "description": "Show user and session IDs"
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo online-auth check-heartbeat",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "identity",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
