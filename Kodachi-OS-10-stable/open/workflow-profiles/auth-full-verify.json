      },
      "command_id": "rust.online-auth.check-heartbeat",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/online-auth",
        "check-heartbeat"
      ],
      "description": "Check if heartbeat service is running"
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo online-auth which-group",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "identity",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
