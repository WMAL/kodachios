{
  "schema_version": "1.1",
  "id": "auth-full-verify",
  "name": "auth-full-verify",
  "description": "Complete authentication verification with all checks: login, IDs, heartbeat, group",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2025-10-08T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo online-auth check-login",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "identity",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.online-auth.check-login",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/online-auth",
        "check-login"
      ],
      "description": "Check if currently logged in"
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sudo online-auth get-ids",
      "condition": {
        "type": "if_contains",
        "pattern": "valid"
