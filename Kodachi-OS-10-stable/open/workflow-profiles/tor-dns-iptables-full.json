{
  "schema_version": "1.1",
  "id": "tor-dns-iptables-full",
  "name": "tor-dns-iptables-full",
  "description": "Setup Tor DNS ONLY with iptables (no torrification)",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
