{
  "schema_version": "1.1",
  "id": "recovery-dns-fallback",
  "name": "DNS Fallback Recovery",
  "description": "DNS-specific recovery workflow that tests current DNS configuration and switches to emergency fallback servers if DNS resolution fails. Addresses common DNS-related connectivity issues where network is up but domain resolution doesn't work. Maintains privacy preferences during fallback.",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2025-10-08T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 180,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "dns-switch status",
      "description": "Show current DNS configuration",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.dns-switch.status",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "status"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "dns-leak test",
      "description": "Run DNS leak test on specified interface or all interfaces (requires prior online-auth authentication; this is also what a bare `dns-leak` runs)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.dns-leak.test",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-leak",
        "test"
      ]
    },
    {
      "id": 3,
      "type": "pause",
      "message": "DNS test failed. Switching to fallback DNS servers. Press Enter to continue.",
      "description": "User confirmation before DNS change",
      "condition": {
        "type": "if_fail"
      },
      "timeout": 0,
      "confirm": false,
      "nice_level": 0
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo dns-switch fallback",
      "description": "Switch to the embedded emergency fallback DNS servers. Use --no-action to preview without changing DNS",
      "condition": {
        "type": "if_fail"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Switch to the embedded emergency fallback DNS servers. Use --no-action to preview without changing DNS",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.dns-switch.fallback",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "fallback"
      ]
    },
    {
      "id": 5,
      "type": "command",
      "cmd": "dns-leak test",
      "description": "Run DNS leak test on specified interface or all interfaces (requires prior online-auth authentication; this is also what a bare `dns-leak` runs)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.dns-leak.test",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-leak",
        "test"
      ]
    },
    {
      "id": 6,
      "type": "command",
      "cmd": "sudo health-control net-check --domain-only",
      "description": "Check network connectivity (IP ping, DNS, and HTTP probe)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "recovery",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.net-check",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "net-check",
        "--domain-only"
      ]
    },
    {
      "id": 7,
      "type": "command",
      "cmd": "echo DNS fallback recovery completed successfully",
      "description": "Run the typed workflow command 'echo DNS fallback recovery completed successfully'.",
      "condition": {
        "type": "if_success"
      },
      "timeout": 10,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "typed-arbitrary-workflow",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Review the step result and restore the prior state before continuing if the command changed system state."
      },
      "command_id": "workflow.argv.echo.77b5d4ed3a1797c0",
      "argv": [
        "echo",
        "DNS",
        "fallback",
        "recovery",
        "completed",
        "successfully"
      ]
    }
  ]
}
