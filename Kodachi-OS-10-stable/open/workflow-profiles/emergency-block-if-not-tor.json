{
  "schema_version": "1.1",
  "id": "emergency-block-if-not-tor",
  "name": "emergency-block-if-not-tor",
  "description": "Check if Tor is active and block internet if Tor is not detected",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2026-07-08T02:25:00Z",
    "version": "1.2"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "ip-fetch check-tor --json",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "anonymity",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.ip-fetch.check-tor",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "check-tor",
        "--json"
      ],
      "description": "Check if connection is using Tor network"
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sudo health-control block-internet",
      "description": "Block all internet traffic",
      "condition": {
        "type": "if_json_path_equals",
        "path": "$.IsTor",
        "value": false
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "emergency",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Block all internet traffic",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.block-internet",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "block-internet"
      ]
    }
  ]
}
