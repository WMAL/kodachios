{
  "schema_version": "1.1",
  "id": "base-network-verification",
  "name": "base-network-verification",
  "description": "Base profile: Comprehensive network verification (health check, IP fetch, Tor check, routing status, DNS status, leak test). Include this for network diagnostics and verification workflows.",
  "metadata": {
    "created": "2025-10-20T00:00:00Z",
    "modified": "2025-10-20T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo health-control net-check --domain-only",
      "description": "Check network connectivity (IP ping, DNS, and HTTP probe)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.net-check",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "net-check",
        "--domain-only"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "ip-fetch",
