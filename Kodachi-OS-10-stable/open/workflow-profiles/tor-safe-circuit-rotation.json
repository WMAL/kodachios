{
  "schema_version": "1.1",
  "id": "tor-safe-circuit-rotation",
  "name": "tor-safe-circuit-rotation",
  "description": "Rotate Tor circuits and prove service and DNS health afterward.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "tor-switch check-tor-all",
      "description": "Check systemctl status for all Tor instances",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.tor-switch.check-tor-all",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "check-tor-all"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo tor-switch new-tor-circuit-all",
      "description": "New circuit for all instances",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: New circuit for all instances",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 2,
      "command_id": "rust.tor-switch.new-tor-circuit-all",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "new-tor-circuit-all"
      ]
    },
    {
      "type": "command",
      "cmd": "tor-switch verify-tor-dns-all",
      "description": "Verify DNS for all instances",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 3,
      "command_id": "rust.tor-switch.verify-tor-dns-all",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "verify-tor-dns-all"
      ]
    },
    {
      "type": "command",
      "cmd": "tor-switch tor-status-all",
      "description": "Get comprehensive status for all Tor instances",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 4,
      "command_id": "rust.tor-switch.tor-status-all",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "tor-status-all"
      ]
    },
    {
      "type": "command",
      "cmd": "ip-fetch tor",
      "description": "Test IP lookup through Tor SOCKS proxy",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 5,
      "command_id": "rust.ip-fetch.tor",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "tor"
      ]
    }
  ]
}
