      },
      "command_id": "rust.health-control.net-check",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "net-check",
        "--domain-only"
      ],
      "description": "Check network connectivity (IP ping, DNS, and HTTP probe)"
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo health-control recover-internet --force",
      "condition": {
        "type": "if_not_contains",
        "pattern": "DOMAIN_ONLY_CONNECTIVITY"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "recovery",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Recover internet connectivity",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.recover-internet",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "recover-internet",
        "--force"
      ],
      "description": "Recover internet connectivity"
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo tor-switch restart-tor",
      "condition": {
        "type": "if_not_contains",
        "pattern": "DOMAIN_ONLY_CONNECTIVITY"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
