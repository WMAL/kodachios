{
  "schema_version": "1.1",
  "id": "network-emergency-recovery",
  "name": "network-emergency-recovery",
  "description": "Emergency recovery: detect failure, recover internet, restart Tor, verify",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2026-07-08T02:25:00Z",
    "version": "1.1"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 600,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo health-control net-check --domain-only",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
