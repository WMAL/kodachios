        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Restart Tor daemon",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "description": "Restart Tor daemon",
      "command_id": "rust.tor-switch.restart-tor",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "restart-tor"
      ]
    },
    {
      "id": 5,
      "type": "command",
      "cmd": "sudo health-control net-check --domain-only",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
