{
  "schema_version": "1.1",
  "id": "privacy-full-leak-audit",
  "name": "privacy-full-leak-audit",
  "description": "Inspect routing, DNS, IPv6, public IP, and active DNS behavior.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo routing-switch status --detailed --json",
      "description": "Show the current connection status (auth-exempt, but needs sudo to read privileged system state)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.routing-switch.status",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "status",
        "--detailed",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "dns-switch status --json",
      "description": "Show current DNS configuration",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 2,
      "command_id": "rust.dns-switch.status",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "status",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "ip -6 route show",
      "description": "Run ip -6 route show through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 3,
      "command_id": "linux.ipv6_routes",
      "argv": [
        "/usr/sbin/ip",
        "-6",
        "route",
        "show"
      ]
    },
    {
      "type": "command",
      "cmd": "dns-switch verify-no-leaks --json",
      "description": "Report any interface with DNS servers different from the expected system DNS (per-interface leak detection)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 4,
      "command_id": "rust.dns-switch.verify-no-leaks",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "verify-no-leaks",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "dns-leak test --json",
      "description": "Run DNS leak test on specified interface or all interfaces (requires prior online-auth authentication; this is also what a bare `dns-leak` runs)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 5,
      "command_id": "rust.dns-leak.test",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-leak",
        "test",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "ip-fetch fetch",
      "description": "Fetch IP geolocation information (default command)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 6,
      "command_id": "rust.ip-fetch.fetch",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "fetch"
      ]
    }
  ]
}
