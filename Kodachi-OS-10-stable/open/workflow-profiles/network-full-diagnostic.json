{
  "schema_version": "1.1",
  "id": "network-full-diagnostic",
  "name": "network-full-diagnostic",
  "description": "Complete network diagnostic: health check, Tor status, DNS leak, IP fetch",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2025-10-08T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo health-control net-check --domain-only",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.net-check",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "net-check",
        "--domain-only"
      ],
      "description": "Check network connectivity (IP ping, DNS, and HTTP probe)"
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "tor-switch tor-status-all",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "anonymity",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.tor-status-all",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "tor-status-all"
      ],
      "description": "Get comprehensive status for all Tor instances"
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "dns-leak test",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.dns-leak.test",
      "argv": [
        "/opt/kodachi/dashboard/hooks/dns-leak",
        "test"
      ],
      "description": "Run DNS leak test on specified interface or all interfaces (requires prior online-auth authentication; this is also what a bare `dns-leak` runs)"
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "ip-fetch",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.ip-fetch.fetch",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch"
      ],
      "description": "Fetch IP geolocation information (default command)"
    }
  ]
}
