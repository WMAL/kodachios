{
  "schema_version": "1.1",
  "id": "privacy-session-close",
  "name": "privacy-session-close",
  "description": "Close authentication, remove selected traces, and leave networking blocked.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo online-auth logout",
      "description": "End the current session",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: End the current session",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.online-auth.logout",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/online-auth",
        "logout"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control wipe-browser-data",
      "description": "Wipe browser data and history",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Wipe browser data and history",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "id": 2,
      "command_id": "rust.health-control.wipe-browser-data",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-browser-data"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control wipe-logs",
      "description": "Securely wipe system logs (journal, syslog, auth.log, kern.log), user history (bash, zsh, python), and application cache logs",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Securely wipe system logs (journal, syslog, auth.log, kern.log), user history (bash, zsh, python), and application cache logs",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "id": 3,
      "command_id": "rust.health-control.wipe-logs",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-logs"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control block-internet --method nftables --allow-local",
      "description": "Block all internet traffic",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Block all internet traffic",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 4,
      "command_id": "rust.health-control.block-internet",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "block-internet",
        "--method",
        "nftables",
        "--allow-local"
      ]
    }
  ]
}
