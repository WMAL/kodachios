{
  "schema_version": "1.1",
  "id": "gtk-tor-dns-enable",
  "name": "GTK Enable Tor DNS",
  "description": "Start Tor DNS and verify it only when the start operation succeeds.",
  "metadata": {
    "created": "2026-08-23T00:00:00Z",
    "modified": "2026-08-23T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo tor-switch start-tor-dns-nftables",
      "description": "Start Tor DNS with nftables",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Start Tor DNS with nftables",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.start-tor-dns-nftables",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "start-tor-dns-nftables"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "tor-switch verify-tor-dns",
      "description": "Verify Tor DNS resolution",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.verify-tor-dns",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "verify-tor-dns"
      ]
    }
  ]
}
