{
  "schema_version": "1.1",
  "id": "privacy-trace-removal",
  "name": "privacy-trace-removal",
  "description": "Remove all traces: wipe logs, browser data, history, and temp files",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2025-10-08T21:01:10Z",
    "version": "1.1"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 600,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "pause",
      "message": "WARNING: This will permanently delete logs, browser data, and temp files. Continue?",
      "condition": {
        "type": "always"
      },
      "timeout": 0,
      "confirm": false,
      "nice_level": 0
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sudo health-control wipe-logs",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "cleaner",
      "score_impact": -3,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Securely wipe system logs (journal, syslog, auth.log, kern.log), user history (bash, zsh, python), and application cache logs",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "command_id": "rust.health-control.wipe-logs",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-logs"
      ],
      "description": "Securely wipe system logs (journal, syslog, auth.log, kern.log), user history (bash, zsh, python), and application cache logs"
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo health-control wipe-browser-data",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "cleaner",
      "score_impact": -3,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Wipe browser data and history",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "command_id": "rust.health-control.wipe-browser-data",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-browser-data"
      ],
      "description": "Wipe browser data and history"
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "echo 'All traces removed successfully'",
      "condition": {
        "type": "if_success"
      },
      "timeout": 10,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "cleaner",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "typed-arbitrary-workflow",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Review the step result and restore the prior state before continuing if the command changed system state."
      },
      "command_id": "workflow.argv.echo.d10ea2819dfec07c",
      "argv": [
        "echo",
        "All traces removed successfully"
      ],
      "description": "Run the typed workflow command 'echo 'All traces removed successfully''."
    }
  ]
