{
  "schema_version": "1.1",
  "id": "gtk-balanced-torrify-weighted",
  "name": "GTK Balanced Torrify weighted",
  "description": "Set weighted load balancing, then torrify through nftables only after the mode change succeeds.",
  "metadata": {
    "created": "2026-08-23T00:00:00Z",
    "modified": "2026-08-23T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo tor-switch set-load-balancing-mode weighted",
      "description": "Set load balancing mode",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Set load balancing mode",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.set-load-balancing-mode",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "set-load-balancing-mode",
        "weighted"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sudo tor-switch torrify-system-nftables-load-balanced",
      "description": "Torrify with nftables load balancing. DESTRUCTIVE: rewrites the live firewall immediately",
      "condition": {
        "type": "if_success"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Torrify with nftables load balancing. DESTRUCTIVE: rewrites the live firewall immediately",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "command_id": "rust.tor-switch.torrify-system-nftables-load-balanced",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "torrify-system-nftables-load-balanced"
      ]
    }
  ]
}
