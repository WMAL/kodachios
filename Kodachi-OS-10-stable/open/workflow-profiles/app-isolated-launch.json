{
  "schema_version": "1.1",
  "id": "app-isolated-launch",
  "name": "app-isolated-launch",
  "description": "Launch a selected executable in a private Firejail sandbox and show its managed state.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "parameters": {
    "executable": {
      "type": "string",
      "description": "Installed executable",
      "required": true
    },
    "arguments": {
      "type": "string",
      "description": "Discrete application arguments",
      "default": "",
      "required": false
    }
  },
  "steps": [
    {
      "type": "command",
      "cmd": "firejail --private ${executable} ${arguments}",
      "description": "Run firejail --private <executable> [args...] through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Run firejail --private <executable> [args...] through the typed Linux executor",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 1,
      "command_id": "linux.sandbox_launch_private",
      "argv": [
        "/usr/bin/firejail",
        "--private",
        "${executable}",
        "${arguments}"
      ]
    },
    {
      "type": "command",
      "cmd": "firejail --list",
      "description": "Run firejail --list through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 2,
      "command_id": "linux.sandbox_list",
      "argv": [
        "/usr/bin/firejail",
        "--list"
      ]
    }
  ]
}
