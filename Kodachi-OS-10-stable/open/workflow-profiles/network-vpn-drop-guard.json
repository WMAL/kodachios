{
  "schema_version": "1.1",
  "id": "network-vpn-drop-guard",
  "name": "network-vpn-drop-guard",
  "description": "Arm active blocking when VPN state changes.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo routing-switch status --detailed --json",
      "description": "Show the current connection status (auth-exempt, but needs sudo to read privileged system state)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.routing-switch.status",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "status",
        "--detailed",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control enable --type watch-guard --watch vpn --method nftables --interval 3 --actions log_event,show_alert,block_network",
      "description": "Enable a watch-guard to monitor system changes and block internet on triggers",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Enable a watch-guard to monitor system changes and block internet on triggers",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 2,
      "command_id": "rust.health-control.enable",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "enable",
        "--type",
        "watch-guard",
        "--watch",
        "vpn",
        "--method",
        "nftables",
        "--interval",
        "3",
        "--actions",
        "log_event,show_alert,block_network"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control watch-guard status --json",
      "description": "Show status of active watch-guards",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 3,
      "command_id": "rust.health-control.watch-guard",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "watch-guard",
        "status",
        "--json"
      ]
    }
  ]
}
