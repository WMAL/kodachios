        "openvpn-cloak",
        "wireguard",
        "amneziawg",
        "shadowsocks",
        "tor",
        "dante",
        "hysteria2",
        "mita",
        "v2ray",
        "xray-trojan",
        "xray-vless",
        "xray-vless-reality",
        "xray-vmess"
      ],
      "default": "wireguard",
      "required": false
    },
    "protocol_display": {
      "type": "string",
      "description": "Display name for the protocol (defaults to uppercase protocol value)",
      "required": false
