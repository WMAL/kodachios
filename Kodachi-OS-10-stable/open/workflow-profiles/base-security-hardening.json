{
  "schema_version": "1.1",
  "id": "base-security-hardening",
  "name": "base-security-hardening",
  "description": "Base profile: Perform security hardening actions (verify, conditional harden, MAC randomization, hostname randomization, timezone randomization). Include this for security setup workflows.",
  "metadata": {
    "created": "2025-10-22T00:00:00Z",
    "modified": "2025-10-22T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 600,
    "working_dir": "."
  },
  "probes": {
    "hardened_modules_count": {
      "probe_type": "count",
      "expression": "count(': HARDENED', previous_output)",
      "description": "Count how many modules are HARDENED from security-verify output"
    }
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo health-control security-verify",
      "description": "Verify if security hardening is properly applied (checks all 7 modules and reports their status)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "soc",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.security-verify",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "security-verify"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sudo health-control security-harden",
      "description": "Apply comprehensive security hardening",
      "condition": {
        "type": "if_expression",
        "expression": "probe('hardened_modules_count') < 4"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "soc",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Apply comprehensive security hardening",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.security-harden",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "security-harden"
      ]
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo health-control mac-change-all",
      "description": "Change all MAC addresses",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "identity",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
