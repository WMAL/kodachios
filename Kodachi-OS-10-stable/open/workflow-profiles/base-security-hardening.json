      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "mac-change-all"
      ]
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo health-control set-random-hostname",
      "description": "Set a random hostname",
      "condition": {
        "type": "always"
      },
