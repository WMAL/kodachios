{
  "schema_version": "1.1",
  "id": "routing-protocol-connect",
  "name": "routing-protocol-connect",
  "description": "Universal routing protocol connection: Connect to any supported routing protocol (OpenVPN, WireGuard, Shadowsocks, Tor, etc.) with authentication check, IP verification, and alert on IP change. Replaces 12+ individual protocol profiles.",
  "metadata": {
    "created": "2025-10-20T00:00:00Z",
    "modified": "2025-10-20T00:00:00Z",
    "version": "2.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "includes": [
    "base-auth-check"
  ],
  "parameters": {
    "protocol": {
      "type": "choice",
      "description": "Routing protocol to connect to",
      "options": [
        "openvpn",
        "openvpn-cloak",
        "wireguard",
        "amneziawg",
        "shadowsocks",
        "tor",
        "dante",
        "hysteria2",
        "mita",
        "v2ray",
        "xray-trojan",
        "xray-vless",
        "xray-vless-reality",
        "xray-vmess"
      ],
      "default": "wireguard",
      "required": false
    }
  },
  "steps": [
    {
      "id": 3,
      "type": "command",
      "cmd": "ip-fetch",
      "description": "Fetch IP geolocation information (default command)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.ip-fetch.fetch",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch"
      ]
    },
    {
      "id": 3.5,
      "type": "command",
      "cmd": "sudo routing-switch status",
      "description": "Show the current connection status (auth-exempt, but needs sudo to read privileged system state)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.status",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "status"
      ]
    },
    {
      "id": 3.7,
      "type": "command",
      "cmd": "sudo routing-switch disconnect",
      "description": "Disconnect the current proxy connection and restore normal routing",
      "condition": {
        "type": "if_state",
        "state": "vpn_connected",
        "expect": true
      },
      "timeout": 240,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": -2,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Disconnect the current proxy connection and restore normal routing",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.disconnect",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "disconnect"
      ]
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo routing-switch connect ${protocol}",
      "description": "Connect to a proxy protocol (openvpn, wireguard, amneziawg use native routing; openvpn-cloak runs OpenVPN inside a locally spawned Cloak client; tor uses redsocks and requires WireGuard, plain OpenVPN, or a supported routed proxy; AmneziaWG, OpenVPN over Cloak, and no-TUN routes cannot underlay Remote Tor; dante, shadowsocks, v2ray, xray-*, mita, hysteria2 use tun2socks). Requires root and a prior online-auth login.",
      "condition": {
        "type": "if_success"
      },
      "timeout": 240,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Connect to a proxy protocol (openvpn, wireguard, amneziawg use native routing; openvpn-cloak runs OpenVPN inside a locally spawned Cloak client; tor uses redsocks and requires WireGuard, plain OpenVPN, or a supported routed proxy; AmneziaWG, OpenVPN over Cloak, and no-TUN routes cannot underlay Remote Tor; dante, shadowsocks, v2ray, xray-*, mita, hysteria2 use tun2socks). Requires root and a prior online-auth login.",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.connect",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "connect",
        "${protocol}"
      ]
    },
    {
      "id": 5,
      "type": "pause",
      "message": "Waiting for connection to stabilize...",
      "description": "Brief pause for connection stabilization",
      "condition": {
        "type": "if_success"
      },
      "timeout": 15,
      "confirm": false,
      "nice_level": 0
    },
    {
      "id": 6,
      "type": "command",
      "cmd": "ip-fetch",
      "description": "Fetch IP geolocation information (default command)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "low",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.ip-fetch.fetch",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch"
      ]
    },
    {
      "id": 7,
      "type": "command",
      "cmd": "echo '${protocol} connected - IP has changed'",
      "description": "Run the typed workflow command 'echo '${protocol} connected - IP has changed''.",
      "condition": {
        "type": "if_success"
      },
      "timeout": 10,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "typed-arbitrary-workflow",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Review the step result and restore the prior state before continuing if the command changed system state."
      },
      "command_id": "workflow.argv.echo.a065b983b07d02be",
      "argv": [
        "echo",
        "${protocol} connected - IP has changed"
      ]
    },
    {
      "id": 8,
      "type": "command",
      "cmd": "sudo routing-switch status",
      "description": "Show the current connection status (auth-exempt, but needs sudo to read privileged system state)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.status",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "status"
      ]
    }
  ]
}
