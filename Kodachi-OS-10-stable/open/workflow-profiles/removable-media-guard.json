        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 1,
      "command_id": "rust.health-control.usb-list",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "usb-list",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control usb-status --json",
      "description": "Check USB Guard protection status",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
