        "needs_sudo": true,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 3,
      "command_id": "linux.usbguard_devices",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/usbguard",
        "list-devices"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control usb-guard-enable --json",
      "description": "Enable USB Guard protection",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Enable USB Guard protection",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 4,
      "command_id": "rust.health-control.usb-guard-enable",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "usb-guard-enable",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control offline-usb-storage --action check --json",
      "description": "Manage USB storage devices",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Manage USB storage devices",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 5,
      "command_id": "rust.health-control.offline-usb-storage",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "offline-usb-storage",
        "--action",
        "check",
        "--json"
      ]
    }
  ]
}
