        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "usb-status",
        "--json"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo usbguard list-devices",
      "description": "Run sudo usbguard list-devices through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
