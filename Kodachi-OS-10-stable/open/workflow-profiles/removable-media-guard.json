{
  "schema_version": "1.1",
  "id": "removable-media-guard",
  "name": "removable-media-guard",
  "description": "Inventory removable media and enable USBGuard protection.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo health-control usb-list --json",
      "description": "List all USB devices",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
