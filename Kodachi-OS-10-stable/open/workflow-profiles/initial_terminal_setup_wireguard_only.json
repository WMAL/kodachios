{
  "schema_version": "1.1",
  "id": "initial_terminal_setup_wireguard_only",
  "name": "initial_terminal_setup_wireguard_only",
  "description": "Terminal ISO startup with WireGuard connection and security hardening (no Tor)",
  "metadata": {
    "created": "2025-10-22T00:00:00Z",
    "modified": "2025-10-22T00:00:00Z",
    "version": "2.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 600
  },
  "prerequisites": {
    "required": [
      {
        "check": "authenticated",
        "expect": true,
        "error": "User must be authenticated before starting WireGuard setup. Run 'sudo online-auth authenticate' first."
      },
      {
        "check": "online",
        "expect": true,
        "error": "Internet connectivity required. Check network connection before proceeding."
      },
      {
        "check": "torrify",
        "expect": false,
        "error": "System is already torrified. Please detorrify first before using WireGuard."
      }
    ],
    "optional": [
      {
        "check": "routing_mode",
        "expect": "none",
        "error": "WARNING: Already connected to network (routing_mode != 'none'). Continuing anyway..."
      }
    ],
    "on_failure": "abort"
  },
  "includes": [
    "base-terminal-setup-full"
  ],
  "parameters": {
    "protocol": {
      "type": "choice",
      "description": "Routing protocol to connect to",
      "options": [
        "wireguard"
      ],
      "default": "wireguard",
      "required": false
    },
    "protocol_display": {
      "type": "string",
      "description": "Display name for the protocol",
      "default": "WIREGUARD",
      "required": false
    }
  },
  "steps": []
}
