      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "check-tor"
      ]
    },
    {
      "id": 7,
      "type": "command",
      "cmd": "ip-fetch",
      "description": "Fetch IP geolocation information (default command)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
