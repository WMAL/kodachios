        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.net-check",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "net-check",
        "--domain-only"
      ]
    },
    {
      "id": 6,
      "type": "command",
      "cmd": "ip-fetch check-tor",
      "description": "Check if connection is using Tor network",
      "condition": {
        "type": "always"
