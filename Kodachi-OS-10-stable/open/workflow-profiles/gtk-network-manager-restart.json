{
  "schema_version": "1.1",
  "id": "gtk-network-manager-restart",
  "name": "GTK NetworkManager Restart",
  "description": "Disable NetworkManager, wait two seconds, enable it, then verify, stopping the success chain after any failed step.",
  "metadata": {
    "created": "2026-08-23T00:00:00Z",
    "modified": "2026-08-23T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo health-control offline-networkmanager --action disable",
      "description": "Manage NetworkManager service",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Manage NetworkManager service",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.offline-networkmanager",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "offline-networkmanager",
        "--action",
        "disable"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sleep 2",
      "description": "Run sleep 2 through the typed Linux executor",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "command_id": "linux.system.sleep_2",
      "argv": [
        "/usr/bin/sleep",
        "2"
      ]
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo health-control offline-networkmanager --action enable",
      "description": "Manage NetworkManager service",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Manage NetworkManager service",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.health-control.offline-networkmanager",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "offline-networkmanager",
        "--action",
        "enable"
      ]
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo health-control offline-networkmanager --action check",
      "description": "Manage NetworkManager service",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
