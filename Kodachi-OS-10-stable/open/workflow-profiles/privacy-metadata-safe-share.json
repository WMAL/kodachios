{
  "schema_version": "1.1",
  "id": "privacy-metadata-safe-share",
  "name": "privacy-metadata-safe-share",
  "description": "Inspect, clean, and hash a file before sharing.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "parameters": {
    "source_file": {
      "type": "string",
      "description": "Validated source file",
      "required": true
    },
    "cleaned_output_file": {
      "type": "string",
      "description": "Output produced by mat2",
      "required": true
    }
  },
  "steps": [
    {
      "type": "command",
      "cmd": "mat2 --show ${source_file}",
      "description": "Run mat2 --show <validated-file> through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 1,
      "command_id": "linux.metadata_inspect",
      "argv": [
        "/usr/bin/mat2",
        "--show",
        "${source_file}"
      ]
    },
    {
      "type": "command",
      "cmd": "mat2 ${source_file}",
      "description": "Run mat2 <validated-file> through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Run mat2 <validated-file> through the typed Linux executor",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 2,
      "command_id": "linux.metadata_clean",
      "argv": [
        "/usr/bin/mat2",
        "${source_file}"
      ]
    },
    {
      "type": "command",
      "cmd": "sha256sum ${cleaned_output_file}",
      "description": "Run sha256sum <validated-file> through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 3,
      "command_id": "linux.hash_file",
      "argv": [
        "/usr/bin/sha256sum",
        "${cleaned_output_file}"
      ]
    }
  ]
}
