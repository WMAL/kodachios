{
  "schema_version": "1.1",
  "id": "endpoint-attack-surface-audit",
  "name": "endpoint-attack-surface-audit",
  "description": "Inspect privilege, sandboxing, mandatory access control, and suspicious executables.",
  "metadata": {
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "author": "Kodachi ColonyOps",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": false,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "type": "command",
      "cmd": "sudo aa-status",
      "description": "Run sudo aa-status through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 1,
      "command_id": "linux.apparmor_status",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/usr/sbin/aa-status"
      ]
    },
    {
      "type": "command",
      "cmd": "systemd-analyze security --no-pager",
      "description": "Run systemd-analyze security --no-pager through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 2,
      "command_id": "linux.systemd_security",
      "argv": [
        "/usr/bin/systemd-analyze",
        "security",
        "--no-pager"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo getcap -r /usr/bin /usr/sbin",
      "description": "Run sudo getcap -r /usr/bin /usr/sbin through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 1800,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 3,
      "command_id": "linux.capabilities",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/usr/sbin/getcap",
        "-r",
        "/usr/bin",
        "/usr/sbin"
      ]
    },
    {
      "type": "command",
      "cmd": "find /usr/bin /usr/sbin -xdev -perm -4000 -type f",
      "description": "Run find /usr/bin /usr/sbin -xdev -perm -4000 -type f through the typed Linux executor",
      "condition": {
        "type": "always"
      },
      "timeout": 1800,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-command",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the corresponding status command and restore the previous configuration if needed."
      },
      "id": 4,
      "command_id": "linux.suid_files",
      "argv": [
        "/usr/bin/find",
        "/usr/bin",
        "/usr/sbin",
        "-xdev",
        "-perm",
        "-4000",
        "-type",
        "f"
      ]
    },
    {
      "type": "command",
      "cmd": "sudo health-control rootkit-scan-enhanced --deep --json",
      "description": "Enhanced rootkit scanning with multiple tools",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "binaries",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "id": 5,
      "command_id": "rust.health-control.rootkit-scan-enhanced",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "rootkit-scan-enhanced",
        "--deep",
        "--json"
      ]
    }
  ]
}
