      },
      "command_id": "workflow.argv.sleep.9221fbd1a53ea5ee",
      "argv": [
        "sleep",
        "15"
      ]
    },
    {
      "id": 6,
      "type": "command",
      "cmd": "sudo health-control net-check --domain-only",
      "description": "Check network connectivity (IP ping, DNS, and HTTP probe)",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
