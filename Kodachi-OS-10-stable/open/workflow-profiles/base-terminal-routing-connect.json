{
  "schema_version": "1.1",
  "id": "base-terminal-routing-connect",
  "name": "base-terminal-routing-connect",
  "description": "Base profile: Robust routing protocol connection with recovery fallback. Handles connection, verification, and automatic recovery if connection fails. Parametrized by protocol.",
  "metadata": {
    "created": "2025-10-22T00:00:00Z",
    "modified": "2025-10-22T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "stop",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 600,
    "working_dir": "."
  },
  "parameters": {
    "protocol": {
      "type": "choice",
      "description": "Routing protocol to connect to",
      "options": [
        "openvpn",
        "openvpn-cloak",
        "wireguard",
        "amneziawg",
        "shadowsocks",
        "tor",
        "dante",
        "hysteria2",
        "mita",
        "v2ray",
        "xray-trojan",
        "xray-vless",
        "xray-vless-reality",
        "xray-vmess"
      ],
      "default": "wireguard",
      "required": false
    },
    "protocol_display": {
      "type": "string",
      "description": "Display name for the protocol (defaults to uppercase protocol value)",
      "required": false
    }
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "echo '=== 5. CONNECTING TO ${protocol} ==='",
      "description": "Run the typed workflow command 'echo '=== 5. CONNECTING TO ${protocol} ===''.",
      "condition": {
        "type": "always"
      },
      "timeout": 300,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "typed-arbitrary-workflow",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Review the step result and restore the prior state before continuing if the command changed system state."
      },
      "command_id": "workflow.argv.echo.62aba91587d2096e",
      "argv": [
        "echo",
        "=== 5. CONNECTING TO ${protocol} ==="
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "sudo routing-switch status",
      "description": "Show the current connection status (auth-exempt, but needs sudo to read privileged system state)",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.status",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "status"
      ]
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo routing-switch disconnect",
      "description": "Disconnect the current proxy connection and restore normal routing",
      "condition": {
        "type": "if_state",
        "state": "vpn_connected",
        "expect": true
      },
      "timeout": 240,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": -2,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Disconnect the current proxy connection and restore normal routing",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.disconnect",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "disconnect"
      ]
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo routing-switch connect ${protocol}",
      "description": "Connect to a proxy protocol (openvpn, wireguard, amneziawg use native routing; openvpn-cloak runs OpenVPN inside a locally spawned Cloak client; tor uses redsocks and requires WireGuard, plain OpenVPN, or a supported routed proxy; AmneziaWG, OpenVPN over Cloak, and no-TUN routes cannot underlay Remote Tor; dante, shadowsocks, v2ray, xray-*, mita, hysteria2 use tun2socks). Requires root and a prior online-auth login.",
      "condition": {
        "type": "if_state",
        "state": "vpn_connected",
        "expect": false
      },
      "timeout": 240,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "routing",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Connect to a proxy protocol (openvpn, wireguard, amneziawg use native routing; openvpn-cloak runs OpenVPN inside a locally spawned Cloak client; tor uses redsocks and requires WireGuard, plain OpenVPN, or a supported routed proxy; AmneziaWG, OpenVPN over Cloak, and no-TUN routes cannot underlay Remote Tor; dante, shadowsocks, v2ray, xray-*, mita, hysteria2 use tun2socks). Requires root and a prior online-auth login.",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.routing-switch.connect",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/routing-switch",
        "connect",
        "${protocol}"
      ]
    },
    {
      "id": 5,
      "type": "command",
      "cmd": "sleep 15",
      "description": "Run the typed workflow command 'sleep 15'.",
      "condition": {
        "type": "if_success"
      },
      "timeout": 300,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "info",
      "score_impact": 0,
      "colonyops_safety": {
