{
  "schema_version": "1.1",
  "id": "tor-dns-fallback",
  "name": "tor-dns-fallback",
  "description": "Try Tor DNS setup with automatic fallback to regular DNS if fails",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2025-10-08T21:01:10Z",
    "version": "1.1"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo tor-switch start-tor-dns-nftables",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Start Tor DNS with nftables",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.start-tor-dns-nftables",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "start-tor-dns-nftables"
      ],
      "description": "Start Tor DNS with nftables"
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "tor-switch verify-tor-dns",
      "condition": {
        "type": "if_success"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.verify-tor-dns",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "verify-tor-dns"
      ],
      "description": "Verify Tor DNS resolution"
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "echo 'Tor DNS failed, using fallback...'",
      "condition": {
        "type": "if_fail"
      },
      "timeout": 10,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "typed-arbitrary-workflow",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Review the step result and restore the prior state before continuing if the command changed system state."
      },
      "command_id": "workflow.argv.echo.01db38b347210234",
      "argv": [
        "echo",
        "Tor DNS failed, using fallback..."
      ],
      "description": "Run the typed workflow command 'echo 'Tor DNS failed, using fallback...''."
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo dns-switch fallback",
      "condition": {
        "type": "if_fail"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "dns",
      "score_impact": 3,
      "colonyops_safety": {
        "danger_level": "high",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "Confirm this workflow step before execution: Switch to the embedded emergency fallback DNS servers. Use --no-action to preview without changing DNS",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.dns-switch.fallback",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/dns-switch",
        "fallback"
      ],
      "description": "Switch to the embedded emergency fallback DNS servers. Use --no-action to preview without changing DNS"
    }
  ]
}
