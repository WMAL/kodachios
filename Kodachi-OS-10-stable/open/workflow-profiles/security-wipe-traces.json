{
  "schema_version": "1.1",
  "id": "security-wipe-traces",
  "name": "security-wipe-traces",
  "description": "Security trace wipe: auth verify, wipe logs, wipe browser, wipe free space",
  "metadata": {
    "created": "2025-10-08T00:00:00Z",
    "modified": "2025-10-08T21:01:10Z",
    "version": "1.1"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 3600,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "sudo online-auth check-login",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "identity",
      "score_impact": 1,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.online-auth.check-login",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/online-auth",
        "check-login"
      ],
      "description": "Check if currently logged in"
    },
    {
      "id": 2,
      "type": "pause",
      "message": "WARNING: This will wipe logs, browser data, and free space. Continue?",
      "condition": {
        "type": "if_contains",
        "pattern": "valid"
      },
      "timeout": 0,
      "confirm": false,
      "nice_level": 0
    },
    {
      "id": 3,
      "type": "command",
      "cmd": "sudo health-control wipe-logs",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "cleaner",
      "score_impact": -3,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Securely wipe system logs (journal, syslog, auth.log, kern.log), user history (bash, zsh, python), and application cache logs",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "command_id": "rust.health-control.wipe-logs",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-logs"
      ],
      "description": "Securely wipe system logs (journal, syslog, auth.log, kern.log), user history (bash, zsh, python), and application cache logs"
    },
    {
      "id": 4,
      "type": "command",
      "cmd": "sudo health-control wipe-browser-data",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "cleaner",
      "score_impact": -3,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Wipe browser data and history",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "command_id": "rust.health-control.wipe-browser-data",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-browser-data"
      ],
      "description": "Wipe browser data and history"
    },
    {
      "id": 5,
      "type": "command",
      "cmd": "sudo health-control wipe-free-space --device /",
      "condition": {
        "type": "always"
      },
      "timeout": 600,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "cleaner",
      "score_impact": -8,
      "colonyops_safety": {
        "danger_level": "critical",
        "requires_auth": true,
        "needs_sudo": true,
        "execution_kind": "tauri-service",
        "destructive": true,
        "workflow_safe": false,
        "shell_safe": true,
        "confirm_copy": "Confirm 'RUN {id}' before this step: Securely wipe free space on a mounted filesystem (use mount points like '/', '/home' or device paths)",
        "rollback_hint": "Use a verified backup or the operation-specific recovery workflow; effects may be irreversible."
      },
      "command_id": "rust.health-control.wipe-free-space",
      "argv": [
        "/usr/bin/sudo",
        "-n",
        "/opt/kodachi/dashboard/hooks/health-control",
        "wipe-free-space",
        "--device",
        "/"
      ],
      "description": "Securely wipe free space on a mounted filesystem (use mount points like '/', '/home' or device paths)"
    }
  ]
}
