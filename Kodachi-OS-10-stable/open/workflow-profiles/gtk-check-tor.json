{
  "schema_version": "1.1",
  "id": "gtk-check-tor",
  "name": "GTK Check If Using Tor",
  "description": "Run both direct Tor checks in the same unconditional order as the legacy GTK semicolon sequence.",
  "metadata": {
    "created": "2026-08-23T00:00:00Z",
    "modified": "2026-08-23T00:00:00Z",
    "version": "1.0"
  },
  "global_settings": {
    "kill_policy": "continue",
    "continue_policy": true,
    "max_log_size": 10485760,
    "default_timeout": 300,
    "working_dir": "."
  },
  "steps": [
    {
      "id": 1,
      "type": "command",
      "cmd": "ip-fetch check-tor",
      "description": "Check if connection is using Tor network",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.ip-fetch.check-tor",
      "argv": [
        "/opt/kodachi/dashboard/hooks/ip-fetch",
        "check-tor"
      ]
    },
    {
      "id": 2,
      "type": "command",
      "cmd": "tor-switch which-is-active",
      "description": "Check active firewall system",
      "condition": {
        "type": "always"
      },
      "timeout": 120,
      "confirm": false,
      "nice_level": 0,
      "cell_store": "gtk-parity",
      "score_impact": 0,
      "colonyops_safety": {
        "danger_level": "safe",
        "requires_auth": false,
        "needs_sudo": false,
        "execution_kind": "tauri-service",
        "destructive": false,
        "workflow_safe": true,
        "shell_safe": true,
        "confirm_copy": "",
        "rollback_hint": "Re-run the matching status command and restore the prior configuration if needed."
      },
      "command_id": "rust.tor-switch.which-is-active",
      "argv": [
        "/opt/kodachi/dashboard/hooks/tor-switch",
        "which-is-active"
      ]
    }
  ]
}
