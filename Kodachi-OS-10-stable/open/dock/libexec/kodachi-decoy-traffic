#!/usr/bin/env bash
# Kodachi Dock Control - Decoy Traffic Generator
#
# SPDX-License-Identifier: LicenseRef-Kodachi-SAN-1.1
# Copyright (c) 2013-2026 Warith Al Maawali
#
# This file is part of Kodachi OS.
# For full license terms, see LICENSE.md or visit:
# https://kodachi.cloud/docs/license.html
#
# Commercial or organizational use requires a written license.
# Contact: warith@digi77.com
#
# Lineage:
# Kodachi has offered a traffic-noise capability since version 5.1, released
# 09.11.2018 (Kodachi-Log.txt: "+ Added Noisy crawler"), and carried one
# through the 8.x line. This file is the Kodachi 9 implementation of that
# capability: original Bash, written for this OS, sharing no code with anything
# that came before it. It is wholly Kodachi work and the Kodachi license above
# is the only one that governs it.
#
# Description:
# The Kodachi 9 decoy traffic generator. No Kodachi Rust verb covers decoy
# traffic, so it is implemented here as a self-contained Bash daemon with no
# dependency beyond curl.
#
# It issues low-rate HTTP requests to a fixed set of large, uncontroversial
# public sites at randomised intervals, so that an observer watching connection
# metadata sees cover traffic mixed with real browsing.
#
# Three deliberate limits, because a traffic generator on a privacy OS is easy
# to get wrong:
#   1. It never follows links found in responses. A crawler that follows
#      arbitrary links can be steered onto content the user did not choose, and
#      that is a liability, not cover.
#   2. Response bodies are discarded and never written to disk.
#   3. It inherits whatever routing is active. It never sets its own proxy, so
#      it cannot accidentally bypass a Tor or VPN path the user has established.
#
# Runs entirely unprivileged and as a single background process guarded by a
# PID file, so repeated dock clicks cannot stack generators.
#
# Author: Warith Al Maawali
# Version: <lab-host>
# Last updated: 2026-08-29

set -uo pipefail

# ── Configuration ─────────────────────────────────────────────

readonly STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kodachi-dock"
readonly PID_FILE="${STATE_DIR}/decoy-traffic.pid"
readonly LOG_FILE="${STATE_DIR}/decoy-traffic.log"
readonly STATS_FILE="${STATE_DIR}/decoy-traffic.stats"

readonly MIN_DELAY=8
readonly MAX_DELAY=45
readonly REQUEST_TIMEOUT=20
# COVER THAT NAMES A BROWSER THIS MACHINE DOES NOT RUN IS NOT COVER.
#
# This was a frozen `rv:128.0 ... Firefox/128.0` string, chosen when Firefox
# 128 ESR was current and never revisited. MEASURED 2026-09-04 on the live
# <lab-host> ISO, <lab-host>, by pointing the shipped browser at a local
# one-shot HTTP listener and reading the request header it actually sent:
#
#     /usr/local/bin/librewolf --version   ->  LibreWolf 155.0-1
#     User-Agent it sent                   ->  Mozilla/5.0 (X11; Linux x86_64;
#                                              rv:155.0) Gecko/20100101 Firefox/155.0
#
# So it reports its REAL major and does not spoof to an ESR line, and the
# decoy's constant differed from the user's real traffic by 27 major versions.
# Every cover request was separable from every real request by one header,
# which is the one thing cover traffic must not be. The file's own header
# already treats a flat request rate as a signature for the same reason.
#
# DERIVED AT START, FROM THE BROWSER THAT SHIPS, and deliberately not at each
# request: one `--version` per daemon start, so a browser upgrade is picked up
# the next time the switch is turned on and the string cannot change mid-run.
# The regex takes the leading major only, so `155.0-1` and `147.0.4-1` both
# yield `155` and `147`; anything that does not parse leaves the fallback in
# place rather than emitting a malformed header.
# THE REAL BINARY FIRST, NEVER THE KODACHI WRAPPER, AND UNDER A TIMEOUT.
#
# `/usr/local/bin/librewolf` looks like the browser and is a 60-line /bin/sh
# wrapper written by overlays/gui-xfce/hooks/live/9600-apply-xfce-customizations
# .hook.chroot:429. It has NO `--version` fast path: it runs `mkdir -p
# "$HOME/Desktop"`, cd's there, picks a profile directory, and execs through
# kodachi-hmalloc-exec, and when EUID is 0 it goes out through `runuser` with
# DISPLAY, XAUTHORITY and a dbus address. `/usr/bin/librewolf` is the binary
# that wrapper itself execs, so it prints the SAME version string with none of
# that work. Asking the wrapper was measured to work and was still wrong: it
# was the longest path to a string the short path already has.
#
# `timeout 5` because this substitution runs at LOAD TIME below, before the
# verb is even parsed, so a browser that wedges would hang `stop` as well as
# `start` and the user could not turn the daemon off from the dock. A version
# read that cannot answer in five seconds has nothing to tell us; the fallback
# is correct and instant.
decoy_user_agent() {
    local browser major
    for browser in /usr/bin/librewolf /usr/local/bin/librewolf /usr/bin/firefox; do
        [ -x "$browser" ] || continue
        major="$(timeout 5 "$browser" --version 2>/dev/null \
                 | /usr/bin/grep -oE '[0-9]+' | head -n 1)"
        if [ -n "$major" ] && [ "$major" -ge 1 ] 2>/dev/null; then
            printf 'Mozilla/5.0 (X11; Linux x86_64; rv:%s.0) Gecko/20100101 Firefox/%s.0\n' \
                   "$major" "$major"
            return 0
        fi
    done
    # No readable browser: keep a plausible, widely-used ESR string rather than
    # emitting nothing, because curl's own default UA would be far louder.
    printf 'Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0\n'
}
readonly USER_AGENT="$(decoy_user_agent)"

# Large, high-traffic, non-sensitive destinations. Requesting these looks like
# ordinary browsing and does not associate the user with any niche interest.
#
# EVERY URL HERE WAS MEASURED, NOT ASSUMED. On 2026-08-29, 136 candidates were
# fetched with the exact user agent and timeout below, across three rounds, and
# only those answering HTTP 200 were kept. 93 survived. Any entry that failed on
# one round was re-probed at least three times before being judged, because a
# single refusal is as likely to be a rate limit as a policy.
#
# That round removed two entries this list used to ship:
# https://www.reuters.com/ answers 401 and https://stackoverflow.com/questions
# answers 403 to a non-browser client, so 2 of the previous 12 targets had been
# generating refusals rather than cover. A refusal is a short, uniform response,
# which is weaker cover than a real page and is itself a small pattern.
#
# A 000 IS WORSE THAN A REFUSAL AND IS THE ONE `check` ROW YOU MUST NOT IGNORE.
# 000 means no HTTP response at all: DNS, TCP or TLS never completed, so the
# worker blocks for the FULL REQUEST_TIMEOUT below on every draw of that target.
# https://www.gnu.org/ was dropped for exactly this on 2026-08-29: its host
# 209.51.188.116 stopped answering ICMP and TCP 80/443 entirely, while
# https://www.fsf.org/ (same organisation, already in this table) kept answering
# 200, so it was the target and not the network. `check`'s REPLACE rows are not
# cosmetic.
#
# DIVERSITY, STATED BY LAYER, because one number here would overstate it:
# 93 URLs, 92 distinct SNI hostnames, 87 distinct registrable domains, and about
# a third of the rotation terminating at just two CDN operators (Fastly and
# Cloudflare). Name-layer diversity is what mostly matters for cover, but an
# observer correlating by flow endpoint sees far fewer than 93 destinations.
# Prefer replacements that are NOT behind those two operators.
#
# Re-measure with `kodachi-decoy-traffic check` before editing this list. A
# target that starts refusing is not an outage, it is a target to replace.
#
# THREE RULES GOVERN WHAT MAY BE ADDED, and they are the reason this is a fixed
# table and not a crawl:
#   1. Nothing adult, gambling, extremist, pirated, or otherwise embarrassing to
#      have in a connection log the user did not choose to create.
#   2. NO DESTINATION WHOSE MERE VISIT IS ITSELF A DISCLOSURE. Privacy tooling
#      is the obvious case and is deliberately absent: fetching torproject.org
#      or a VPN vendor as "cover" advertises exactly the interest the cover
#      exists to hide, which inverts the purpose of the feature. The rule is
#      wider than that, and is written as a class on purpose so nobody extends
#      the list wrongly later. Activism, health, legal, immigration and
#      financial-distress destinations are all excluded by it.
#
#      THE TABLE ONCE VIOLATED THIS RULE AND THE VIOLATION SURVIVED REVIEW.
#      An earlier revision shipped https://www.who.int/ and
#      https://www.ncbi.nlm.nih.gov/ while this very paragraph named health as
#      an excluded class. NCBI is PubMed, the most identifiable
#      biomedical-literature destination there is. Both were removed on
#      2026-08-29. Recorded here rather than quietly fixed, because a rule
#      contradicted by its own table is WEAKER than no rule: the next
#      maintainer reads the entries, not the prose.
#
#   2b. THE LIMIT OF RULE 2, STATED RATHER THAN GLOSSED. Rule 2 rests on the
#      claim that a visit to a mainstream news site is deniable. THAT CLAIM IS
#      JURISDICTIONAL, and it fails for exactly the user a privacy OS exists
#      for. This table ships al Jazeera, Deutsche Welle, the BBC, the Guardian,
#      NPR, CBC and Euronews; some of those are banned or blocked in some
#      countries. Cover traffic is INVOLUNTARY: the user did not choose these
#      destinations, so in such a jurisdiction the generator manufactures
#      precisely the association Rule 2 exists to prevent. A weaker version of
#      the same shape applies to the six US federal URLs here, five distinct
#      .gov domains (nasa, noaa, nps, usgs, weather), which form a recognisable
#      cluster. Counted rather than estimated: an earlier revision of this
#      paragraph said seven, which was wrong under every reading, and a file
#      this precise about its own numbers cannot be loose about that one.
#
#      This is an ACCEPTED, DOCUMENTED RISK and not an oversight, because the
#      alternative (a table with no news in it) is poor cover for ordinary
#      browsing, which is the whole point. The mitigation is that this is a
#      plain, editable table: a user in an affected jurisdiction should delete
#      the entries that are sensitive where they are. Anyone localising Kodachi
#      should treat this paragraph as the first thing to revisit.
#
#      BE HONEST ABOUT WHO CAN ACTUALLY APPLY THAT MITIGATION. This file is
#      root-owned under /usr/local/libexec, and the dock exposes only start,
#      stop, status and watch. So editing the table is available to a
#      MAINTAINER, and to a user willing to edit a root-owned file by hand. It
#      is NOT available through any Kodachi interface, which means that for the
#      user rule 2b is written for it is a theoretical mitigation today. Saying
#      so is the point: a documented risk whose mitigation nobody can reach is
#      an undocumented risk with extra words.
#   3. Large and stable enough that one more request is unremarkable to the
#      operator of the site as well as to an observer of the user.
readonly TARGETS=(
    # Reference and libraries
