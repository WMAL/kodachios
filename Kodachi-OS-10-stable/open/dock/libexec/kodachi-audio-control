"""Open XFCE audio controls with an honest Kodachi microphone-policy notice."""

import json
import os
import shutil
import subprocess
import sys


HEALTH_ARGS = (
    "offline-microphone", "--action", "check", "--output", "json",
)
KNOWN_STATES = {
    "persistent_blocked", "currently_muted", "available", "degraded", "unknown",
}
HEALTH_CONTROL = "/opt/kodachi/dashboard/hooks/health-control"


def resolve_program(name):
    path = shutil.which(name)
    if not path or not os.path.isabs(path) or not os.access(path, os.X_OK):
        return None
    return os.path.realpath(path)


def resolve_health_control():
    if (os.path.isfile(HEALTH_CONTROL)
            and os.access(HEALTH_CONTROL, os.X_OK)):
        return HEALTH_CONTROL
    return None


def microphone_policy_state():
    """Return the typed policy enum, treating every malformed result as unknown."""
    health_control = resolve_health_control()
    if health_control is None:
        return "unknown"
    try:
        result = subprocess.run(
            [health_control, *HEALTH_ARGS],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=5,
            check=False,
        )
        if result.returncode != 0:
            return "unknown"
        payload = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, TypeError):
        return "unknown"
    if not isinstance(payload, dict) or payload.get("status") != "success":
        return "unknown"
    data = payload.get("data")
    if not isinstance(data, dict) or data.get("success") is not True:
        return "unknown"
    state = data.get("microphone_policy_state")
    return state if state in KNOWN_STATES else "unknown"


def notify(summary, body, blocking=False):
    """Show a best-effort desktop notice without ever blocking audio controls."""
    if blocking:
        zenity = resolve_program("zenity")
        if zenity:
            try:
                subprocess.run(
                    [zenity, "--warning", "--title", summary, "--text", body],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=30,
                    check=False,
                )
                return
            except (OSError, subprocess.SubprocessError):
                pass
    notifier = resolve_program("notify-send")
    if notifier:
        try:
            subprocess.Popen(
                [notifier, summary, body],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            pass


def main():
    if os.geteuid() == 0:
        print("kodachi-audio-control: refusing to run graphical audio controls as root",
              file=sys.stderr)
        return 2
    pavucontrol = resolve_program("pavucontrol")
    if pavucontrol is None:
        print("kodachi-audio-control: pavucontrol is not installed", file=sys.stderr)
        return 2

    state = microphone_policy_state()
    if state == "persistent_blocked":
        notify(
            "Microphone disabled by Kodachi",
            "Kodachi's persistent microphone guard is active. To use a microphone, "
            "enable it in Dashboard > Sound/Audio settings.",
            blocking=True,
        )
    elif state in {"degraded", "unknown"}:
        notify(
            "Kodachi microphone status unavailable",
            "Audio controls will open, but Kodachi could not verify the persistent "
            "microphone policy. Check Dashboard > Sound/Audio settings.",
        )

    os.execv(pavucontrol, [pavucontrol])
    print("kodachi-audio-control: pavucontrol returned unexpectedly", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
