# THE CLIENT-SIDE BRUTE-FORCE BOUND. Deliberately BELOW the server's own
# threshold, so this window gives up while the machine still has attempts left
# rather than after it has spent them. The cooldown is long enough to break a
# retype-and-retry reflex and short enough that somebody who has gone to fetch
# the right password is not punished for it.
DEV_ATTEMPT_LIMIT = 3
DEV_ATTEMPT_COOLDOWN = 300

# How old a downloaded apt index may get before the window stops merely
# reporting its age and starts telling him to refresh it. Matched to how often
# the Kodachi channels publish, so a normal week is quiet and a forgotten
# machine is not.
STALE_INDEX_DAYS = 7

# THE PROGRESS PROTOCOL, apt's own, arriving on the SAME pipe as the log.
# `kodachi-repo-apt` now passes `-o APT::Status-Fd=1`, so apt writes
# machine-readable progress lines into the stream this window already reads:
#
#     dlstatus:<id>:<percent>:<description>      download phase
#     pmstatus:<package>:<percent>:<description> unpack/configure phase
#     pmconffile:<file>:<old>:<new>              a conffile prompt
#     pmerror:<package>:<percent>:<message>      a package failed
#     media-change:<media>:<drive>               not reachable here, apt-only
#
# MEASURED 2026-08-29 that this coexists with `-q`: `apt-get download -q -o
# APT::Status-Fd=1 hello` produced 6 protocol lines out of 8. Percentages are
# floats and are NOT monotonic across phases: apt restarts at 0 when it moves
# from downloading to unpacking, which is why the bar is labelled with the
# phase and never presented as one continuous 0-100 for the whole operation.
#
# These lines are CONSUMED, never printed: they are protocol, not output, and
# a log full of `pmstatus:` noise would undo the pane fix above. `pmerror` is
# the exception and is printed, because a package failing is exactly what the
# reader of that pane is there for.
# APT REPORTS 0.0000 ON EVERY dlstatus LINE OF AN INDEX REFRESH, so the
# percentage is useless for exactly the operation run most often. Measured on
# <lab-host>, 2026-08-30, during a real `Update from servers` and captured
# in a screenshot: the gauge read "Downloading  0%" while the description
# beside it read "Retrieving file 147 of 149". The progress is in the
# description, and `file <i> of <n>` is a stable apt string, so use it when
# apt's own percentage is absent or flat zero. A package DOWNLOAD reports real
# percentages and never reaches this branch.
# THE HELPER'S STARTUP SENTINEL. kodachi-repo-apt emits this immediately after
# its root check and BEFORE it takes the dpkg lock, so its arrival is positive
# evidence that pkexec authenticated and the child is running. Silence alone
# cannot prove the opposite: a live helper can be quiet while it waits on the
# lock. Both copies of this literal must move together, here and in the helper.
HELPER_STARTED = "kodachi-helper-started:"
# The flag that asks kodachi-repo-apt to emit the sentinel above. It is opt-in
# because the dock and the Tauri dashboard run the same verbs and print the
# helper's stdout verbatim; only this window parses protocol. Duplicated in the
# helper for the same reason HELPER_STARTED is: that program runs as root and
# deliberately imports no kodachi_* module. A contract asserts both copies.
PROTOCOL_FLAG = "--protocol"

FILE_COUNTER = re.compile(r"\bfile\s+(\d+)\s+of\s+(\d+)\b", re.I)

PROGRESS_PREFIXES = ("dlstatus:", "pmstatus:", "pmconffile:", "pmerror:",
                     "media-change:")

# MEASURED AGAINST THE WINDOW THE OPERATOR NAMED AS THE STANDARD,
# `kodachi-command-window network`, rendered offscreen on <lab-host>:
# natural 857x628, minimum 825x628. This window was natural 1466x832 and
# MINIMUM 1172x832, so it could not be dragged down to the size the other
# Cairo windows open at, whatever set_default_size asked for: a content
# minimum always beats the window's default. The numbers below are the
# reference's, not a guess, and tests/render_repo_manager.py prints the
# measured minimum so a future widening cannot pass unnoticed.
#
# 628 is the reference's CONTENT height, not the size it opens at, and the two
# are different numbers because ui.Window rewrites both. Measured on the same
# VM by constructing the shell with each sibling's own arguments:
#   kodachi-command-window network   width=880 height=620 -> opens 1064x620
#   the command spec default         width=760 height=840 -> opens  944x760
#   the catalog page                 width=640 height=800 -> opens  940x760
# So the house range is 940 to 1064 wide and 620 to 760 tall. Do not read the
# 640 this constant used to hold as a target that was missed; at 640 the
# vertical Paned is allocated ~346px, and taking the command log out of that
# left the datasheet showing one metric row.
#
# 700 DECLARED AN OPEN_WIDTH BELOW THIS WINDOW'S CONTENT MINIMUM, WHICH IS WHY
# IT IS NOW 760. Measured on <lab-host> with the catalogue loaded and the
# shell's CSS installed, which is the only state in which the number is real:
# the content minimum is 943 against a declared OPEN_WIDTH of 940.
#
# READ THE CONSEQUENCE CAREFULLY, BECAUSE THE FIRST VERSION OF THIS COMMENT GOT
# IT WRONG AND SAID THE WINDOW "OPENED 3px NARROWER THAN IT CAN ACTUALLY BE
# DRAWN". Nothing opened narrow and nothing was clipped. GTK3 will not map a
# toplevel below its content minimum (<agent> proved it with a positive
# control on 2026-08-26), so the window simply OPENED AT 943 and could always be
# dragged to 943. The old wording was also self-contradictory on its own terms:
# a window cannot fail to reach the size it opens at.
#
# THE DEFECT THAT WAS REAL is the DISAGREEMENT between the geometry this file
# declares and the geometry GTK produces. The product then reasons about a width
# the user never gets, and both geometry contracts below compare against
# OPEN_WIDTH, so they failed. Making the declared width agree with the measured
# minimum is what closes it. Same class, same correction, and the full
# derivation: kodachi_ui.py, the block above `_widen_to_content_minimum`. The 3px come from the SIDEBAR, not from this window's pages:
# ui.Window gives the rail `set_size_request(SIDEBAR_WIDTH, -1)`, which is a
# FLOOR and not a cap, and its nav scroller carries
# `set_policy(NEVER, AUTOMATIC)`, so the widest nav row propagates its full
# minimum width upward. Measured chain: nav vbox 174 -> scroller 198 (+24 for
# the vertical scrollbar) -> sidebar 223 (+25 CSS padding) against a declared
# 184, then 223 + 720 of content = 943.
#
# 760 is not a padding number picked to clear the assertion, it is the width
# the command spec default already uses three lines above, and it opens at 944,
# inside the same family. Widening by 4px is the honest fix here because the
# content genuinely needs 943; narrowing the rail instead would clip nav text.
# The sidebar overflowing its own declared width is a real defect in the SHARED
# shell and it is reported separately, because closing it there moves every
# Kodachi window and this window must not carry that decision alone.
WINDOW_WIDTH = 760
WINDOW_HEIGHT = 700

# WHAT THE WINDOW ACTUALLY OPENS AT, DERIVED, NOT RESTATED. ui.Window does not
# use the width and height it is given: it adds the sidebar, floors the result
# at MIN_STANDALONE_WIDTH and caps both axes. So 700x700 above opens at 940x700,
# and a contract comparing a table against WINDOW_WIDTH is comparing it against
# a number that never reaches the screen. Deriving it here means a change to the
# shared shell's own constants moves this with it instead of silently making
# every size assertion in the test suite wrong.
OPEN_WIDTH = min(ui.Window.MAX_COMPACT_WIDTH,
                 max(WINDOW_WIDTH + ui.Window.SIDEBAR_WIDTH,
                     ui.Window.MIN_STANDALONE_WIDTH))
OPEN_HEIGHT = min(WINDOW_HEIGHT, ui.Window.MAX_COMPACT_HEIGHT)

# How much of the opened window a FULL WIDTH page table may use: everything
# except the sidebar and the 14px margin the grid carries on each side. A table
# wider than this is a table that needs a horizontal scrollbar on first paint.
PAGE_WIDTH = OPEN_WIDTH - ui.Window.SIDEBAR_WIDTH - 28

# THE SUM OF THESE IS THE TABLE'S MINIMUM WIDTH, and therefore the window's.
# A Gtk.TreeViewColumn set to FIXED sizing reports its fixed width as its
# minimum, so seven columns adding up to 898 made the whole window refuse to be
# narrower than 898 plus the sidebar plus the margins, whatever the window's
# own default size said. Measured offscreen on <lab-host>: the sources
# table alone was min=898 and the updates table min=836, against a reference
# window whose ENTIRE minimum is 825. Every column is resizable and ellipsizes,
# so these are opening widths and not limits.
SOURCE_COLUMNS = [("Repository", 96), ("Type", 44), ("URI", 186),
                  ("Suite", 78), ("Components", 110), ("Status", 70),
                  ("File", 104)]

UPDATE_COLUMNS = [("Package", 168), ("Installed", 130), ("Available", 130),
                  ("Comes from", 150), ("Class", 76)]

# Sums to 596, comfortably under the 825 reference minimum discussed above, so
# this page does not become the thing that decides the window's width.
FAVOURITE_COLUMNS = [("Application", 176), ("Category", 96), ("Packages", 60),
                     ("Version", 130), ("State", 134)]

