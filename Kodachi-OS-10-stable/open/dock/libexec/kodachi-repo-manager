_GRID_CSS_DONE = False


def tile(letter, component, big=False):
    """A letter in a rounded square, coloured by component.

    The colour is per widget rather than per class because the palette is
    keyed on data, and a class per component would be three near-identical
    CSS blocks that nobody keeps in step with TILE_COLOURS.
    """
    back, fore = TILE_COLOURS.get(component, TILE_DEFAULT)
    label = ui.cls(Gtk.Label(label=(letter or "?")[:1].upper()), "repo-tile")
    if not big:
        label.get_style_context().add_class("repo-tile-small")
    provider = Gtk.CssProvider()
    provider.load_from_data((
        "label { background-color: %s; color: %s; }" % (back, fore)
    ).encode("utf-8"))
    label.get_style_context().add_provider(
        provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    return label


def short_date(stamp):
    """`Mon, 17 Aug 2026 21:37:06 +0000` -> `17 Aug 2026`.

    Returned unchanged when it does not parse, because a date this window
    could not read is worth showing raw rather than replacing with "unknown":
    the raw string is what a reader would paste into a bug report.
    """
    if not stamp:
        return "unknown"
    parts = stamp.replace(",", " ").split()
    for index in range(len(parts) - 2):
        day, month, year = parts[index:index + 3]
        if day.isdigit() and year.isdigit() and len(year) == 4:
            return "%s %s %s" % (day, month, year)
    return stamp


# THE SENTINEL HAS A NAME BECAUSE TWO PLACES NOW HAVE TO AGREE ON IT: the
# settle() that writes it and the datasheet that must recognise it as a
# NON-answer. It used to be a bare literal at one site, which was fine while
# nothing read it back, and a silent coupling the moment something did.
# AND IT IS NOW BOTH RENDERED AND COMPARED, SO IT MUST NEVER BECOME
# TRANSLATABLE. It reaches the user through `short_upload(...)` in the metric
# cell and it is the equality key in the retry test at the datasheet. This
# window has no gettext, no `_()` and no locale import today, so the risk is
# zero-live; the day somebody localises these GTK windows the failure is
# silent rather than loud, because the cell renders in the new language, the
# `== UPLOAD_UNKNOWN` test never fires again, and every package shows the
# offline sentinel forever with no retry and no error. Flagged by
# <agent> 2026-08-22 as the same class as the dashboard's translated
# `confirmText: 'DELETE'`, pointing the opposite way: there a translation
# breaks a gate, here it breaks a retry.
UPLOAD_UNKNOWN = "unknown (offline)"


def short_upload(stamp):
    """`2026-08-16 08:39:22` -> `16 Aug 2026`, anything else unchanged.

    The metric cell is 120px wide. The full timestamp does not fit, so GTK
    ellipsised it to `2026-08-16 08:39 ...` on the VM render, which reads as
    a truncation bug rather than as a date. Parsed here so the cell shows a
    date and the tooltip keeps the exact string.
    """
    if not stamp:
        return "unknown"
    head = stamp.split()[0]
    parts = head.split("-")
    if len(parts) == 3 and parts[0].isdigit() and len(parts[0]) == 4:
        try:
            month, day = int(parts[1]), int(parts[2])
        except ValueError:
            return stamp
        # RANGE-CHECKED, BECAUSE THE IndexError ARM COULD NEVER CATCH THIS.
        # `MONTHS[int("00") - 1]` is `MONTHS[-1]`, a perfectly VALID negative
        # index, so a month of 00 rendered as `Dec` and raised nothing: a month
        # the window never read, presented as fact, in a cell whose whole
        # contract is that it shows a date the window actually fetched. Day 00
        # rendered as `0 Aug 2026`.
        #
        # THE TWO-DIGIT TEST IS THE SECOND HALF AND IT IS ABOUT AGREEMENT, not
        # about parsing. `upload_sort_stamp` requires exactly 8 digits in the
        # date field, so `2026-8-16` displayed as `16 Aug 2026` and sorted as
        # 0, and a `Newest` order filed a package carrying a visibly correct
        # date in among the unknowns. Two predicates for one question is the
        # defect; making them agree is the fix.
        #
        # Neither shape is reachable from the shipped producer, which formats
        # with a zero-padded `%m` (kodachi_repo.fetch_upload_date). Both are
        # reachable from ~/.cache/kodachi/repo-manager/uploads.json, which
        # `read_upload_cache` accepts as any dict with no value validation and
        # which is a plain user-writable file. Same class, and the same
        # reachability, as the `(clock + "0000")[:4]` padding bug documented in
        # `upload_sort_stamp` below.
        if (len(parts[1]) != 2 or len(parts[2]) != 2
                or not 1 <= month <= 12 or not 1 <= day <= 31):
            return stamp
        return "%d %s %s" % (day, MONTHS[month - 1], parts[0])
    return short_date(stamp)


def upload_sort_stamp(stamp):
    """`2026-08-16 08:39 UTC` -> 202608160839. Anything else -> 0.

    THE ONLY PER-PACKAGE DATE THIS WINDOW HAS, AND IT IS NOT IN THE CATALOG.
    `repo.candidate()` returns exactly what the Packages index declared and the
    parser's twenty keys do not include an upload date (kodachi_repo.py builds
    the record at :433, and its own comment at :289 says the Release `Date:` is
    NOT the date any individual package was uploaded). The date the datasheet
    shows is fetched over the network one package at a time by `_fetch_upload`
    and cached in `uploads.json`, so a `Newest` order can only ever cover
    packages whose date has already been looked up. The chip's tooltip says so.

    An int, not the string, because the caller negates it for a newest-first
    order and a string cannot be negated. Compared as TEXT the cache's two
    other shapes sort between two real dates: "unknown (offline)" (written on
    fetch failure) and a raw HTTP date the strptime in fetch_upload_date could
    not parse. Both land on 0 here and the caller sorts them last.
    """
    parts = (stamp or "").split()
    if not parts:
        return 0
    digits = "".join(character for character in parts[0]
                     if character.isdigit())
    if len(parts[0].split("-")) != 3 or len(digits) != 8:
        return 0
    # PAD EACH FIELD, NEVER THE CONCATENATION. `(clock + "0000")[:4]` pads on
    # the RIGHT, so a 3-digit clock like "8:39" became 8390 and outranked
    # 23:00 on the same day. Not reachable from the only writer, because
    # `fetch_upload_date` formats with `%H:%M` and %H is zero-padded, but a
    # hand-edited uploads.json reaches it and the failure is silent.
    # <agent> 2026-08-22, who checked the writer before reporting it.
    clock = parts[1].split(":") if len(parts) > 1 else []
    hour = "".join(c for c in (clock[0] if clock else "") if c.isdigit())
    minute = "".join(c for c in (clock[1] if len(clock) > 1 else "")
                     if c.isdigit())
    return int(digits + hour.zfill(2)[:2] + minute.zfill(2)[:2])


MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
          "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]


def badge(text, tone="on"):
    classes = {"on": "repo-badge", "dim": "repo-badge-dim",
               "warn": "repo-badge-warn"}
    label = ui.cls(Gtk.Label(label=text), "repo-badge")
    if tone != "on":
        label.get_style_context().add_class(classes[tone])
    return label


def chip(text, missing=False):
    label = ui.cls(Gtk.Label(label=text), "repo-chip")
    if missing:
        label.get_style_context().add_class("repo-chip-missing")
    label.set_selectable(True)
    return label


def install_grid_css():
    global _GRID_CSS_DONE
    if _GRID_CSS_DONE:
        return
    provider = Gtk.CssProvider()
    provider.load_from_data(GRID_CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    _GRID_CSS_DONE = True


class RepoManager:
    def __init__(self):
        install_grid_css()
        # The button registry is created here, not in _actionbar, because the
        # datasheet header now owns three of the buttons and is built first.
        self.buttons = {}
        # Armed for real in run_helper; present from construction so Stop
        # and set_busy can never touch an attribute that does not exist.
        self.helper_stop = threading.Event()
        self.helper_proc = None
        self.channel = "stable"
        self.filter = "all"
        self.query = ""
        self.selected = None
        # Which of the three sort chips over the grid is pressed, and which of
        # the four datasheet tabs is showing. Both are view state and neither
        # is ever read by the helper.
        self.sort = "name"
        # Direction for the sort above. Every chip opens in its forward
        # direction and flips on a second press; see SORTS and `_on_sort`.
        self.sort_reverse = False
        self.ds_tab = "about"
        # refresh_table() empties the FlowBox before it refills it, and an
        # empty FlowBox emits `selected-children-changed` with nothing
        # selected. Without this guard that mid-rebuild signal would clear
        # self.selected and close the datasheet a few microseconds before the
        # rebuild re-selects the same package, so every keystroke in the
        # filter box would blank the pane the user is reading.
        self._rebuilding = False
        # name -> the card widget currently drawn for it, so the selection can
        # be restored by name after a rebuild and a contract can read what a
        # card actually renders.
        self.card_index = {}
        self.catalog = {"packages": [], "present": {}, "dates": {},
                        "system_pin": None, "lists_dir": repo.lists_dir(),
                        "installed_count": 0}
        self.uploads = repo.read_upload_cache()
        # Cache keys this window has already spent a fetch on, so a failure
        # is retried once per window rather than once per datasheet rebuild.
        self._upload_tried = set()
        self._upload_failed = {}
        # THE CELL AN UPLOAD ANSWER BELONGS IN, AND THE KEY IT IS FOR. Both are
        # rewritten by every datasheet build, and `_fetch_upload`'s settle
        # resolves its target through them rather than through the widget it
        # captured when the thread started. See show_detail and _fetch_upload.
        self._upload_label = None
        self._upload_key = ""
        self.busy = False
        # Console/progress state, all created before _replace_body builds the
        # widgets that read them: _console_target is called from the very first
        # size-allocate, which can fire during construction.
        self.console_expanded = False
        # The datasheet's current width, driven by the drag grip. Seeded from
        # the mockup's own 432 so nothing changes until he drags it.
        self.detail_width = DETAIL_WIDTH
        self._grip_origin = None
        self._dev_prompt_shown = False
        # Failed dev credential attempts, and the monotonic deadline until
        # another is allowed. See _dev_attempt_guard for why the CLIENT bounds
        # this even though the server is the thing that authenticates.
        self._dev_attempts = 0
        self._dev_locked_until = 0.0
        # PER-RUN TOKEN. Every queued idle callback that writes run state
        # carries the token of the run that queued it, so a callback that
        # arrives late cannot label a finished run, or the NEXT one, with the
        # previous run's status. <agent>, finding c804ba72.
        self._run_token = 0
        # verb -> Gtk.MenuItem, so _apply_action_lock can grey the maintenance
        # entries while a helper runs like every other privileged control.
        self.maintenance_items = {}
        self.maintenance_button = None
        self._progress_seen = False
        self._progress_pulse_id = 0
        self._divider_locked = False
        self._pinning = False
        self.page = "packages"
        self.sources = []
        self.updates = []
        self.updates_error = ""
        self.updates_checked = False
        self._updates_generation = 0
        # ISO images. A separate source from apt (see kodachi_repo's ISO
        # section), so it gets its own generation counter and its own error, and
        # a failure to read it never touches the apt numbers beside it.
        self.iso_rows = []
        self.iso_error = ""
        self.iso_checked = False
        self.iso_read_at = ""
        self._iso_fetched_at = 0.0
        self._iso_generation = 0
        self.favourites = []
        self.favourites_error = ""
        self.favourites_checked = False
        self._favourites_generation = 0
        self._trust_generation = 0
        self._trust_pending = None
        self._trust_cache = {}
        self._state_cache = {}
        self._catalog_generation = 0
        self.catalog_checked = False
        self.catalog_error = ""
        self.catalog_ready = False
        # A background check can outlive the window: he can close it while apt
        # is still being simulated. Writing into a destroyed widget from the
        # idle callback prints Gtk criticals and, on the sources page, touches a
        # store that no longer has a view.
        self.alive = True

        # The subtitle names ALL THREE destinations, because it is the only
        # line on the page that says what the window is for and it is visible
        # from every page. It used to describe the Kodachi channels alone,
        # which read as plainly wrong while the Updates page was showing 447
        # Debian upgrades.
        self.window = ui.Window(
            "Repository Manager",
            "Kodachi packages and channels, every apt repository this machine "
            "reads, and the updates waiting on all of them",
            width=WINDOW_WIDTH, height=WINDOW_HEIGHT)
        self._strip_slot = self.window._state_slot
        self.window.connect("destroy", self._on_destroy)
        self.window.connect("delete-event", self._on_delete_event)
        self._replace_body()
        self._build_nav()
        self.window.connect("key-press-event", self._on_window_key)
        self.reload()

    def _on_destroy(self, _widget):
        self.alive = False

    def _on_delete_event(self, _window, _event):
        """Warn, and let him decide, before a close can cut apt off.

        NOT a nicety. `kodachi-repo-apt` starts apt with INHERITED stdout (no
        `stdout=` at its Popen), so apt writes into the pipe whose READ end
        this process owns. This Gtk.Application holds FLAGS_NONE and this is
        its only window, so destroying it quits the application, the process
        exits, the read end closes, and CPython's default
        `restore_signals=True` has already put SIGPIPE back to SIG_DFL in the
        child: apt dies on its next write. Mid `dpkg --unpack` that leaves the
        machine needing `sudo dpkg --configure -a`, and the window that could
        have explained it has gone with the process.

        A WARNING WITH AN EXPLICIT OVERRIDE, NOT A LOCKED DOOR. Refusing
        outright would trap him: after Stop on a pkexec'd helper the run is
        abandoned but `busy` stays True until that root process exits, so an
        unconditional refusal would make the window unclosable for as long as
        apt takes. He is told exactly what closing costs and keeps the
        decision. Returning True stops the delete; returning False lets it
        proceed.
        """
        if not self.busy:
            return False
        dialog = Gtk.MessageDialog(
            transient_for=self.window, modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE,
            text="A privileged operation is still running")
        dialog.format_secondary_text(
            "Closing this window now cuts apt off mid-operation, which can "
            "leave dpkg needing `sudo dpkg --configure -a` before anything "
            "else can be installed. Wait for it to finish, or close anyway "
            "if you know the operation has already ended.")
        dialog.add_button("Keep waiting", Gtk.ResponseType.CANCEL)
        close = dialog.add_button("Close anyway", Gtk.ResponseType.ACCEPT)
        close.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        answer = dialog.run()
        dialog.destroy()
        return answer != Gtk.ResponseType.ACCEPT

    def _on_window_key(self, _window, event):
        """Keyboard map, then the Tab bridge.

        THE WINDOW BOUND EXACTLY ONE KEY BEFORE THIS: Tab. No refresh, no way
        to reach the filter box, no way to dismiss the datasheet, no mnemonics
        anywhere. Four bindings, each mapping to a control that already exists
        so the keyboard cannot do anything the pointer cannot:

          F5 / Ctrl+R   Refresh status   (the free one, never apt update)
          Ctrl+F        focus the filter entry
          Ctrl+L        clear the console
          Escape        close the datasheet if open

        ESCAPE DELIBERATELY DOES NOT CLOSE THE WINDOW, which is the usual GTK
        reflex for it. This window can have a root apt operation in flight, and
        its own delete-event handler exists to warn before a close cuts dpkg
        off mid-unpack. A key that bypassed that warning would be a way to
        break the machine by leaning on the keyboard.
        """
        control = event.state & Gdk.ModifierType.CONTROL_MASK
        if event.keyval in (Gdk.KEY_F5,) or (
                control and event.keyval in (Gdk.KEY_r, Gdk.KEY_R)):
            # The free recount, not `apt update`: a key should not be able to
            # start a password prompt and a network fetch by accident.
            if not self.busy:
                self.reload()
            return True
        if control and event.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            entry = getattr(self, "search", None)
            if entry is not None and self.page == "packages":
                entry.grab_focus()
                return True
            return False
        if control and event.keyval in (Gdk.KEY_l, Gdk.KEY_L):
            self.clear_console()
            return True
        if event.keyval == Gdk.KEY_Escape:
            if (getattr(self, "detail_reveal", None) is not None
                    and self.detail_reveal.get_reveal_child()):
                self._on_detail_close(None)
            return True
        semantic_modifiers = (
            Gdk.ModifierType.SHIFT_MASK
            | Gdk.ModifierType.CONTROL_MASK
            | Gdk.ModifierType.MOD1_MASK
            | Gdk.ModifierType.SUPER_MASK
            | Gdk.ModifierType.HYPER_MASK
            | Gdk.ModifierType.META_MASK)
        if (event.keyval != Gdk.KEY_Tab
                or event.state & semantic_modifiers):
            return False
        focused = self.window.get_focus()
        if (self.page == "packages"
                and isinstance(focused, Gtk.FlowBoxChild)):
            action = getattr(focused, "package_action", None)
            if action is None:
                return False
            if action.get_sensitive() and action.get_can_focus():
                target = action
            elif (not action.get_sensitive()
                    and self.detail_reveal.get_reveal_child()
                    and self.ds_close.get_visible()):
                # A package absent from the selected channel has a disabled
                # card action. Its datasheet is still live and is the next
                # useful keyboard region, so do not consume Tab on a target
                # that cannot take focus.
                target = self.ds_close
            else:
                return False
        elif (self.page == "packages"
              and any(focused is getattr(child, "package_action", None)
                      for child in self.cards.get_children())):
            # The datasheet contains Close, its four tabs, and the package
            # actions. Enter that visible region before the shared console.
            target = self.ds_close
        elif self.page == "packages" and focused is self.ds_close:
            target = next((button for button in self.tab_buttons.values()
                           if button.get_active()), None)
        elif (self.page == "packages"
                and focused in self.tab_buttons.values()):
            actions = [self.buttons[key]
                       for key in ("install", "switch", "hold", "remove")
                       if self.buttons[key].get_visible()
                       and self.buttons[key].get_sensitive()
                       and self.buttons[key].get_can_focus()]
            target = actions[0] if actions else self.log
        elif (self.page == "packages"
                and focused in [self.buttons[key]
                                for key in ("install", "switch", "hold", "remove")]):
            actions = [self.buttons[key]
                       for key in ("install", "switch", "hold", "remove")
                       if self.buttons[key].get_visible()
                       and self.buttons[key].get_sensitive()
                       and self.buttons[key].get_can_focus()]
            if focused not in actions:
                return False
            position = actions.index(focused)
            target = (actions[position + 1]
                      if position + 1 < len(actions) else self.log)
        elif (self.page == "packages"
                and focused in self.channel_buttons.values()):
            children = (self.cards.get_selected_children()
                        or self.cards.get_children())
            target = children[0] if children else None
        elif focused is self.nav_buttons.get(self.page):
            target = {
                "sources": self.sources_view,
                "updates": self.updates_view,
                "favourites": self.favourites_view,
            }.get(self.page)
        elif focused is {
                "sources": self.sources_view,
                "updates": self.updates_view,
                "favourites": self.favourites_view,
        }.get(self.page):
            target = self.log
        else:
            return False
        if (target is None or not target.get_visible()
                or not target.get_sensitive() or not target.get_can_focus()):
            return False
        target.grab_focus()
        # A failed grab must not swallow the key. Let GTK's normal traversal
        # try when the proposed destination did not actually take focus.
        return self.window.get_focus() is target

    # ------------------------------------------------------------------
    # layout
    # ------------------------------------------------------------------
    def _replace_body(self):
        """Swap the shell's single scrolling column for a real three-pane app.

        The shared shell scrolls one column of cards, which is right for a list
        of switches and wrong for a table that must stay visible while a detail
        pane and a command log move underneath it.
        """
        scroll = getattr(self.window, "_scroll", None)
        if scroll is not None and scroll.get_parent() is not None:
            scroll.get_parent().remove(scroll)

        outer = ui.vbox(0)
        self.window.root.pack_start(outer, True, True, 0)
        # ABOVE THE PAGE STACK, so it is on screen from every page. See
        # _global_bar for why the existing Refresh was not enough.
        outer.pack_start(self._global_bar(), False, False, 0)

        vertical = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL)
        outer.pack_start(vertical, True, True, 0)

        # Three destinations, one command log. The log is deliberately OUTSIDE
        # the stack: an apt run started from the Updates page prints while the
        # user is reading the package table, and hiding that output behind a
        # page switch is how a long silent postinst turns into "it is frozen".
        self.pages = Gtk.Stack()
        self.pages.set_transition_type(Gtk.StackTransitionType.NONE)
        vertical.pack1(self.pages, True, False)

        packages = ui.vbox(0)
        packages.pack_start(self._toolbar(), False, False, 0)
        # THE DATASHEET IS A SLIDE-OVER NOW, NOT HALF OF A SPLIT. A Gtk.Paned
        # is the right widget for two panes that both always exist and share
        # the width; the mockup has one pane that owns the whole window and a
        # 432px panel that slides in over the right of it when a card is
        # chosen and gives every pixel back when it is closed. A Paned cannot
        # express that: its divider is an absolute offset, so a revealed child
        # of width 0 still leaves a divider and a dead strip. What is lost
        # with it is the drag handle between list and datasheet, which had no
        # counterpart in the mockup and nothing to drag once the datasheet is
        # a fixed-width overlay.
        horizontal = ui.hbox(0)
        packages.pack_start(horizontal, True, True, 0)
        self.pages.add_named(packages, "packages")
        self.pages.add_named(self._sources_page(), "sources")
        self.pages.add_named(self._updates_page(), "updates")
        self.pages.add_named(self._favourites_page(), "favourites")
        # A Gtk.Stack picks its visible child from the children that are SHOWN.
        # Without this the stack has no visible child until the window is shown,
        # set_visible_child_name() is a no-op, and every nav click looks dead.
        self.pages.show_all()
        self.pages.set_visible_child_name("packages")

        # THE GRID EXPANDS, THE DATASHEET DOES NOT. It is the exact opposite
        # of the split this replaces, and it is the whole point of the
        # storefront: with nothing selected the grid is the window, and the
        # cards wrap into as many columns as the width allows.
        horizontal.pack_start(self._table(), True, True, 0)
        horizontal.pack_start(self._detail(), False, False, 0)

        vertical.pack2(self._console(), False, True)
        vertical.set_position(672)
        # A Paned divider is an ABSOLUTE offset from the top, so a constant is
        # wrong at every size but one. Measured on the VM render at 1150 tall:
        # the command log took 245 vertical pixels of empty black, 21% of the
        # window. A ONE-SHOT pin was the first fix and it is wrong in both
        # directions: at 940x640, the size this window now opens at, the paned
        # is allocated ~346px, the old `<= 400` guard returned early, the
        # divider stayed at its 672 constant and the command log was pushed
        # off the bottom of the window entirely. Pinning once at 640 and then
        # maximising has the mirror fault: the offset stays put and the log
        # grows to fill everything the window gained.
        # So re-pin the log to CONSOLE_HEIGHT on every allocation, and stop the
        # moment the operator drags the divider, because after that the
        # position is theirs. MIN_TOP_PANE keeps the pin from squeezing the
        # table and datasheet to nothing on a very short window; below that the
        # divider is left where it is and both panes scroll.
        # THE LOCK ARMS ON PRESS, NOT ON RELEASE, AND THAT ONE WORD WAS THE BUG.
        # A Gtk.Paned drag is a press, then a stream of motion events each of
        # which sets a new position and triggers a size-allocate, then a
        # release. Arming on `button-release-event` meant every one of those
        # intermediate allocates still saw `_divider_locked == False` and
        # re-pinned the divider to `height - CONSOLE_HEIGHT`, so the log
        # snapped back under the pointer on every motion event and only the
        # final position, set after the last allocate, could survive. In
        # practice the pane fought the drag the whole way and usually won.
        # Arming on PRESS makes the very first motion event authoritative.
        #
        # A KEY-PRESS HANDLER covers the path that moves the divider without a
        # pointer: keyboard resize, F8 then arrows. It used to be a
        # `notify::position` handler, which is the signal GTK ALSO emits from
        # its own allocation, so it locked the divider on the first automatic
        # placement and the default never applied. See note_keyboard_resize.
        self._divider_locked = False
        self._pinning = False

        def remember_drag(paned, event):
            self._divider_locked = True
            return False

        def note_keyboard_resize(paned, event):
            """A keyboard divider move is a user instruction, same as a drag.

            THIS USED TO BE A `notify::position` HANDLER AND IT ARMED THE LOCK
            BEFORE ANYBODY TOUCHED ANYTHING. The guard was `if not
            self._pinning`, which covers the moves THIS code makes and nothing
            else, and GTK emits notify::position from its own allocation and
            clamping too. So the very first size-allocate set
            `_divider_locked = True`, and from then on:

              , `place_divider` returned early on every later allocation, so
                maximising the window left the divider at the offset it had at
                944x700 and the command output pane kept a sliver of a much
                taller window, or none of it;
              , `_auto_expand_console` begins `if self._divider_locked or
                self.console_expanded: return`, so THE PANE NEVER OPENED WHEN A
                RUN STARTED. That is the feature the operator asked for, and it
                had never once run.

            MEASURED 2026-08-30 on <lab-host>, real window, offscreen,
            open at 944x700 then resize to 3414x1408, which is the sequence of
            opening it and maximising it:

                                            paned  position  locked  expanded
                before, opened                378       377    True         .
                before, maximised             378       377    True         .
                before, run starts            378       377    True     False
                after,  opened                378       188   False         .
                after,  maximised            1104       914   False         .
                after,  run starts           1104       497   False      True

            The `after` row for a starting run is the whole fix: the divider
            moves and `console_expanded` finally becomes True.
            """
            self._divider_locked = True
            return False

        def place_divider(paned, allocation):
            if self._divider_locked:
                return
            if allocation.height < CONSOLE_HEIGHT + MIN_TOP_PANE:
                return
            want = allocation.height - self._console_target(allocation.height)
            if paned.get_position() != want:
                self._pinning = True
                try:
                    paned.set_position(want)
                finally:
                    self._pinning = False

        vertical.connect("button-press-event", remember_drag)
        vertical.connect("key-press-event", note_keyboard_resize)
        vertical.connect("size-allocate", place_divider)
        self._vertical = vertical

        self.actions = Gtk.Stack()
        self.actions.set_transition_type(Gtk.StackTransitionType.NONE)
        # A Stack requests the TALLEST of its pages on both axes by default,
        # so the two-row packages bar was setting the height of the one-row
        # sources and updates bars and both rendered as a mostly empty card
        # with 76px pill buttons floating in it. Each bar owns a different
        # number of rows, so ask for the visible one's height only.
        self.actions.set_vhomogeneous(False)
        self.actions.add_named(self._actionbar(), "packages")
        self.actions.add_named(self._sources_actionbar(), "sources")
        self.actions.add_named(self._updates_actionbar(), "updates")
        self.actions.add_named(self._favourites_actionbar(), "favourites")
        self.actions.show_all()
        self.actions.set_visible_child_name("packages")
        outer.pack_start(self.actions, False, False, 0)

    def _global_bar(self):
        """One always-visible row: refresh everything, and say how old it is.

        Operator, 2026-08-29: "there is no button to refresh the over all repo
        status and know what is the new".

        A `Refresh` button DID exist, and saying so precisely is the point,
        because the fix is not "add the button that is missing". It was the
        sixth of six buttons packed to the right of the packages page's foot,
        it existed on that ONE page, and it ran `apt-get update` under pkexec,
        so the only control offering to refresh anything cost an authentication
        prompt and a network round trip. Meanwhile the Updates page had
        "Recount only" and Additional apps had "Recheck", both free and both
        scoped to their own page, so the catalogue, the rail counts and the
        channel strip, the numbers he was actually looking at, had no cheap
        refresh at all.

        So this row is TWO controls with the difference written on them, on
        every page:

          Refresh status      re-reads /var/lib/apt/lists, dpkg and the pins.
                              No password, no network, no apt run. This is what
                              answers "did that change anything".
          Update from servers `apt-get update` through the helper. Password,
                              network, and it is the only one of the two that
                              can discover a NEW version.

        And the age of the index they read, because a refresh of a
        three-month-old index is confidently wrong and nothing on screen said
        so: nothing in this window ever stat'd the apt lists.
        """
        bar = ui.cls(ui.hbox(8), "card")
        bar.set_margin_start(14)
        bar.set_margin_end(14)
        bar.set_margin_top(6)
        bar.set_margin_bottom(2)

        self._button(bar, "status_refresh", "Refresh status",
                     "Re-read this machine's package state: the apt indexes "
                     "already downloaded, what dpkg says is installed, and the "
                     "channel pins. Costs no password and touches no network, "
                     "and changes nothing. Use it to see the effect of "
                     "something that has just finished.",
                     lambda _b: self.reload())
        self._button(bar, "status_update", "Update from servers",
                     "sudo apt update through the Kodachi helper: ask every "
                     "configured repository for a new package index, then "
                     "re-read everything. This is the only control here that "
                     "can discover a version that was not already known.",
                     lambda _b: self.run_helper(["update"], "apt update"))

        # ---- maintenance, behind one button ------------------------------
        # A MENU AND NOT FIVE MORE BUTTONS. The packages foot already carries
        # six, and the operator's standing complaint about this window is that
        # its controls are bulky ("i [expletive] said dont use bulky big contols
        # they look bad"). These five are also all rare: a user may never need
        # Repair, and if they do it is once. Rare and destructive-adjacent is
        # exactly what a menu is for, and it keeps the foot the size it is.
        maintenance = Gtk.MenuButton(label="Maintenance")
        ui.cls(maintenance, "ghost", "chip")
        maintenance.set_valign(Gtk.Align.CENTER)
        menu = Gtk.Menu()
        for label, tip, argv, description, confirm in MAINTENANCE_ACTIONS:
            item = Gtk.MenuItem(label=label)
            item.set_tooltip_text(tip)
            item.connect(
                "activate",
                lambda _i, a=argv, d=description, c=confirm, t=tip:
                self._on_maintenance(a, d, c, t))
            menu.append(item)
            self.maintenance_items[argv[0]] = item
        # ── DEV CREDENTIALS, REACHABLE FROM THE TOP ───────────────────────
        # Operator, 2026-08-30, arrow pointing at this button: "if you are
        # logged in to dev you shoudl have a button to clear ther credentioals
        # so its locked again". The button exists, and it is the fifth of six
        # controls in the packages foot, at the bottom edge of a 1440px-tall
        # window, greyed while a run is in progress, which is exactly the state
        # his screenshot caught it in. Rare, credential-shaped and reversible
        # is what this menu already holds, so it belongs here as well; the foot
        # button stays, because moving it would break the muscle memory of
        # anyone who has found it.
        #
        # Its label is written by _draw_strip alongside the foot button's, from
        # the same predicate, so the two can never disagree about whether this
        # machine holds a dev key.
        menu.append(Gtk.SeparatorMenuItem())
        # BUILT WITH THE RIGHT LABEL, not merely corrected later. _draw_strip
        # keeps both controls in step, but it first runs only after the
        # catalogue thread lands, so a menu built with the wrong verb
        # advertises "Dev credentials" on a machine that holds a key, for
        # however long the first apt read takes.
        self.dev_auth_item = Gtk.MenuItem(
            label="Clear dev credentials" if dev_auth_file_present()
            else "Dev credentials")
        self.dev_auth_item.set_tooltip_text(
            "Store or clear the login and password for the dev channel. "
            "Storing them lets this machine see and install dev packages; "
            "clearing them removes the key and the dev package list with it.")
        self.dev_auth_item.connect("activate",
                                   lambda _i: self._on_dev_auth(None))
        menu.append(self.dev_auth_item)
        menu.show_all()
        maintenance.set_popup(menu)
        maintenance_tip = ("Repairs and housekeeping: fix an interrupted "
                           "package transaction, install upgrades that need "
                           "new dependencies, remove packages nothing needs, "
                           "empty the download cache, or undo a machine-wide "
                           "channel pin.")
        maintenance.set_tooltip_text(maintenance_tip)
        ui.set_control_accessibility(maintenance, "Maintenance",
                                     maintenance_tip)
        # A Gtk.MenuButton IS a Gtk.Button (via ToggleButton), so marking it
        # privileged is enough for _apply_action_lock's tree walk to grey it
        # while a helper runs, exactly like the six buttons in the foot. Every
        # item behind it starts a root operation, so leaving it live during a
        # run would offer a second one; _on_maintenance refuses anyway, but a
        # control that looks available and then declines is the thing the
        # ds_reason row exists to stop this window doing.
        maintenance.kodachi_privileged_action = True
        self.maintenance_button = maintenance
        bar.pack_start(maintenance, False, False, 0)

        # ── THE RUN STATUS, AT THE TOP, WHERE HE IS ALREADY LOOKING ───────
        # Operator, 2026-08-30, arrow drawn at the console pane: "THis shoudl
        # be the default view when i run update this panel is hidden down you
        # cant see the progress bar!", and separately "the user can't even tell
        # if the update or install is completed !".
        #
        # Mirroring progress into the console's own header does NOT answer
        # that, and I nearly shipped it believing it did: that header sits
        # INSIDE the pane he is complaining about, roughly 1140px down a
        # 1435px window, so it is exactly as far away as the bar. This label is
        # in the top action bar, two controls from the buttons that start these
        # operations, and it is on screen whatever page is showing and whatever
        # is scrolled where.
        #
        # It carries the same string as the console note, from
        # _set_run_status, so the top of the window and the bottom of it can
        # never disagree about whether a run is finished.
        self.run_status = ui.lbl("", "note")
        self.run_status.set_ellipsize(Pango.EllipsizeMode.END)
        self.run_status.set_no_show_all(True)
        ui.set_control_accessibility(
            self.run_status, "Operation status",
            "What the running repository operation is doing, and how it "
            "ended.")
        bar.pack_end(self.run_status, False, False, 0)

        self.index_age = ui.lbl("", "note")
        self.index_age.set_ellipsize(Pango.EllipsizeMode.END)
        bar.pack_end(self.index_age, False, False, 0)
        return bar

    def _on_maintenance(self, argv, description, confirm_body, tip):
        """Run one maintenance verb, asking first when it can remove things.

        The confirmation is not blanket: `clean` cannot lose anything the
        user wants and asking about it trains people to click through
        dialogs. `fix-broken`, `full-upgrade`, `autoremove` and `system-clear`
        can each remove a package or change what the whole machine tracks, so
        each states what it may do before it does it.

        `fix-broken` WAS IN THE FIRST GROUP AND SHOULD NOT HAVE BEEN. It runs
        `apt -y -f install`, which may remove a package to repair a broken
        set. See the note beside its MAINTENANCE_ACTIONS entry.
        """
        if self.busy:
            self.append_log(
                "Another privileged repository operation is still running; "
                "this request was not started.\n")
            return
        if confirm_body and not self.confirm(description, confirm_body):
            return
        self.run_helper(list(argv), description)

    def _refresh_index_age(self):
        """Say how old the newest Kodachi apt index on this machine is.

        MTIME, NOT THE RELEASE FILE'S `Date:` HEADER, and the two answer
        different questions. The datasheet's INDEX SYNCED cell already shows
        the Date header, which is when the PUBLISHER built the index; this is
        when THIS MACHINE last fetched one, which is the number that tells him
        whether "no updates" means "nothing new" or "nobody has asked in three
        months". Nothing in the window measured it: a grep for os.stat over
        both modules found one hit, on a keyring, and none on the lists.
        """
        label = getattr(self, "index_age", None)
        if label is None:
            return
        newest = None
        directory = self.catalog.get("lists_dir") or repo.lists_dir()
        for channel in repo.CHANNELS:
            for path in repo.index_files(channel, directory):
                try:
                    stamp = os.path.getmtime(path)
                except OSError:
                    continue
                if newest is None or stamp > newest:
                    newest = stamp
        if newest is None:
            label.set_text("no package index on this machine")
            ui.set_ellipsis_tooltip(
                label, "No Kodachi repository index has been downloaded here, "
                "so there is nothing to list. Press Update from servers.")
            return
        age = max(0, time.time() - newest)
        days = age / 86400.0
        if days < 1:
            hours = int(age // 3600)
            text = ("index fetched under an hour ago" if hours < 1
                    else "index fetched %d hour%s ago"
                    % (hours, "" if hours == 1 else "s"))
        else:
            whole = int(days)
            text = "index fetched %d day%s ago" % (whole,
                                                   "" if whole == 1 else "s")
        # A THRESHOLD, BECAUSE AN AGE ALONE IS NOT A JUDGEMENT. Seven days is
        # chosen to match how often the channels actually publish; past it the
        # words say what to do rather than leaving him to work it out.
        if days >= STALE_INDEX_DAYS:
            text += ", press Update from servers"
            label.get_style_context().add_class("repo-stale")
        else:
            label.get_style_context().remove_class("repo-stale")
        label.set_text(text)
        ui.set_ellipsis_tooltip(
            label, "%s. This is when this machine last downloaded a package "
            "index, not when the version you see was published." % text)

    def _console_target(self, window_height):
        """How many vertical pixels the command log should get right now.

        One function so the default placement, the Expand toggle and the
        auto-expand on a starting run cannot drift apart. Bounded on both
        sides: never smaller than CONSOLE_HEIGHT, and never so large that the
        table above it drops below MIN_TOP_PANE, which is what stops Expand
        from swallowing the window on a short screen.
        """
        if not getattr(self, "console_expanded", False):
            return CONSOLE_HEIGHT
        want = int(window_height * CONSOLE_EXPANDED_FRACTION)
        return max(CONSOLE_HEIGHT, min(want, window_height - MIN_TOP_PANE))

    def _apply_console_size(self):
        """Move the divider to the current target, overriding a past drag.

        Clears `_divider_locked` deliberately: the user pressing Expand IS a
        new instruction about the divider, and honouring an earlier drag over
        an explicit later click would make the button look dead.
        """
        paned = getattr(self, "_vertical", None)
        if paned is None:
            return
        allocation = paned.get_allocation()
        if allocation.height < CONSOLE_HEIGHT + MIN_TOP_PANE:
            return
        self._divider_locked = False
        self._pinning = True
        try:
            paned.set_position(
                allocation.height - self._console_target(allocation.height))
        finally:
            self._pinning = False

    def _on_console_expand(self, button):
        self.console_expanded = button.get_active()
        ui.state_toggle(button, "Collapse" if self.console_expanded
                        else "Expand")
        self._apply_console_size()

    def _auto_expand_console(self):
        """Grow the log once, when a run starts, if he has not sized it himself.

        ONCE, and only from the default. If he collapsed it, or dragged the
        divider anywhere, that is a decision and a starting apt run is not a
        reason to overrule it. Without this the first thing a new user sees
        when they press Upgrade is a nine-line pane scrolling too fast to read;
        with it the pane opens to the size that shows a whole apt summary and
        stays wherever he leaves it afterwards.
        """
        if self._divider_locked or self.console_expanded:
            return
        self.console_expanded = True
        expand = getattr(self, "log_expand", None)
        if expand is not None:
            # set_active re-enters _on_console_expand, which re-labels the
            # button and applies the size, so do not duplicate either here.
            expand.set_active(True)
        else:
            self._apply_console_size()

    def _toolbar(self):
        bar = ui.cls(ui.hbox(8), "card")
        bar.set_margin_start(14)
        bar.set_margin_end(14)
        bar.set_margin_top(8)
        bar.set_margin_bottom(4)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Filter by name, summary or hash")
        # THE SEARCH BOX IS SIZED IN CHARACTERS, NOT PIXELS. Operator, a3.png:
        # "search box too bulky and big". A GtkSearchEntry sizes itself from
        # max(width-chars, the placeholder) and the default width-chars on this
        # theme is generous, so the 176px request was a FLOOR under an already
        # large natural width and did nothing to shrink it. Capping width-chars
        # is what actually bounds it; the placeholder is shortened to match,
        # because a placeholder longer than the box is ellipsised into
        # uselessness and the full sentence moves to the tooltip.
        self.search.get_style_context().add_class("repo-filter")
        self.search.set_width_chars(14)
        self.search.set_max_width_chars(18)
        self.search.set_placeholder_text("Filter")
        ui.set_row_tooltip(self.search,
                           "Filter this channel by package name, summary or "
                           "SHA256, as you type")
        self.search.connect("search-changed", self._on_search)
        bar.pack_start(self.search, False, False, 0)

        # ONE SEGMENTED CONTROL, not three separate buttons with three sets of
        # padding. Operator, a1.png: "i [expletive] said dont use bulky big contols
        # they look bad !!!". The height came from the theme's default button
        # padding on a GtkRadioButton in toggle mode, which is tuned for a
        # dialog's OK button and not for a filter strip. `.repo-seg` in
        # GRID_CSS gives the three of them a single compact metric, and the
        # linked box draws them as one control so the eye reads a switch rather
        # than a row of buttons.
        self.channel_buttons = {}
        segmented = ui.cls(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                                   spacing=0), "repo-seg")
        segmented.get_style_context().add_class("linked")
        segmented.set_valign(Gtk.Align.CENTER)
        group = None
        for key in ("stable", "beta", "dev"):
            button = Gtk.RadioButton.new_with_label_from_widget(group, key.upper())
            if group is None:
                group = button
            button.set_mode(False)
            button.connect("toggled", self._on_channel, key)
            ui.set_row_tooltip(button, "Show the %s channel: %s"
                               % (repo.CHANNELS[key]["label"],
                                  repo.CHANNELS[key]["url"]))
            segmented.pack_start(button, False, False, 0)
            self.channel_buttons[key] = button
        bar.pack_start(segmented, False, False, 0)

        # ---- the dot legend, because a colour nobody explains is decoration -
        # Operator, a1.png: "what does the dot mean the green one and why some
        # have it some dont have it !". Both halves of that are fair. The
        # column had an EMPTY header, so there was nothing to hover and nothing
        # to read, and "AVAILABLE" was #4b5b4b against a #05070a background,
        # which is a dot only if you already know it is there. The legend is
        # built from STATE_COLOURS itself, so a state added to that table
        # cannot be missing from the key.
        # ON ITS OWN ROW, NOT IN THE TOOLBAR. Measured at the real 940x700
        # opening size on <lab-host>: beside the search entry, the
        # segmented channel control and the counter, the five legend words were
        # allocated 25px each against the 35 to 72px they need, so every one of
        # them rendered as an ellipsis. The toolbar is simply not wide enough
        # for a key and three controls at the width he asked this window to
        # open at, and shrinking the key until it is unreadable is not a
        # compromise, it is the original defect with extra steps.
        self._legend_row = self._state_legend()

        # THE COUNTER BELONGS OVER THE LIST IT COUNTS. Operator, a3.png:
        # "alignment issue !" with an arrow at "8 of 28 packages". The toolbar
        # spans the whole window, both panes, while the list occupied only the
        # left one, so a bare pack_end parked the count at the far right edge
        # of the datasheet, hundreds of pixels from the list and directly above
        # a column of dependency chips. It now sits in its own expanding slot
        # packed with the left group, and pack_end inside THAT slot right-
        # aligns it over the grid rather than over the window, so it cannot
        # drift back across the datasheet when the window is resized.
        #
        # THE ORIGINAL FIX ANCHORED IT TO TABLE_WIDTH AND THAT CONSTANT IS GONE.
        # TABLE_WIDTH was the old TreeView's column sum and died with the
        # TreeView in the storefront conversion; test_repo_manager.py asserts
        # the module no longer defines it. The card grid has no fixed width to
        # anchor to, which is why the slot expands instead.
        self.counter = ui.lbl("", "note")
        self.counter.set_xalign(1.0)
        # Same reason as the legend: "28 of 28 packages" is 99px of minimum
        # for a number the table itself also shows. ELLIPSIZE ONLY, see the
        # legend below for why max_width_chars(1) was the wrong knob and what
        # it did to this label.
        self.counter.set_ellipsize(Pango.EllipsizeMode.END)
        counter_slot = ui.hbox(0)
        counter_slot.pack_end(self.counter, False, False, 0)
        bar.pack_start(counter_slot, True, True, 0)
        self._counter_slot = counter_slot

        stack = ui.vbox(2)
        stack.pack_start(bar, False, False, 0)
        stack.pack_start(self._legend_row, False, False, 0)
        return stack

    def _state_legend(self):
        """The key for the list's state dot, built from STATE_COLOURS."""
        legend = ui.cls(ui.hbox(8), "repo-legend")
        legend.set_valign(Gtk.Align.CENTER)
        # It sits on its own row now, so it carries the toolbar's own
        # horizontal margins or it would start flush against the window edge
        # while everything above it is inset.
        legend.set_margin_start(14)
        legend.set_margin_end(14)
        legend.set_margin_bottom(4)
        for word, colour in STATE_COLOURS.items():
            item = ui.hbox(4)
            dot = ui.lbl("", "note")
            dot.set_markup('<span foreground="%s">\u25cf</span>' % colour)
            item.pack_start(dot, False, False, 0)
            text = ui.cls(ui.lbl(word.title(), "note"), "repo-legend-word")
            # THE LEGEND MUST NOT SET THE WINDOW'S MINIMUM WIDTH. Measured
            # offscreen on <lab-host> after this legend was added: the
            # toolbar's minimum went to 816px, of which the legend alone was
            # 340, and the whole window's minimum went to 1032 against an
            # OPEN_WIDTH of 940. The contract
            # test_the_window_can_be_dragged_down_to_the_size_it_opens_at
            # caught it, which is what it is for, and it is the operator's own
            # complaint from a1.png: "the window size shoudl be as other gtkk
            # cairo windos not so big".
            #
            # ELLIPSIZE ALONE. `set_ellipsize(END)` is what separates the two
            # numbers a label reports: MINIMUM drops to about one character so
            # the window can be dragged narrow, and NATURAL stays the whole
            # word so at any normal size the legend reads "Installed Update
            # Downgrade Available Not In Channel".
            #
            # I ORIGINALLY ADDED `set_max_width_chars(1)` HERE AND IT DESTROYED
            # THE LEGEND. That property CLAMPS THE NATURAL width, it does not
            # preserve it, so these labels asked for one character and, packed
            # with expand=False, were allocated exactly that. Measured on
            # <lab-host> at the real 940x700 opening size: "Update" got
            # 8px against the 35px it needs, "Not In Channel" 8px against 72,
            # and the package counter 9px against 101. Five labels rendered as
            # a smear of ellipsis, including the legend added to answer his
            # a1.png question "what does the dot mean".
            #
            # Found by the truncation detector in the state sweep, not by
            # looking: the fix for one of his findings had quietly created
            # another of the same kind, and the window-minimum contract that
            # prompted the change stayed green throughout because MINIMUM was
            # never the number that broke.
            text.set_ellipsize(Pango.EllipsizeMode.END)
            item.pack_start(text, False, False, 0)
            ui.set_row_tooltip(item, STATE_MEANINGS[word])
            legend.pack_start(item, False, False, 0)
        # ALL FIVE MEANINGS IN ONE HOVER. The TreeView had three surfaces for
        # STATE_MEANINGS: the legend items, every row's own tooltip, and the
        # State COLUMN HEADER, which joined all five and which my old comment
        # called the half of his question ("what does the dot mean") that a one
        # word heading cannot answer. The headers went with the TreeView, so
        # that surface became "read five words and hover five times". Restored
        # on the legend box itself, carrying the same joined string; the item
        # tooltips above still win when the pointer is over one of them.
        legend.set_tooltip_text("\n".join(
            "%s , %s" % (word.title(), STATE_MEANINGS[word])
            for word in STATE_COLOURS))
        return legend

    def _table(self):
        """The storefront grid the approved mockup draws, and the bar over it.

        NOT A WIDER TREEVIEW. The list was four columns in a 316px strip
        beside the datasheet, which is the shape a picker takes when the
        datasheet is the point of the window. The mockup makes the packages
        the point instead: a grid of cards that each answer "what is this, am
        I behind, and what does the button do" without a click, and the
        datasheet slides in over the right of it only when one is chosen.

        THE STORE SURVIVES THE TREEVIEW. `self.store` is still a
        `Gtk.ListStore` over `FIELDS`, still filled by `refresh_table()`, and
        still the thing every data contract reads. It stopped being a
        *renderer's* model and became the row record a card is built from, so
        the schema, the field indices and every assertion about them are
        unchanged by this conversion. What is gone is the cell renderer, the
        four `Gtk.TreeViewColumn`s and the header row.
        """
        column = ui.vbox(0)

        # ---- the breadcrumb, and the three sort chips ------------------
        # A TreeView sorts by clicking a column header. A grid has no headers,
        # so without these three chips the conversion would silently drop
        # ordering, which is a feature and not a decoration: "which of these
        # is the big download" is unanswerable in a 60 card grid.
        crumbs = ui.hbox(8)
        crumbs.set_margin_start(14)
        crumbs.set_margin_end(14)
        crumbs.set_margin_bottom(6)
        self.crumb = ui.cls(ui.lbl("", "note"), "repo-crumb")
        self.crumb.set_xalign(0.0)
        self.crumb.set_ellipsize(Pango.EllipsizeMode.END)
        crumbs.pack_start(self.crumb, True, True, 0)

        self.sort_buttons = {}
        chips = ui.cls(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                               spacing=4), "repo-sorts")
        chips.set_valign(Gtk.Align.CENTER)
        group = None
        self._sort_labels = {}
        for key, label, reverse_label, tip in SORTS:
            button = Gtk.RadioButton.new_with_label_from_widget(group, label)
            if group is None:
                group = button
            button.set_mode(False)
            button.get_style_context().add_class("repo-sort")
            ui.set_row_tooltip(button, tip)
            # `clicked`, NOT `toggled`. A radio that is already active does not
            # emit `toggled` when it is pressed again, so a toggled handler can
            # never see the second press, which is the whole direction flip. It
            # does emit `clicked`, and pressing an INACTIVE chip emits clicked
            # exactly once as well, so one handler covers both and cannot
            # double-refresh the grid.
            button.connect("clicked", self._on_sort, key)
            chips.pack_start(button, False, False, 0)
            self.sort_buttons[key] = button
            self._sort_labels[key] = (label, reverse_label)
        crumbs.pack_end(chips, False, False, 0)
        column.pack_start(crumbs, False, False, 0)

        # ---- the "channel not configured" banner -----------------------
        # show_detail(None) has always carried this sentence, so it was
        # readable only when NOTHING was selected. The mockup puts it over the
        # grid, where it is the first thing read on a channel that has no apt
        # source, and that is the state it is about.
        self.notcfg = ui.cls(ui.lbl("", "note", wrap=True), "repo-notcfg")
        self.notcfg.set_xalign(0.0)
        self.notcfg.set_margin_start(14)
        self.notcfg.set_margin_end(14)
        self.notcfg.set_margin_bottom(6)
        self.notcfg.set_no_show_all(True)
        column.pack_start(self.notcfg, False, False, 0)

        # ---- the grid ---------------------------------------------------
        frame = ui.scroller(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        # GRID_MIN_WIDTH is the grid's MINIMUM, not its fixed width: one card
        # column plus its margins. The grid expands into everything the
        # datasheet is not using, which on a closed datasheet is the whole
        # window, and that is what makes it a storefront rather than a strip.
        # It is deliberately NOT TABLE_WIDTH, which was the sum of the old
        # TreeView's columns: propagating that as a floor put the window's
        # minimum 16px above the width it opens at. See the constant.
        frame.set_size_request(GRID_MIN_WIDTH, -1)
        frame.get_style_context().add_class("repo-grid-wrap")
        self.store = Gtk.ListStore(*([str] * len(FIELDS)))
        self.cards = Gtk.FlowBox()
        self.cards.set_can_focus(True)
        ui.set_control_accessibility(
            self.cards, "Package cards",
            "Use the arrow keys to move between package cards, then Tab to "
            "reach the selected card's action.")
        self.cards.get_style_context().add_class("repo-cards")
        self.cards.set_selection_mode(Gtk.SelectionMode.SINGLE)
        # HOMOGENEOUS, so a package with a long summary does not make its own
        # column wider than the rest and stagger every row below it.
        self.cards.set_homogeneous(True)
        self.cards.set_max_children_per_line(6)
        self.cards.set_min_children_per_line(1)
        self.cards.set_row_spacing(10)
        self.cards.set_column_spacing(10)
        self.cards.set_valign(Gtk.Align.START)
        for setter in ("set_margin_start", "set_margin_end"):
            getattr(self.cards, setter)(10)
        for setter in ("set_margin_top", "set_margin_bottom"):
            getattr(self.cards, setter)(12)
        self.cards.connect("selected-children-changed", self._on_select)
        frame.add(self.cards)
        column.pack_start(frame, True, True, 0)
        return column

    def _on_sort(self, button, key):
        """A chip over the grid was pressed.

        Pressing the ACTIVE chip flips the direction, which is what re-clicking
        a TreeViewColumn header did and what the first version of this row had
        no way to express. The chip's own label carries the direction, so the
        state is on screen rather than in a variable: an arrow the operator
        cannot see is not a control.
        """
        # ONE PRESS USED TO RUN THIS TWICE. Four radios share one group, so
        # activating one DEACTIVATES the outgoing one, and the outgoing chip
        # emits `clicked` as well. That spurious call arrives with
        # `self.sort == key` still true for the OLD key, so it took the flip
        # branch, inverted `sort_reverse`, relabelled the outgoing chip to its
        # reversed word and ran a full `refresh_table()`, all of which the
        # second call then undid. The end state was correct every time, which
        # is why no contract saw it, and the cost was a thrown-away rebuild of
        # the whole grid on every chip press, on the window the operator
        # already reported as slow (a2.png, "takes long time").
        #
        # `toggled:A` precedes `clicked:A`, so the outgoing chip is ALREADY
        # inactive when its call arrives and this drops exactly that one.
        # Measured by <agent> 2026-08-22 on GTK 3.24.49 in both
        # directions: without the guard 2 runs per press, with it 1, and all
        # four end states and all four labels byte-identical. Wiring on
        # `toggled` instead would not have helped: the order is toggled:A,
        # clicked:A, toggled:B, clicked:B.
        if not button.get_active():
            return
        if self.sort == key:
            self.sort_reverse = not self.sort_reverse
        else:
            previous = self.sort_buttons.get(self.sort)
            if previous is not None:
                previous.set_label(self._sort_labels[self.sort][0])
            self.sort = key
            self.sort_reverse = False
        forward, backward = self._sort_labels[key]
        button.set_label(backward if self.sort_reverse else forward)
        self.refresh_table()

    def _card_state_tooltip(self, name, word):
        """The sentence the TreeView used to attach to the row under the
        pointer, now attached to the card itself.

        `query-tooltip` on a TreeView was the only way to vary a tooltip by
        row; a card is a real widget, so it simply carries its own. The text
        is unchanged and still comes from STATE_MEANINGS, so the legend, the
        badge and this cannot drift apart.
        """
        meaning = STATE_MEANINGS.get((word or "").upper())
        return "%s , %s" % (name, meaning) if meaning else None

    def _package_card(self, package, row, state):
        """One card, built from the store row and the package record.

        `row` is the `FIELDS` tuple `refresh_table()` just appended, so every
        value shown here is the same value a data contract reads out of the
        store. Nothing on a card is computed from a second source.
        """
        name = row[FIELD["Package"]]
        component = row[FIELD["Comp"]]
        installed = row[FIELD["Installed"]]
        pin = row[FIELD["Track"]]
        word = row[FIELD["State"]]
        current = repo.candidate(package, self.channel)

        card = ui.cls(ui.vbox(7), "repo-card")
        # The mockup's `minmax(236px,1fr)`. A FlowBox is homogeneous, so this
        # floor is what decides how many columns a given window width gets;
        # without it six cards are squeezed onto one line at any width and
        # every name ellipsises to three characters.
        card.set_size_request(CARD_WIDTH, -1)

        # ---- tile, name, candidate version -----------------------------
        top = ui.hbox(9)
        top.pack_start(tile(name, component, big=True), False, False, 0)
        identity = ui.vbox(2)
        title = ui.cls(ui.lbl(name, "note"), "repo-card-name")
        title.set_xalign(0.0)
        title.set_ellipsize(Pango.EllipsizeMode.END)
        title.set_tooltip_text(name)
        identity.pack_start(title, False, False, 0)
        version = ui.cls(
            ui.lbl(current["version"] if current else "\u2014", "note"),
            "repo-card-ver")
        version.set_xalign(0.0)
        version.set_ellipsize(Pango.EllipsizeMode.END)
        identity.pack_start(version, False, False, 0)
        top.pack_start(identity, True, True, 0)
        card.pack_start(top, False, False, 0)

        # ---- what it is for --------------------------------------------
        # The curated benefit when there is one, the maintainer's summary
        # otherwise, which is the same choice the datasheet's prose makes.
        blurb = (package["benefit"] if package["curated"] else
                 package["summary"]) or "no summary in the index"
        summary = ui.cls(ui.lbl(blurb, "note", wrap=True), "repo-card-sum")
        summary.set_xalign(0.0)
        summary.set_lines(2)
        summary.set_ellipsize(Pango.EllipsizeMode.END)
        summary.set_max_width_chars(30)
        summary.set_tooltip_text(blurb)
        card.pack_start(summary, False, False, 0)

        # ---- am I behind, without a click ------------------------------
        # THE ONE THING THE FOUR COLUMNS COULD NOT SAY. A row showed the
        # installed version and the candidate in two separate columns and left
        # the comparison to the reader; the delta states it.
        if not current:
            delta, quiet = "not published in this channel", True
        elif installed in ("", "-"):
            delta, quiet = "not installed", True
        elif installed == current["version"]:
            delta = "up to date"
            if pin and pin != "auto":
                delta += "  \u00b7  pinned to %s" % pin
            quiet = True
        else:
            delta = "%s \u2192 %s%s" % (
                installed, current["version"],
                "  (downgrade)" if state == "downgrade" else "")
            quiet = False
        line = ui.cls(ui.lbl(delta, "note"), "repo-card-delta")
        if quiet:
            line.get_style_context().add_class("repo-card-delta-eq")
        line.set_xalign(0.0)
        line.set_ellipsize(Pango.EllipsizeMode.END)
        line.set_tooltip_text(delta)
        card.pack_start(line, False, False, 0)

        # ---- dot, state, pin, size -------------------------------------
        foot = ui.hbox(6)
        dot = ui.cls(ui.lbl("", "note"), "repo-card-dot")
        dot.set_markup('<span foreground="%s">\u25cf</span>'
                       % STATE_COLOURS.get(word.upper(), "#4b5b4b"))
        foot.pack_start(dot, False, False, 0)
        foot.pack_start(badge(word.upper(),
                              "warn" if state in ("upgradable", "downgrade")
                              else ("on" if package["installed"] else "dim")),
                        False, False, 0)
        if pin and pin != "auto":
            foot.pack_start(badge("PIN %s" % pin.upper(), "dim"),
                            False, False, 0)
        size = ui.cls(ui.lbl(row[FIELD["Size"]], "note"), "repo-card-size")
        size.set_xalign(1.0)
        foot.pack_end(size, False, False, 0)
        card.pack_start(foot, False, False, 0)

        # ---- the card's own action button ------------------------------
        # The mockup puts one on every card, and it is the same action the
        # datasheet's Install button performs on the same package: pressing it
        # selects the card first, so the pane the user is about to read is
        # already describing what they just pressed.
        if not current:
            label, live = "Not in channel", False
        elif state == "upgradable":
            label, live = "Upgrade", True
        elif state == "downgrade":
            label, live = "Downgrade", True
        elif package["installed"]:
            label, live = "Reinstall", True
        else:
            label, live = "Install", True
        if state == "upgradable":
            action_tip = ("Upgrade %s to the newer %s candidate."
                          % (name, self.channel))
        elif state == "downgrade":
            action_tip = ("Downgrade %s to the older %s candidate. "
                          "You will be asked to confirm first."
                          % (name, self.channel))
        elif package["installed"]:
            action_tip = ("Reinstall the current %s build of %s."
                          % (self.channel, name))
        else:
            action_tip = ("Install %s from the %s channel."
                          % (name, self.channel))
        action = ui.cls(Gtk.Button(label=label), "ghost", "chip")
        action.kodachi_privileged_action = True
        action.kodachi_catalog_dependent = True
        self._set_action_sensitive(action, live)
        ui.set_row_tooltip(
            action,
            action_tip if live else
            "%s publishes no build of %s, so there is nothing to install "
            "from here." % (repo.CHANNELS[self.channel]["label"], name))
        action.connect("clicked", self._on_card_action, name)
        card.pack_start(action, False, False, 0)

        holder = Gtk.FlowBoxChild()
        holder.set_can_focus(True)
        holder.add(card)
        # The card, not the child, so a contract reading `card_index[name]`
        # walks the same widget tree the user sees.
        holder.package_name = name
        holder.package_card = card
        holder.package_action = action
        tip = self._card_state_tooltip(name, word)
        if tip:
            card.set_tooltip_text(tip)
        # FlowBoxChild is itself a keyboard stop when the box is selectable.
        # Name that exact focus owner, not only the labels nested inside its
        # card, so keyboard and assistive-technology users do not meet one
        # silent stop before every Install/Upgrade button.
        ui.set_control_accessibility(
            holder, "%s package card" % name,
            "%s. %s" % (name, tip or "Package state is unavailable."))
        return holder

    def _on_card_action(self, _button, name):
        """The button on a card: select that card, then install it."""
        self.select_package(name)
        self._on_install(None)

    def select_package(self, name):
        """Select the card for `name`, by name, whatever position it is in."""
        child = self.card_index.get(name)
        if child is None:
            return False
        self.cards.select_child(child)
        return True

    def _detail(self):
        """The SLIDE-OVER datasheet the approved mockup draws.

        It used to be the second half of a Gtk.Paned and was therefore always
        on screen, 392px of "No package selected." whenever nothing was. The
        mockup makes it a panel that is not there until a card is chosen, has
        a close button of its own, and splits its contents across four tabs so
        the hashes are one click from the top instead of six screens down.
        """
        # AUTOMATIC, not NEVER. With NEVER the child's minimum width is the
        # scroller's minimum, so the pane could never be narrower than its
        # widest row and the window inherited that floor.
        scroll = ui.scroller(Gtk.PolicyType.AUTOMATIC,
                             Gtk.PolicyType.AUTOMATIC)
        # DETAIL_WIDTH is the mockup's own `.detail.open{width:432px}`.
        scroll.set_size_request(DETAIL_WIDTH, -1)
        # THE SAME PROPAGATION TRAP AS THE GRID, one panel over. Measured
        # offscreen: this ScrolledWindow reported min=669, from the datasheet
        # header row, and the window could not go below that however small the
        # size request was. The scrollbar was there the whole time and
        # unreachable, because the window grew instead.
        scroll.set_propagate_natural_width(False)
        self.detail_box = ui.vbox(0)
        scroll.add(self.detail_box)

        # ---- built ONCE and reparented, never rebuilt with the pane -----
        # show_detail() clears the datasheet on every selection, and a widget
        # recreated under the pointer is a widget that can be clicked into
        # existence and out of it between press and release. Holding one
        # instance also keeps self.buttons["install"] valid before anything
        # has been selected at all.
        self.ds_actions = ui.cls(ui.hbox(6), "repo-dfoot")
        self._button(self.ds_actions, "install", "Install",
                     "Install or update the selected package from the channel "
                     "shown above.", self._on_install)
        self._button(self.ds_actions, "switch", "Switch channel",
                     "Move the selected package to the other channel and pin "
                     "it there, so later upgrades keep tracking that channel.",
                     self._on_switch)
        self._button(self.ds_actions, "hold", "Hold updates",
                     "Keep the selected package at its installed version, or "
                     "resume updates when it is already held.", self._on_hold)
        self._button(self.ds_actions, "remove", "Remove",
                     "apt remove the selected package. Configuration files "
                     "are kept.", self._on_remove)

        # WHY THE BUTTONS ARE GREY, IN WORDS. Operator, 2026-08-21, on a2.png
        # with DEV selected: "buttons not working". They were doing exactly
        # what they were told, `set_sensitive(False)`, and saying nothing about
        # it. A GTK3 insensitive widget receives no events, so it never emits a
        # tooltip query either: the one place the reason could have been
        # written is the one place it could never be read. The mockup gives it
        # a row of its own above the command line, which is where it is now.
        self.ds_reason = ui.cls(ui.lbl("", "note", wrap=True), "repo-reason")
        self.ds_reason.set_xalign(0.0)
        self.ds_reason.set_max_width_chars(48)
        # NO_SHOW_ALL, or `detail_box.show_all()` re-reveals it a few lines
        # after _sync_package_buttons() hid it, and the row is then present and
        # empty on every package that has no reason. `set_visible(True)` is
        # unaffected by this flag, so the visible case is unchanged.
        self.ds_reason.set_no_show_all(True)
        self.ds_why_row = ui.hbox(0)
        self.ds_why_row.set_margin_start(16)
        self.ds_why_row.set_margin_end(16)
        self.ds_why_row.set_margin_top(6)
        self.ds_why_row.pack_start(self.ds_reason, True, True, 0)

        # ---- the close button, top right of the header ------------------
        self.ds_close = ui.cls(Gtk.Button(label="\u2715"), "ghost", "chip")
        ui.set_row_tooltip(self.ds_close, "Close the datasheet")
        self.ds_close.set_valign(Gtk.Align.START)
        self.ds_close.connect("clicked", self._on_detail_close)

        # ---- the four tabs ----------------------------------------------
        self.ds_tabbar = ui.cls(ui.hbox(2), "repo-tabbar")
        self.ds_tabbar.set_margin_start(10)
        self.ds_tabbar.set_margin_end(10)
        self.tab_buttons = {}
        group = None
        for key, label, tip in DS_TABS:
            button = Gtk.RadioButton.new_with_label_from_widget(group, label)
            if group is None:
                group = button
            button.set_mode(False)
            button.get_style_context().add_class("repo-tab")
            ui.set_row_tooltip(button, tip)
            button.connect("toggled", self._on_tab, key)
            self.ds_tabbar.pack_start(button, False, False, 0)
            self.tab_buttons[key] = button

        # ---- what the button runs, fixed under the tab body -------------
        # It was the second to last section of one long scroll, so on the
        # Dependencies of a 38 entry package it was nineteen rows below the
        # fold. The mockup pins it, because it is the answer to "what happens
        # if I press that" and the button is right underneath it.
        self.ds_cmd_box = ui.cls(ui.vbox(3), "repo-dcmd")
        self.ds_cmd_box.set_margin_start(16)
        self.ds_cmd_box.set_margin_end(16)
        self.ds_cmd_box.set_margin_top(8)
        self.ds_cmd_box.set_margin_bottom(8)
        # THE CAPTION IS NOT FIXED, BECAUSE THE BOX BELOW IT IS NOT. Three of
        # the four branches that fill it put an English sentence there, and a
        # caption promising a command over a paragraph in a monospace face is
        # the same kind of small lie the rest of this pane was just cleaned of.
        # Found by <agent> 2026-08-22 as the sibling of A3; the
        # DEV_REFUSAL branch already did it before my F3 split and I added two
        # more members to its class.
        self.ds_cmd_caption = ui.cls(ui.lbl("WHAT THE BUTTON RUNS", "note"),
                                     "repo-ds-section")
        self.ds_cmd_caption.set_xalign(0.0)
        self.ds_cmd_box.pack_start(self.ds_cmd_caption, False, False, 0)
        self.ds_cmd = mono("")
        self.ds_cmd.set_xalign(0.0)
        self.ds_cmd.set_line_wrap(True)
        self.ds_cmd.set_selectable(True)
        self.ds_cmd_box.pack_start(self.ds_cmd, False, False, 0)

        self.ds_actions.set_halign(Gtk.Align.END)
        self.ds_actions.set_margin_start(16)
        self.ds_actions.set_margin_end(16)
        self.ds_actions.set_margin_top(9)
        self.ds_actions.set_margin_bottom(9)

        # THE CLOSE BUTTON DOES NOT SCROLL, AND IS NOT UNDER THE SCROLLBAR.
        # Measured on <lab-host> at 1600x1000: with the \u2715 packed into
        # the datasheet's own header, inside the scroller, GTK's overlay
        # scrollbar is drawn on top of it and a pointer click reaches the
        # scrollbar instead of the button, so the slide-over could not be
        # dismissed with the mouse at all. Turning overlay scrolling off is
        # worse: the scrollbar then takes a real column, the datasheet grows a
        # HORIZONTAL scrollbar and every body line is clipped mid-word. A fixed
        # bar above the scroller is the shape the mockup draws anyway, its
        # `.dhead` being sticky, and it puts the button where nothing overlaps
        # it at any scroll position.
        closebar = ui.hbox(0)
        closebar.set_margin_top(10)
        closebar.set_margin_end(14)
        closebar.pack_end(self.ds_close, False, False, 0)
        panel = ui.vbox(0)
        panel.pack_start(closebar, False, False, 0)
        panel.pack_start(scroll, True, True, 0)
        # ---- THE FOOT, NOW ACTUALLY FIXED -------------------------------
        # These four were packed into `detail_box`, which is the child of the
        # ScrolledWindow above, under a comment calling them "the fixed foot".
        # They were not fixed: they scrolled with the body, so on any package
        # with a long description or a full Dependencies tab the command line
        # and all four action buttons sat below the fold with nothing
        # indicating they existed. That is the clipped row in the operator's
        # 2026-08-29 screenshot, where Upgrade, Switch to beta and Remove are
        # cut off at the bottom edge of the panel.
        #
        # Packing them into `panel`, a sibling of the scroller, is what the
        # word "fixed" was always claiming. `_ds_clear` already reparents them
        # rather than destroying them, so nothing about their lifetime changes.
        panel.pack_start(self.ds_why_row, False, False, 0)
        panel.pack_start(self.ds_cmd_box, False, False, 0)
        panel.pack_start(self.ds_actions, False, False, 0)

        # ---- the drag grip on the left edge ------------------------------
        # Operator, 2026-08-29: "the package info panel on the right i should
        # be able to resize it and see more info of the package if i want to so
        # make the border dragable for resize".
        #
        # WHY NOT A Gtk.Paned, which is the obvious answer and is what this
        # panel used to be. A Paned divider is an ABSOLUTE offset from one
        # edge, so a revealed child of width 0 still leaves a divider and a
        # dead strip; the approved mockup wants a panel that is not there at
        # all until a card is chosen and gives every pixel back when it is
        # closed. That is why the Paned was removed, and the reasoning still
        # holds. What was lost with it was the drag handle, and nothing
        # replaced it. This grip is that handle without the geometry: an event
        # box on the panel's leading edge that rewrites the scroller's width
        # request as the pointer moves, so the slide-over keeps its semantics
        # and the border becomes draggable.
        grip = Gtk.EventBox()
        grip.set_size_request(6, -1)
        grip.get_style_context().add_class("repo-grip")
        grip.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK
                        | Gdk.EventMask.ENTER_NOTIFY_MASK)
        ui.set_row_tooltip(
            grip, "Drag to make the package panel wider or narrower")

        def on_enter(widget, _event):
            window = widget.get_window()
            if window is not None:
                window.set_cursor(Gdk.Cursor.new_from_name(
                    widget.get_display(), "col-resize"))
            return False

        def on_press(_widget, event):
            self._grip_origin = (event.x_root, self.detail_width)
            return True

        def on_motion(_widget, event):
            origin = getattr(self, "_grip_origin", None)
            if origin is None:
                return False
            start_x, start_width = origin
            # LEFT EDGE, so dragging LEFT makes it WIDER: the delta is
            # subtracted, not added. Getting this backwards is the kind of
            # inversion that reads as "the drag works but fights me".
            self.set_detail_width(start_width - (event.x_root - start_x))
            return True

        def on_release(_widget, _event):
            self._grip_origin = None
            return True

        grip.connect("enter-notify-event", on_enter)
        grip.connect("button-press-event", on_press)
        grip.connect("motion-notify-event", on_motion)
        grip.connect("button-release-event", on_release)

        framed = ui.hbox(0)
        framed.pack_start(grip, False, False, 0)
        framed.pack_start(panel, True, True, 0)
        self.detail_scroll = scroll

        self.detail_reveal = Gtk.Revealer()
        # SLIDE_LEFT is GTK's name for "slide in from the right", which is the
        # edge this panel lives on.
        self.detail_reveal.set_transition_type(
            Gtk.RevealerTransitionType.SLIDE_LEFT)
        self.detail_reveal.set_transition_duration(170)
        self.detail_reveal.set_reveal_child(False)
        # `framed`, not `panel`: the grip is part of the thing that slides in,
        # so it appears and disappears with the datasheet rather than leaving a
        # 6px handle floating against the grid when nothing is selected.
        self.detail_reveal.add(framed)
        return self.detail_reveal

    def set_detail_width(self, width):
        """Resize the datasheet, clamped, and remember it.

        Clamped at both ends and the bounds are not decoration. Below
        DETAIL_MIN_WIDTH the four tab labels no longer fit on one row and the
        metric grid collapses into unreadable ellipses; above
        DETAIL_MAX_WIDTH the panel starts eating the card grid it exists to
        describe, and on a narrow window it could cover it completely, leaving
        no way to select a different package and therefore no way to get the
        panel back to a usable size.
        """
        width = int(max(DETAIL_MIN_WIDTH, min(DETAIL_MAX_WIDTH, width)))
        if width == getattr(self, "detail_width", None):
            return
        self.detail_width = width
        scroll = getattr(self, "detail_scroll", None)
        if scroll is not None:
            scroll.set_size_request(width, -1)

    def _on_detail_close(self, _button):
        """The \u2715 in the datasheet header: put the grid back to full width."""
        had_selection = bool(self.cards.get_selected_children())
        self.selected = None
        self.cards.unselect_all()
        # unselect_all synchronously emits selected-children-changed, whose
        # handler owns the normal clear. Only use the fallback when no card was
        # selected, or one click rebuilds the datasheet twice.
        if not had_selection:
            self.show_detail(None)

    def _on_tab(self, button, key):
        """One of the four datasheet tabs was pressed."""
        if not button.get_active() or self.ds_tab == key:
            return
        self.ds_tab = key
        # ALL FOUR BODIES ARE ALREADY BUILT, so this is a stack switch and not
        # a rebuild: no fetch is restarted, the scroll position of the pane is
        # the only thing that moves, and a section can never be missing
        # because its tab was not open.
        if getattr(self, "ds_tabs", None) is not None:
            self.ds_tabs.set_visible_child_name(key)

    def _ds_clear(self):
        """Empty the datasheet without destroying the reparented widgets.

        Five things outlive a rebuild now, not one: the four action buttons,
        the tab bar, the reason row and the command box. Every one of them is a
        control the user can be mid-click on.

        THE CLOSE BUTTON IS DELIBERATELY NOT IN THIS LIST. It lives in the
        fixed bar above the scroller and is never packed into detail_box, so
        including it here would remove it from that bar on the first selection
        change and nothing would ever put it back.
        """
        # ONLY THE TAB BAR IS REPARENTED NOW. The other three, the reason row,
        # the command box and the action buttons, moved out of `detail_box`
        # and into the fixed `panel` beside the scroller, so they are no longer
        # children of the box this function empties. Detaching them here as
        # well would tear the fixed foot off the panel on the first selection
        # change and, because nothing re-packs it into `panel`, the buttons
        # would vanish for the life of the window: the same one-way removal the
        # close-button comment below already warns about.
        parent = self.ds_tabbar.get_parent()
        if parent is not None:
            parent.remove(self.ds_tabbar)
        for child in self.detail_box.get_children():
            self.detail_box.remove(child)

    def _ds_section(self, box, caption):
        label = ui.cls(ui.lbl(caption, "note"), "repo-ds-section")
        label.set_xalign(0.0)
        label.set_margin_top(14)
        box.pack_start(label, False, False, 0)

    def _ds_body(self, box, text):
        label = ui.cls(ui.lbl(text, "note", wrap=True), "repo-ds-body")
        label.set_xalign(0.0)
        label.set_selectable(True)
        box.pack_start(label, False, False, 0)

    def _ds_metric(self, strip, key, value, note="", accent=False, full=""):
        """Build one metric cell, pack it, AND RETURN IT. See _upload_label."""
        cell = ui.cls(ui.vbox(1), "repo-metric-cell")
        cell.set_margin_start(13)
        cell.set_margin_end(13)
        cell.set_margin_top(9)
        cell.set_margin_bottom(9)
        for text, klass in ((key, "repo-metric-key"),
                            (value, "repo-metric-val-accent" if accent
                             else "repo-metric-val"),
                            (note, "repo-metric-note")):
            if not text:
                continue
            label = ui.cls(ui.lbl(text, "note"), klass)
            label.set_xalign(0.0)
            label.set_ellipsize(Pango.EllipsizeMode.END)
            label.set_max_width_chars(16)
            if klass != "repo-metric-key":
                label.set_selectable(True)
                # `full` is the unabbreviated string behind an abbreviated
                # value, so the cell can read "16 Aug 2026" while the tooltip
                # still hands over the exact timestamp to paste.
                label.set_tooltip_text(
                    full if (full and klass.startswith("repo-metric-val"))
                    else text)
            cell.pack_start(label, False, False, 0)
        strip.pack_start(cell, True, True, 0)
        return cell

    def _ds_hash(self, box, key, value, copy_value=None):
        """One integrity row, with the copy button the mockup draws.

        A 64 character hash that cannot be copied is decoration: the only
        thing anyone does with it is paste it somewhere else.

        `copy_value` SEPARATES WHAT IS READ FROM WHAT IS PASTED, and it exists
        because the fix for G1 groups the fingerprint rows into blocks of four
        so a human can compare them. A grouped fingerprint is the right thing
        to READ and the wrong thing to paste into a command, so the button
        keeps handing over the compact form. Defaulting to `value` leaves
        every other caller, and every hash row, behaving exactly as before.
        """
        copied = value if copy_value is None else copy_value
        row = ui.cls(ui.hbox(8), "repo-hash")
        row.set_margin_top(5)
        column = ui.vbox(1)
        name = ui.cls(ui.lbl(key, "note"), "repo-hash-key")
        name.set_xalign(0.0)
        column.pack_start(name, False, False, 0)
        column.pack_start(mono(value or "absent from the index"), False, False, 0)
        row.pack_start(column, True, True, 0)
        if value:
            button = ui.cls(Gtk.Button(label="copy"), "ghost", "chip")
            ui.set_row_tooltip(button, "Copy this %s to the clipboard" % key)
            # The button itself is handed to the helper so the chip can say it
            # copied. `copy` is lower case here and the helper matches the case
            # it finds, so this flips to `copied` rather than shouting.
            button.connect("clicked",
                           lambda b, v=copied: ui.copy_with_feedback(b, v))
            row.pack_end(button, False, False, 0)
        box.pack_start(row, False, False, 0)

    def _console(self):
        box = ui.vbox(0)
        head = ui.cls(ui.hbox(8), "hdr")
        head.pack_start(ui.lbl("COMMAND OUTPUT", "design1-nav-heading"),
                        False, False, 0)
        self.console_note = ui.lbl("idle", "design1-sidebar-status-note")
        # Runtime text, so it must never decide the window's minimum
        # width. END ellipsize drops the minimum and keeps the natural.
        self.console_note.set_ellipsize(Pango.EllipsizeMode.END)

        # ── OUTPUT CONTROLS (G40) ──────────────────────────────────────────
        # This console shipped with NO controls at all, which made it worse
        # than the state the operator complained about in a16: there he had a
        # Clear and wanted more, and here apt's own output, the thing this
        # window tells him to read ("apt lists them in the output below before
        # it acts"), could not be copied, could not stop jumping, and could not
        # be emptied. The text is selectable, but dragging a selection through
        # a install log inside a 200px viewport is not a way to copy anything.
        #
        # Three of the four are the ResultPanel's, deliberately: same labels,
        # same tooltips, same ghost styling, so a user who has learned them in
        # a command window already knows them here. FOLLOW REPLACES KEEP,
        # because Keep answers "stop replacing my output with the next answer"
        # and this console never replaced anything: it is append-only and is
        # already the run log Keep produces. What it did instead was yank the
        # view to the bottom on every write (scroll_to_mark, unconditionally),
        # so reading anything above the newest line during a long apt run was
        # impossible. Follow is the console-shaped question, and it defaults on
        # so the behaviour is unchanged until the reader asks for it.
        #
        # Packed end-first, so GTK lays them out Follow, Wrap, Copy, Clear from
        # the left, with the note still furthest right.
        head.pack_end(self.console_note, False, False, 0)

        clear = ui.cls(Gtk.Button(label="Clear"), "ghost", "chip")
        clear_tip = ("Empty this console. It only clears text already printed; "
                     "nothing is run, installed or undone.")
        clear.set_tooltip_text(clear_tip)
        ui.set_control_accessibility(clear, "Clear console", clear_tip)
        clear.connect("clicked", lambda *_: self.clear_console())
        head.pack_end(clear, False, False, 0)

        self.log_copy = ui.cls(Gtk.Button(label="Copy"), "ghost", "chip")
        copy_tip = ("Copy everything in this console to the clipboard. Nothing "
                    "is run and nothing is changed.")
        self.log_copy.set_tooltip_text(copy_tip)
        ui.set_control_accessibility(self.log_copy, "Copy console output",
                                     copy_tip)
        self.log_copy.connect("clicked", lambda *_: self.copy_console())
        head.pack_end(self.log_copy, False, False, 0)

        self.log_wrap = ui.state_toggle(
            ui.cls(Gtk.ToggleButton(), "ghost", "chip"), "Wrap")
        wrap_tip = ("Wrap long lines to the console width instead of scrolling "
                    "sideways. Display only: the output itself is unchanged.")
        self.log_wrap.set_tooltip_text(wrap_tip)
        ui.set_control_accessibility(self.log_wrap, "Wrap long lines", wrap_tip)
        self.log_wrap.set_active(True)
        self.log_wrap.connect("toggled", self._apply_log_wrap)
        head.pack_end(self.log_wrap, False, False, 0)

        # ── STOP (G64) ─────────────────────────────────────────────────────
        # Sensitive ONLY while a helper is running, which is the inverse of
        # every other button here, and it is why this one is deliberately kept
        # out of self.buttons: set_busy() switches that whole dict off.
        self.log_stop = ui.cls(Gtk.Button(label="Stop"), "ghost", "chip")
        stop_tip = ("Stop waiting for the command that is running and give the "
                    "buttons back. The helper runs as root, so this window "
                    "cannot always end it; a package operation already under "
                    "way may finish on its own. Nothing already installed or "
                    "removed is undone.")
        self.log_stop.set_tooltip_text(stop_tip)
        ui.set_control_accessibility(self.log_stop, "Stop waiting", stop_tip)
        self.log_stop.set_sensitive(False)
        self.log_stop.connect("clicked", lambda *_: self.stop_helper())
        head.pack_end(self.log_stop, False, False, 0)

        # ── EXPAND (G1) ────────────────────────────────────────────────────
        # The divider was always draggable in principle and never in practice
        # (see the button-press fix in _replace_body), and nothing on screen
        # said it could be dragged at all. A button is discoverable, is
        # keyboard reachable, and gives the same answer at every window size.
        self.log_expand = ui.state_toggle(
            ui.cls(Gtk.ToggleButton(), "ghost", "chip"), "Expand")
        expand_tip = ("Make the command output taller, so a whole apt summary "
                      "is readable without scrolling. Display only: nothing is "
                      "run and no output is changed. The divider above can also "
                      "be dragged.")
        self.log_expand.set_tooltip_text(expand_tip)
        ui.set_control_accessibility(self.log_expand, "Expand command output",
                                     expand_tip)
        self.log_expand.connect("toggled", self._on_console_expand)
        head.pack_end(self.log_expand, False, False, 0)

        self.log_follow = ui.state_toggle(
            ui.cls(Gtk.ToggleButton(), "ghost", "chip"), "Follow")
        follow_tip = ("Keep the newest line in view. Switch it off to read "
                      "earlier output while a command is still printing; the "
                      "command is not affected either way.")
        self.log_follow.set_tooltip_text(follow_tip)
        ui.set_control_accessibility(self.log_follow, "Follow new output",
                                     follow_tip)
        self.log_follow.set_active(True)
        head.pack_end(self.log_follow, False, False, 0)

        box.pack_start(head, False, False, 0)

        # ── THE PROGRESS BAR (G3) ──────────────────────────────────────────
        # Operator, 2026-08-29: "there is no progress of update is shown! nor a
        # progress gauge!". There was not, anywhere: this window, its helper and
        # the shared UI library contained no ProgressBar, no Spinner and no
        # request for apt's status protocol. `set_busy` wrote the word "working"
        # into the header once and nothing touched it again until the process
        # exited, so a ten-minute upgrade and a wedged one looked identical.
        #
        # NO_SHOW_ALL because an idle window must not carry an empty gauge; it
        # is revealed by _progress_begin and hidden by _progress_end. `show_text`
        # carries the phase and the package name, because a bare bar answers
        # "how far" and never "at what", and "at what" is the half that tells
        # him whether a long pause is a big download or a stuck postinst.
        self.progress = Gtk.ProgressBar()
        self.progress.get_style_context().add_class("repo-progress")
        self.progress.set_show_text(True)
        self.progress.set_no_show_all(True)
        self.progress.set_margin_start(14)
        self.progress.set_margin_end(14)
        self.progress.set_margin_bottom(4)
        ui.set_control_accessibility(
            self.progress, "Operation progress",
            "How far the running repository operation has got, and what it is "
            "doing now.")
        box.pack_start(self.progress, False, False, 0)

        scroll = ui.scroller(Gtk.PolicyType.AUTOMATIC,
                             Gtk.PolicyType.AUTOMATIC)
        scroll.set_size_request(-1, CONSOLE_HEIGHT - 44)
        self.log = Gtk.TextView()
        self.log.get_style_context().add_class("repo-log")
        scroll.get_style_context().add_class("repo-grid-wrap")
        self.log.set_editable(False)
        self.log.set_cursor_visible(False)
        self.log.set_monospace(True)
        self.log.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        ui.set_control_accessibility(
            self.log, "Repository operation output",
            "Selectable output from repository and package operations.")
        scroll.add(self.log)
        box.pack_start(scroll, True, True, 0)
        return box

    # ------------------------------------------------------------------
    # progress: apt's status protocol -> one bar
    # ------------------------------------------------------------------
    def consume_progress(self, line):
        """Turn one apt status line into bar state. Returns True if consumed.

        THE RETURN VALUE IS THE FILTER. A consumed line is protocol and must
        never reach the log, or the pane the operator just asked to be made
        visible fills with hundreds of `pmstatus:` rows and is worse than when
        it was hidden. `pmerror` is deliberately NOT consumed: a package that
        failed is the single thing a reader of that pane is there for.

        Defensive about the shape because this is third-party-influenced text:
        apt's format is `prefix:field:percent:description`, but a description
        may itself contain colons (a URL always does), so the split is bounded
        to 4 and the remainder stays in the description. A percent that will
        not parse leaves the fraction alone rather than resetting the bar to
        zero, which would make a working operation look like it restarted.
        """
        if line.startswith(HELPER_STARTED):
            # PROTOCOL, NOT LOG TEXT. The user gains nothing from a line
            # saying the helper started; the `$ pkexec ...` echo above it
            # already said what was launched. Its whole job is to reach _pump,
            # which reads the raw bytes and has already seen it by now.
            return True
        for prefix in PROGRESS_PREFIXES:
            if not line.startswith(prefix):
                continue
            if prefix == "pmerror:":
                return False
            parts = line.split(":", 3)
            field = parts[1] if len(parts) > 1 else ""
            percent = parts[2] if len(parts) > 2 else ""
            detail = parts[3].strip() if len(parts) > 3 else ""
            if prefix == "pmconffile:":
                # A conffile decision. The helper runs apt with
                # DEBIAN_FRONTEND=noninteractive so apt answers it itself by
                # keeping the installed file; say so rather than letting a
                # silent decision pass, because the user's edited config being
                # preserved is a fact he may need to know.
                self.append_log(
                    "note: %s has a new version in the package; the installed "
                    "file was kept\n" % field)
                return True
            self._progress_seen = True
            try:
                fraction = max(0.0, min(1.0, float(percent) / 100.0))
            except (TypeError, ValueError):
                fraction = None
            if not fraction:
                # `not fraction` is deliberate: it catches None AND 0.0, and
                # 0.0 is the index-refresh case. A real download that happens
                # to report 0.0 on one line loses nothing by being described
                # as 1 of 9 for that line.
                counted = FILE_COUNTER.search(detail or "")
                if counted:
                    done, files = int(counted.group(1)), int(counted.group(2))
                    if files > 0:
                        fraction = max(0.0, min(1.0, done / float(files)))
            phase = "Downloading" if prefix == "dlstatus:" else "Installing"
            label = detail or field or phase
            # A NEW PHASE RESTARTS THE CLOCK, because apt restarts the
            # percentage. Without this the first `pmstatus:` line is measured
            # against the download's start time and the unpack claims to be
            # 3% done after four minutes, i.e. an hour left, which is wrong by
            # an order of magnitude in the direction he would act on.
            if phase != getattr(self, "_phase", None):
                self._phase = phase
                self._phase_started = time.monotonic()
            parts = [phase]
            if fraction is not None:
                self.progress.set_fraction(fraction)
                parts.append("%d%%" % int(fraction * 100))
                total = getattr(self, "_download_total", None)
                if total and phase == "Downloading":
                    parts.append("%s of %s"
                                 % (self._human_bytes(total * fraction),
                                    self._human_bytes(total)))
                eta = self._progress_eta(fraction)
                if eta is not None:
                    parts.append("~%s left" % self._human_seconds(eta))
            self.progress.set_text("  ".join(parts + [label]))
            # THE SAME SENTENCE IN THE HEADER, which is the half that answers
            # the operator's screenshot. The bar lives inside the console pane
            # at the bottom of the window; the header note is on screen
            # whatever is scrolled where, so progress is legible without
            # hunting for the pane ("this panel is hidden down you cant see
            # the progress bar!").
            self._set_run_status("  ".join(parts), "info")
            return True
        return False

    # ------------------------------------------------------------------
    # "is it finished?" , the question the window could not answer (G-run)
    #
    # Operator, 2026-08-30: "the user can't even tell if the update or install
    # is completed !". He was right, and the reason is narrow and fixable.
    # Everything this window knew about a finished run went into ONE LINE
    # appended to a monospace console: `done: install veracrypt from dev`. That
    # console sits at the bottom of a tall window, scrolls, and is emptied by
    # Clear. Meanwhile `set_busy(False)` reset the one always-visible label,
    # `console_note`, back to the word "idle", which is what an untouched
    # window says too. So a finished install, a failed install and a window
    # nobody had used all presented identically the moment the run ended.
    #
    # Three additions, and they share one label so there is exactly one place
    # to look:
    #   , while running, `console_note` carries phase, percent, how much of
    #     the download is done and an estimate of what is left;
    #   , when it ends, it carries a VERDICT that stays until the next run;
    #   , the verdict is coloured and names the exit code when there is one.
    # ------------------------------------------------------------------
    def _set_run_status(self, text, tone=None):
        """Say the same thing at the top of the window and in the console.

        TWO LABELS AND ONE CALLER. `run_status` is in the top action bar, which
        is what the operator can actually see; `console_note` is in the console
        header beside the output the message is about. Writing them from one
        place is what stops the top of the window claiming a run is finished
        while the bottom still says "working".

        `run_status` is hidden while it has nothing to say, so an untouched
        window carries no empty furniture next to the index age.
        """
        markup = None
        if tone is not None:
            markup = ('<span foreground="%s">%s</span>'
                      % (ui.STATE_TONE_COLORS.get(tone, ui.TEXT_TERTIARY),
                         html.escape(text)))
        for name in ("console_note", "run_status"):
            label = getattr(self, name, None)
            if label is None:
                continue
            if markup is None:
                label.set_text(text)
            else:
                label.set_markup(markup)
            label.set_tooltip_text(text)
        top = getattr(self, "run_status", None)
        if top is not None:
            # "idle" is the console's resting word and it is meaningless in the
            # top bar, where an empty label is the honest rendering of "nothing
            # has been run".
            show = bool(text) and text.strip() != "idle"
            top.set_visible(show)
            if show:
                top.show()
        # AND IN THE WINDOW TITLE, WHICH IS THE ONLY PART OF THIS WINDOW
        # VISIBLE WHILE IT IS BEHIND SOMETHING ELSE. An apt upgrade takes
        # minutes and nobody watches a progress bar for minutes: they switch to
        # a browser, and the taskbar entry is then the whole interface. A title
        # of "Kodachi , Repository Manager" says the same thing during a run,
        # after a successful run and after a failed one, which is the operator's
        # complaint restated at window-manager level.
        self._set_window_title(text if (text and text.strip() != "idle")
                               else "")

    def _set_window_title(self, suffix):
        """`Kodachi , Repository Manager` plus the run state, when there is one.

        Trimmed to a taskbar-sized fragment: a window list shows perhaps forty
        characters, so a verdict carrying the description and the elapsed time
        would push the application's own name out of view and the entry would
        become unidentifiable, which is worse than saying nothing.
        """
        window = getattr(self, "window", None)
        if window is None:
            return
        base = "Kodachi , Repository Manager"
        head = (suffix or "").split(" , ")[0].strip()
        window.set_title("%s , %s" % (base, head) if head else base)


    # THE MEASURED SIGNATURE OF A DESKTOP WITH NO POLKIT AGENT, and it is a
    # CONJUNCTION of two tokens that pkexec itself printed on
    # <lab-host>, 2026-08-30, in one line:
    #
    #   Error creating textual authentication agent: Error opening current
    #   controlling terminal for the process (`/dev/tty'): No such device or
    #   address
    #
    # MY FIRST VERSION ALSO LISTED "no authentication agent" AND MATCHED ON
    # ANY OF THEM, WHICH IS SELF-FULFILLING: that phrase is not in pkexec's
    # output at all, it is the sentence THIS WINDOW PRINTS when it makes the
    # diagnosis. So one real no-agent failure wrote the trigger into the
    # console, and any later 127 matched it. <agent>, 2026-08-30.
    NO_AGENT_SIGNATURES = (
        "creating textual authentication agent",
        "/dev/tty",
    )

    def _looks_like_a_missing_polkit_agent(self):
        """Did THIS run fail because nothing could show a password prompt?

        SCOPED TO THIS RUN, NOT TO A TAIL OF THE WHOLE CONSOLE. The console
        PERSISTS ACROSS RUNS UNLESS CLEARED, so a tail is not a bound on
        anything: after one real no-agent failure its signature
        sits in the last few thousand characters for as long as the window is
        open, and the next short 127 from any cause inherits the diagnosis.
        `_log_cursor` is stamped by run_helper when it echoes the command, so
        this reads only what this run produced. <agent>, 2026-08-30.

        The comment this replaces claimed the tail prevented exactly the
        contamination it caused.
        """
        cursor = getattr(self, "_log_cursor", None)
        if cursor is None:
            return False
        this_run = self.console_text()[cursor:].lower()
        return all(sig in this_run for sig in self.NO_AGENT_SIGNATURES)

    @staticmethod
    def _human_seconds(seconds):
        """`1m 42s`, `12s`, `1h 04m`. Never "a while": he is timing this."""
        seconds = int(max(0, seconds))
        if seconds < 60:
            return "%ds" % seconds
        if seconds < 3600:
            return "%dm %02ds" % divmod(seconds, 60)
        hours, rest = divmod(seconds, 3600)
        return "%dh %02dm" % (hours, rest // 60)

    @staticmethod
    def _human_bytes(count):
        for unit, scale in (("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
            if count >= scale:
                return "%.1f %s" % (count / scale, unit)
        return "%d B" % int(count)

    def _note_download_total(self, line):
        """Learn the download size from apt's own summary line.

        apt prints `Need to get 13.3 MB of archives.` (or `Need to get 1,234 kB
        of archives.`) before it acquires anything, and `dlstatus` then reports
        a percentage of exactly that. Multiplying the two is the only way this
        window can say "5.6 MB of 13.3 MB", because the status protocol carries
        no byte counts at all.

        Best effort by design: a run with nothing to download never prints the
        line, an apt in another language prints a different one, and in both
        cases the bar falls back to phase and percent. It must never raise.
        """
        marker = "Need to get "
        if marker not in line:
            return
        try:
            tail = line.split(marker, 1)[1]
            number, unit = tail.split()[0], tail.split()[1]
            scale = {"B": 1, "kB": 1e3, "MB": 1e6, "GB": 1e9}.get(unit)
            if scale is None:
                return
            self._download_total = float(number.replace(",", "")) * scale
        except (IndexError, ValueError):
            return

    def _progress_eta(self, fraction):
        """Seconds left in THIS phase, or None while the estimate is worthless.

        Keyed to the phase, not the run: apt restarts its percentage at 0 when
        it stops downloading and starts unpacking, so one continuous estimate
        across both would jump backwards and read as the operation restarting.

        Withheld below 3% and below 3 seconds because an estimate built on two
        data points is noise, and a wrong "4 hours left" is worse than no
        number: he acts on it.
        """
        started = getattr(self, "_phase_started", None)
        if started is None or fraction is None or fraction < 0.03:
            return None
        elapsed = time.monotonic() - started
        if elapsed < 3.0:
            return None
        return elapsed * (1.0 - fraction) / fraction

    def _progress_begin(self, description):
        """Show the bar, pulsing, before apt has said anything.

        PULSING FIRST IS THE POINT. The gap this closes is the one at the very
        start of a run: pkexec is prompting, apt is resolving, and nothing has
        produced a percentage yet, which is exactly the window in which the old
        window looked frozen. A pulse says "alive, no number yet" honestly,
        and the first dlstatus line replaces it with a real fraction.
        """
        self._progress_seen = False
        self._phase = None
        self._phase_started = time.monotonic()
        self._download_total = None
        self.progress.set_fraction(0.0)
        self.progress.set_text(description)
        self.progress.set_visible(True)
        self._progress_pulse_id = GLib.timeout_add(
            120, self._progress_pulse)

    def _progress_pulse(self):
        """Keep the bar moving while apt is silent. Stops once it is not."""
        if not self.alive or not self.busy:
            self._progress_pulse_id = 0
            return False
        if self._progress_seen:
            # A real fraction has arrived; a pulse on top of it would fight the
            # value and make the bar jitter between the two.
            self._progress_pulse_id = 0
            return False
        self.progress.pulse()
        return True

    def _progress_end(self):
        paused = getattr(self, "_progress_pulse_id", 0)
        if paused:
            GLib.source_remove(paused)
        self._progress_pulse_id = 0
        self._progress_seen = False
        self.progress.set_visible(False)
        self.progress.set_fraction(0.0)
        self.progress.set_text("")

    def _apply_log_wrap(self, *_args):
        self.log.set_wrap_mode(
            Gtk.WrapMode.WORD_CHAR if self.log_wrap.get_active()
            else Gtk.WrapMode.NONE)

    def clear_console(self):
        """Empty the console. Text only: no helper is run and nothing is undone.

        AND IT MOVES `_log_cursor` BACK TO ZERO, because THE CONSOLE IS NOT
        APPEND-ONLY and I wrote a run-scoped cursor as though it were. Clear
        stays enabled while a helper runs (it is text-only, so there is no
        reason to grey it), and pressing it mid-run left `_log_cursor` indexing
        a buffer that no longer exists: `console_text()[cursor:]` then returns
        the empty string, and a GENUINE no-agent failure arriving afterwards
        would be classified neutral because its signature had nowhere to land.
        <agent>, 2026-08-30.

        Zero is not a fallback, it is the correct value: after a Clear
        everything the buffer subsequently holds was produced by the run that
        is still going.
        """
        self.log.get_buffer().set_text("")
        if getattr(self, "_log_cursor", None) is not None:
            self._log_cursor = 0

    def console_text(self):
        buffer = self.log.get_buffer()
        return buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(),
                               False)

    def copy_console(self, button=None):
        """Copy the console to the clipboard, and say so on the button.

        `button` defaults to the console's own Copy control rather than being
        required, so a caller that has no widget in hand (a test, or a future
        keyboard binding) still gets the copy and still gets the feedback.
        """
        ui.copy_with_feedback(
            button if button is not None else getattr(self, "log_copy", None),
            self.console_text())

    def _actionbar(self):
        """The CHANNEL MIGRATION bar the mockup draws across the foot.

        The per-package buttons moved into the datasheet header, because they
        act on ONE package and belong beside it. What is left here acts on the
        WHOLE MACHINE, which is a different and much larger decision, and the
        bar says which channel that decision would move it to before any of
        the buttons are reachable.
        """
        outer = ui.cls(ui.vbox(0), "repo-migration")
        bar = ui.hbox(8)
        bar.set_margin_start(16)
        bar.set_margin_end(16)
        bar.set_margin_top(9)
        bar.set_margin_bottom(9)
        outer.pack_start(bar, False, False, 0)

        caption = ui.cls(ui.lbl("CHANNEL MIGRATION", "note"), "repo-ds-section")
        caption.set_xalign(0.0)
        bar.pack_start(caption, False, False, 0)

        # The three steps, drawn as a track, so the direction of a move is
        # visible before it is made. Beta is not always ahead of stable, so
        # "forward" here means "toward the less settled channel", never
        # "toward the newer version", and the tooltip says so.
        self.migration_steps = {}
        track = ui.hbox(4)
        # THE ARROW IS NOT DECORATION, SO IT NEEDS A KEY. Found by the state
        # sweep that reproduces the operator's own method: a glyph asserting
        # something with nothing on screen or under the pointer to explain it,
        # which is exactly what he caught with the state dot on a1.png. The
        # words STABLE/BETA/DEV describe themselves; the "\u203a" between them
        # is the only thing claiming an ORDER, and read naively it says
        # "newer to the right", which is false. Both the arrows and the track
        # itself carry the sentence, so hovering the gap answers too.
        track.set_tooltip_text(TRACK_DIRECTION)
        for index, key in enumerate(("stable", "beta", "dev")):
            if index:
                arrow = ui.lbl("\u203a", "note")
                arrow.set_tooltip_text(TRACK_DIRECTION)
                track.pack_start(arrow, False, False, 0)
            step = ui.cls(ui.lbl(repo.CHANNELS[key]["label"].upper(), "note"),
                          "repo-mig-step")
            ui.set_row_tooltip(step, self._step_tooltip(key))
            track.pack_start(step, False, False, 0)
            self.migration_steps[key] = step
        bar.pack_start(track, False, False, 0)

        self.migration_note = ui.lbl("", "note")
        self.migration_note.set_xalign(0.0)
        self.migration_note.set_ellipsize(Pango.EllipsizeMode.END)
        self.migration_note.set_max_width_chars(12)
        bar.pack_start(self.migration_note, True, True, 0)

        # THE BUTTONS GO ON THEIR OWN ROW. Caption, track, note and five
        # buttons in ONE horizontal box made this the widest thing in the
        # window: 8 children whose minimums summed to 781 and a box minimum of
        # 869, which is 44 pixels more than the ENTIRE minimum of the window
        # the operator named as the standard. Splitting the row changes nothing
        # about what the bar says or does, and it is what lets the window open
        # at the size the other Cairo windows open at.
        actions = ui.hbox(8)
        actions.set_margin_start(16)
        actions.set_margin_end(16)
        actions.set_margin_bottom(9)
        outer.pack_start(actions, False, False, 0)

        def add(key, label, tooltip, handler, pack_end=False):
            return self._button(actions, key, label, tooltip, handler, pack_end)

        add("export", "Export",
            "Write every Kodachi package, its installed version, its pin and "
            "the hash of the artifact each channel offers, to a JSON file you "
            "choose. Nothing on this machine is changed.",
            self._on_export, pack_end=True)
        add("system", "Move system",
            "Pin every Kodachi package to the channel shown above, then "
            "upgrade. This is the whole machine, not the selected package.",
            self._on_system, pack_end=True)
        # THE TOOLTIP IS USER-VISIBLE TOO, and the operator's instruction was
        # about what the USER IS SHOWN, not about which widget shows it.
        # Trimming the dialog and leaving the same disclosure one hover away
        # would have been a fix in the letter and not in the substance: this
        # string named the credential file, its mode and the transport. A
        # tooltip is if anything MORE likely to reach a screenshot than a
        # modal, because it appears under the pointer while somebody is already
        # photographing the window to ask for help.
        add("dev_auth", "Dev credentials",
            "Store or clear the login and password for the dev channel. "
            "Storing them lets this machine see and install dev packages; "
            "clearing them removes the key and the dev package list with it.",
            self._on_dev_auth, pack_end=True)
        add("channel_setup", "Add channel",
            "Write the apt source for the channel shown above, using the "
            "Kodachi signing key this application pins, then apt update. If "
            "that channel is already configured the button removes the source "
            "this application wrote, and never one you installed yourself.",
            self._on_channel_setup, pack_end=True)
        add("upgrade", "Update all",
            "sudo apt update followed by sudo apt upgrade. This is what the old "
            "Kodachi System Update terminal script did.",
            lambda _b: self.run_helper(["upgrade"], "apt update + apt upgrade"),
            pack_end=True)
        add("refresh", "Refresh",
            "sudo apt update, through the Kodachi helper. Re-reads both channels.",
            lambda _b: self.run_helper(["update"], "apt update"), pack_end=True)
        return outer

    def _step_tooltip(self, key):
        """What one step of the migration track means, in words."""
        return ("%s%s. %s Moving the whole system here is a pin on every "
                "Kodachi package, and it can be a downgrade: beta is not "
                "always ahead of stable."
                % (repo.CHANNELS[key]["url"],
                   ", the channel this window is showing"
                   if key == getattr(self, "channel", None) else "",
                   TRACK_DIRECTION))

    def _draw_migration(self):
        """Light the step the machine is actually on, and say what is off it."""
        steps = getattr(self, "migration_steps", None)
        if not steps:
            return
        for key, label in steps.items():
            context = label.get_style_context()
            if key == self.channel:
                context.add_class("repo-mig-step-on")
            else:
                context.remove_class("repo-mig-step-on")
            # The lit step is a COLOUR carrying a fact, so the fact is written
            # down as well. Same finding as the state dot: a user who cannot
            # tell the two greens apart gets the sentence instead.
            ui.set_row_tooltip(label, self._step_tooltip(key))
        held = [p["name"] for p in self.catalog["packages"]
                if p["pinned"] and p["pinned"] != "stable"]
        if held:
            shown = ", ".join(sorted(held)[:4])
            if len(held) > 4:
                shown += " and %d more" % (len(held) - 4)
            text = ("%d package%s pinned off stable: %s"
                    % (len(held), "" if len(held) == 1 else "s", shown))
            self.migration_note.set_text(text)
            self.migration_note.set_tooltip_text(
                "%d package%s pinned off stable: %s"
                % (len(held), "" if len(held) == 1 else "s",
                   ", ".join(sorted(held))))
        else:
            pin = self.catalog["system_pin"]
            text = "whole system tracks %s" % (pin or "stable (default)")
            self.migration_note.set_text(text)
            self.migration_note.set_tooltip_text(text)

    def _on_export(self, _button):
        """Write the manifest the mockup's third migration button promises."""
        chooser = Gtk.FileChooserDialog(
            title="Export the Kodachi package manifest",
            transient_for=self.window, action=Gtk.FileChooserAction.SAVE)
        chooser.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                            "Save", Gtk.ResponseType.OK)
        chooser.set_current_name("kodachi-packages.json")
        chooser.set_do_overwrite_confirmation(True)
        try:
            if chooser.run() != Gtk.ResponseType.OK:
                return
            target = chooser.get_filename()
        finally:
            chooser.destroy()
        if not target:
            return
        manifest = {
            "channel_shown": self.channel,
            "system_pin": self.catalog["system_pin"],
            "index_dates": self.catalog["dates"],
            "packages": [],
        }
        for package in self.catalog["packages"]:
            manifest["packages"].append({
                "name": package["name"],
                "component": package["component"],
                "installed": package["installed"],
                "pinned": package["pinned"],
                "channels": dict(
                    (key, {"version": entry["version"],
                           "sha256": entry["sha256"],
                           "size": entry["size"]})
                    for key, entry in package["channels"].items()),
            })
        try:
            with io.open(target, "w", encoding="utf-8",
                         errors="replace") as handle:
                json.dump(manifest, handle, indent=2, sort_keys=True)
        # ValueError for the ENCODE direction. UnicodeEncodeError subclasses
        # ValueError, not OSError, so this read as "the write is handled"
        # while a surrogate in a package name walked straight out of it.
        except (OSError, ValueError) as error:
            self.append_log("Could not write %s: %s\n" % (target, error))
            return
        self.append_log("Wrote %d packages to %s\n"
                        % (len(manifest["packages"]), target))

    # THE ONE ACTION EACH PAGE IS FOR. Everything else on a bar is secondary
    # and wears `ghost`, which is what the reference window the operator named
    # as the standard uses for every row action: outlined, transparent, and
    # visually quieter than a filled GTK button. Measured on that window,
    # `kodachi-command-window network`: two buttons in a footer, `ghost` Close
    # beside `primary` Connect, and nothing else on the page. A bar of six
    # filled buttons reads as bulky next to it whatever their pixel height is,
    # and their pixel height was never the problem: mine measured 32px against
    # the reference's 44px.
    PRIMARY_BUTTONS = ("updates_apply", "source_add")

    def _button(self, bar, key, label, tooltip, handler, pack_end=False):
        button = Gtk.Button(label=label)
        button.kodachi_privileged_action = True
        button.kodachi_catalog_dependent = key in (
            "install", "switch", "hold", "remove", "system",
            "fav_install", "fav_remove", "channel_setup")
        # `chip` is the shared design's compact button: 5px 12px at 12px type,
        # against the default button's 9px 20px at 14px. Both tokens come from
        # kodachi_ui.py and neither is invented here. `ghost` or `primary`
        # carries the colour, `chip` carries the size, and the two compose.
        ui.cls(button, "primary" if key in self.PRIMARY_BUTTONS else "ghost",
               "chip")
        # AND IT MUST NOT STRETCH. `fill` in a horizontal box governs the
        # HORIZONTAL axis only: a child always gets the box's full height
        # unless it says otherwise. All three action bars live in one
        # Gtk.Stack, a Stack requests the tallest of its pages, and the
        # packages bar is two rows, so the one-row sources and updates bars
        # were allocated that full height and every button in them rendered as
        # a 76px pill. That is the "big and bulky buttons" the operator saw:
        # the size tokens were already right, the vertical fill was not.
        button.set_valign(Gtk.Align.CENTER)
        ui.set_row_tooltip(button, tooltip)
        button.connect("clicked", handler)
        if pack_end:
            bar.pack_end(button, False, False, 0)
        else:
            bar.pack_start(button, False, False, 0)
        self.buttons[key] = button
        return button

    def _page_bar(self):
        bar = ui.cls(ui.hbox(8), "card")
        bar.set_margin_start(14)
        bar.set_margin_end(14)
        bar.set_margin_top(4)
        bar.set_margin_bottom(10)
        return bar

    def _grid(self, columns, extra):
        """A fixed-width table plus `extra` hidden columns for row identity."""
        scroll = ui.scroller(Gtk.PolicyType.AUTOMATIC,
                             Gtk.PolicyType.AUTOMATIC)
        # DO NOT LET THE TABLE SET THE WINDOW'S WIDTH. A ScrolledWindow
        # propagates its child's natural width by default, so the horizontal
        # scrollbar existed and was never reachable: the window simply grew to
        # the table instead. With propagation off, the columns still open at
        # their widths above and the user can scroll or resize.
        scroll.set_propagate_natural_width(False)
        store = Gtk.ListStore(*([str] * (len(columns) + extra)))
        view = Gtk.TreeView(model=store)
        view.get_style_context().add_class("repo-grid")
        scroll.get_style_context().add_class("repo-grid-wrap")
        view.set_headers_visible(True)
        view.set_enable_search(False)
        for index, (title, width) in enumerate(columns):
            renderer = Gtk.CellRendererText()
            renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
            column = Gtk.TreeViewColumn(title, renderer, text=index)
            column.set_resizable(True)
            column.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
            column.set_fixed_width(width)
            column.set_min_width(48)
            column.set_sort_column_id(index)
            view.append_column(column)
        scroll.add(view)
        return scroll, store, view

    # ------------------------------------------------------------------
    # page: every apt source on the machine
    # ------------------------------------------------------------------
    def _sources_page(self):
        box = ui.vbox(0)

        head = ui.cls(ui.hbox(8), "card")
