}


def source_preset_label(channel):
    """The combo row for one channel, as the user reads it."""
    return "Kodachi %s%s" % (
        repo.CHANNELS[channel]["label"],
        " (credentials required)" if channel == "dev" else "")


def preset_source_fields(channel):
    """Exactly the fields `kodachi-repo-apt enable <channel>` will write.

    Shown in the dialog so the user SEES the source before he agrees to it,
    and never sent anywhere: the helper derives every one of these from its own
    constants. A test pins this function against those constants, because a
    preview that disagrees with what gets written is worse than no preview.
    """
    spec = repo.CHANNELS[channel]
    return {
        "name": "kodachi-%s.sources" % channel,
        "types": "deb",
        "uri": spec["url"],
        "suite": spec["suite"],
        "components": " ".join(repo.COMPONENTS),
        "keyring": os.path.basename(ARCHIVE_KEYRING),
        # THE SIXTH STANZA FIELD, WHICH HAS NO ROW IN THIS DIALOG AND IS
        # WRITTEN ANYWAY. `verb_enable` emits Architectures (kodachi-repo-apt
        # :1568) and `verb_source_add` emits none at all, so a preset and a
        # hand-typed repository produce materially different stanzas. The
        # dialog said nothing about that until the inspector counted the
        # fields on 2026-08-30: five previewed against six written. There is
        # no Architectures row to fill, so it is stated in the note instead,
        # and it is keyed here so ONE table answers "what will be written".
        "architectures": PRESET_ARCHITECTURES,
    }


def fingerprint_groups(value):
    """A fingerprint as groups of four hex, one line per key.

    ONE FORMATTER FOR BOTH ROWS, BECAUSE THE TWO ROWS EXIST TO BE COMPARED.
    The Integrity tab prints the pinned fingerprint and the fingerprint this
    machine actually carries directly above one another, and the entire point
    of reading the keyring was to let a person see a disagreement. They were
    printed in two different formats: the pin came from the constant, which is
    written `17D7C4B0 2273 0515 ...` (one group of eight then eight of four),
    and the observed value came from gpg's colon `fpr:` field, which is 40
    unbroken hex. So on a perfectly healthy machine the two rows LOOKED
    different, which is the failure state, and the comparison the code does
    correctly (`.replace(" ", "").upper()`) was invisible on screen. Found by
    <agent> 2026-08-22, G1.

    PER LINE, NOT OVER THE WHOLE STRING, and that is the trap in this function
    rather than an embellishment. The `extra-keys` state joins several
    fingerprints with newlines, and grouping the joined blob would run the end
    of one key into the start of the next and print a fingerprint that exists
    on no machine anywhere.

    IT DOES NOT MAKE THE ATTACK STATE LOOK HEALTHY, which was the objection
    raised against normalising at all: on `extra-keys` the pinned key is
    usually FIRST, so its line is now byte-identical to the pin row. What
    carries the disagreement there is not the digits, it is the row LABEL,
    which counts the keys, and the paragraph below it, which says apt honours
    every one of them. Both are asserted by contract, because "it is still
    visible" is exactly the kind of claim that stops being true after the next
    edit.
    """
    grouped = []
    for line in (value or "").split("\n"):
        packed = "".join(line.split()).upper()
        if not packed:
            continue
        grouped.append(" ".join(packed[at:at + 4]
                                for at in range(0, len(packed), 4)))
    return "\n".join(grouped)


def installed_repository_key(path=None):
    """(state, fingerprint, detail) for the keyring apt actually honours.

    WHY THIS EXISTS. The Integrity tab used to print `repo.REPO_FINGERPRINT`,
    a module CONSTANT, under a heading that reads as a report about this
    machine, so the pane asserted "this application pins the Kodachi signing
    key" without ever opening the keyring. On a box that ran the pre-cc240c235
    helper the file can carry the pinned key AND an attacker key: apt verifies
    the attacker's InRelease perfectly happily, the catalog loads, and the one
    block on the page that is about TRUST said everything was fine. Found by
    <agent> 2026-08-21, who also pointed out that the Sources page two
    thousand lines away already reads the real per-stanza `signed_by`, so the
    product held two predicates for one question and they disagreed in the
    direction that reassures.

    `state` is one of `absent`, `unreadable`, `unparseable`, `no-keys`,
    `mismatch`, `extra-keys`, `pinned`. Only `pinned` means the machine
    carries exactly the key this application trusts.

    GNUPGHOME IS A THROWAWAY DIRECTORY, and that is not tidiness.
    `gpg --show-keys` CREATES `$HOME/.gnupg`, `pubring.kbx` and `trustdb.gpg`
    merely to read a key from stdin. Under the GUI's own HOME that is a
    surprise side effect of drawing a panel; under the helper's `HOME=/root`
    it fails outright for an ordinary user, gpg exits non-zero and this
    function would return `unreadable` for a perfectly good keyring, which is
    the failure that reads as "very secure" and tests as nothing.
    """
    path = path or ARCHIVE_KEYRING
    if not os.path.exists(path):
        return ("absent", "",
                "no Kodachi keyring is installed at %s" % path)
    try:
        with open(path, "rb") as handle:
            binary = handle.read()
    except OSError as error:
        return ("unreadable", "", "cannot read %s: %s" % (path, error))
    if not binary:
        return ("unparseable", "", "%s is empty" % path)
    # THE mkdtemp USED TO SIT OUTSIDE THIS `try`, ONE LINE ABOVE IT, WHICH
    # MADE A FULL OR UNWRITABLE TMPDIR A CRASH IN THE DRAW PATH. This function
    # is called from `_render_detail`, so an `OSError` here does not degrade a
    # sentence, it propagates out of the GTK draw for every card selection and
    # every keystroke in the search box: the datasheet stops rendering and the
    # traceback goes to a console nobody is reading. `/tmp` on this product is
    # a tmpfs shared with the whole session, so "no space left on device" is a
    # state that happens rather than a theoretical one. Found by
    # <agent> 2026-08-22, G3.
    #
    # FOLDED INTO THE EXISTING BRANCH, NOT GIVEN A STATE OF ITS OWN, for the
    # same reason the timeout below was: "gpg could not be run" is precisely
    # what a missing GNUPGHOME means, and a new state would owe wording to two
    # dicts, a row to the seven-state judge and an arm to the calibrator. The
    # detail string names the errno, so the pane says why rather than guessing.
    home = None
    try:
        home = tempfile.mkdtemp(prefix="kodachi-repo-keyview-")
        shown = subprocess.run(
            ["/usr/bin/gpg", "--show-keys", "--with-colons"],
            env=dict(os.environ, GNUPGHOME=home), input=binary,
            capture_output=True, check=False, timeout=10)
    # SAME CLASS AS THE gpgv CALL BELOW: a subprocess with no timeout on the
    # GTK main loop is a frozen window. Folded into the EXISTING branch rather
    # than given a state of its own, because "gpg could not be run" is what a
    # timeout means and a new state would need its own wording, its own
    # contract and its own row in the seven-state judge.
    #
    # WHAT THIS DOES **NOT** COVER, said plainly: the `open(path, "rb")` read
    # a few lines above has the same exposure and no timeout can be applied to
    # it. So this narrows the window rather than closing it.
    except (OSError, subprocess.TimeoutExpired) as error:
        return ("unparseable", "", "gpg could not be run: %s" % error)
    finally:
        # `home` IS None WHEN mkdtemp ITSELF FAILED. Without this guard the
        # fix above trades a FileNotFoundError for a NameError raised out of
        # the `finally`, which is the same crash wearing a worse name.
        if home:
            shutil.rmtree(home, ignore_errors=True)
    if shown.returncode != 0:
        return ("unparseable", "", "gpg could not read %s" % path)
    # `fpr:` IS GATED ON `pub:`, so a signing SUBKEY's fingerprint can never
    # be the value compared against the pin. Same walk as the helper's, on
    # purpose: two predicates for one question is the defect being fixed here.
    # EVERY PRIMARY, NOT THE FIRST. Returning only the first fingerprint made
    # the pane draw two IDENTICAL rows for the attack this whole function
    # exists to catch, because the poisoned keyring is <pinned key, attacker
    # key> IN THAT ORDER: putting the pinned key first is exactly what
    # defeated the old count-free pin. So the first primary IS the pinned one,
    # and a reader comparing the two rows saw agreement while the code was
    # reading the file perfectly. Found by <agent> 2026-08-22, A1.
    # `len(fingerprints) < primaries` takes the FIRST fpr line after each pub
    # and ignores any further ones for that same key.
    primaries, fingerprints, at_primary = 0, [], False
    for line in shown.stdout.decode("utf-8", "replace").splitlines():
        if line.startswith("pub:"):
            primaries += 1
            at_primary = True
        elif line.startswith("sub:"):
            at_primary = False
        elif (line.startswith("fpr:") and at_primary
                and len(fingerprints) < primaries):
            fingerprints.append(line.split(":")[9])
    fingerprint = fingerprints[0] if fingerprints else ""
    pinned = repo.REPO_FINGERPRINT.replace(" ", "").upper()
    # ZERO KEYS IS NOT "TOO MANY KEYS". `primaries != 1` used to collapse the
    # two OPPOSITE conditions into one state whose name, wording and remedy
    # all describe two-or-more, and the pane then printed three sentences of
    # which one was false: "carries 0 primary keys, so apt trusts every one of
    # them", a claim of membership in an empty set, over a hash row saying
    # "not a keyring gpg can read" when gpg had read it perfectly and exited
    # 0. Found by <agent> 2026-08-22, who did not reason it out: they
    # lifted this function by AST and fed it real gpg 2.4.7 artifacts. A
    # SECRET-key export and a DETACHED SIGNATURE both make gpg exit 0 and emit
    # no `pub:` line at all, so this branch is reachable without anything
    # being corrupt. The product never writes such a file (the helper's own
    # `primaries == 1` guard), so it arrives by hand, by a truncated fetch, or
    # by dearmoring the wrong artifact, which is precisely the situation this
    # pane exists to describe.
    if primaries == 0:
        return ("no-keys", "",
                "%s holds no primary key at all, so apt has nothing to verify "
                "a Kodachi InRelease against and every update from this "
                "repository fails closed" % path)
    if primaries != 1:
        return ("extra-keys", "\n".join(fingerprints),
                "%s carries %d primary keys, so apt trusts every one of them "
                "and not only Kodachi's" % (path, primaries))
    if fingerprint.upper() != pinned:
        return ("mismatch", fingerprint,
                "the installed key is not the pinned one")
    return ("pinned", fingerprint,
            "the installed key is exactly the pinned one")


def apt_parser_can_use_keyring(path=None, channel=None):
    """Can GPGV, the parser apt actually verifies with, load this keyring?

    `True`, `False`, or `None` for "the question could not be asked here".
    None is a real answer and the caller must render it as one, because the
    probe needs an artifact this machine may not have.

    WHY A SECOND PARSER AT ALL. `installed_repository_key` asks gpg. apt does
    not use gpg: it passes `Signed-By` to gpgv, whose keyring reader is more
    permissive. Measured 2026-08-22 by <agent>, gpg/gpgv 2.4.7, two
    throwaway ed25519 keys, six fixtures, both controls: a MALFORMED marker
    packet (`0xCA` with a wrong body length, and `0xC8` and `0xCB` do it too)
    spliced between two keys makes `gpg --show-keys` exit 2 with ZERO
    primaries while gpgv verifies a signature out of the same file. The
    CANONICAL 5-byte marker `0xCA 0x03 "PGP"` does NOT split them: gpg parses
    it and skips it. So the class is malformed-packet, not marker-packet, and
    writing down "gpg rejects marker packets" would be the wrong lesson.

    MY OWN FIRST PROBE HERE WAS WRONG AND THE RECORD SHOULD SAY SO RATHER
    THAN QUIETLY IMPROVE. I ran `gpgv --keyring <path> /dev/null /dev/null`,
    got rc=2 and the identical "verify signatures failed: Unknown system
    error" for all four fixtures INCLUDING a perfectly good keyring, and
    published that the probe cannot discriminate. It cannot, but only because
    gpgv reads the SIGNATURE first and dies before the keyring loader is ever
    reached. Given a real inline-signed document it separates cleanly, in
    both directions, with both controls behaving. A probe that returns the
    same value for every input is a stuck instrument, and I read a stuck
    instrument as a finding about the subject.

    THREE BOUNDS, and each one is why a line of this function exists:

    1. This answers "can apt's parser USE this keyring", never "is this the
       PINNED key". A keyring holding an attacker's key answers True here and
       is exactly what `installed_repository_key` exists to catch. The two
       are complementary and the caller must not print one as the other.
    2. GNUPGHOME is forced to an empty throwaway directory. Without it the
       operator's own keyring answers the question and every fixture reads
       True. That confound ate the advisor's first table two days running.
    3. Only `_InRelease` will do. `release_file()` falls back to `_Release`,
       whose signature is DETACHED in a separate `Release.gpg`, and gpgv
       handed a detached-signed file alone refuses every keyring, which would
       report False for a healthy machine. Answering None is correct there.
    """
    path = path or ARCHIVE_KEYRING
    # ABSOLUTE OR NOTHING, AND BOUND 2 IS WHAT MAKES THIS NECESSARY RATHER
    # THAN TIDY. gpgv resolves a `--keyring` argument containing no slash
    # against GNUPGHOME, not the working directory, and bound 2 forces
    # GNUPGHOME to an EMPTY throwaway directory, so a bare filename can never
    # resolve. Measured by <agent> 2026-08-22, gpgv 2.4.7, one key,
    # one clearsigned document, only the argument form changing:
    #
    #     --keyring /abs/path/keyring.gpg      rc=0  Good signature
    #     --keyring ./keyring.gpg              rc=0  Good signature
    #     --keyring keyring.gpg  (cwd IS it)   rc=2  Can't check signature
    #
    # That rc=2 is BYTE-IDENTICAL to the one a keyring which genuinely lacks
    # the signing key produces, so the window would tell the operator apt
    # cannot verify with a keyring that is perfectly good, and nothing in the
    # output would say why. `os.path.exists` does not catch it: exists()
    # answers about the CWD and gpgv answers about GNUPGHOME, so on a relative
    # path those two lines are talking about different files. Today only the
    # absolute default hides this; refuse loudly instead of relying on it.
    if not os.path.isabs(path):
        raise ValueError(
            "gpgv resolves a bare --keyring name against GNUPGHOME, which "
            "this function forces empty, so %r could only ever answer "
            "False; pass an absolute path" % path)
    if not os.path.exists(path):
        return None
    # WITH NO `channel=` THIS TAKES THE FIRST CHANNEL DECLARED IN
    # `repo.CHANNELS` THAT HAS AN INDEX, and that is a stated choice, not an
    # accident. Dict order is insertion order, so it is deterministic rather
    # than arbitrary, but on a multi-channel machine it still answers about
    # ONE channel while the caller asked about none. The live call site always
    # passes the channel the pane is showing. Anyone adding a second call site
    # should pass one too.
    channels = [channel] if channel else list(repo.CHANNELS)
    signed = None
    for name in channels:
        candidate = repo.release_file(name)
        if candidate and candidate.endswith("_InRelease"):
            signed = candidate
            break
    if signed is None:
        return None
    # SAME MOVE AS THE KEYVIEW PROBE ABOVE, and here it is cheaper still: this
    # function's whole contract is that None means "the question could not be
    # asked here", and a GNUPGHOME that cannot be created is exactly that. It
    # used to raise instead, out of a helper the datasheet calls while drawing.
    home = None
    try:
        home = tempfile.mkdtemp(prefix="kodachi-repo-gpgv-")
        probe = subprocess.run(
            ["/usr/bin/gpgv", "--keyring", path, signed],
            env=dict(os.environ, GNUPGHOME=home),
            capture_output=True, check=False, timeout=10)
    # A HANG HERE IS A FROZEN WINDOW, NOT AN ERROR. This runs on the GTK main
    # loop, and the keyring it reads can sit on a stalled mount. Both outcomes
    # are "the question could not be asked here", which is exactly what None
    # already means, so neither needs a new state.
    except (OSError, subprocess.TimeoutExpired):
        return None
    finally:
        if home:
            shutil.rmtree(home, ignore_errors=True)
    return probe.returncode == 0


def dev_auth_file_present():
    """Whether an auth FILE exists, which is strictly weaker than "configured".

    RENAMED FROM `dev_credentials_stored`, because the old name asserted
    something this predicate cannot observe and the window printed that claim
    to the user. Found by <agent>, 2026-08-21, and the divergence is
    real on 4 of 7 fixture states:

        fixture                        helper            this predicate
        absent                         not stored        not present     agree
        empty file                     not stored        not present     agree
        complete stanza                stored            present         agree
        machine line only              NOT stored        present         DIVERGE
        login, no password             NOT stored        present         DIVERGE
        fields commented out           NOT stored        present         DIVERGE
        whitespace only                NOT stored        present         DIVERGE

    Every divergence runs the same way: the window would say "configured"
    while `kodachi-repo-apt` refuses with exit 5 and apt returns 401. A window
    asserting the opposite of the truth is the hardest state to diagnose from
    the GUI, and the helper's own docstring had already written down why an
    exists-check is insufficient, one file away from this one.

    THE ADVISOR'S PROPOSED REPAIR IS NOT AVAILABLE HERE, and that is the
    reason for a rename rather than a parse. They suggested teaching the
    window to parse the file for field PRESENCE, on the premise that it is
    readable. It is not: `verb_dev_credentials` chmods it 0600 root:root
    (kodachi-repo-apt:634) precisely so no local user can read the password,
    and the 0755 on the DIRECTORY only permits stat, never open. Measured on
    <lab-host>: the directory is drwxr-xr-x root:root. So `getsize` is
    the strongest question an unprivileged process may ask, and the fix is to
    stop overclaiming its answer rather than to strengthen the predicate.

    The HELPER remains the enforcement point and already fails closed
    (`verb_enable` returns 5 for dev with no usable credential), so nothing
    here decides whether apt runs. This decides only what the window SAYS.
    """
    # ONE IMPLEMENTATION, IN THE DATA LAYER. Identical logic to what stood
    # here, moved to repo.dev_entitled() because `catalog()` now needs the same
    # answer to decide whether to LOAD the dev channel at all. Two copies of a
    # predicate that gates disclosure is how the two halves end up disagreeing,
    # and the disagreement would be invisible: the grid would show dev packages
    # the buttons refuse to act on, or the reverse.
    # DEV_AUTH_FILE, this module's own, passed explicitly. It is bound to
    # repo.DEV_AUTH_FILE so the value is identical, but passing it keeps THIS
    # module's constant authoritative for this function: a test that patches
    # kodachi-repo-manager.DEV_AUTH_FILE at a fixture path must still change
    # what this returns. Without the argument the library would read its own
    # copy and the patch would be silently inert, which is the worst kind of
    # test, one that exercises a path it cannot influence and passes.
    return repo.dev_entitled(DEV_AUTH_FILE)

# STATE_TONE used to sit here. Nothing in the product ever read it: its only
# reference in the whole repository was a test asserting every state word had a
# tone, so the test was keeping unreachable code alive and reporting that as
# coverage. The tones the strip uses are chosen at the call site.

STATE_WORD = {
    "current": "installed",
    "installed": "installed",
    "upgradable": "update",
    "downgrade": "downgrade",
    "available": "available",
    "absent": "not in channel",
}


def helper_path():
    """Prefer the installed helper; fall back to the one beside this file.

    The fallback exists so the window is testable from a checkout. It is checked
    SECOND, so on a real machine the shipped helper always wins.
    """
    if os.path.exists(HELPER):
        return HELPER
    if os.path.exists(_LOCAL_HELPER):
        return _LOCAL_HELPER
    return HELPER


def mono(text, *classes):
    """A selectable monospace line that cannot widen the window.

    The wrap is not cosmetic. A ScrolledWindow with a NEVER horizontal policy
    takes its minimum width from its content, so a single unwrapped 64
    character sha256 label pushed the whole window from 1358px to 1493px,
    which is wider than a 1366px laptop screen. Wrapping by character keeps a
    hash readable and keeps the pane inside its allotted 360px.
    """
    label = ui.lbl(text, *classes)
    label.set_selectable(True)
    label.set_line_wrap(True)
    label.set_line_wrap_mode(Pango.WrapMode.CHAR)
    label.set_max_width_chars(38)
    label.set_xalign(0.0)
    # CSS, NOT override_font. Gtk.Widget.override_font has been deprecated
    # since GTK 3.16 and PyGObject prints a DeprecationWarning naming this exact
    # line on every launch, which is noise in the log the user is told to read
    # when something fails. The class below is scoped to this window and pins
    # the same monospace stack every other Kodachi window uses, so a machine
    # without Ubuntu Mono degrades the same way here as it does there.
    label.get_style_context().add_class("repo-mono")
    return label


