# THE KEY THE MACHINE ACTUALLY CARRIES, not the one this code wants.
# `kodachi-repo-apt` installs the repository key here at 0644 and every
# Kodachi source stanza names this path in `Signed-By`, so it is the file apt
# consults and it is world readable: the window can judge it with no root.
ARCHIVE_KEYRING = "/usr/share/keyrings/kodachi-archive-keyring.gpg"

# The helper's "nothing to do, the requested state already holds" answer. NOT a
# failure and NOT a success: a run that correctly changed nothing. Without a
# branch of its own it falls into settle_run's generic arm and the window says
# "FAILED , exit code 3", which is a false failure standing where a false green
# used to be. Bound to kodachi-repo-apt's EXIT_UNCHANGED by a contract, because
# a protocol number written in two files is two numbers.
HELPER_UNCHANGED = 3


# ── The Kodachi channels offered ready-made in the Add repository dialog ──
#
# Operator, 2026-08-30: "usr shoudl be able to add kodachi main and beta and
# dev as pre configured itemes so if he choose kodachi stabel it shoudl
# automaticly ad the correct source with signitures same as for beta etc .. but
# it shoudl never add dev passwords those have to be entered manually".
#
# The dialog he was pointing at is SYSTEM SOURCES > Add repository, which until
# now had six blank fields and no idea Kodachi exists. Adding the stable
# channel from there meant typing the URI, the suite, all three components and
# the keyring name correctly from memory, and getting the keyring wrong is not
# a typo you notice: apt simply refuses the repository later.
#
# THE PRESET DOES NOT WRITE A STANZA OF ITS OWN. It routes to the helper's
# `enable <channel>` verb, which has existed since this application shipped and
# is the same verb the CHANNELS rail's "Add channel" button emits: it installs
# the archive key if it is absent, CHECKS IT AGAINST THE FINGERPRINT PINNED IN
# THE HELPER, refuses a duplicate or a switched-off entry, writes
# /etc/apt/sources.list.d/kodachi-<channel>.sources and then runs apt update.
#
# THE FIRST VERSION OF THIS COMMENT JUSTIFIED THAT WITH A FALSE CLAIM, and the
# correction is worth keeping because the false version was more persuasive.
# It said posting six fields to `source-add` would be "a SECOND, unpinned way
# to write a Kodachi source". It would not be unpinned: `verb_source_add`
# recognises the official channels by URI and suite, REFUSES unless Signed-By
# is exactly the pinned KEYRING, and calls `ensure_keyring()` itself
# (kodachi-repo-apt:2184-2194). Pinning does not distinguish the two verbs at
# all. Found by the inspector, 2026-08-30.
#
# THE REAL REASONS, which survive: one path means one set of refusals, so the
# duplicate, dormant and dev-credential checks cannot be implemented twice and
# drift; `enable` derives every field from the helper's own constants, so a
# preset cannot post a stanza that disagrees with them; and it is the same
# verb the CHANNELS button emits, so the two controls cannot diverge in what
# they write. A weaker argument honestly stated is worth more than a strong
# one that does not hold.
#
# DEV CARRIES NO PASSWORD THROUGH THIS DIALOG, EVER. The dev channel is HTTP
# Basic Auth at the server, and its credential lives in a 0600 root-only
# auth.conf.d file written by `dev-credentials`, which reads both lines from
# STDIN so neither reaches argv or this window's log. This dialog has no
# password field and does not gain one: choosing the Dev preset with no
# credential stored refuses and names the button that takes it, which is
# CHANNELS > Dev credentials. Writing the dev source without the credential
# would be worse than useless, because every later apt command on the machine
# would print the 401, including the ones about stable.
SOURCE_PRESET_CHANNELS = ("stable", "beta", "dev")
# What `verb_enable` puts on the Architectures line. A CONSTANT HERE AND A
# CONSTANT THERE IS TWO SOURCES OF TRUTH, so a contract compares this against
# the helper's own stanza template rather than against a remembered value.
PRESET_ARCHITECTURES = "amd64"
# The Types combo's model, defined once. Indexed by position when a preset
# selects a value, so a second literal copy would be a silent ordering bug.
TYPES_VALUES = ("deb", "deb-src")
SOURCE_PRESET_CUSTOM = "Custom repository"

# What the dialog says under the fields once a preset is chosen. One sentence
# about what will be written, then the one thing that is different about that
# channel. Dev's line is the operator's instruction restated where the person
# choosing Dev is looking, rather than left in a tooltip he has no reason to
# hover.
PRESET_NOTES = {
    None: "",
    "stable": "The released channel, signed with the Kodachi archive key. "
