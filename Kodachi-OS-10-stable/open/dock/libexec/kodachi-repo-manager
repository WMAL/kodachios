ICON_DIR = os.path.join(
    os.environ.get("KODACHI_ICON_DIR", "/usr/share/kodachi/dock/icons"), "repo")


def art(name, px=20):
    """One of this window's own icons, at `px`.

    Falling back to the window mark is what produced a rail of sixteen
    identical Kodachi logos, so a MISSING file here yields a blank of the right
    size instead: an absent icon should look absent, not look like every other
    row.
    """
    path = os.path.join(ICON_DIR, name) if name else ""
    if path and os.path.exists(path):
        return ui.icon(path, px)
    blank = Gtk.Image()
    blank.set_size_request(px, px)
    blank.kodachi_icon_path = path
    blank.kodachi_icon_loaded = False
    return blank


def source_selector(entry):
    """(where, name) for the helper, so one basename cannot mean two files.

    D1: the window used to send a bare basename, and the helper mapped the
    literal name "sources.list" to /etc/apt/sources.list unconditionally. A
    file at /etc/apt/sources.list.d/sources.list is legal and apt reads it, so
    selecting THAT row and pressing Disable would have commented out Debian's
    own sources.list while the window reported acting on the other file. The
    directory is now named explicitly and is one of exactly two fixed words,
    so it adds no path, no separator and nothing user-controlled to the argv.
    """
    if entry["path"] == "/etc/apt/sources.list":
        return "main", "sources.list"
    return "d", entry["filename"]


# THE DEV CHANNEL IS USABLE FROM HERE NOW, so this text is about a state, not
