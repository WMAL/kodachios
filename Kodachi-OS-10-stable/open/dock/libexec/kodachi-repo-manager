        head.set_margin_end(14)
        head.set_margin_top(8)
        head.set_margin_bottom(4)
        head.pack_start(ui.lbl(
            "Every repository apt reads on this machine, Debian's own and any "
            "you added yourself.", "note"), False, False, 0)
        self.sources_note = ui.lbl("", "note")
        # Runtime text, so it must never decide the window's minimum
        # width. END ellipsize drops the minimum and keeps the natural.
        self.sources_note.set_ellipsize(Pango.EllipsizeMode.END)
        head.pack_end(self.sources_note, False, False, 0)
        box.pack_start(head, False, False, 0)

        scroll, self.sources_store, self.sources_view = self._grid(
            SOURCE_COLUMNS, 3)          # + filename, + path, + position
        ui.set_control_accessibility(
            self.sources_view, "System repositories",
            "System apt repository entries and their enabled state.")
        box.pack_start(scroll, True, True, 0)
        self.sources_view.get_selection().connect("changed",
                                                  self._on_source_select)

        self.source_detail = ui.lbl("", "note")
        self.source_detail.set_line_wrap(True)
        self.source_detail.set_xalign(0.0)
        self.source_detail.set_margin_start(14)
        self.source_detail.set_margin_end(14)
        self.source_detail.set_margin_top(6)
        box.pack_start(self.source_detail, False, False, 0)
        return box

    def _sources_actionbar(self):
        bar = self._page_bar()
        self._button(bar, "source_refresh", "Reload list",
                     "Re-read /etc/apt/sources.list and "
                     "/etc/apt/sources.list.d. Changes nothing.",
                     lambda _b: self.refresh_sources())
        self._button(bar, "source_enable", "Enable",
                     "Switch the selected repository back on. In a .list file "
                     "the deb lines are uncommented, and deb-src lines are "
                     "left exactly as they are; in a .sources file the "
                     "Enabled: no line is removed and a stanza commented out "
                     "with a # on every line is uncommented as written. Acts "
                     "on the whole file, and asks first.",
                     lambda _b: self._on_source_state(True))
        self._button(bar, "source_disable", "Disable",
                     "Switch it off and keep the file. In a .list file every "
                     "deb line is commented out; in a .sources file Enabled: "
                     "no is added. The file is backed up first, and this acts "
                     "on the whole file.",
                     lambda _b: self._on_source_state(False))
        self._button(bar, "source_add", "Add repository",
                     "Write a new .sources file in /etc/apt/sources.list.d "
                     "for a repository you choose, then apt update. Nothing "
                     "is installed. The window could remove a repository and "
                     "not add one, so a repository you removed could not be "
                     "put back from here.",
                     self._on_source_add)
        self._button(bar, "source_remove", "Remove file",
                     "Back the selected file up to /var/backups/"
                     "kodachi-apt-sources and delete it.",
                     self._on_source_remove)
        self._button(bar, "source_update", "Check for updates",
                     # C3: this promised a re-count "from each repository".
                     # There is no per-repository count anywhere in this
                     # window: the strip shows one total and this table has no
                     # count column. It says what it does now.
                     "sudo apt update for every repository listed here, then "
                     "re-read the pending update list. The totals are on the "
                     "Updates page and in the strip above.",
                     lambda _b: self.run_helper(["update"], "apt update"),
                     pack_end=True)
        return bar

    # ------------------------------------------------------------------
    # page: what apt would upgrade right now
    # ------------------------------------------------------------------
    def _updates_page(self):
        box = ui.vbox(0)

        head = ui.cls(ui.hbox(8), "card")
        head.set_margin_start(14)
        head.set_margin_end(14)
        head.set_margin_top(8)
        head.set_margin_bottom(4)
        head.pack_start(ui.lbl(
            "Pending updates from every repository, not only Kodachi's.",
            "note"), False, False, 0)
        self.updates_note = ui.lbl("not checked yet", "note")
        # Runtime text, so it must never decide the window's minimum
        # width. END ellipsize drops the minimum and keeps the natural.
        self.updates_note.set_ellipsize(Pango.EllipsizeMode.END)
        head.pack_end(self.updates_note, False, False, 0)
        box.pack_start(head, False, False, 0)

        box.pack_start(self._iso_card(), False, False, 0)

        # ── WHY THE LIST IS EMPTY, WHEN IT IS EMPTY BECAUSE apt REFUSED ────
        # An empty table plus the four words "could not check" was the entire
        # explanation this page offered, and the table's emptiness is the part
        # that reads as "nothing to do". This row carries apt's own sentence
        # and the repair, wrapped, and it is hidden whenever the check
        # succeeded so a healthy machine gains no furniture.
        self.updates_problem = ui.cls(ui.vbox(2), "card")
        self.updates_problem.set_margin_start(14)
        self.updates_problem.set_margin_end(14)
        self.updates_problem.set_margin_bottom(4)
        self.updates_problem.set_no_show_all(True)
        self.updates_problem_text = ui.lbl("", "note", wrap=True)
        self.updates_problem_text.set_xalign(0.0)
        self.updates_problem_text.set_selectable(True)
        self.updates_problem.pack_start(
            self.updates_problem_text, False, False, 0)
        self.updates_problem_fix = ui.lbl("", "note", wrap=True)
        self.updates_problem_fix.set_xalign(0.0)
        self.updates_problem.pack_start(
            self.updates_problem_fix, False, False, 0)
        box.pack_start(self.updates_problem, False, False, 0)

        scroll, self.updates_store, self.updates_view = self._grid(
            UPDATE_COLUMNS, 0)
        ui.set_control_accessibility(
            self.updates_view, "Pending updates",
            "Packages apt currently reports as upgradeable.")
        box.pack_start(scroll, True, True, 0)
        return box

    # ------------------------------------------------------------------
    # ISO IMAGES, on the page about updates, because that is what they are
    #
    # Operator, 2026-09-18: "GTK should also be notifying the user with the
    # stable updates of ISO and the beta updates of the ISO. Same as the Tauri
    # dashboard."
    #
    # BOTH LINES, SEPARATELY, and that is the whole point rather than a detail.
    # A machine running a beta image is AHEAD of the published stable line by
    # design, so a single comparison against stable says "nothing to do" on that
    # machine forever. Reported by a user that day: a <lab-host> desktop was
    # compared against stable 9.0.1.174, correctly refused the older line, and
    # was told "no release changes detected" while beta ISO <lab-host> had been
    # published that morning.
    #
    # This is the one card in this window whose numbers do not come from apt,
    # because apt does not know which image a machine was installed from. The
    # window's rule is kept by NAMING the source in the card itself, and by
    # printing "not compared" rather than a reassuring word whenever either side
    # is missing.
    # ------------------------------------------------------------------
    def _iso_card(self):
        card = ui.cls(ui.vbox(3), "card")
        card.set_margin_start(14)
        card.set_margin_end(14)
        card.set_margin_bottom(4)
        title = ui.hbox(8)
        title.pack_start(ui.cls(ui.lbl("ISO IMAGES", "note"),
                                "repo-ds-section"), False, False, 0)
        self.iso_note = ui.lbl("not checked yet", "note")
        self.iso_note.set_ellipsize(Pango.EllipsizeMode.END)
        title.pack_end(self.iso_note, False, False, 0)
        card.pack_start(title, False, False, 0)
        card.pack_start(ui.lbl(
            "Read from the published release file, not from apt: apt does not "
            "know which image this machine was installed from. The stable line "
            "and the beta line are compared separately, because a machine "
            "running a beta image is ahead of stable by design.",
            "note", wrap=True), False, False, 0)
        self.iso_body = ui.vbox(2)
        card.pack_start(self.iso_body, False, False, 0)
        self.iso_card = card
        return card

    def _iso_state_words(self, state, published, line):
        """One row's wording for one published line. Four states, four answers."""
        if state == repo.ISO_UPDATE:
            return ("%s %s available" % (line, published), True)
        if state == repo.ISO_CURRENT:
            return ("%s %s, this machine matches it" % (line, published), False)
        if state == repo.ISO_AHEAD:
            return ("%s %s is older than this machine" % (line, published),
                    False)
        return ("%s not compared" % line, False)

    def _render_iso_rows(self):
        body = getattr(self, "iso_body", None)
        if body is None:
            return
        for child in body.get_children():
            body.remove(child)
        if self.iso_error:
            row = ui.lbl("could not read the published release file: %s"
                         % self.iso_error, "note", wrap=True)
            body.pack_start(row, False, False, 0)
            body.show_all()
            return
        if not self.iso_rows:
            body.pack_start(ui.lbl("not checked yet", "note"), False, False, 0)
            body.show_all()
            return
        for entry in self.iso_rows:
            row = ui.hbox(8)
            row.pack_start(ui.cls(ui.lbl(entry["label"], "note"),
                                  "repo-ds-body"), False, False, 0)
            # RUNTIME TEXT MUST NEVER DECIDE THIS WINDOW'S MINIMUM WIDTH, and the
            # first version of this row did exactly that. Three long badges plus two
            # labels packed horizontally took the window's minimum to 955px against
            # an OPEN_WIDTH of 944, which
            # test_the_summary_strip_survives_its_own_runtime_text caught on the VM:
            # the window could not be drawn at the width it opens at. The same rule
            # is already written on `updates_note` a few methods above.
            #
            # So: ONE ellipsizing sentence carrying every value, with the full text
            # on the tooltip, and a SHORT badge only when there is something to act
            # on. Nothing here grows with a version string's length.
            detail = "installed %s" % (entry["local"] or "unknown")
            for line, state, published in (
                    ("stable", entry["stable_state"], entry["stable"]),
                    ("beta", entry["beta_state"], entry["beta"])):
                words, _alert = self._iso_state_words(state, published, line)
                detail = "%s  ·  %s" % (detail, words)
            note = ui.lbl(detail, "note")
            note.set_ellipsize(Pango.EllipsizeMode.END)
            note.set_tooltip_text("%s\n\nRead from %s" % (
                detail, repo.MAIN_INFO_URL))
            row.pack_start(note, True, True, 0)
            pending = [line for line, state in (
                ("stable", entry["stable_state"]),
                ("beta", entry["beta_state"])) if state == repo.ISO_UPDATE]
            if pending:
                row.pack_end(badge("%s update" % "+".join(pending), "warn"),
                             False, False, 0)
            body.pack_start(row, False, False, 0)
        body.show_all()

    ISO_REFRESH_MIN_SECONDS = 600

    def _maybe_refresh_iso_images(self):
        """Fetch the published ISO versions only if the last read is stale.

        A network read per page switch would be rude and pointless: the published
        file changes when a release is cut, not when a user clicks a rail row. The
        explicit buttons still force a read through refresh_iso_images().
        """
        # THROTTLE ON THE ATTEMPT, NOT ON THE RESULT. An earlier version required
        # self.iso_rows to be non-empty before the window applied, so an OFFLINE machine,
        # which is the one case where rows stay empty, started a fresh 8-second curl on
        # every switch to this page: exactly the spamming the window was meant to stop,
        # aimed at the user least able to afford it. Raised by <agent>, 2026-09-19.
        last = getattr(self, "_iso_fetched_at", 0.0)
        if last and (time.monotonic() - last) < self.ISO_REFRESH_MIN_SECONDS:
            return
        self.refresh_iso_images()

    def refresh_iso_images(self):
        """Read the published release file in a worker and render both lines.

        Never called on the GTK thread for the network part, and every exit path
        goes through `apply_result`, so a thread that dies leaves the note
        saying what happened rather than "checking" forever.
        """
        self._iso_generation += 1
        generation = self._iso_generation
        self.iso_checked = False
        self.iso_error = ""
        if getattr(self, "iso_note", None) is not None:
            self.iso_note.set_text("checking")

        def worker():
            info, error, rows = None, "", []
            try:
                info, error = repo.fetch_main_info()
                if info is not None:
                    rows = repo.iso_rows(info)
                    # Keep the last successful read so a later offline open can
                    # still show something, labelled with when it was read.
                    repo.write_iso_cache({
                        "read_at": time.strftime("%Y-%m-%d %H:%M UTC",
                                                 time.gmtime()),
                        "rows": rows,
                    })
            except BaseException as exc:
                error = "could not read ISO image versions: %s" % _exc_detail(exc)
            finally:
                GLib.idle_add(apply_result, generation, rows, error)

        def apply_result(result_generation, rows, error):
            if not self.alive:
                return False
            if result_generation != self._iso_generation:
                return False
            if error and not rows:
                # Fall back to the last successful read, and SAY it is old.
                cached = repo.read_iso_cache()
                cached_rows = cached.get("rows")
                if isinstance(cached_rows, list) and cached_rows:
                    rows = cached_rows
                    self.iso_read_at = str(cached.get("read_at") or "")
                    error = ""
            else:
                self.iso_read_at = time.strftime("%Y-%m-%d %H:%M UTC",
                                                 time.gmtime())
            self.iso_rows = rows if isinstance(rows, list) else []
            self.iso_error = error
            self.iso_checked = True
            self._iso_fetched_at = time.monotonic()
            if getattr(self, "iso_note", None) is not None:
                pending = [entry["label"] for entry in self.iso_rows
                           if entry.get("stable_state") == repo.ISO_UPDATE
                           or entry.get("beta_state") == repo.ISO_UPDATE]
                if error:
                    self.iso_note.set_text("could not check")
                    self.iso_note.set_tooltip_text(error)
                elif pending:
                    self.iso_note.set_text("%d image%s with a newer build: %s"
                                           % (len(pending),
                                              "" if len(pending) == 1 else "s",
                                              ", ".join(pending)))
                    self.iso_note.set_tooltip_text(
                        "Read %s from %s" % (self.iso_read_at or "just now",
                                             repo.MAIN_INFO_URL))
                else:
                    self.iso_note.set_text("no newer image published")
                    self.iso_note.set_tooltip_text(
                        "Read %s from %s" % (self.iso_read_at or "just now",
                                             repo.MAIN_INFO_URL))
            self._render_iso_rows()
            return False

        try:
            threading.Thread(target=worker, daemon=True).start()
        # `Exception`, not `RuntimeError`: `threading.Thread.start` raises
        # MemoryError under the exact condition that stops a thread starting,
        # and the narrow catch left the card reading "checking" forever. Same
        # reasoning as refresh_updates below.
        except Exception as exc:
            apply_result(generation, [],
                         "could not start the ISO version check: %s"
                         % _exc_detail(exc))

    def _set_updates_remedy(self, error, remedy):
        """Show or hide the Updates page's problem row.

        Called with ("", "") on every SUCCESSFUL check, which is what stops a
        repaired machine from carrying yesterday's complaint. Tolerant of the
        widgets being absent so a partially built window, or a test that drives
        refresh_updates() without the page, cannot raise here.
        """
        row = getattr(self, "updates_problem", None)
        if row is None:
            return
        if not error:
            row.set_visible(False)
            return
        self.updates_problem_text.set_text("apt said: %s" % error)
        self.updates_problem_fix.set_text(remedy)
        self.updates_problem_fix.set_visible(bool(remedy))
        row.set_visible(True)
        row.show()
        self.updates_problem_text.show()
        if remedy:
            self.updates_problem_fix.show()

    def _updates_actionbar(self):
        bar = self._page_bar()
        self._button(bar, "updates_check", "Check for updates",
                     "sudo apt update, then list everything apt would upgrade.",
                     lambda _b: self.run_helper(["update"], "apt update"))
        self._button(bar, "updates_recount", "Recount only",
                     "Re-read the indexes already on disk. Downloads nothing "
                     "and needs no password.",
                     lambda _b: self.refresh_updates())
        self._button(bar, "updates_apply", "Install all updates",
                     "sudo apt update followed by sudo apt upgrade, for every "
                     "repository on the machine.",
                     self._on_apply_updates, pack_end=True)
        return bar

    # ------------------------------------------------------------------
    # page: applications Debian ships that this desktop commonly wants
    #
    # This page REPLACES the ISO's one-click installer, removed in the same
    # change. That framework generated a menu entry per app and a shell script
    # behind it, and its defining weakness was that a registration was never
    # checked against a repository: three separate apps shipped buttons for
    # package names that resolved nowhere. Here the state column is computed
    # from the machine's own apt on every refresh, so a name that resolves
    # nowhere renders as "not offered by apt" with no button, rather than as a
    # button that fails when pressed.
    # ------------------------------------------------------------------
    def _favourites_page(self):
        box = ui.vbox(0)

        head = ui.cls(ui.hbox(8), "card")
        head.set_margin_start(14)
        head.set_margin_end(14)
        head.set_margin_top(8)
        head.set_margin_bottom(4)
        # ELLIPSIZE, or this sentence decides how narrow the window can be.
        # Measured on <lab-host>: without it the page reported a 1085px
        # minimum against an OPEN_WIDTH of 940, because a label with neither
        # wrap nor ellipsize reports its whole text as its MINIMUM. The
        # sources page carries the same shape at 85 characters and stays
        # under the bar, which is why the pattern went unnoticed until this
        # 110-character one. See :1073 for why set_max_width_chars is the
        # wrong tool here: it clamps the NATURAL width, not the minimum.
        intro = ui.lbl(
            "Applications Debian ships. Installed from Debian, not from "
            "Kodachi's repository.", "note")
        intro.set_ellipsize(Pango.EllipsizeMode.END)
        intro.set_tooltip_text(intro.get_text())
        head.pack_start(intro, False, False, 0)
        self.favourites_note = ui.lbl("", "note")
        # Runtime text, so it must never decide the window's minimum
        # width. END ellipsize drops the minimum and keeps the natural.
        self.favourites_note.set_ellipsize(Pango.EllipsizeMode.END)
        head.pack_end(self.favourites_note, False, False, 0)
        box.pack_start(head, False, False, 0)

        scroll, self.favourites_store, self.favourites_view = self._grid(
            FAVOURITE_COLUMNS, 2)       # + app id, + state key
        ui.set_control_accessibility(
            self.favourites_view, "Additional applications",
            "Optional applications and whether apt can install or remove them.")
        box.pack_start(scroll, True, True, 0)
        self.favourites_view.get_selection().connect(
            "changed", lambda _s: self._sync_favourite_buttons())

        self.favourite_detail = ui.lbl("", "note")
        self.favourite_detail.set_line_wrap(True)
        self.favourite_detail.set_xalign(0.0)
        self.favourite_detail.set_margin_start(14)
        self.favourite_detail.set_margin_end(14)
        self.favourite_detail.set_margin_top(6)
        box.pack_start(self.favourite_detail, False, False, 0)
        return box

    def _favourites_actionbar(self):
        bar = self._page_bar()
        self._button(bar, "fav_install", "Install",
                     "sudo apt install the selected application from Debian. "
                     "Nothing is pinned and no Kodachi channel is involved.",
                     self._on_favourite_install)
        self._button(bar, "fav_remove", "Remove",
                     "sudo apt remove the selected application. Configuration "
                     "files are left in place, exactly as apt-get remove "
                     "would leave them.",
                     self._on_favourite_remove)
        self._button(bar, "fav_refresh", "Recheck",
                     "Ask apt again what is installed and what it could "
                     "install. Downloads nothing and needs no password.",
                     lambda _b: self.refresh_favourites())
        return bar

    # The words the State column shows, kept here so the page and its
    # contract name the same strings. WRITTEN OUT rather than derived from
    # repo.favourite_rows(), because a test comparing a derived label against
    # the thing it was derived from cannot fail.
    FAVOURITE_STATE_WORDS = {
        "installed": "installed",
        "partial": "partly installed",
        "available": "not installed",
        "unavailable": "not offered by apt",
    }

    def refresh_favourites(self):
        """Re-read dpkg and apt, and redraw the table from what they say."""
        self._favourites_generation += 1
        generation = self._favourites_generation
        self.favourites_checked = False
        self.favourites_error = ""
        self.favourites_note.set_text("checking")
        self.favourites_note.set_tooltip_text("checking")
        self._sync_favourite_buttons()
        self._refresh_nav_counts()

        def worker():
            rows, error = [], ""
            # SAMPLED HERE, BESIDE THE ROWS IT EXPLAINS, for two reasons.
            #
            # THREAD: os.listdir on the UI thread is what the naive placement
            # cost. _sync_favourite_buttons() is wired to the treeview's
            # "changed" signal, so reading it there ran a filesystem stat on
            # EVERY row click. All apt work on this page already happens in this
            # worker and lands through GLib.idle_add; this now follows the same
            # rule as its neighbours.
            #
            # TOCTOU: read in the idle callback it is sampled at a DIFFERENT
            # INSTANT from favourite_rows(). An `apt update` finishing in that
            # window makes it True while the rows still came from empty lists,
            # and the user is handed back the misleading "the name may be wrong"
            # message the whole change exists to remove. One sample, one story.
            lists_present = True
            try:
                lists_present = repo.apt_lists_present()
                rows = repo.favourite_rows()
            except BaseException as exc:
                error = ("apt could not be queried: %s"
                         % _exc_detail(exc))
            finally:
                GLib.idle_add(apply_result, generation, rows, error,
                              lists_present)

        def apply_result(result_generation, rows, error, lists_present=True):
            if not self.alive or result_generation != self._favourites_generation:
                return False
            self.favourites_checked = True
            self.favourites_error = error
            # Carried on the instance so the detail pane, which is redrawn from
            # the selection signal long after this returns, describes the SAME
            # apt state these rows were computed from.
            self.favourites_lists_present = lists_present
            if error:
                # The page must still render. An apt that cannot be questioned
                # is a state the user can be in on a fresh live boot.
                self.favourites_note.set_text(error)
                self.favourites_note.set_tooltip_text(error)
                self._sync_favourite_buttons()
                self._refresh_nav_counts()
                return False
            self.favourites = rows
            self.favourites_store.clear()
            for row in rows:
                packages = ("%d" % row["total_count"]
                            if row["total_count"] > 1 else row["packages"][0])
                self.favourites_store.append([
                    row["title"], row["category"], packages,
                    row["version"] or "",
                    self.FAVOURITE_STATE_WORDS.get(
                        row["state"], row["state"]),
                    row["id"], row["state"],
                ])
            installed = sum(1 for r in rows if r["state"] == "installed")
            missing = [r for r in rows if r["state"] == "unavailable"]
            note = "%d of %d installed" % (installed, len(rows))
            if missing:
                # Same correction as the detail pane. When every entry is
                # unofferable AND apt holds no indexes, the honest summary is
                # that apt has not been asked yet, not a list of package names
                # implied to be wrong. Naming 18 packages there is actively
                # misleading, because none of them is the problem.
                if not lists_present:
                    note = ("%d of %d installed, apt has no package lists yet, "
                            "refresh them then press Recheck"
                            % (installed, len(rows)))
                else:
                    note += ", not offered by apt: %s" % ", ".join(
                        sorted(name for r in missing for name in r["unavailable"]))
            self.favourites_note.set_text(note)
            self.favourites_note.set_tooltip_text(note)
            self._sync_favourite_buttons()
            self._refresh_nav_counts()
            return False

        try:
            threading.Thread(target=worker, daemon=True).start()
        # `Exception`, NOT `RuntimeError`, AND THE NARROW CATCH WAS A REAL HOLE.
        # MEASURED 2026-08-26 against this machine's CPython 3.13.5:
        # `threading.Thread.start` wraps its call to `_start_joinable_thread` in
        # `except Exception: ...; raise`, i.e. the standard library itself expects a
        # non-RuntimeError out of it. `RuntimeError("can't start new thread")` is the
        # common failure, but the allocation underneath raises `MemoryError`, which is
        # precisely the condition under which a thread fails to start in the first
        # place. A MemoryError skipped this arm entirely and left the manager in the
        # busy state it had already entered. `Exception` and not `BaseException`, so a
        # KeyboardInterrupt or SystemExit still propagates rather than being rendered
        # to the operator as a repository error.
        except Exception as exc:
            apply_result(
                generation, [],
                "could not start favourite check: %s"
                % _exc_detail(exc))

    def selected_favourite(self):
        model, treeiter = self.favourites_view.get_selection().get_selected()
        if treeiter is None:
            return None
        app_id = model[treeiter][5]
        for row in getattr(self, "favourites", []):
            if row["id"] == app_id:
                return row
        return None

    def _sync_favourite_buttons(self):
        row = self.selected_favourite()
        install = self.buttons.get("fav_install")
        remove = self.buttons.get("fav_remove")
        if install is None or remove is None:
            return
        if (not self.catalog_ready or not self.favourites_checked
                or self.favourites_error):
            self._set_action_sensitive(install, False)
            self._set_action_sensitive(remove, False)
            return
        if row is None:
            self._set_action_sensitive(install, False)
            self._set_action_sensitive(remove, False)
            self.favourite_detail.set_text(
                "Select an application to install or remove it.")
            return
        state = row["state"]
        self._set_action_sensitive(
            install, state in ("available", "partial"))
        # NOT state-based. `unavailable` outranks `partial` in the model,
        # so a bundle holding one installed package and one apt cannot
        # offer would have had Remove greyed out with something to remove.
        self._set_action_sensitive(
            remove, bool(row["installed_packages"]))
        detail = "%s  ,  %s" % (row["title"], row["note"])
        detail += "\nPackages: %s" % " ".join(row["packages"])
        if state == "unavailable":
            # THE COMMON CAUSE IS NEITHER OF THE TWO THIS USED TO NAME. With no
            # downloaded indexes apt-cache policy still exits 0 and still answers,
            # it simply knows nothing, so EVERY package reads as unofferable and
            # the user was told the name might be wrong or the archive area might
            # be disabled. Both false. Operator-reported 2026-09-10: a user
            # following instructions to install GIMP saw all 8 applications in
            # this state. Reproduced by pointing apt-cache at an empty lists dir,
            # 8 of 8 unavailable; with populated lists the same code says 7
            # available and 1 genuinely unavailable.
            if not getattr(self, "favourites_lists_present", True):
                detail += ("\napt has not downloaded any package lists yet, so it "
                           "cannot say what is installable. This is normal on a "
                           "live session and on a freshly installed system. "
                           "Refresh the lists first (System sources > Refresh, or "
                           "`sudo apt update`), then press Recheck. Nothing is "
                           "wrong with %s."
                           % ", ".join(row["unavailable"]))
            else:
                detail += ("\nNot offered by apt on this machine: %s. The name may "
                           "be wrong, or the archive area that carries it may not "
                           "be enabled in System sources."
                           % ", ".join(row["unavailable"]))
            if row["installed_packages"]:
                detail += ("\nRemove still works and acts on the %d already "
                           "installed: %s."
                           % (len(row["installed_packages"]),
                              " ".join(row["installed_packages"])))
        elif state == "partial":
            detail += ("\n%d of %d packages are installed, so this "
                       "application is not fully usable yet."
                       % (row["installed_count"], row["total_count"]))
        self.favourite_detail.set_text(detail)

    def _on_favourite_install(self, _button):
        if not self._catalog_action_ready():
            return
        row = self.selected_favourite()
        if row is None:
            return
        self.run_helper(["app-install"] + list(row["packages"]),
                        "install %s" % row["title"])

    def _on_favourite_remove(self, _button):
        if not self._catalog_action_ready():
            return
        row = self.selected_favourite()
        if row is None:
            return
        # The INSTALLED subset, never the catalog list: apt-get remove
        # fails the whole command on a name it cannot resolve.
        self.run_helper(["app-remove"] + list(row["installed_packages"]),
                        "remove %s" % row["title"])

    # Tooltips live here rather than inline so the rail loop stays readable.
    # Every row gets one: the rail is the only place a channel or a filter is
    # named, and "thirdparty" tells a first-time reader nothing on its own.
    NAV_TIPS = {
        "stable": "The Stable channel: the builds Kodachi has released. This is "
                  "what a machine should normally track.",
        "all": "Every component of the channel shown above.",
        "main": "main: the Kodachi core binaries and services.",
        "thirdparty": "thirdparty: software Kodachi packages but does not "
                      "write, rebuilt against this release.",
        "apps": "apps: the optional desktop applications.",
        "beta": "The Beta channel: the next release, published earlier. Beta "
                "can be BEHIND stable, so moving to it can be a downgrade.",
        "dev": "The Dev channel: internal builds protected by Basic Auth.",
        "installed": "Only the Kodachi packages already on this machine.",
        "upgradable": "Only the packages where the channel above carries a "
                      "newer version than the one installed.",
        "pinned": "Only the packages pinned to a channel, which keeps later "
                  "upgrades tracking that channel rather than the default.",
        "diff": "Only the packages where stable and beta carry different "
                "versions, which is what a channel move would actually change.",
        "sources": "Every apt repository this machine reads: Debian, security, "
                   "backports, Whonix, Kodachi and anything you added yourself",
        "updates": "Everything apt would upgrade right now, and which "
                   "repository each update comes from",
        "favourites": "Applications Debian already ships that a Kodachi "
                      "desktop commonly wants: install or remove them here "
                      "instead of hunting for a download",
    }

    def _nav_tip(self, key):
        """Return a rail description whose machine-state claims are current."""
        if key != "dev":
            return self.NAV_TIPS[key]
        configured = bool(
            (self.catalog.get("configured") or {}).get("dev"))
        auth_present = dev_auth_file_present()
        if configured and auth_present:
            state = ("The Dev source is configured and a non-empty "
                     "authentication file is present. Dev package actions "
                     "are available; the privileged helper still validates "
                     "the stanza before apt runs.")
        elif configured:
            state = ("The Dev source is configured, but no non-empty "
                     "authentication file is present. Dev package actions "
                     "stay disabled until Dev credentials are entered.")
        elif auth_present:
            state = ("A non-empty Dev authentication file is present, but "
                     "the Dev source is not configured. Select Dev and use "
                     "Add channel to enable it.")
        else:
            state = ("The Dev source is not configured and no non-empty "
                     "authentication file is present. Enter Dev credentials "
                     "before adding the channel.")
        return "%s %s" % (self.NAV_TIPS[key], state)

    def _build_nav(self):
        adder = getattr(self.window, "_add_nav", None)
        self.nav_buttons = {}
        self.nav_counts = {}
        self.nav_groups = {}
        if adder is None:
            return
        nav = getattr(self.window, "_nav", None)
        for heading, rows in SIDEBAR:
            group_box = self._nav_heading(heading)
            for key, label, kind, indent, icon_name in rows:
                if kind == "channel":
                    handler = lambda b, k=key: self.set_channel(k, b)
                elif kind == "filter":
                    handler = lambda b, k=key: self.set_filter(k, b)
                elif kind == "page":
                    handler = lambda b, k=key: self.set_page(k, b)
                else:
                    # NOT A FALLBACK. Every kind in SIDEBAR is handled above,
                    # and the branch that used to live here ran a legacy
                    # script for anything unrecognised. A typo in a `kind`
                    # therefore produced a rail row that silently launched a
                    # terminal. Refusing is the only safe reading of "I do not
                    # know what this row does".
                    raise ValueError(
                        "SIDEBAR row %r has kind %r, which nothing handles"
                        % (key, kind))
                tip = self._nav_tip(key)
                button = adder(label, os.path.join(ICON_DIR, icon_name),
                               tip, handler)
                # REPARENT INTO THE GROUP'S REVEALER. The shared _add_nav packs
                # straight into `self.window._nav`, which is right for a window
                # with one flat rail and wrong here: a row that stays in `_nav`
                # is a row the group's collapse cannot hide, and it would then
                # sit BELOW the collapsed group's remaining rows in pack order,
                # so collapsing SYSTEM would appear to move its rows rather
                # than hide them. Everything _add_nav does besides the packing
                # (the destination count, the first-row activation, the
                # accessibility wiring) is left exactly as it was.
                if group_box is not None and nav is not None:
                    nav.remove(button)
                    group_box.pack_start(button, False, False, 0)
                self.nav_buttons[key] = button
                self._decorate_nav(button, key, indent)

    def _decorate_nav(self, button, key, indent):
        """Indent a component row and give every row its own count on the right.

        The shared _add_nav builds `[icon][label ....]`; the mockup's rail also
        carries a number, and that number is the reason the rail is worth
        looking at, because it says how much is behind each row before it is
        clicked.
        """
        content = button.get_child()
        if content is None:
            return
        if indent:
            content.set_margin_start(12 * indent)
        count = ui.cls(ui.lbl("", "repo-nav-count"), "repo-nav-count")
        count.set_xalign(1.0)
        content.pack_end(count, False, False, 0)
        self.nav_counts[key] = count

    def _refresh_nav_counts(self):
        """Recompute every rail number from the catalogue actually loaded.

        CATALOGUE-DERIVED ROWS GO BLANK WHILE THE CATALOGUE IS BEING RE-READ,
        and that is the whole fix for "the updates items remained 7 even though
        the update is running". Calling this function at the start of reload()
        is NOT sufficient on its own and was tried first: every value below is
        computed from `self.catalog`, which still holds the PREVIOUS answer
        until the worker thread returns, so a recount mid-reload re-rendered
        the identical stale numbers and the rail did not move.

        `self.updates`, `self.favourites` and `self.sources` already had this
        property, via `updates_checked` and friends; the eleven rows reload()
        owns did not. `catalog_ready` is the flag reload() clears up front and
        sets only after a successful read, so it is the correct predicate for
        exactly these rows, and it also covers the error path, where the old
        code left every number at its pre-operation value under a failure
        message.
        """
        counts = getattr(self, "nav_counts", None)
        if not counts:
            return
        # A recount can be requested before the first catalogue has ever landed
        # (reload() calls this on its first line), so getattr, not attribute
        # access: __init__ seeds self.catalog but not necessarily this flag if
        # a future edit moves the assignment.
        known = getattr(self, "catalog_ready", False)
        packages = self.catalog["packages"] if known else []

        def channel_total(channel):
            return sum(1 for p in packages if channel in p["channels"])

        repositories = [entry for entry in self.sources
                        if entry.get("format") in {"deb822", "one-line"}]
        source_incomplete = any(
            entry.get("format") in {"read-error", "invalid"}
            for entry in self.sources)
        values = {
            "stable": channel_total("stable") if known else None,
            "beta": channel_total("beta") if known else None,
            "dev": channel_total("dev") if known else None,
            "all": len(packages) if known else None,
            "sources": None if source_incomplete else len(repositories),
            "updates": (len(self.updates)
                        if self.updates_checked
                        and not self.updates_error else None),
            "favourites": (len(self.favourites)
                           if self.favourites_checked
                           and not self.favourites_error else None),
        }
        for key in ("main", "thirdparty", "apps"):
            values[key] = (sum(1 for p in packages if p["component"] == key)
                           if known else None)
        values["installed"] = (sum(1 for p in packages if p["installed"])
                               if known else None)
        values["upgradable"] = (
            sum(1 for p in packages if self._package_state(p) == "upgradable")
            if known else None)
        values["pinned"] = (sum(1 for p in packages if p["pinned"])
                            if known else None)
        values["diff"] = (sum(1 for p in packages if self._differs(p))
                          if known else None)
        for key, label in counts.items():
            value = values.get(key)
            # A row with no count of its own shows nothing rather than 0,
            # because "0" on a rail row reads as "nothing to install" and not
            # as "this row is not a list".
            label.set_text("" if value is None else str(value))
        # Credential and source state can change after the rail is built.
        # Refresh its answer alongside the counts instead of leaving the
        # launch-time sentence attached to a live control.
        for key, button in getattr(self, "nav_buttons", {}).items():
            ui.set_row_tooltip(button, self._nav_tip(key))

    def _differs(self, package):
        stable = repo.candidate(package, "stable")
        beta = repo.candidate(package, "beta")
        return bool(stable and beta and stable["version"] != beta["version"])

    def _nav_heading(self, text):
        """A group heading that is also the toggle for its own rows.

        Operator, 2026-08-21, on a1.png: "make the menu collpasable so i can
        collapse and expand". The rail is four groups and sixteen rows tall, so
        on a short window the SYSTEM group is below the fold whatever he does.

        The heading is a flat button, not a label with an event box: a label
        cannot be reached from the keyboard and gives no hover feedback, so a
        clickable one is a control that does not admit it is a control. The
        arrow is part of the button's own text rather than a separate widget,
        which keeps the heading exactly as tall as it was before.

        Collapsed state is per group and lives only for the life of the window.
        It is deliberately NOT persisted: a rail that comes back collapsed is
        how a feature goes missing, and this window is opened to find something.
        """
        nav = getattr(self.window, "_nav", None)
        if nav is None:
            return None
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_can_focus(True)
        label = ui.cls(ui.lbl(self._nav_heading_text(text, True),
                              "design1-nav-heading"), "repo-group")
        label.set_xalign(0.0)
        button.add(label)
        button.set_margin_top(12)
        button.set_margin_bottom(2)
        ui.set_row_tooltip(button, "Collapse or expand the %s group" % text)
        nav.pack_start(button, False, False, 0)

        revealer = Gtk.Revealer()
        revealer.set_reveal_child(True)
        revealer.set_transition_type(
            Gtk.RevealerTransitionType.SLIDE_DOWN)
        revealer.set_transition_duration(120)
        rows = ui.vbox(0)
        revealer.add(rows)
        nav.pack_start(revealer, False, False, 0)

        button.connect("clicked", self._on_nav_group, text, revealer, label)
        self.nav_groups[text] = (revealer, label)
        return rows

    @staticmethod
    def _nav_heading_text(text, expanded):
        # U+25BE / U+25B8, the same pair the Sources page uses for a folded
        # row, so one glyph means one thing across the whole window.
        return "%s  %s" % ("\u25be" if expanded else "\u25b8", text)

    def _on_nav_group(self, _button, text, revealer, label):
        expanded = not revealer.get_reveal_child()
        revealer.set_reveal_child(expanded)
        label.set_text(self._nav_heading_text(text, expanded))

    # ------------------------------------------------------------------
    # data
    # ------------------------------------------------------------------
    def reload(self):
        self._retry_failed_upload_dates()
        self._catalog_generation += 1
        generation = self._catalog_generation
        self.catalog_checked = False
        self.catalog_error = ""
        self.catalog_ready = False
        self._apply_action_lock()
        self.counter.set_text("checking package catalogue")
        # THE RAIL MUST SAY "CHECKING" TOO, AND THIS IS THE OPERATOR'S
        # "the updates items remained 7 even though the update is running".
        # The crumb line above went honestly to "checking package catalogue"
        # while the rail beside it kept rendering Upgradable 7, Installed 11
        # and the rest, computed from the catalogue this function is in the act
        # of replacing. A number that is merely out of date reads exactly like
        # a number that is current, so the window was asserting a stale fact
        # with full confidence for the whole async re-read.
        #
        # refresh_updates() has done this correctly for its own count since it
        # was written (`updates_checked = False` then a recount): this is the
        # same two lines, for the counts reload() owns. `catalog_checked` is
        # already False by the line above, so _refresh_nav_counts renders the
        # blank/checking form for every catalogue-derived row.
        self._refresh_nav_counts()

        def worker():
            catalog, sources, error = None, None, ""
            try:
                # RESOLVED ONCE, HERE, AND PASSED IN. Letting catalog() fall
                # back to its own default would read the LIBRARY's copy of the
                # auth path while every button in this window reads THIS
                # module's, so the grid and the controls could disagree about
                # whether the machine is entitled to dev. One answer per
                # reload, from the window's own predicate.
                catalog = repo.catalog(include_dev=dev_auth_file_present())
                sources = repo.system_sources()
            except BaseException as exc:
                try:
                    error = "could not read package catalogue: %s: %s" % (
                        type(exc).__name__, exc)
                except BaseException:
                    error = "could not read package catalogue"
            finally:
                GLib.idle_add(apply_result, generation, catalog, sources, error)

        def apply_result(result_generation, catalog, sources, error):
            if (not self.alive
                    or result_generation != self._catalog_generation):
                return False
            self.catalog_checked = True
            self.catalog_error = error
            if error:
                self.counter.set_text("could not read package catalogue")
                self.append_log(error + "\n")
                # THE ERROR PATH USED TO RETURN WITHOUT TOUCHING THE RAIL,
                # which left every count showing its PRE-OPERATION value under
                # a failure message most eyes skip: fail-open on the numbers
                # while the buttons fail closed. `catalog_ready` stays False,
                # so this recount renders the unknown form rather than a
                # number the window cannot stand behind.
                self._refresh_nav_counts()
                return False
            self.catalog = catalog
            self.catalog_ready = True
            self._apply_action_lock()
            self._state_cache.clear()
            self.refresh_sources(sources)
            self._draw_strip()
            self.refresh_table()
            # Both follow-up apt snapshots are already asynchronous.
            self.refresh_updates()
            self.refresh_favourites()
            return False

        try:
            threading.Thread(target=worker, daemon=True).start()
        # `Exception`, NOT `RuntimeError`, AND THE NARROW CATCH WAS A REAL HOLE.
        # MEASURED 2026-08-26 against this machine's CPython 3.13.5:
        # `threading.Thread.start` wraps its call to `_start_joinable_thread` in
        # `except Exception: ...; raise`, i.e. the standard library itself expects a
        # non-RuntimeError out of it. `RuntimeError("can't start new thread")` is the
        # common failure, but the allocation underneath raises `MemoryError`, which is
        # precisely the condition under which a thread fails to start in the first
        # place. A MemoryError skipped this arm entirely and left the manager in the
        # busy state it had already entered. `Exception` and not `BaseException`, so a
        # KeyboardInterrupt or SystemExit still propagates rather than being rendered
        # to the operator as a repository error.
        except Exception as exc:
            apply_result(
                generation, None, None,
                "could not start catalogue check: %s"
                % _exc_detail(exc))

    def _draw_strip(self):
        pairs = []
        for key in ("stable", "beta", "dev"):
            spec = repo.CHANNELS[key]
            present = self.catalog["present"].get(key)
            configured = bool(
                (self.catalog.get("configured") or {}).get(key))
            count = sum(1 for p in self.catalog["packages"]
                        if key in p["channels"])
            if configured and present:
                value = "%d packages" % count
                # SAY THAT THIS MACHINE ALREADY HOLDS A DEV KEY. Operator,
                # 2026-08-30: "I clicked on dev and it did nto ask me for user
                # and password !!!!!". The window was right not to ask: the key
                # in /etc/apt/auth.conf.d was written on 2026-08-22. It was
                # wrong to be silent about it, because the only reading left
                # was that the lock is not enforced at all.
                #
                # THE LABEL NAMES THE PREDICATE AND NOTHING MORE, and it took
                # me two tries to get there. I wrote ", unlocked" first, which
                # asserts the channel WORKS. Told that was too strong, I wrote
                # ", key stored", which is a SYNONYM FOR THE PHRASE THIS FILE
                # HAD ALREADY REJECTED one branch below ("credentials stored"),
                # so the second attempt re-created the defect under a new noun
                # and my test blessed it by banning only the old spelling.
                # <agent> rejected both, 2026-08-30.
                #
                # What `dev_auth_file_present()` observes is a NON-EMPTY FILE.
                # A stanza carrying a `machine` line and no password satisfies
                # it, and in that state NO usable key is stored at all and apt
                # answers 401; that predicate's own docstring records it as
                # reachable on 4 of 7 fixture states. So the chip says what was
                # actually seen, and every stronger reading is left to the user
                # or to a check that performs one.
                #
                # AND IT IS TWO WORDS, NOT FIVE. ", unlocked on this machine"
                # pushed the first row of four chips past the edge at 944px,
                # the width this window opens at, so the DEV chip ellipsized: a
                # fix for unreadable chips that made one chip unreadable.
                # test_no_status_fact_clips_its_own_value caught it at that
                # width and nowhere else, which is why the phrase is compact.
                if key == "dev" and dev_auth_file_present():
                    value += ", auth file"
                tone = "on" if key == "stable" else "info"
            elif configured:
                value = "configured, not synced"
                tone = "warn"
            elif present:
                value = "source absent, stale index present"
                tone = "warn"
            else:
                if key != "dev":
                    value = "not configured"
                elif dev_auth_file_present():
                    # NOT "credentials stored". `dev_auth_file_present()`
                    # proves a non-empty file exists and nothing more; a
                    # truncated stanza satisfies it and still returns 401.
                    #
                    # ONE VOCABULARY FOR ONE STATE, and it is the file. This
                    # branch and the configured branch above describe the same
                    # file from two sides and used to use two different words,
                    # so a user reading this had no reason to connect it to the
                    # Clear dev credentials control or to the prompt he
                    # expected and did not get. Neither may claim a key is
                    # stored or that the channel works: see the branch above.
                    value = "auth file; channel absent"
                else:
                    value = "needs credentials"
                tone = "off"
            pairs.append((spec["label"], value, tone))
        pairs.append(("Installed", "%d packages" % self.catalog["installed_count"],
                      "on"))
        pairs.append(("System channel",
                      self.catalog["system_pin"] or "stable (default)",
                      "info" if self.catalog["system_pin"] else "off"))
        repositories = [entry for entry in self.sources
                        if entry.get("format") in {"deb822", "one-line"}]
        inert = len(self.sources) - len(repositories)
        enabled = sum(1 for entry in repositories if entry["enabled"])
        repository_value = "%d enabled of %d" % (enabled, len(repositories))
        if inert:
            repository_value += "; %d invalid or non-repository row%s" % (
                inert, "" if inert == 1 else "s")
        pairs.append(("Repositories", repository_value,
                      "warn" if inert else "on" if enabled else "off"))
        if self.updates_error:
            # THE REASON, NOT THE FACT THAT THERE IS ONE. "could not check"
            # told the operator nothing he could act on, and this window owns
            # the repair for the commonest cause. See repo.classify_apt_error.
            short, _remedy = repo.classify_apt_error(self.updates_error)
            pairs.append(("Pending updates", short, "err"))
        elif not self.updates_checked:
            pairs.append(("Pending updates", "checking", "info"))
        elif self.updates:
            security = sum(1 for u in self.updates if u["kind"] == "security")
            value = "%d waiting" % len(self.updates)
            if security:
                value += ", %d security" % security
            pairs.append(("Pending updates", value,
                          "err" if security else "warn"))
        else:
            pairs.append(("Pending updates", "system is current", "on"))
        # ONE PREDICATE, BOTH CONTROLS. The foot button and the Maintenance
        # menu item say the same thing about the same file, so a machine that
        # holds a dev key cannot offer "Dev credentials" in one place and
        # "Clear dev credentials" in the other.
        dev_label = ("Clear dev credentials" if dev_auth_file_present()
                     else "Dev credentials")
        button = self.buttons.get("dev_auth")
        if button is not None:
            button.set_label(dev_label)
        item = getattr(self, "dev_auth_item", None)
        if item is not None:
            item.set_label(dev_label)
        button = self.buttons.get("channel_setup")
        if button is not None:
            configured_path = (
                (self.catalog.get("configured") or {}).get(self.channel))
            configured = bool(configured_path)
            managed_path = os.path.join(
                repo.sources_dir(), "kodachi-%s.sources" % self.channel)
            managed = configured_path == managed_path
            button.set_label(
                "Remove channel" if managed else
                "Configured externally" if configured else "Add channel")
            # DEV IS ADDABLE ONCE ITS CREDENTIAL IS STORED. Hardcoding
            # `!= "dev"` meant the button stayed grey even after the operator
            # had entered working credentials, which is the same defect in the
            # opposite direction from the Install button being live on a
            # channel that does not carry the package.
            #
            # AND THE CREDENTIAL GATES ADDING ONLY, NEVER REMOVING. Found by
            # the inspector, 2026-08-30, and it was a genuine dead end rather
            # than a wording problem. `verb_disable` needs no credential, and
            # `verb_dev_credentials_clear` DELIBERATELY leaves the source in
            # place (kodachi-repo-apt:1486), so "clear the dev credentials"
            # is the documented way to reach a machine that has a managed dev
            # source and no auth file. In that exact state this button read
            # "Remove channel" and was INSENSITIVE, so the only control that
            # could remove it could not be pressed, and there is no menu twin.
            # A refusal elsewhere in this window now names this button, which
            # is what turned a latent dead end into a visible one.
            self._set_action_sensitive(
                button, (not configured or managed)
                and (managed or self.channel != "dev"
                     or dev_auth_file_present()))
            if configured and not managed:
                tip = ("This channel is configured in %s. Use System Sources "
                       "to inspect it; this button only removes the exact "
                       "kodachi-%s.sources file created here."
                       % (configured_path, self.channel))
                ui.set_control_accessibility(button, "Channel configured externally", tip)
                button.set_tooltip_text(tip)
        # THE THIRD MEMBER, AND ITS SENSITIVITY WAS NEVER SET AT ALL. "Move
        # system" runs `kodachi-repo-apt system <channel>`, and `_on_system`
        # refuses dev with no stored credential exactly like Install does, so
        # the button was permanently live and its only effect in that state was
        # to print the refusal. Set here rather than in `_sync_package_buttons`
        # because moving the whole system is a CHANNEL action and does not
        # depend on which package is selected.
        move = self.buttons.get("system")
        if move is not None:
            self._set_action_sensitive(
                move, self.channel != "dev" or dev_auth_file_present())
        self._draw_migration()
        # Four per row: seven facts in one row asked for 1557px of window.
        self.window.state_strip(pairs, wrap_at=4)
        self._strip_slot.show_all()
        # Redrawn alongside the strip, so the age and the channel facts beside
        # it can never describe two different reads of the same directory.
        self._refresh_index_age()

    def visible(self):
        rows = []
        for package in self.catalog["packages"]:
            component = package["component"]
            state = self._package_state(package)
            if self.filter in ("main", "thirdparty", "apps"):
                if component != self.filter:
                    continue
            elif self.filter == "installed" and not package["installed"]:
                continue
            elif self.filter == "upgradable" and state != "upgradable":
                continue
            elif self.filter == "pinned" and not package["pinned"]:
                continue
            elif self.filter == "diff":
                stable = repo.candidate(package, "stable")
                beta = repo.candidate(package, "beta")
                if not stable or not beta or stable["version"] == beta["version"]:
                    continue
            if self.query:
                haystack = " ".join([
                    package["name"], package["summary"], package["benefit"],
                    (repo.candidate(package, self.channel) or {}).get("sha256", ""),
                ]).lower()
                if self.query not in haystack:
                    continue
            rows.append(package)
        return self._sorted(rows)

    def _sorted(self, rows):
        """The grid's order, which is exactly what the three chips select.

        The TreeView sorted by clicking a column header, so this method is the
        conversion's replacement for that feature and not an addition: without
        it a grid of cards has no order at all beyond whatever the catalog
        happened to be built in. The three branches are the mockup's, term for
        term (mockup-1-storefront.html, `visible()`).
        """
        if self.sort == "size":
            # Biggest download first. A missing size sorts last rather than
            # first, which is what `|| 0` does on the mockup side.
            ordered = sorted(rows, key=lambda package: -(
                (repo.candidate(package, self.channel) or {}).get("size") or 0))
        elif self.sort == "date":
            # NEWEST FIRST, OVER THE DATES THIS WINDOW HAS ACTUALLY FETCHED.
            # This branch used to key on `candidate(...)["uploaded"]`, a key no
            # producer has ever written: `grep -rn uploaded usr/` finds the
            # reader, the tooltip and the datasheet's own cache lookup, and
            # zero writers into a catalog record. So every key was "", and
            # `sorted` on an all-equal key returns the input unchanged: the
            # chip was an IDENTITY PERMUTATION on a real machine, not only on a
            # fixture, for its whole life. Found by <agent>
            # 2026-08-21, who also caught that the arm written to prove this
            # chip re-derived the same missing key and so could never fail.
            #
            # A date that has not been fetched sorts LAST in the forward
            # direction and ties break by name, which is what a missing size
            # already does on `Largest`. Name order rather than catalog order
            # so that the unfetched tail is at least deterministic.
            def upload_rank(package):
                # THE SAME ARTIFACT THE PANE CACHED UNDER, INCLUDING ITS
                # FALLBACK. `show_detail` uses `artifact_channel = self.channel
                # if current else ref_channel`, so for a package the shown
                # channel does not carry it writes the date under the
                # REFERENCE channel's key. Reading `self.channel` unconditio-
                # nally here missed every one of those, and on DEV it missed
                # ALL of them: dev publishes no index on this machine, so
                # `candidate(package, "dev")` is None for every package, every
                # sort key collapsed to the single string "dev|" and the chip
                # fell back to name order while the operator watched every date
                # arrive in the pane. <agent> 2026-08-22, correcting my
                # own claim that the two keys could never disagree.
                artifact = repo.candidate(package, self.channel)
                channel = self.channel
                if not artifact:
                    artifact, channel = self._reference(package, self.channel)
                minted = upload_sort_stamp(self.uploads.get(
                    "%s|%s" % (channel, (artifact or {}).get("filename", ""))))
                return (0 if minted else 1, -minted, package["name"])
            ordered = sorted(rows, key=upload_rank)
        elif self.sort == "state":
            # The order the TreeView's State column used to reach. A state the
            # table does not list sorts last instead of raising, so a new
            # upgrade_state() value degrades to "ungrouped" rather than
            # emptying the grid.
            def state_rank(package):
                word = STATE_WORD.get(
                    self._package_state(package), "")
                rank = (STATE_ORDER.index(word) if word in STATE_ORDER
                        else len(STATE_ORDER))
                return (rank, package["name"])
            ordered = sorted(rows, key=state_rank)
        else:
            # A -> Z, with the core suite first. `main` is pinned ahead of the
            # rest and everything else falls in component order, which is what
            # the mockup's localeCompare does and is NOT the same as sorting
            # the three component names alphabetically.
            ordered = sorted(rows, key=lambda package: (
                0 if package["component"] == "main" else 1,
                package["component"], package["name"]))
        # ONE REVERSAL FOR ALL FOUR, which is what a TreeViewColumn's DESC
        # toggle did: it reversed the same comparison rather than defining a
        # second one, so there is no key that can disagree with its own
        # forward direction.
        return list(reversed(ordered)) if self.sort_reverse else ordered

    def refresh_table(self):
        """Refill the store, then rebuild the grid of cards from it.

        THE STORE IS FILLED FIRST AND THE CARD IS BUILT FROM THE ROW. Building
        a card straight from the package record and appending to the store
        separately would be two renderings of one fact, and the contracts read
        the store while the operator reads the card: they would be free to
        disagree. `_package_card` is handed the row values it must display.
        """
        selected = self.selected
        # See the comment on self._rebuilding in __init__: emptying a FlowBox
        # emits `selected-children-changed` with nothing selected.
        self._rebuilding = True
        try:
            self.store.clear()
            for child in self.cards.get_children():
                self.cards.remove(child)
                child.destroy()
            self.card_index = {}
            rows = self.visible()
            for package in rows:
                stable = repo.candidate(package, "stable")
                beta = repo.candidate(package, "beta")
                current = repo.candidate(package, self.channel)
                state = self._package_state(package)
                values = [
                    package["name"],
                    package["component"],
                    package["installed"] or "-",
                    (stable or {}).get("version", "-"),
                    (beta or {}).get("version", "-"),
                    # C2: this printed `pinned or "stable"`, so an unpinned
                    # package and one deliberately pinned to stable rendered
                    # identically, while the pin silently decides what later
                    # installs do. "auto" means no pin: the package follows
                    # whatever channel is shown above.
                    package["pinned"] or "auto",
                    repo.human_size((current or {}).get("size")),
                    STATE_WORD.get(state, state),
                    package["name"],
                ]
                self.store.append(values)
                child = self._package_card(package, values, state)
                self.card_index[package["name"]] = child
                self.cards.add(child)
            self.cards.show_all()
            self.counter.set_text("%d of %d packages" %
                                  (len(rows), len(self.catalog["packages"])))
            self._draw_crumb(len(rows))
            self._draw_notcfg()
            # Restore while the signal guard is still armed, then rebuild the
            # datasheet explicitly once. Selecting an already-selected name
            # emits no signal, so the previous version left a stale pane after
            # search, sort and reload even though the card grid was current.
            if selected is not None and selected in self.card_index:
                self.cards.select_child(self.card_index[selected])
                self.selected = selected
            elif rows:
                self.selected = rows[0]["name"]
                self.cards.select_child(self.card_index[self.selected])
            else:
                self.selected = None
        finally:
            self._rebuilding = False
        self.show_detail(self.package(self.selected) if self.selected else None)

    def _draw_crumb(self, shown):
        """`Stable channel \u203a All packages \u00b7 8 of 28 packages`.

        The counter label in the toolbar still carries the bare "8 of 28
        packages" and is still what a contract reads. This is the mockup's
        breadcrumb, which says the same number in the place the mockup puts it
        and adds the two things the number alone does not: which channel and
        which filter produced it.
        """
        label = dict(FILTERS).get(self.filter, self.filter)
        plain = ("%s \u203a %s  \u00b7  %d of %d packages"
                 % (repo.CHANNELS[self.channel]["label"], label, shown,
                    len(self.catalog["packages"])))
        self.crumb.set_markup(
            '%s \u203a %s  \u00b7  <span foreground="#a6e07a"><b>%d of %d '
            'packages</b></span>'
            % (GLib.markup_escape_text(repo.CHANNELS[self.channel]["label"]),
               GLib.markup_escape_text(label), shown,
               len(self.catalog["packages"])))
        # The crumb sits in a row it SHARES with three sort chips, and the
        # grid pane is the one that gives way when the datasheet slides in, so
        # at the 940px opening width this label is ellipsized by design. The
        # ellipsis is only acceptable while the full sentence is recoverable,
        # which is what test_no_label_is_cut_off_with_no_way_to_read_it
        # measures. Plain text, not the markup: a tooltip renders markup as
        # literal angle brackets, and the contract compares get_text().
        self.crumb.set_tooltip_text(plain)

    def _draw_notcfg(self):
        """The banner over the grid for a channel with no apt source.

        The same sentence show_detail(None) has always carried, moved to where
        it is read. In the pane it was visible only while NOTHING was
        selected, which on a configured machine is a state a user passes
        through for one frame.
        """
        if (self.catalog.get("configured") or {}).get(self.channel):
            self.notcfg.set_text("")
            self.notcfg.hide()
            return
        self.notcfg.set_text(
            "The %s channel is not configured on this machine. Press Add "
            "channel below and this application will write the apt source "
            "for it, using the signing key it pins, and then run apt update. "
            "Nothing is installed or upgraded."
            % repo.CHANNELS[self.channel]["label"])
        self.notcfg.show()

    # ------------------------------------------------------------------
    # pages
    # ------------------------------------------------------------------
    def set_page(self, name, button=None):
        self.page = name
        # THE ISO FETCH BELONGS TO THIS PAGE, NOT TO EVERY RECOUNT.
        #
        # It used to hang off refresh_updates(), which the initial load and both
        # page buttons call, so every apt recount also started a worker thread
        # running curl against kodachi.cloud even when nobody was looking at the
        # card. Measured on a test VM: the window suite's own 100ms budget for an
        # unrelated `show_detail` call came in at 109ms with that fetch in flight,
        # against 638s total for the same suite without it and 690s with it. The
        # assertion is a wall clock and the overshoot was noise, but the cause was
        # real work I had added where it was not needed.
        #
        # Now it runs when this page is actually shown, at most once every ten
        # minutes, so flipping between rail rows cannot spam the network either.
        if name == "updates":
            self._maybe_refresh_iso_images()
        self.pages.set_visible_child_name(name)
        self.actions.set_visible_child_name(name)
        marker = getattr(self.window, "_set_active_nav", None)
        # FALL BACK TO THE ROW THAT OWNS THIS PAGE when no button is handed in.
        # Only a click supplies one, so a programmatic set_page left the rail
        # highlighting whatever was clicked last: the sidebar said "All
        # packages" while the System sources table was on screen. The rail is
        # the only thing telling him where he is, so it follows the page rather
        # than the click.
        if button is None:
            # getattr, because the body is built before the nav rows exist.
            button = getattr(self, "nav_buttons", {}).get(name)
        if marker is not None and button is not None:
            marker(button)

    def refresh_sources(self, sources=None):
        # THE KEY IS READ BEFORE THE LIST IS REPLACED. `selected_source()`
        # resolves two of its seven fields (`signed_by`, `options`) through
        # `_entry_at`, which indexes `self.sources` BY POSITION using the store
        # row's hidden column 9. Those positions belong to the list that built
        # the store. Reading the key after the reassignment mixed the selected
        # row's path/type/uri/suite/components with a DIFFERENT repository's
        # keyring and options, so nothing matched, `index` stayed 0, and the
        # selection landed on whatever sorts first, normally
        # /etc/apt/sources.list. Adding a source that sorts before the selected
        # one is enough to shift every later entry and trigger it, and every
        # add, remove, enable and disable path ends here.
        selected = self.selected_source()
        self.sources = repo.system_sources() if sources is None else sources
        self.sources_store.clear()
        for position, entry in enumerate(self.sources):
            self.sources_store.append([
                entry["kind_label"],
                entry["types"],
                entry["uri"],
                entry["suite"],
                entry["components"] or "-",
                "enabled" if entry["enabled"] else "disabled",
                entry["filename"],
                entry["filename"],
                entry["path"],
                # F1: the row's own position in self.sources. A VALUE key is
                # the wrong instrument for "which row is selected", because
                # every value key is a guess about which fields happen to be
                # unique on this machine: the first one omitted `types` and
                # matched a commented-out deb-src twin, and widening it to
                # include `types` still collides for two entries in one file
                # that differ only in Components (deb ... trixie main and
                # deb ... trixie contrib). The position cannot collide,
                # because the table is built from this list in this order.
                str(position),
            ])
        errors = [entry for entry in self.sources
                  if entry.get("format") == "read-error"]
        invalid = [entry for entry in self.sources
                   if entry.get("format") == "invalid"]
        inert = [entry for entry in self.sources
                 if entry.get("format") == "commented-block"]
        repositories = [entry for entry in self.sources
                        if entry.get("format") in {"deb822", "one-line"}]
        enabled = sum(1 for entry in repositories if entry["enabled"])
        if errors or invalid:
            note = ("INCOMPLETE: %d repository rows read; %d unread path%s; "
                    "%d invalid source entr%s" %
                    (len(repositories), len(errors),
                     "" if len(errors) == 1 else "s", len(invalid),
                     "y" if len(invalid) == 1 else "ies"))
            self.sources_note.set_text(note)
            self.sources_note.set_tooltip_text(
                note + ": " + ", ".join(
                    entry["path"] for entry in errors + invalid))
        else:
            note = "%d enabled, %d disabled, %d files" % (
                enabled, len(repositories) - enabled,
                len({entry["path"] for entry in repositories}))
            if inert:
                note += "; %d commented prose block%s not counted" % (
                    len(inert), "" if len(inert) == 1 else "s")
            self.sources_note.set_text(note)
            self.sources_note.set_tooltip_text(note)
        if self.sources:
            index = 0
            if selected:
                for position, entry in enumerate(self.sources):
                    if (entry["path"], entry["types"], entry["uri"],
                            entry["suite"], entry["components"] or "-",
                            entry["signed_by"], tuple(sorted(
                                (entry.get("options") or {}).items()))) == selected:
                        index = position
                        break
            # THE ROW CARRYING THIS POSITION, NEVER THE POSITION AS A PATH.
            # `index` is an offset into self.sources; a Gtk.TreePath is an
            # offset into the VIEW. `_grid` calls set_sort_column_id on every
            # visible header of this table and a Gtk.ListStore sorts IN PLACE,
            # so one click on the Status header makes the two orders differ and
            # TreePath(index) highlights a different repository than the one
            # just acted on, with all four action buttons then pointed at it.
            # Column 9 travels with its row, which is exactly why `_entry_at`
            # reads it, so it answers this question too.
            selection = self.sources_view.get_selection()
            treeiter = self.sources_store.get_iter_first()
            while treeiter is not None:
                if int(self.sources_store[treeiter][9]) == index:
                    selection.select_iter(treeiter)
                    break
                treeiter = self.sources_store.iter_next(treeiter)
            else:
                selection.select_path(Gtk.TreePath(0))
        else:
            self._on_source_select(None)
        # Manual source refreshes must update the rail in the same turn. The
        # background catalogue worker also refreshes counts, but relying on it
        # leaves a stale confident number after an unread or invalid source is
        # discovered by this direct path.
        self._refresh_nav_counts()

    def selected_source(self):
        selection = getattr(self, "sources_view", None)
        if selection is None:
            return None
        model, treeiter = self.sources_view.get_selection().get_selected()
        if treeiter is None:
            return None
        row = model[treeiter]
        # THE RE-SELECTION KEY, used only to find the same repository again
        # after the list has been re-read from disk, where a position would be
        # meaningless because entries can appear, vanish or move. It is the
        # FULL identity, every field that distinguishes one entry from another
        # in the same file, because each field left out is a collision:
        # omitting `types` matched an enabled `deb` against its own
        # commented-out `deb-src` twin (measured on <lab-host>, where the
        # detail pane read "State: enabled" under a row whose Status column
        # read "disabled"), and omitting `components` collides for
        # `deb ... trixie main` beside `deb ... trixie contrib`.
        entry = self._entry_at(row)
        return (row[8], row[1], row[2], row[3], row[4],
                entry["signed_by"] if entry else "",
                tuple(sorted((entry.get("options") or {}).items()))
                if entry else ())

    def _entry_at(self, row):
        """The entry a store row was built from, by position, never by value.

        The position is exact: the table is built from self.sources in order
        and column 9 records where each row came from. A value key answers a
        different question (find this repository again in a NEW list) and
        cannot answer this one without assuming which fields are unique.
        """
        try:
            position = int(row[9])
        except (IndexError, TypeError, ValueError):
            return None
        if 0 <= position < len(self.sources):
            return self.sources[position]
        return None

    def source_entry(self):
        view = getattr(self, "sources_view", None)
        if view is None:
            return None
        model, treeiter = view.get_selection().get_selected()
        if treeiter is None:
            return None
        return self._entry_at(model[treeiter])

    def _on_source_select(self, _selection):
        entry = self.source_entry()
        enable = self.buttons.get("source_enable")
        disable = self.buttons.get("source_disable")
        remove = self.buttons.get("source_remove")
        if entry is None:
            self.source_detail.set_text("")
            for button in (enable, disable, remove):
                if button is not None:
                    self._set_action_sensitive(button, False)
            return
        bits = ["File: %s" % entry["path"],
                "Format: %s" % ("deb822 (.sources)" if entry["format"] == "deb822"
                                else "unread source path"
                                if entry["format"] == "read-error"
                                else "invalid apt source entry"
                                if entry["format"] == "invalid"
                                else "commented block not parsed"
                                if entry["format"] == "commented-block"
                                else "one line (.list)"),
                "State: %s" % ("enabled" if entry["enabled"] else "disabled")]
        is_repository = entry["format"] in {"deb822", "one-line"}
        if not is_repository:
            bits.append("Trust: not inferred because this row is not a valid "
                        "repository entry")
        elif entry["signed_by"]:
            bits.append("Signed by: %s" % entry["signed_by"])
        elif entry.get("options"):
            bits.append("Signed by: not stated; this entry has explicit apt "
                        "options shown below, so trust behavior is not inferred")
        else:
            bits.append("Signed by: not stated in this entry, apt falls back "
                        "to the trusted keyring set")
        if entry["architectures"]:
            bits.append("Architectures: %s" % entry["architectures"])
        if entry.get("architectures_add"):
            bits.append("Architectures add: %s"
                        % entry["architectures_add"])
        if entry.get("architectures_remove"):
            bits.append("Architectures remove: %s"
                        % entry["architectures_remove"])
        security = set(repo.APT_SECURITY_OPTIONS)
        architecture_keys = {
            "arch", "arch+", "arch-", "architectures",
            "architectures-add", "architectures-remove", "signed-by",
        }
        for key, value in sorted((entry.get("options") or {}).items()):
            if key in architecture_keys:
                continue
            label = key.replace("-", " ").title()
            normalized = str(value).strip().lower()
            high_risk = (
                key in {"trusted", "allow-insecure", "allow-weak",
                        "allow-downgrade-to-insecure"}
                and normalized not in repo.DISABLING_VALUES
            ) or (
                key in {"check-date", "check-valid-until"}
                and normalized in repo.DISABLING_VALUES
            )
            if high_risk:
                bits.append("HIGH RISK apt override: %s=%s in %s"
                            % (label, value, entry["path"]))
            elif key in security:
                bits.append("Apt policy override: %s=%s in %s"
                            % (label, value, entry["path"]))
            else:
                bits.append("Other apt option: %s=%s in %s"
                            % (label, value, entry["path"]))
        siblings = [e for e in self.sources if e["path"] == entry["path"]]
        if len(siblings) > 1:
            bits.append("This file defines %d entries; Enable, Disable and "
                        "Remove act on all of them." % len(siblings))
        if entry["kind"] == "custom":
            bits.append("This repository is not part of Debian or Kodachi. "
                        "Software installed from it is trusted by whoever "
                        "signs it.")
        switchable = bool(entry.get("switchable", False))
        if enable is not None:
            self._set_action_sensitive(
                enable, switchable and not entry["enabled"])
            enable_tip = (
                "Enable this disabled repository file."
                if switchable and not entry["enabled"] else
                "Enable is unavailable because this repository is already enabled."
                if switchable else
                "Enable is unavailable because this row is not safely switchable.")
            ui.set_control_accessibility(enable, "Enable repository", enable_tip)
            enable.set_tooltip_text(enable_tip)
        if disable is not None:
            self._set_action_sensitive(
                disable, switchable and entry["enabled"])
            disable_tip = (
                "Disable this enabled repository while keeping its file."
                if switchable and entry["enabled"] else
                "Disable is unavailable because this repository is already disabled."
                if switchable else
                "Disable is unavailable because this row is not safely switchable.")
            ui.set_control_accessibility(
                disable, "Disable repository", disable_tip)
            disable.set_tooltip_text(disable_tip)
        mutation_reason = entry.get("mutation_reason") or (
            "this parsed row is not safely mutable by the source helper")
        removable = (bool(entry.get("mutable", entry.get("switchable", False)))
                     and entry["format"] in {"deb822", "one-line"}
                     and entry["path"] != "/etc/apt/sources.list")
        if remove is not None:
            self._set_action_sensitive(remove, removable)
            remove_tip = (
                "Back up and remove the selected repository file."
                if removable else
                "Remove is unavailable: %s." % mutation_reason)
            ui.set_control_accessibility(
                remove, "Remove repository file", remove_tip)
            remove.set_tooltip_text(remove_tip)
        if entry["format"] == "read-error":
            bits.append("Unread source: %s. Enable, Disable and Remove are "
                        "disabled because this window could not inspect the "
                        "file safely." % entry["components"])
        elif not switchable:
            bits.append("Enable, Disable and Remove unavailable: %s."
                        % mutation_reason)
        elif entry["enabled"]:
            bits.append("Enable unavailable: this repository is already enabled.")
        else:
            bits.append("Disable unavailable: this repository is already disabled.")
        if not removable:
            if entry["path"] == "/etc/apt/sources.list":
                bits.append("Remove unavailable: /etc/apt/sources.list is the "
                            "distribution main list; disable it instead.")
            else:
                bits.append("Remove unavailable: %s." % mutation_reason)
        self.source_detail.set_text("   |   ".join(bits))

    def refresh_updates(self):
        self._updates_generation += 1
        generation = self._updates_generation
        self.updates_checked = False
        self.updates = []
        self.updates_error = ""
        self.updates_store.clear()
        self.updates_note.set_text("checking")
        self._refresh_nav_counts()
        apply_button = self.buttons.get("updates_apply")
        if apply_button is not None:
            self._set_action_sensitive(apply_button, False)

        def worker():
            # Same shape as run_helper above: `apply_result` is the only thing
            # that replaces the "checking" placeholder, so an exception
            # escaping `pending_updates` leaves the note reading "checking"
            # forever. Its own guard cannot catch a decode error, because
            # UnicodeDecodeError is a ValueError and that guard names OSError
            # and SubprocessError. Fixed at the source too; this is the
            # backstop for everything else that can go wrong in a thread.
            updates, error = [], ""
            try:
                updates, error = repo.pending_updates()
            except BaseException as exc:
                error = ("could not read pending updates: %s"
                         % _exc_detail(exc))
            finally:
                GLib.idle_add(apply_result, generation, updates, error)

        def apply_result(result_generation, updates, error):
            if not self.alive:
                return False
            # Overlapping checks are reachable from startup plus the Recheck
            # button. Completion order must not let a slow older apt snapshot
            # replace the newer request's result or error.
            if result_generation != self._updates_generation:
                return False
            self.updates = updates
            self.updates_error = error
            self.updates_checked = True
            self.updates_store.clear()
            for update in updates:
                self.updates_store.append([
                    update["name"],
                    update["installed"] or "not installed",
                    update["candidate"],
                    update["origin"],
                    # C5: this column mixed "Kodachi" with "security" and
                    # "regular" in one table.
                    {"kodachi": "Kodachi", "security": "Security"}.get(
                        update["kind"], "Regular"),
                ])
            # CLEARED BEFORE THE BRANCH, NOT INSIDE THE ERROR ARM. The tooltip
            # used to be written only when there WAS an error, so a machine
            # that failed a check and then passed one kept the old apt error
            # and its remedy under a chip reading "nothing to upgrade": a
            # hover that contradicts the label, describing a fault that has
            # already been repaired. Found by <agent>, 2026-08-30.
            # Every arm below either overwrites this or means it.
            self.updates_note.set_tooltip_text(None)
            if error:
                # THE PAGE GETS THE WHOLE TRUTH: apt's own words, plus what to
                # do about them, plus where the control that does it lives. The
                # chip in the strip carries only `short`, because it is a chip.
                short, remedy = repo.classify_apt_error(error)
                self.updates_note.set_text(short)
                self.updates_note.set_tooltip_text(
                    "%s\n\n%s" % (error.strip(), remedy) if remedy
                    else error.strip())
                self._set_updates_remedy(error.strip(), remedy)
            elif not updates:
                self.updates_note.set_text("nothing to upgrade")
                self._set_updates_remedy("", "")
            else:
                by_kind = {}
                for update in updates:
                    by_kind[update["kind"]] = by_kind.get(update["kind"], 0) + 1
                parts = ["%d %s" % (count, name) for name, count in
                         sorted(by_kind.items())]
                self.updates_note.set_text("%d pending: %s"
                                           % (len(updates), ", ".join(parts)))
                self._set_updates_remedy("", "")
            if apply_button is not None:
                self._set_action_sensitive(
                    apply_button, bool(updates) and not error)
            self._refresh_nav_counts()
            self._draw_strip()
            return False

        try:
            threading.Thread(target=worker, daemon=True).start()
        # `Exception`, NOT `RuntimeError`, AND THE NARROW CATCH WAS A REAL HOLE.
        # MEASURED 2026-08-26 against this machine's CPython 3.13.5:
        # `threading.Thread.start` wraps its call to `_start_joinable_thread` in
        # `except Exception: ...; raise`, i.e. the standard library itself expects a
        # non-RuntimeError out of it. `RuntimeError("can't start new thread")` is the
        # common failure, but the allocation underneath raises `MemoryError`, which is
        # precisely the condition under which a thread fails to start in the first
        # place. A MemoryError skipped this arm entirely and left the manager in the
        # busy state it had already entered. `Exception` and not `BaseException`, so a
        # KeyboardInterrupt or SystemExit still propagates rather than being rendered
        # to the operator as a repository error.
        except Exception as exc:
            apply_result(
                generation, [],
                "could not start updates check: %s"
                % _exc_detail(exc))

    def package(self, name):
        for package in self.catalog["packages"]:
            if package["name"] == name:
                return package
        return None

    def _package_state(self, package):
        """One version comparison per package/channel/version identity."""
        current = repo.candidate(package, self.channel)
        key = (package.get("name"), self.channel, package.get("installed"),
               (current or {}).get("version"))
        if key not in self._state_cache:
            self._state_cache[key] = repo.upgrade_state(package, self.channel)
        return self._state_cache[key]

    def _trust_identity(self, channel):
        """Identity of both files consumed by the background trust check."""
        def identity(path):
            try:
                info = os.stat(path)
                return (path, info.st_mtime_ns, info.st_size)
            except (OSError, TypeError):
                return (path, None, None)

        bindings = tuple(repo.configured_channel_keyrings(channel))
        return (tuple(identity(path) for path in bindings),
                identity(repo.release_file(channel)), channel)

    def _observed_repository_key(self, channel):
        """Return cached trust state and start a non-blocking refresh if stale."""
        stamp = self._trust_identity(channel)
        cached = self._trust_cache.get(stamp)
        if cached is not None:
            return cached
        if self._trust_pending != stamp:
            self._trust_generation += 1
            generation = self._trust_generation
            self._trust_pending = stamp

            def worker():
                usable = None
                report = ("unparseable", "",
                          "repository trust check did not complete")
                try:
                    bindings = repo.configured_channel_keyrings(channel)
                    if bindings != [ARCHIVE_KEYRING]:
                        report = (
                            "source-binding", "",
                            "the live official source is bound to %s, not %s"
                            % (", ".join(bindings) if bindings
                               else "no Signed-By keyring", ARCHIVE_KEYRING))
                    else:
                        report = installed_repository_key(bindings[0])
                        if report[0] == "unparseable":
                            usable = apt_parser_can_use_keyring(
                                path=bindings[0], channel=channel)
                except BaseException as exc:
                    try:
                        detail = "%s: %s" % (type(exc).__name__, exc)
                    except BaseException:
                        detail = "exception details unavailable"
                    report = ("unparseable", "",
                              "repository trust check failed: %s" % detail)
                finally:
                    GLib.idle_add(
                        apply_result, generation, stamp, report, usable)

            def apply_result(result_generation, result_stamp, report, usable):
                if (not self.alive
                        or result_generation != self._trust_generation
                        or result_stamp != self._trust_identity(channel)):
                    return False
                self._trust_pending = None
                self._trust_cache[result_stamp] = tuple(report) + (usable,)
                package = self.package(self.selected) if self.selected else None
                if package is not None:
                    self.show_detail(package)
                return False

            try:
                threading.Thread(target=worker, daemon=True).start()
            # `Exception`, NOT `RuntimeError`, AND THE NARROW CATCH WAS A REAL HOLE.
            # MEASURED 2026-08-26 against this machine's CPython 3.13.5:
            # `threading.Thread.start` wraps its call to `_start_joinable_thread` in
            # `except Exception: ...; raise`, i.e. the standard library itself expects a
            # non-RuntimeError out of it. `RuntimeError("can't start new thread")` is the
            # common failure, but the allocation underneath raises `MemoryError`, which is
            # precisely the condition under which a thread fails to start in the first
            # place. A MemoryError skipped this arm entirely and left the manager in the
            # busy state it had already entered. `Exception` and not `BaseException`, so a
            # KeyboardInterrupt or SystemExit still propagates rather than being rendered
            # to the operator as a repository error.
            except Exception as exc:
                report = (
                    "unparseable", "",
                    "could not start repository trust check: %s"
                    % _exc_detail(exc))
                apply_result(generation, stamp, report, None)
                return self._trust_cache.get(
                    stamp, tuple(report) + (None,))
        return ("checking", "", "Repository trust is still being checked.",
                None)

    # ------------------------------------------------------------------
    # detail
    # ------------------------------------------------------------------
    def show_detail(self, package):
        """Rebuild the datasheet for `package`.

        The order is the order the mockup draws it, and that order is an
        argument: identity first, then the six numbers a person actually
        decides on, then the prose, then the two channels side by side, then
        the hashes. Anything that needs the network (the upload date) is
        filled in later rather than blocking the pane.
        """
        self._ds_clear()
        if package is None:
            empty = ui.vbox(8)
            empty.set_margin_start(18)
            empty.set_margin_end(18)
            empty.set_margin_top(18)
            empty.pack_start(ui.lbl("No package selected.", "note"),
                             False, False, 0)
            if not (self.catalog.get("configured") or {}).get(self.channel):
                empty.pack_start(ui.lbl(
                    "The %s channel is not configured on this machine. Press "
                    "Add channel below and this application will write the "
                    "apt source for it, using the signing key it pins, and "
                    "then run apt update. Nothing is installed or upgraded."
                    % repo.CHANNELS[self.channel]["label"], "note", wrap=True),
                    False, False, 0)
            self.detail_box.pack_start(empty, False, False, 0)
            self.detail_box.show_all()
            # THE PANEL SLIDES AWAY, it does not sit there saying "No package
            # selected." in 432px of black. The empty body above is still
            # built, because a contract reads it and because a channel with no
            # apt source is a state the pane can be opened into deliberately.
            self.detail_reveal.set_reveal_child(False)
            return

        current = repo.candidate(package, self.channel)
        ref, ref_channel = self._reference(package, self.channel)
        stable = repo.candidate(package, "stable")
        beta = repo.candidate(package, "beta")
        state = self._package_state(package)

        # ---- identity -------------------------------------------------
        head = ui.hbox(14)
        head.set_margin_start(18)
        head.set_margin_end(18)
        head.set_margin_top(16)
        head.set_margin_bottom(12)
        head.pack_start(tile(package["name"], package["component"], big=True),
                        False, False, 0)

        column = ui.vbox(3)
        title = ui.cls(ui.lbl(package["name"], "hdr-title"), "repo-ds-name")
        title.set_xalign(0.0)
        title.set_selectable(True)
        column.pack_start(title, False, False, 0)
        summary = ui.cls(
            ui.lbl(package["summary"] or "no summary in the index", "note",
                   wrap=True), "repo-ds-desc")
        summary.set_xalign(0.0)
        column.pack_start(summary, False, False, 0)

        badges = ui.hbox(5)
        badges.set_margin_top(3)
        badges.pack_start(badge(package["component"].upper()), False, False, 0)
        badges.pack_start(badge(STATE_WORD.get(state, state).upper(),
                                "warn" if state == "upgradable" else
                                ("on" if package["installed"] else "dim")),
                          False, False, 0)
        badges.pack_start(
            badge("PINNED TO %s" % package["pinned"].upper() if package["pinned"]
                  else "UNPINNED",
                  "on" if package["pinned"] else "dim"), False, False, 0)
        if current:
            badges.pack_start(
                badge("SIGNED" if current.get("sha256") else "NO HASH",
                      "on" if current.get("sha256") else "warn"),
                False, False, 0)
            if current.get("arch"):
                badges.pack_start(badge(current["arch"].upper(), "dim"),
                                  False, False, 0)
        column.pack_start(badges, False, False, 0)
        head.pack_start(column, True, True, 0)

        # THE ACTIONS SIT ON THEIR OWN ROW, NOT BESIDE THE TITLE. Three buttons
        # packed into the header made that row's MINIMUM width 669px, and a
        # Gtk.Paned adds its children's minimums, so the window could not be
        # dragged below 970 + the 184px sidebar however small its default size
        # was. Measured offscreen against the window the operator named as the
        # standard, `kodachi-command-window network`, whose whole minimum is
        # 825. It is also where that window puts its actions: a row of its own
        # at the foot, never crowded against the heading.
        self.detail_box.pack_start(head, False, False, 0)
        # THE THREE BUTTONS ARE PACKED AT THE FOOT NOW, not under the header.
        # Same reason they left the header row in the first place, taken one
        # step further by the mockup: they are the last thing in the panel, so
        # the sentence saying why one of them is grey and the command line
        # saying what it runs sit directly above the button they are about.
        self._sync_package_buttons(package, state)

        # ---- the six numbers, THREE TO A ROW ---------------------------
        # Six cells in ONE row gave each about 65px in a 392px pane, and every
        # heading rendered as "CANDI...", "INSTA...", "DOWN...": a strip of six
        # numbers where neither the number nor the word was readable. Two rows
        # of three double the width per cell and cost one row of height.
        strip = ui.cls(ui.vbox(0), "repo-metric-strip")
        top = ui.hbox(0)
        bottom = ui.hbox(0)
        # HOMOGENEOUS, or the two rows do not line up. Operator, 2026-08-21,
        # on a1.png, with an arrow drawn between the two rows: "why not
        # alighned ?". `pack_start(cell, True, True, 0)` gives every cell its
        # MINIMUM WIDTH PLUS AN EQUAL SHARE OF WHAT IS LEFT OVER, so a cell
        # whose note reads "Last-Modified of the .deb" claims more minimum
        # than one reading "on this machine", and column 2 of the bottom row
        # starts at a different x than column 2 of the top row. Expand=True
        # equalises the LEFTOVER, never the total, which is exactly why this
        # looked like it should already work. set_homogeneous forces all three
        # columns to one width in both rows, so the grid reads as a grid.
        top.set_homogeneous(True)
        bottom.set_homogeneous(True)
        strip.pack_start(top, False, False, 0)
        strip.pack_start(bottom, False, False, 0)
        self._ds_metric(top, "CANDIDATE",
                        (current or {}).get("version", "not in this channel"),
                        repo.CHANNELS[self.channel]["label"], accent=True)
        self._ds_metric(top, "INSTALLED",
                        package["installed"] or "not installed",
                        "on this machine")
        # `artifact` is the record the size, hash and upload date describe. It
        # is the selected channel's when there is one, and the fallback above
        # otherwise, so the six numbers stay six numbers instead of six "n/a".
        artifact = current or ref
        artifact_channel = self.channel if current else ref_channel
        self._ds_metric(top, "DOWNLOAD",
                        repo.human_size((artifact or {}).get("size")),
                        ("%s on disk"
                         % repo.human_size((artifact or {}).get("installed_size")))
                        if current else
                        ("%s on disk, from %s"
                         % (repo.human_size((artifact or {}).get("installed_size")),
                            ref_channel)) if artifact else "nothing to download")
        synced_value, synced_note, synced_full, synced_sentence = \
            self._index_synced()
        self._ds_metric(bottom, "INDEX SYNCED", synced_value, synced_note,
                        full=synced_full)
        cache_key = "%s|%s" % (artifact_channel,
                              (artifact or {}).get("filename", ""))
        uploaded = self.uploads.get(cache_key)
        upload_failure = self._upload_failed.get(cache_key)
        # A PERSISTED FAILURE IS NOT AN ANSWER. Nothing writes the sentinel to
        # disk any more, but a machine that ran an older build still has one
        # in ~/.cache/kodachi/repo-manager/uploads.json, and that file is
        # never rewritten for a package whose fetch keeps failing. So the
        # sentinel is downgraded to a miss on the first sight of it in a
        # window, which retries the fetch once and then leaves it alone.
        if uploaded == UPLOAD_UNKNOWN and cache_key not in self._upload_tried:
            uploaded = None
        # "checking..." IS A PROMISE THAT A FETCH IS RUNNING. It used to be
        # written whenever the cache was cold, while the fetch below was
        # started only `if uploaded is None and current`, so on a channel with
        # no candidate the cell said "checking..." for as long as the window
        # stayed open and nothing was ever checked. Operator, a2.png: "takes
        # long time". The word is now written only on the path that actually
        # starts a thread.
        if upload_failure:
            upload_cell_value = "upload date unavailable"
        elif uploaded:
            upload_cell_value = short_upload(uploaded)
        elif artifact:
            upload_cell_value = "checking..."
        else:
            upload_cell_value = "no published artifact"
        upload_cell = self._ds_metric(
            bottom, "UPLOADED", upload_cell_value,
            "Last-Modified of the .deb" if current else
            ("Last-Modified in %s" % ref_channel) if artifact else
            "no channel carries this package", full=uploaded)
        # THE CELL IT CAME FROM, never an index into the strip. This read
        # `strip.get_children()[-1]`, which was the UPLOADED cell only while
        # UPLOADED happened to be built last; splitting the strip into two rows
        # would have silently repointed it at DEPENDS, and the live upload date
        # would have been written into the dependency count.
        self._upload_label = upload_cell.get_children()[1]
        # AND THE KEY THAT CELL IS SHOWING, set here and not inside
        # `_fetch_upload`, because a REBUILD does not call `_fetch_upload`
        # (`_upload_tried` already holds the key) and a package with no
        # artifact does not call it either. Setting it only where the thread
        # starts would leave the key naming package A while the label pointed
        # at package B's cell, and A's date would be written into B's row.
        self._upload_key = cache_key
        self._ds_metric(bottom, "DEPENDS", str(len(package["depends"])),
                        "%d recommended" % len(package["recommends"]))
        self.detail_box.pack_start(strip, False, False, 0)
        # THE SAME PREDICATE THE CELL USED, NOT A NARROWER ONE. The cell
        # above writes "checking..." on `not uploaded and artifact`, and this
        # guard used to start the thread on `uploaded is None and artifact`.
        # They agree for every value this code writes, because :2741 stores
        # `value or "unknown (offline)"` and never an empty string. They
        # DISAGREE for an empty string arriving from the on-disk cache, which
        # `read_upload_cache()` parses from ~/.cache/kodachi/repo-manager/
        # uploads.json: the cell would promise "checking..." and no thread
        # would ever run, for as long as the window stayed open. That is
        # exactly the a2.png complaint ("takes long time") that the comment
        # above this cell says was already fixed once, surviving in the one
        # state where the two conditions differ. Two predicates for one
        # question is the defect; making them the same expression is the fix.
        if (not uploaded and not upload_failure and artifact
                and cache_key not in self._upload_tried):
            self._fetch_upload(cache_key, artifact, self._upload_label,
                               artifact_channel)

        # ---- the four tab bodies ---------------------------------------
        # ALL FOUR ARE BUILT, EVERY TIME, and the Stack shows one. Building
        # only the open tab would make every section conditional on a click,
        # so a contract walking `detail_box` would see whatever tab happened
        # to be open and read a missing section as a missing feature. It also
        # means switching tab is free and restarts no fetch.
        self.detail_box.pack_start(self.ds_tabbar, False, False, 0)
        self.ds_tabs = Gtk.Stack()
        self.ds_tabs.set_transition_type(Gtk.StackTransitionType.NONE)
        # A Stack asks for the LARGEST of its children on both axes by
        # default, so the 38 chip Dependencies body would set the height and
        # the width of the About body as well.
        self.ds_tabs.set_hhomogeneous(False)
        self.ds_tabs.set_vhomogeneous(False)
        self.detail_box.pack_start(self.ds_tabs, True, True, 0)

        def tab_body(name):
            box = ui.vbox(0)
            box.set_margin_start(18)
            box.set_margin_end(18)
            box.set_margin_bottom(16)
            self.ds_tabs.add_named(box, name)
            return box

        about = tab_body("about")
        tech = tab_body("tech")
        integrity = tab_body("int")
        depends = tab_body("dep")

        # ---- ABOUT: what it is for, and where the words came from -------
        if package["curated"]:
            self._ds_section(about, "WHAT YOU GET")
            self._ds_body(about, package["benefit"])
            self._ds_section(about, "WHEN TO USE IT")
            self._ds_body(about, package["usecase"])
            # The maintainer's own text is kept even when there is a curated
            # blurb, under its own heading, because the two say different
            # things and the mockup shows both.
            self._ds_section(about, "PACKAGE DESCRIPTION")
            self._ds_body(about, package["description"] or package["summary"]
                          or "the index carries no description")
        else:
            self._ds_section(about, "PACKAGE DESCRIPTION, AS THE MAINTAINER WROTE IT")
            self._ds_body(about, package["description"] or package["summary"] or
                          "the index carries no description")

        self._ds_section(about, "SOURCE")
        self._ds_body(about, "%s\n%s\nindex Date: %s\nread from %s\nsection %s"
                      # TWO CONVENTIONS FOR A MISSING FIELD, ONE LINE APART.
                      # The maintainer slot admits the absence; the homepage
                      # slot used to put the REPOSITORY url in the space
                      # reserved for the project's own page, unmarked, and
                      # two lines below that this same block already prints
                      # `read from <index path>`, so the substitution answered
                      # a question the block answers again anyway. Found by
                      # <agent> 2026-08-22, B3.
                      % (package["maintainer"] or "no maintainer in the index",
                         package["homepage"] or "no homepage in the index",
                         self.catalog["dates"].get(self.channel) or synced_sentence,
                         (current or {}).get("index_path",
                                             self.catalog["lists_dir"]),
                         (artifact or {}).get("section") or "unknown"))

        # ---- VERSION & DATES: the two channels, then the timestamps -----
        self._ds_section(tech, "CHANNEL COMPARISON")
        cards = ui.hbox(10)
        # Same reason as the metric strip above: the STABLE card and the BETA
        # card carry different version strings, so without this the divider
        # between them sits off centre and the two cards are visibly unequal.
        cards.set_homogeneous(True)
        cards.set_margin_top(4)
        for key, entry, alt in (("stable", stable, False), ("beta", beta, True)):
            cards.pack_start(self._channel_card(package, key, entry, alt),
                             True, True, 0)
        tech.pack_start(cards, False, False, 0)
        if stable and beta and stable["version"] != beta["version"]:
            self._ds_body(tech,
                          "The two channels carry different versions, so "
                          "switching channel changes the installed build. apt "
                          "will report it as an upgrade or a downgrade "
                          "depending on direction, and beta is not always "
                          "ahead of stable.")
        elif stable and beta and stable["sha256"] == beta["sha256"]:
            self._ds_body(tech,
                          "Both channels ship a byte identical artifact, so "
                          "switching channel changes nothing for this package.")

        # THE DEV CHANNEL IS NOT ONE OF THE TWO CARDS, and it is not nothing
        # either. The comparison above is stable against beta, because those
        # are the two a switch can move between; dev is shown when it
        # publishes this package. What is said about it is now read off this
        # machine rather than recited: see the block below.
        dev = repo.candidate(package, "dev")
        if dev:
            self._ds_section(tech, "DEV CHANNEL")
            # F2's DEFECT AGAIN, WITH A DIFFERENT CONSTANT. This block used to
            # append DEV_REFUSAL, which asserts a fact about THIS MACHINE ("no
            # credentials are stored on this machine yet") without consulting
            # anything on it. The branch's own precondition usually makes that
            # sentence FALSE: `candidate(package, "dev")` is built from
            # `index_files("dev")` (kodachi_repo.py load_channel), i.e. a dev
            # Packages index sitting in apt lists here, and a Basic-Auth
            # protected repo can only have been fetched with working
            # credentials. So the success path ended "enter credentials, apt
            # update, open the package, and be told to go enter the
            # credentials you just entered". Found by <agent>
            # 2026-08-22, A3, off my own pointer at the other three tabs.
            # The same window already answers this with the real predicate in
            # the sidebar and in the ds_cmd gate; this was the third site and
            # the only recited one.
            if dev_auth_file_present():
                # NOT "your credentials work". `dev_auth_file_present()`
                # proves a non-empty file exists and nothing more, which is
                # the same bound the sidebar states, so the sentence claims
                # only what the predicate can see.
                stance = ("An auth file for it is present at %s, which is why "
                          "apt could fetch this index at all. That file "
                          "existing is not proof the credentials still work: "
                          "a truncated stanza satisfies the same check and "
                          "still returns 401." % DEV_AUTH_FILE)
            else:
                stance = ("There is no auth file at %s, so this dev index is "
                          "left over: apt fetched it when there was one and "
                          "the credentials have since been cleared. Open "
                          "CHANNELS in the sidebar and press Dev credentials "
                          "to enter them again." % DEV_AUTH_FILE)
            self._ds_body(tech, "%s is published in %s. %s"
                          % (dev["version"], repo.CHANNELS["dev"]["url"],
                             stance))

        # THE DUPLICATE IS SHOWN, NOT DISCARDED. P1, <agent>
        # 2026-08-21: a package published in two components of one channel
        # used to be collapsed to whichever component sorted LAST, so main
        # carrying 9.9 and thirdparty carrying 1.0 showed 1.0 and the main
        # entry was gone with no error and no count. load_channel now keeps
        # the higher version, which is what apt would select, and hands the
        # loser here. Drawn only when there IS one, because a duplicate is
        # worth saying precisely because it is unusual.
        if (artifact or {}).get("also_in"):
            self._ds_section(tech, "ALSO PUBLISHED IN")
            self._ds_body(tech, "\n".join(
                "%s carries version %s of this package. The datasheet above "
                "describes %s from %s, which is the higher version and the "
                "one apt would install."
                % (other["component"], other["version"],
                   artifact["version"], artifact["component"])
                for other in artifact["also_in"]))

        self._ds_section(tech, "VERSION AND DATES")
        # NO "RELEASED" ROW. The mockup draws one, and the real apt index has
        # no field behind it: a Packages stanza carries no release date, only
        # the pool file's Last-Modified, which is the UPLOADED row below. A
        # row that would read "unknown" for every package on every machine is
        # a placeholder shown as a fact, which is the exact defect
        # `_index_synced` was rewritten to remove, so it is left out rather
        # than filled with a word.
        self._ds_hash(tech, "CANDIDATE VERSION",
                      (artifact or {}).get("version") or "not published")
        # THE MIDDLE FALLBACK USED TO BE `(artifact or {}).get("uploaded")` AND
        # IT COULD NEVER CONTRIBUTE ANYTHING. A parsed channel record carries
        # twenty keys and `uploaded` is not one of them, so that disjunct was
        # always falsy: it read as a second source for this date and was
        # nothing of the kind. Same missing key that made the `Newest` chip an
        # identity permutation (<agent> 2026-08-21); found here by an
        # AST sweep for the CLASS, comparing every record-shaped key the window
        # reads against every key the parser and the window write. Two hits in
        # the file, both this key, both now gone.
        self._ds_hash(tech, "UPLOADED TO THE POOL",
                      uploaded
                      or ("checking..." if artifact else "no published artifact"))
        self._ds_hash(tech, "INDEX SYNCED", synced_sentence)
        self._ds_hash(tech, "ARCHITECTURE / SECTION",
                      "%s  \u00b7  %s" % ((artifact or {}).get("arch") or "unknown",
                                          (artifact or {}).get("section") or "unknown"))

        # ---- INTEGRITY ---------------------------------------------------
        # DRAWN FROM THE REFERENCE RECORD WHEN THE CHANNEL HAS NONE. Operator,
        # a2.png: "where is the hash". A hash is a property of a published
        # .deb, not of the radio button at the top of the window, so hiding it
        # because DEV is selected removed the one thing on the page a user
        # would paste somewhere. The heading says which channel the bytes are
        # from, and a line below says why it is not the selected one.
        if not artifact:
            self._ds_body(integrity,
                          "No channel on this machine carries a build of %s, "
                          "so there is no artifact anywhere to hash."
                          % package["name"])
        else:
            self._ds_section(integrity, "INTEGRITY, %s ARTIFACT"
                             % artifact_channel.upper())
            if not current:
                self._ds_body(integrity,
                              "%s publishes no build of this package on this "
                              "machine, so the hashes below are the %s "
                              "artifact. They are what apt would verify if you "
                              "switched to %s."
                              % (repo.CHANNELS[self.channel]["label"],
                                 artifact_channel, artifact_channel))
            for key, value in (("SHA256", artifact["sha256"]),
                               ("SHA1", artifact["sha1"]),
                               ("MD5", artifact["md5"])):
                self._ds_hash(integrity, key, value)

            # REPOSITORY TRUST REPORTS THE MACHINE, NOT THE SOURCE CODE.
            # This block used to print the pinned constant under this heading
            # and say the application pins its key, both of which are true of
            # the CODE and neither of which was ever checked against the file
            # apt honours. Now the keyring is read and judged, and the two
            # fingerprints are shown side by side so a disagreement is
            # visible rather than described.
            trust = self._observed_repository_key(artifact_channel)
            state, observed, detail = trust[:3]
            usable = trust[3] if len(trust) > 3 else None
            self._ds_section(integrity, "REPOSITORY TRUST")
            # NOT "InRelease is signed", WHICH WAS ITSELF A RECITAL. apt
            # refuses to write an index it could not verify, and this page is
            # read out of that index, so the signature check is a fact ABOUT
            # THIS MACHINE derivable from the page existing at all. Saying so
            # is the difference between a claim and its evidence.
            self._ds_body(integrity,
                          "apt verified the InRelease signature before it "
                          "wrote the index this page is read from. %s" % detail)
            self._ds_hash(
                integrity, "PINNED KEY",
                fingerprint_groups(repo.REPO_FINGERPRINT),
                copy_value=repo.REPO_FINGERPRINT.replace(" ", "").upper())
            # THE LABEL COUNTS EXACTLY WHAT THE ROW PRINTS, and it is derived
            # from the value rather than from the state, so the two can never
            # disagree. A keyring with more than one primary key prints them
            # all: printing only the first drew two identical rows under a
            # heading whose comment promises a visible disagreement.
            # "not readable" IS ALSO NOT WHAT ABSENT MEANS, and the four
            # non-key states end up in different places: a missing file, a
            # file this process cannot open, a file gpg cannot parse, and a
            # file that parsed into the wrong key. Collapsing them sends a
            # user to fix a corrupt keyring that is not there, or to fix a
            # file mode on bytes that are actually corrupt.
            # THE SINGULAR LABEL USED TO IMPLY A KEY THAT IS NOT THERE. With
            # zero observed keys the old `else` printed "KEY ON THIS MACHINE",
            # so all four zero-key states (absent, unreadable, unparseable,
            # no-keys) announced a key and then printed a sentence saying
            # there was not one. Three branches, because one, several and none
            # are three different facts.
            observed_keys = [f for f in observed.split("\n") if f]
            if len(observed_keys) == 1:
                key_row = "KEY ON THIS MACHINE"
            elif observed_keys:
                key_row = "KEYS ON THIS MACHINE (%d present)" % len(observed_keys)
            else:
                key_row = "KEYS ON THIS MACHINE (none present)"
            self._ds_hash(integrity, key_row,
                          fingerprint_groups(observed) if observed else {
                              "absent": "no keyring installed",
                              "unreadable": "could not be read",
                              "no-keys": "no primary key in the file",
                              # WRITTEN OUT, NOT LEFT TO THE FALLBACK. This
                              # dict used to name three states and let
                              # `unparseable` fall through to the default,
                              # which meant the default was doing double duty
                              # as real wording AND as the catch-all, so
                              # nothing could tell an unworded state from a
                              # worded one. That is the same "write the
                              # wording, do not widen the fallback" rule this
                              # window already states one dict below, and it
                              # is what lets the contract DERIVE which states
                              # this dict owes a sentence to instead of
                              # carrying a hand-written exemption.
                              # "gpg cannot read" and not "unreadable":
                              # gpgv may well read it, see the paragraph
                              # below. The row must not imply a verdict the
                              # window has not got.
                              "unparseable": "not a keyring gpg can read",
                              "source-binding": "official source binding refused",
                              "checking": "checking repository key",
                          }.get(state,
                                "no wording here for the state the keyring "
                                "check returned (%r)" % state),
                          copy_value=observed or None)
            if state != "pinned":
                self._ds_body(integrity, {
                    # NOT "the key here is NOT the pinned one". For extra-keys
                    # one of them USUALLY IS, and saying otherwise is a claim
                    # the rows above visibly contradict.
                    "extra-keys":
                        "apt honours EVERY key in that file, so the pinned "
                        "one being among them is not protection: an InRelease "
                        "signed by any of the others verifies just as well. "
                        "Run an install or a channel change and the "
                        "privileged helper will re-judge the keyring and "
                        "replace it with the pinned key alone.",
                    "mismatch":
                        "The key apt honours here is NOT the key this "
                        "application pins. Anything installed from the "
                        "repository was verified against that key, not "
                        "against the pinned one. Run an install or a channel "
                        "change and the privileged helper will re-judge the "
                        "keyring and replace it.",
                    "source-binding":
                        "The enabled official source is not bound to the "
                        "canonical Kodachi keyring. The privileged helper "
                        "will refuse update, install and channel changes "
                        "until Signed-By names %s." % ARCHIVE_KEYRING,
                    "absent":
                        "There is no Kodachi keyring at %s to judge, so "
                        "nothing here is a statement about what apt would "
                        "accept." % ARCHIVE_KEYRING,
                    "unreadable":
                        "The file is there and this window could not open it, "
                        "which is a permission problem and not a corrupt key: "
                        "the helper installs it at 0644 and something has "
                        "changed that. apt runs as root and is unaffected, so "
                        "nothing here is a statement about what apt would "
                        "accept.",
                    # THIS PARAGRAPH USED TO MAKE A CLAIM ABOUT apt AND THE
                    # CLAIM WAS FALSE IN THE REASSURING DIRECTION. It said the
                    # key "is corrupt or truncated", which the operator reads
                    # as "the update is broken". apt does not verify with gpg.
                    # It verifies with GPGV, and gpgv's keyring reader is more
                    # permissive than gpg's: measured 2026-08-22 by
                    # <agent> and reproduced independently by me on
                    # this host with gpg/gpgv 2.4.7, two throwaway ed25519
                    # keys and both controls, a single 7-byte 0xCA marker
                    # packet spliced between two keys makes
                    # `gpg --show-keys` report ZERO primaries and exit 2 while
                    # gpgv VERIFIES a signature out of the same file. So for
                    # that shape the true statement is the opposite of the old
                    # one: apt would trust a key this window cannot show and
                    # never compared against the pin.
                    #
                    # THIS PARAGRAPH IS THE FALLBACK NOW, NOT THE ANSWER.
                    # A previous version of this comment said the gpgv probe
                    # "does not work: 4 of 4 identical, so it separates
                    # nothing", and I committed that. It was wrong, and it
                    # was wrong in the direction that closes a question:
                    # `gpgv --keyring <path> /dev/null /dev/null` returns the
                    # same rc=2 for every input because gpgv reads the
                    # SIGNATURE first and dies before it ever loads the
                    # keyring. Given a REAL inline-signed document the same
                    # probe separates cleanly, both directions, both controls
                    # behaving (<agent>, six fixtures, 2026-08-22).
                    # `apt_parser_can_use_keyring` above now asks it against
                    # the `_InRelease` apt already refreshed into
                    # /var/lib/apt/lists, so there is no shipped fixture and
                    # no new network call, and a sentence naming gpgv's
                    # verdict is appended below when the answer exists.
                    #
                    # When it does not exist, which is a machine that has
                    # never updated or is on another channel, this paragraph
                    # stands alone and UNKNOWN is still the honest word. So
                    # the wording below is unchanged on purpose: it is what a
                    # reader gets when the probe cannot be run, and it must
                    # keep being true on its own.
                    "unparseable":
                        "The file is there and readable, and gpg refuses "
                        "these bytes, so this window cannot tell you what is "
                        "inside it. That is NOT the same as apt refusing it: "
                        "apt verifies with gpgv, whose reader accepts some "
                        "files gpg rejects, so a keyring in this state can "
                        "still be one apt is happily trusting. Treat this as "
                        "UNKNOWN rather than as broken. Run an install or a "
                        "channel change and the privileged helper will "
                        "replace it with the pinned key, which is the only "
                        "way to turn this back into an answer.",
                    "no-keys":
                        "gpg read this file without complaint and found no "
                        "primary key in it, which is what a secret-key "
                        "export, a detached signature or a truncated fetch "
                        "looks like. apt has nothing to verify with, so it "
                        "fails closed rather than accepting anything: this is "
                        "an update that will not work, not an update that is "
                        "unsafe. Run an install or a channel change and the "
                        "privileged helper will reinstall the pinned key.",
                    "checking":
                        "The repository key and apt's verifier are being "
                        "checked in the background. This pane will refresh "
                        "when the result is available.",
                # `.get`, NOT `[state]`, AND IT IS THE SAME DEFENCE ALREADY
                # STANDING ELEVEN LINES UP. Two lookups on one variable with
                # two conventions is the coupling, not the crash: today the
                # judge returns exactly six states and five of them are keys
                # here, so nothing fires. Add a seventh, which is a one-line
                # change in a function whose entire design is "more states,
                # said precisely", and a KeyError raises inside
                # `_render_detail`, so the WHOLE datasheet disappears rather
                # than one sentence. Found by <agent> 2026-08-22, B1.
                # The fallback is deliberately an admission and not a guess:
                # a pane that invents wording for a state nobody wrote is the
                # recital defect this whole block was rewritten to remove.
                }.get(state,
                      "This window has no wording for the state the keyring "
                      "check returned (%r), so read the line above rather "
                      "than this one." % state))

            # ASK THE ACTUAL CONSUMER, but only in the one state where gpg
            # and gpgv are known to disagree. Every other state has already
            # been decided by a parser that read the file successfully, and
            # running a subprocess here would be paid on every datasheet
            # rebuild, which is every keystroke of the search box.
            if state == "unparseable":
                self._ds_body(integrity, {
                    True:
                        "GPGV, WHICH IS WHAT apt ACTUALLY VERIFIES WITH, "
                        "reads this file and accepts the signature on the "
                        "index apt last fetched. So the repository is "
                        "working and the unreadable-to-gpg bytes above are "
                        "not stopping it. What this does NOT say is that the "
                        "key is the pinned one: gpgv was asked whether it "
                        "can use the keyring, not whose key is in it, and "
                        "this window could not make that comparison because "
                        "gpg would not parse the file.",
                    False:
                        "GPGV, WHICH IS WHAT apt ACTUALLY VERIFIES WITH, "
                        "also refuses this file against the index apt last "
                        "fetched. Both parsers agree, so this is a keyring "
                        "no update can use and the failure is closed rather "
                        "than silent.",
                    None:
                        "GPGV IS WHAT apt ACTUALLY VERIFIES WITH, and it "
                        "could not be asked here: that question needs an "
                        "inline-signed index in /var/lib/apt/lists and this "
                        "machine has none for this channel. Run an update "
                        "and this line becomes an answer.",
                }[usable])

            self._ds_section(integrity, "POOL LOCATION")
            self._ds_body(integrity,
                          repo.CHANNELS[artifact_channel]["url"] + "/"
                          + artifact["filename"])

            # THE OTHER CHANNEL'S ARTIFACT, and only when there are two to
            # compare. Reading `current["sha256"]` here would throw on every
            # package the shown channel does not publish, which is precisely
            # the state the reference fallback above exists for: the fallback
            # is what makes that dereference reachable.
            other_key = "beta" if artifact_channel == "stable" else "stable"
            other = repo.candidate(package, other_key)
            if other and current:
                self._ds_section(integrity, "THE OTHER CHANNEL'S ARTIFACT")
                self._ds_hash(integrity, "SHA256 \u00b7 %s" % other_key,
                              other["sha256"])
                self._ds_body(
                    integrity,
                    "Byte identical across both channels."
                    if artifact["sha256"] == other["sha256"] else
                    "A different artifact, so a channel switch really does "
                    "replace the build.")
            elif not current:
                self._ds_body(integrity,
                              "%s carries no artifact for this package, so "
                              "there is nothing here to compare against."
                              % repo.CHANNELS[self.channel]["label"])
            else:
                # THE FOURTH CASE, AND IT USED TO SAY NOTHING AT ALL. The
                # three others each get a sentence, so a reader who lands on
                # this one sees a POOL LOCATION row naming a single channel
                # and then blank space, which is the only one of the four
                # they cannot tell from a rendering fault. The opposite case
                # is spelled out directly above, so this was an asymmetry in
                # the block's own convention rather than a missing feature.
                # Found by <agent> 2026-08-22, B2.
                self._ds_body(integrity,
                              "%s publishes no build of this package, so "
                              "there is no second artifact to compare "
                              "against and the hashes above are the only "
                              "ones that exist."
                              % repo.CHANNELS[other_key]["label"])

        # ---- DEPENDENCIES ------------------------------------------------
        # A tab of their own, which is what the split buys: codium declares 38
        # and at full width that is nineteen rows of chips, and they used to
        # be printed in the same scroll as the hashes.
        self._ds_section(depends, "DEPENDENCIES (%d)" % len(package["depends"]))
        if package["depends"]:
            depends.pack_start(self._chip_flow(package["depends"]),
                               False, False, 0)
            self._ds_body(depends,
                          "Hover a chip for the version constraint the "
                          "package declares. A chip ending in +2 means the "
                          "index offers 2 other packages the installer will "
                          "accept instead of the one named, and the tooltip "
                          "lists them.")
        else:
            self._ds_body(depends,
                          "none declared, this package installs standalone")
        if package["recommends"]:
            self._ds_section(depends, "RECOMMENDS (%d)"
                             % len(package["recommends"]))
            depends.pack_start(self._chip_flow(package["recommends"]),
                               False, False, 0)

        # THE FIXED FOOT IS PACKED ONCE, IN _detail(), INTO THE PANEL BESIDE
        # THE SCROLLER. It used to be packed here, into detail_box, which is
        # the scroller's child, so it scrolled away under long content. What
        # remains here is only the DECISION about what the command line says.
        if self.channel == "dev" and not dev_auth_file_present():
            # C4 again: printing the command is a promise, so it is printed
            # only when the command could actually run. Without the stored
            # stanza apt 401s before it reaches the package.
            self._set_ds_cmd(DEV_REFUSAL.strip(), False)
        elif not current:
            # THE SECOND MEMBER OF THAT CLASS, and the gate above reached only
            # the first. `install.set_sensitive(bool(current))` greys the
            # button and the reason row directly above already says this
            # channel publishes no build of the package, so printing "what the
            # button runs: install it from stable" underneath was the pane
            # contradicting itself in adjacent rows. Found by
            # <agent> 2026-08-21: a principle written beside one
            # branch is about the CLASS, and this one had reached one of two
            # members. The greyed button was the honest half.
            # AND IT SPLITS THE SAME TWO WAYS THE REASON ROW SPLITS, because
            # "this channel publishes no build" and "this channel is not set
            # up here" are different facts with different remedies, and
            # `candidate()` returns None for both. Printing the first when the
            # second is true sends a user hunting a package that is there.
            label = repo.CHANNELS[self.channel]["label"]
            if not (self.catalog.get("configured") or {}).get(self.channel):
                self._set_ds_cmd(
                    "%s is not configured on this machine, so there is no "
                    "index to install %s from. Open CHANNELS in the sidebar "
                    "to enable it." % (label, package["name"]), False)
            else:
                other = self._reference(package, self.channel)[1]
                elsewhere = (" Switch the channel above to %s to install it."
                             % repo.CHANNELS[other]["label"]) if other else ""
                self._set_ds_cmd(
                    "%s publishes no build of %s, so there is nothing to "
                    "install from it.%s" % (label, package["name"], elsewhere),
                    False)
        else:
            self._set_ds_cmd("pkexec %s install %s %s"
                             % (helper_path(), package["name"], self.channel),
                             True)

        self.detail_box.show_all()
        # Gtk.Stack chooses its first visible child during show_all(). Restore
        # the persistent radio state AFTER that visibility pass, or any search,
        # sort, filter, channel change, reload, or reselection that rebuilds the
        # datasheet displays About under a still-active Dependencies tab.
        self.ds_tabs.set_visible_child_name(self.ds_tab)
        self.detail_reveal.set_reveal_child(True)

    def _set_ds_cmd(self, text, is_command):
        """Fill the pinned foot, and make the caption and the face agree.

        `repo-mono` is the monospace class, and it belongs on a command and
        on nothing else: prose set in a terminal face reads as something you
        could paste, which is exactly the promise C4 says a printed command
        makes. The caption changes with it, so the box never announces a
        command it does not contain.
        """
        self.ds_cmd.set_text(text)
        self.ds_cmd_caption.set_text("WHAT THE BUTTON RUNS" if is_command
                                     else "WHY THERE IS NOTHING TO RUN")
        style = self.ds_cmd.get_style_context()
        if is_command:
            style.add_class("repo-mono")
        else:
            style.remove_class("repo-mono")

    def _index_synced(self):
        """What INDEX SYNCED honestly reads, per channel state.

        Found by the sweep that reproduces the operator's own method on a1
        and a2. The cell used to read `unknown` under the note
        `signed Release`, which asserts that a signed Release exists and this
        window merely failed to read it. On a machine set up the documented
        way that is false twice over: dev is not a source at all, so there is
        no Release file to read and never was. `unknown` is a placeholder
        shown as a fact, which is the first shape he caught.

        Three distinct states, three distinct sentences, and none of them is
        "unknown". Returns (cell value, cell note, tooltip, full sentence for
        the SOURCE block).
        """
        stamp = self.catalog["dates"].get(self.channel)
        if stamp:
            return short_date(stamp), "signed Release", stamp, stamp
        label = repo.CHANNELS[self.channel]["label"]
        if not (self.catalog.get("configured") or {}).get(self.channel):
            reason = ("%s is not a source on this machine, so apt has never "
                      "fetched its Release file" % label)
            return "not configured", "no source for %s" % label, reason, reason
        reason = ("%s is a source but apt has not fetched its Release file "
                  "yet" % label)
        return "never synced", "run CHECK FOR UPDATES", reason, reason

    def _chip_flow(self, names):
        """A dense flow of dependency chips.

        The chip carries the bare package name and the version constraint goes
        to the tooltip. Rendering "libatk-bridge2.0-0 (>= 2.5.3)" inline makes
        every chip wide enough that only two fit per line, which is what turned
        a 38 entry list into nineteen rows on the VM render.
        """
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(8)
        flow.set_min_children_per_line(3)
        flow.set_homogeneous(False)
        flow.set_row_spacing(4)
        flow.set_column_spacing(4)
        for name in names:
            short = name.split(" (")[0].split(" |")[0].strip() or name
            # AN ALTERNATIVE IS NOT A NARROWER DEPENDENCY, AND THE CHIP USED
            # TO CLAIM IT WAS. `systemd | systemd-standalone-sysusers |
            # systemd-sysusers` drew a chip reading `systemd` alone, which is
            # the pane being MORE SPECIFIC than the index it read: the
            # package is equally happy with any of the three. The full string
            # was in the tooltip, but the prose under the flow only offers a
            # version constraint as a reason to hover, so a reader looking at
            # a version-free chip had no cue that one existed.
            # MEASURED BEFORE ADOPTING IT, on <lab-host>: 3 of 9
            # `Depends:` lines in the stable apps index carry an alternative,
            # plus 1 of 4 `Recommends:` in main, so this is live on codium,
            # gitkraken, librewolf and kodachi-hooks-core rather than
            # theoretical. Found by <agent> 2026-08-22, B4.
            # The marker is a COUNT rather than the joined names because the
            # joined form reaches 67 characters here, and chip width is the
            # whole reason the constraint went to the tooltip to begin with.
            alternatives = len([a for a in name.split("|") if a.strip()]) - 1
            widget = chip("%s  +%d" % (short, alternatives)
                          if alternatives > 0 else short)
            if short != name:
                widget.set_tooltip_text(name)
            flow.add(widget)
        return flow

    def _sync_package_buttons(self, package, state):
        """Label the three header buttons for the package actually selected.

        A fixed "Install" over a package that is already installed and current
        is the window telling him something untrue about his own machine.
        """
        # SENSITIVITY IS DECIDED BY WHAT THE ACTION CAN DO, NOT BY THE CHANNEL
        # NAME. `self.channel != "dev"` left Install live on STABLE for a
        # package stable does not publish, so pressing it ran an apt install
        # that could only fail, and it disabled Install on DEV even once dev
        # was configured and carrying the package. The question both buttons
        # actually need answered is "is there a candidate in the selected
        # channel", which is `current`.
        current = repo.candidate(package, self.channel)
        configured = self.catalog.get("configured") or {}
        # AN ENABLED BUTTON IS A PROMISE, WHICH IS THE MIRROR OF THE RULE THE
        # COMMAND ROW ALREADY FOLLOWS. `_set_ds_cmd` refuses to print a command
        # for dev with no stored credential, and `_on_install` refuses to run
        # one, so the pane said "no credentials are stored" in the command row
        # while the Install button beside it stayed live, and pressing it wrote
        # the same refusal into the log. Every other member of this class was
        # already handled (`channel_setup` at the strip, the other-channel card
        # button), so this was the one member the principle had not reached.
        # Found by <agent> 2026-08-22 as the second half of their §3.
        dev_locked = self.channel == "dev" and not dev_auth_file_present()
        reasons = []
        # NO DEFAULT. `configured_channels()` returns keys ONLY for channels
        # that have a source, so an absent key IS "not configured", and a
        # `, True` default asserted the opposite for exactly the case this
        # reason was written for: on a machine with stable and beta sources
        # and no dev source, `.get("dev", True)` returned True and the
        # sentence explaining why the dev buttons are grey never appeared.
        # Found by the state sweep, not by reading the diff.
        if not configured.get(self.channel):
            reasons.append("%s is not configured on this machine yet. Open "
                           "CHANNELS in the sidebar to enable it."
                           % repo.CHANNELS[self.channel]["label"])
        elif dev_locked:
            # BEFORE `not current`, DELIBERATELY. Dev is Basic-Auth protected,
            # so on a machine with no stored stanza the index is never fetched
            # and `current` is None for EVERY package. Ordered the other way
            # round this state would report "dev publishes no build of foo",
            # which is a claim about the repository derived from a fact about
            # this machine, and it sends the reader hunting a package that is
            # there.
            reasons.append(DEV_REFUSAL.strip())
        elif not current:
            other = self._reference(package, self.channel)[1]
            reasons.append(
                "%s publishes no build of %s%s."
                % (repo.CHANNELS[self.channel]["label"], package["name"],
                   ", but %s does" % other if other else ""))
        install = self.buttons.get("install")
        if install is not None:
            if state == "upgradable":
                install.set_label("Upgrade")
                action_tip = ("Upgrade %s to the newer %s candidate."
                              % (package["name"], self.channel))
            elif state == "downgrade":
                install.set_label("Downgrade")
                action_tip = ("Downgrade %s to the older %s candidate. "
                              "You will be asked to confirm first."
                              % (package["name"], self.channel))
            elif package["installed"]:
                install.set_label("Reinstall")
                action_tip = ("Reinstall the current %s build of %s."
                              % (self.channel, package["name"]))
            else:
                install.set_label("Install")
                action_tip = ("Install %s from the %s channel."
                              % (package["name"], self.channel))
            ui.set_row_tooltip(install, action_tip)
            self._set_action_sensitive(
                install, bool(current) and not dev_locked)
        remove = self.buttons.get("remove")
        if remove is not None:
            self._set_action_sensitive(
                remove, bool(package["installed"]))
            # NO REASON LINE FOR "not installed". It was written here first and
            # it is noise: it fires on every available package, which is the
            # ordinary case, and the row's own state badge already says
            # AVAILABLE two inches away. A reason that appears almost always
            # stops being read, and then the reason that MATTERS, the one about
            # a channel that does not publish this package, arrives in a slot
            # the eye has learned to skip. The label earns its place by being
            # empty most of the time.
        switch = self.buttons.get("switch")
        if switch is not None:
            # SWITCH IS ABOUT THE OTHER CHANNEL, so its own candidate decides.
            # On DEV the old code named STABLE as "the other channel" only by
            # accident of the ternary, and then disabled the button anyway.
            other = switch_target(package)
            switch.set_label("Switch to %s" % other)
            self._set_action_sensitive(
                switch, bool(repo.candidate(package, other)))
        hold = self.buttons.get("hold")
        if hold is not None:
            held = bool(package.get("held"))
            hold.set_label("Resume updates" if held else "Hold updates")
            ui.set_row_tooltip(
                hold,
                ("Let apt update %s again." if held else
                 "Keep %s at its installed version while other packages update.")
                % package["name"])
            self._set_action_sensitive(hold, bool(package["installed"]))
        if getattr(self, "ds_reason", None) is not None:
            self.ds_reason.set_text(reasons[0] if reasons else "")
            self.ds_reason.set_visible(bool(reasons))

    def _channel_card(self, package, key, entry, alt):
        """One side of the CHANNEL COMPARISON block."""
        card = ui.cls(ui.vbox(3), "repo-chan-card")
        if alt:
            card.get_style_context().add_class("repo-chan-card-alt")
        head = ui.hbox(6)
        name = ui.cls(ui.lbl(repo.CHANNELS[key]["label"].upper(), "note"),
                      "repo-ds-section")
        name.set_xalign(0.0)
        head.pack_start(name, True, True, 0)
        if self.channel == key:
            head.pack_end(badge("SHOWING", "dim"), False, False, 0)
        card.pack_start(head, False, False, 0)

        version = ui.cls(ui.lbl(entry["version"] if entry else "not published",
                                "note"),
                         "repo-chan-ver-alt" if alt else "repo-chan-ver")
        version.set_xalign(0.0)
        version.set_selectable(True)
        card.pack_start(version, False, False, 0)
        if entry:
            card.pack_start(mono("%s  \u00b7  %s"
                                 % (repo.human_size(entry["size"]),
                                    (entry["sha256"] or "no hash")[:16])),
                            False, False, 0)
            button = ui.cls(Gtk.Button(label="Install this build"),
                            "ghost", "chip")
            button.kodachi_privileged_action = True
            button.kodachi_catalog_dependent = True
            ui.set_row_tooltip(
                button,
                "Show the %s channel and install %s from it. If it is older "
                "than what is installed apt reports a downgrade, and this "
                "window does not hide that."
                % (repo.CHANNELS[key]["label"], package["name"]))
            button.connect("clicked", self._on_card_install, key)
            self._set_action_sensitive(
                button, key != "dev" or dev_auth_file_present())
            card.pack_start(button, False, False, 0)
        else:
            card.pack_start(ui.lbl("this package is not in that channel",
                                   "note", wrap=True), False, False, 0)
        return card

    def _on_card_install(self, _button, key):
        """Switch to that channel first, then install from it.

        Installing "from the other card" without moving the window there would
        leave every other panel describing a channel the install did not use.
        """
        self.set_channel(key)
        self._on_install(None)

    @staticmethod
    def _reference(package, exclude):
        """The channel record the datasheet falls back to, and its channel key.

        Operator, 2026-08-21, on a2.png with DEV selected and four separate
        arrows: "why all n/a", "where is purpose", "where is the hash", "takes
        long time". All four are ONE root cause. DEV publishes no index on this
        machine, so `candidate(package, "dev")` is None, and every block that
        opened with `if current:` drew nothing: no size, no SHA256, no pool
        URL, and an UPLOADED cell stuck on "checking..." forever because the
        fetch is only started when there is a filename to fetch.

        The facts did not stop existing when the channel selector moved. The
        package is still published, still installed, still has a hash. So the
        datasheet shows the record from a channel that DOES carry it, and says
        which one, rather than showing "n/a" six times and looking broken.
        Returns (None, "") only if no channel carries the package at all.
        """
        for key in ("stable", "beta", "dev"):
            if key == exclude:
                continue
            entry = repo.candidate(package, key)
            if entry:
                return entry, key
        return None, ""

    def _fetch_upload(self, cache_key, entry, label, channel=None):
        # THE CHANNEL IS AN ARGUMENT, not self.channel. The reference record
        # above can come from a channel other than the selected one, and
        # fetch_upload_date builds the URL from the channel, so reading
        # self.channel here would have asked the DEV pool for a STABLE .deb
        # and cached the 404 as "unknown (offline)".
        channel = channel or self.channel
        # ONCE PER WINDOW, NOT ONCE PER REBUILD. The datasheet is rebuilt on
        # every keystroke of the search box, so without this the retry below
        # would respawn a thread per character typed.
        self._upload_tried.add(cache_key)
        filename = entry.get("filename", "")

        def worker():
            # Same shape again, and this one cannot self-heal: `_upload_tried`
            # is already in the set by the time this runs, so a thread that
            # dies without calling `settle` means the cell is never filled and
            # never retried for the life of the process.
            value, error = None, "upload-date producer returned no result"
            try:
                result = repo.fetch_upload_date(channel, filename)
                if isinstance(result, tuple) and len(result) == 2:
                    value, error = result
                else:
                    # Compatibility for injected test producers and one older
                    # installed model during staged upgrades.
                    value = result
                    error = "" if value else error
            except BaseException as exc:
                error = _exc_detail(exc)
            finally:
                GLib.idle_add(settle, value, error)

        def settle(value, error):
            # A FAILURE IS KEPT IN MEMORY AND NEVER WRITTEN TO DISK.
            # `fetch_upload_date` returns None for no network, a missing
            # curl, the 8-second timeout, a non-zero curl, AND for rc == 0
            # with no Last-Modified header, which is what a 404 looks like
            # (the command is `curl -sSI` with no `-f`). Persisting that put
            # a TRUTHY string in a store whose only reader asks "do I have a
            # value", so one datasheet opened while Tor was still building a
            # circuit poisoned that package's UPLOADED cell permanently, on
            # that machine, across restarts, with no UI able to clear it:
            # Refresh runs `apt update`, not this, and the cache has no TTL,
            # no expiry and no eviction. The only cure was deleting a JSON
            # file the operator has no reason to know exists. Found by
            # <agent> 2026-08-22 by reading the chain rather than
            # hitting it. The class is the one worth remembering: a SENTINEL
            # WRITTEN ON THE ERROR PATH IS INDISTINGUISHABLE FROM DATA ON
            # EVERY SUBSEQUENT READ.
            if value:
                self.uploads[cache_key] = value
                self._upload_failed.pop(cache_key, None)
                repo.write_upload_cache(self.uploads)
            else:
                # Unknown is not a date and is never persisted as one. Keep a
                # transient, named failure for this window until Refresh.
                self.uploads.pop(cache_key, None)
                self._upload_failed[cache_key] = error
            # THE CELL CURRENTLY SHOWING THIS KEY, NOT THE WIDGET THIS FETCH
            # CAPTURED. This wrote into the `label` handed in when the thread
            # started and skipped the write once that widget had been
            # unparented: `_upload_tried` still holds the key, so the rebuilt
            # cell starts no replacement fetch and says "checking..." with
            # nothing running behind it. The comment at the cell site states
            # the contract this breaks in capitals: "checking..." IS A PROMISE
            # THAT A FETCH IS RUNNING.
            #
            # HOW LONG IT LASTS, STATED HONESTLY. An earlier draft of this
            # comment said "for the life of the window", which an inspector
            # corrected on 2026-08-26 and was right to. The two lines ABOVE
            # this one have already written `self.uploads[cache_key]` and
            # `repo.write_upload_cache(...)`, so the ANSWER is never lost: the
            # stale "checking..." survives only until that datasheet is next
            # rebuilt, and never survives a restart. It is a visibly wrong cell
            # that outlasts the operator looking at it, not a permanent one,
            # and the fix is the same either way.
            #
            # IT NEEDS NO USER ACTION AND FIRES ON THE FIRST PACKAGE OPENED IN
            # A FRESH WINDOW. The same show_detail that starts this fetch also
            # starts the repository-trust check, whose apply_result calls
            # show_detail again (:4304) and rebuilds the whole strip. That
            # check is a local gpg read and this one is a TLS round trip with
            # an 8-second budget, so it wins the race routinely. Typing one
            # more character in the search box does it deterministically.
            #
            # The captured label stays as the fallback so a direct call that
            # never went through show_detail still writes where it was told.
            target = None
            if self.alive:
                if self._upload_key == cache_key:
                    target = self._upload_label
                elif label is not None and label.get_parent() is not None:
                    target = label
            if target is not None:
                # The label is the UPLOADED cell of the metric strip, so it
                # carries the value alone: the old "%-14s Uploaded:" padding
                # belonged to a column of monospaced key/value lines that no
                # longer exists.
                if value:
                    target.set_text(short_upload(value))
                    target.set_tooltip_text(value)
                else:
                    target.set_text("upload date unavailable")
                    target.set_tooltip_text(
                        "Upload date unavailable: %s. Press Refresh to retry."
                        % error)
            return False

        try:
            threading.Thread(target=worker, daemon=True).start()
        # `Exception`, NOT `RuntimeError`, AND THE NARROW CATCH WAS A REAL HOLE.
        # MEASURED 2026-08-26 against this machine's CPython 3.13.5:
        # `threading.Thread.start` wraps its call to `_start_joinable_thread` in
        # `except Exception: ...; raise`, i.e. the standard library itself expects a
        # non-RuntimeError out of it. `RuntimeError("can't start new thread")` is the
        # common failure, but the allocation underneath raises `MemoryError`, which is
        # precisely the condition under which a thread fails to start in the first
        # place. A MemoryError skipped this arm entirely and left the manager in the
        # busy state it had already entered. `Exception` and not `BaseException`, so a
        # KeyboardInterrupt or SystemExit still propagates rather than being rendered
        # to the operator as a repository error.
        except Exception as exc:
            settle(
                None, "could not start upload-date check: %s"
                % _exc_detail(exc))

    def _retry_failed_upload_dates(self):
        """Allow one new attempt per failed key after an explicit reload."""
        for cache_key in self._upload_failed:
            self._upload_tried.discard(cache_key)
        self._upload_failed.clear()

    # ------------------------------------------------------------------
    # events
    # ------------------------------------------------------------------
    def _on_search(self, entry):
        self.query = entry.get_text().strip().lower()
        self.refresh_table()

    def _on_channel(self, button, key):
        if not button.get_active():
            return
        self.set_channel(key)

    def set_channel(self, key, button=None):
        """Show `key`'s catalogue everywhere: table, rail counts and datasheet.

        The rail and the toolbar radios are two views of ONE piece of state, so
        the radio is driven from here rather than the other way round; without
        that a rail click left the toolbar claiming the old channel.
        """
        if getattr(self, "_switching", False):
            return
        # ASK FOR THE KEY WHEN HE ASKS FOR THE CHANNEL.
        # Operator, 2026-08-29: "so if user click on it it should ask for the
        # keys, or else user can not access it". Before this, clicking DEV
        # silently showed the whole private catalogue on a machine that had
        # once held a credential, and a bare empty grid on one that never had,
        # with the reason buried in a rail tooltip. Now the click either
        # produces the credential dialog or explains, in the grid itself, what
        # is missing.
        #
        # NOT A SECURITY BOUNDARY AND MUST NOT BE READ AS ONE. This is a
        # routing decision about what the window shows; the boundary is the
        # 401 at the server plus the fact that clearing the credential now
        # deletes the fetched metadata, so there is nothing left for an edited
        # window to display. See repo.dev_entitled().
        #
        # `_dev_prompt_shown` bounds it to once per window: a user who cancels
        # is entitled to look at the locked state without being asked again on
        # every click, and re-prompting on each visit is the shape that trains
        # people to dismiss dialogs without reading them.
        # DEFERRED TO AN IDLE CALLBACK, AND THAT IS A CORRECTNESS FIX, NOT A
        # STYLE CHOICE. `self.confirm` runs a MODAL dialog, and `dialog.run()`
        # does not return until somebody answers it. Calling it inline here
        # meant set_channel("dev") never returned on any machine with no user
        # in front of it. MEASURED 2026-08-29 on <lab-host>: the full GTK
        # suite ran 130 contracts green and then hung indefinitely on
        # `test_the_dev_lock_greys_the_buttons_it_already_refuses`, which does
        # exactly `set_channel("dev")` with dev_auth_file_present patched to
        # False. A modal opened with no one to dismiss it.
        #
        # An idle callback fixes both halves. A test drives the window without
        # running a main loop, so the idle never fires and the switch is
        # instant and dialog-free. The real application is always in its main
        # loop, so the dialog appears the moment the channel switch finishes,
        # which is also the better order: he sees the locked dev page first and
        # the request for a key over it, rather than a dialog about a page he
        # has not been shown yet.
        if (key == "dev" and not dev_auth_file_present()
                and not getattr(self, "_dev_prompt_shown", False)
                and not self.busy):
            self._dev_prompt_shown = True
            GLib.idle_add(self._offer_dev_credentials_idle)
        self._switching = True
        try:
            self.channel = key
            marker = getattr(self.window, "_set_active_nav", None)
            if marker is not None and button is not None:
                marker(button)
            radio = getattr(self, "channel_buttons", {}).get(key)
            if radio is not None and not radio.get_active():
                # set_active fires "toggled", which lands back in _on_channel
                # and calls this method again. Without the guard the whole
                # switch runs twice, and the second run repaints a datasheet
                # the first run already built.
                radio.set_active(True)
        finally:
            self._switching = False
        self.set_page("packages")
        self.refresh_table()
        self._refresh_nav_counts()
        self._draw_strip()

    def set_filter(self, key, button=None):
        self.filter = key
        marker = getattr(self.window, "_set_active_nav", None)
        if marker is not None and button is not None:
            marker(button)
        # A package filter is also a destination: clicking "Updates" in the
        # package group while the Sources page is showing must bring the table
        # back, or the click looks dead.
        self.set_page("packages")
        self.refresh_table()

    def _on_select(self, flowbox):
        """A card was chosen in the grid.

        Guarded on `_rebuilding`, because emptying the FlowBox emits this
        signal with nothing selected and that is not the user deselecting
        anything. Without the guard every keystroke in the filter box would
        blank the datasheet a moment before the rebuild re-selected the same
        package, which reads as a flicker and loses the scroll position.
        """
        if self._rebuilding:
            return
        children = flowbox.get_selected_children()
        if not children:
            self.selected = None
            self.show_detail(None)
            return
        self.selected = getattr(children[0], "package_name", None)
        self.show_detail(self.package(self.selected))

    def _on_install(self, _button):
        if not self._catalog_action_ready():
            return
        package = self.package(self.selected)
        if package is None:
            return
        # C4: the helper used to refuse dev outright, so this emitted a command
        # that could only ever come back "failed with exit code 2", after the
        # detail pane had printed it under "WHAT THE BUTTON RUNS". The helper
        # now accepts dev, so the only thing left to refuse is dev WITHOUT a
        # stored credential, which is a fixable state and says how to fix it.
        if self.channel == "dev" and not dev_auth_file_present():
            self.append_log(DEV_REFUSAL)
            return
        state = self._package_state(package)
        if state == "downgrade" and not self.confirm(
                "Downgrade %s?" % package["name"],
                "The %s candidate is older than the installed version. "
                "Continuing runs apt for that exact older channel build."
                % self.channel):
            return
        self.run_helper(["install", package["name"], self.channel],
                        "%s %s from %s" % (
                            "downgrade" if state == "downgrade" else "install",
                            package["name"], self.channel))

    def _on_remove(self, _button):
        if not self._catalog_action_ready():
            return
        package = self.package(self.selected)
        if package is None:
            return
        if not self.confirm("Remove %s?" % package["name"],
                            "apt remove keeps configuration files. Packages that "
                            "depend on it will be removed too, and apt lists them "
                            "in the output below before it acts."):
            return
        self.run_helper(["remove", package["name"]],
                        "remove %s" % package["name"])

    def _on_switch(self, _button):
        if not self._catalog_action_ready():
            return
        package = self.package(self.selected)
        if package is None:
            return
        target = switch_target(package)
        entry = repo.candidate(package, target)
        if entry is None:
            self.append_log("%s is not published in the %s channel.\n"
                            % (package["name"], target))
            return
        if not self.confirm(
                "Move %s to the %s channel?" % (package["name"], target),
                "It will be pinned to %s (%s) and stay there until you move it "
                "back. apt may report this as a downgrade." %
                (target, entry["version"])):
            return
        self.run_helper(["switch", package["name"], target],
                        "switch %s to %s" % (package["name"], target))

    def _on_hold(self, _button):
        """Hold the selected installed package, or release its existing hold."""
        if not self._catalog_action_ready():
            return
        package = self.package(self.selected)
        if package is None or not package["installed"]:
            return
        if package.get("held"):
            self.run_helper(["unhold", package["name"]],
                            "resume updates for %s" % package["name"])
        else:
            self.run_helper(["hold", package["name"]],
                            "hold %s at its installed version" % package["name"])

    def _on_system(self, _button):
        if not self._catalog_action_ready():
            return
        if self.channel == "dev" and not dev_auth_file_present():
            self.append_log(DEV_REFUSAL)
            return
        if not self.confirm(
                "Move every Kodachi package to the %s channel?" % self.channel,
                "This pins the whole suite to %s and then upgrades. On this "
                "repository the beta channel is currently BEHIND stable, so "
                "moving to beta downgrades the core packages."
                % self.channel):
            return
        self.run_helper(["system", self.channel],
                        "move the system to %s" % self.channel)

    def _on_channel_setup(self, _button):
        """Add or remove the apt source for the channel shown above.

        B1: `enable` and `disable` existed in the helper from the start, with
        the key fingerprint pinned, and nothing in the window emitted either
        one. The only thing this application had to say about an unconfigured
        beta channel was "run curl ... | sudo sh in a terminal", which is the
        terminal this application was written to replace, and the published
        setup.sh writes `Suites: stable`, so beta could not be reached from
        the GUI at all on a stock machine.
        """
        channel = self.channel
        label = repo.CHANNELS[channel]["label"]
        configured_path = (self.catalog.get("configured") or {}).get(channel)
        managed_path = os.path.join(
            repo.sources_dir(), "kodachi-%s.sources" % channel)
        if configured_path and configured_path == managed_path:
            # NO CREDENTIAL CHECK ON THE REMOVE PATH. It used to be here,
            # carried over from before this branch was split out, and it was
            # both wrong and unreachable: `verb_disable` requires no
            # credential, so refusing removal for the want of one names an
            # obstacle that is not in the way. It was unreachable only because
            # the same missing-credential state ALSO greyed this button, which
            # is the dead end fixed in `_draw_strip` above. Removing the grey
            # without removing this would have traded a dead end for a
            # nonsense refusal. Found by the inspector, 2026-08-30, in the
            # same function this change had already rewritten.
            if not self.confirm(
                    "Remove the %s repository?" % label,
                    "This deletes /etc/apt/sources.list.d/kodachi-%s.sources, "
                    "the file this application wrote, and then runs apt "
                    "update. A source you installed yourself, including the "
                    "one the published setup.sh writes, is left alone and the "
                    "helper will say so. Installed packages are not removed."
                    % channel):
                return
            self.run_helper(["disable", channel],
                            "remove the %s repository" % label)
            return
        self.add_channel_source(channel)

    def add_channel_source(self, channel):
        """Write the pinned apt source for one Kodachi channel, or say why not.

        THE ONE PLACE THIS WINDOW ADDS A KODACHI CHANNEL. Two controls reach
        it: the CHANNELS rail's "Add channel" button, which acts on the channel
        being displayed, and the SYSTEM SOURCES "Add repository" dialog's
        Kodachi presets, which act on the channel the user picked from the
        combo. Both emit the same `enable <channel>` verb with the same
        confirmation, because a second way to write a Kodachi source is a
        second thing that can drift away from the fingerprint the helper pins.

        Every refusal below is a state the helper would refuse anyway. Saying
        so here, in words, before anything runs, is the difference between an
        application and a wrapper around an exit code.
        """
        label = repo.CHANNELS[channel]["label"]
        configured_path = (self.catalog.get("configured") or {}).get(channel)
        managed_path = os.path.join(
            repo.sources_dir(), "kodachi-%s.sources" % channel)
        # WHAT IS ALREADY ON THE MACHINE IS ASKED BEFORE WHAT IS MISSING FROM
        # IT, and the order is the whole correctness of the dev message.
        # Raised by <agent>, 2026-08-30: with the credential hint first,
        # a machine carrying an EXTERNALLY configured dev source and no local
        # auth file was told "no credentials are stored", which is true and is
        # not the answer to the question he asked. The source is already there;
        # what he needs to know is which file has it. A refusal that names the
        # wrong obstacle sends somebody to type a password that will change
        # nothing.
        if configured_path and configured_path != managed_path:
            self.append_log(
                "%s is configured externally in %s. Use System Sources to "
                "inspect it; this button will not run a helper action that is "
                "guaranteed to refuse that file.\n" % (label, configured_path))
            return
        if configured_path:
            self.append_log(
                "%s is already configured by %s, so there is nothing to add. "
                "Select %s in CHANNELS and press Remove channel. Nothing was "
                "changed.\n" % (label, configured_path, label))
            return
        # DEV BEFORE DORMANT, AND THE ORDER IS A SAFETY QUESTION RATHER THAN A
        # wording one. The dormant branch below tells the user to open SYSTEM
        # SOURCES and press Enable on the switched-off file. For a DEV source
        # with no credential stored that is ACTIVELY BAD ADVICE: `_on_source_state`
        # carries no dev-credential gate, so following it switches on a source
        # that answers 401 and makes every later apt command on the machine
        # report it, which is precisely what the credential check exists to
        # prevent. The state is product-created (add dev, switch it off in
        # System Sources, then clear the dev credentials). Found by the
        # inspector, 2026-08-30, after I moved this check below the dormant one.
        #
        # Still AFTER the two "it is already there" branches, per
        # <agent>: a machine that already has the source does not need
        # to be told about a password, it needs to be told which file has it.
        #
        # THE UNPRIVILEGED HINT IS A COURTESY, NOT THE GATE. The gate is
        # `verb_enable()`, which calls `dev_credentials_present()` as root and
        # returns 5 before touching the keyring, the sources directory or apt.
        if channel == "dev" and not dev_auth_file_present():
            self.append_log(DEV_REFUSAL)
            return
        # PRESENT BUT SWITCHED OFF IS NOT ABSENT, AND THE CONFIRMATION MUST NOT
        # SAY IT IS. `configured_channels` requires `entry["enabled"]`, so a
        # kodachi-<channel>.sources this window's own Disable button switched
        # off does not appear in `catalog["configured"]` at all. Without this
        # branch both refusals above passed, the confirmation promised "This
        # writes /etc/apt/sources.list.d/kodachi-<channel>.sources", and the
        # helper then correctly returned 4 telling the user to run
        # `kodachi-repo-apt source-enable d <file>` in a terminal, from a
        # window that has a button for exactly that. Found by the inspector,
        # 2026-08-30. The helper was never wrong; the promise was.
        try:
            dormant = repo.dormant_channel_sources().get(channel)
        except repo.RepositoryStateError as error:
            # A source directory this window cannot read is not a licence to
            # promise a write into it. Say what could not be read and stop.
            self.append_log(
                "The configured repositories could not be re-read (%s), so "
                "whether %s already has a switched-off source here is "
                "unknown. Press Reload list. Nothing was changed.\n"
                % (error, label))
            return
        if dormant:
            self.append_log(
                "%s is already defined in %s with its switch OFF, so apt "
                "ignores it. Adding a second source would make apt report "
                "\"Target Packages is configured multiple times\" on every "
                "update. Open SYSTEM SOURCES, select that file and press "
                "Enable instead. Nothing was changed.\n" % (label, dormant))
            return
        # AND THE RESIDUE THE PARSER CANNOT SEE, which is why this is a PATH
        # test and not another predicate. `dormant_channel_sources` above
        # mirrors the helper for every stanza `system_sources` can parse, and
        # that is genuinely not all of them: a deb822 block with no Components
        # is classified `invalid` by this window's parser, because apt would
        # reject it, while the helper's looser reader still counts it as the
        # channel switched off and refuses to write beside it. Chasing byte
        # parity between two parsers is the wrong fix for a promise; asking
        # whether the FILE IS THERE is the right one, needs no parsing, and
        # covers every shape at once.
        #
        # This is not a refusal. The helper handles an occupied path correctly
        # now, by backing it up or by refusing a symlink. What it must not do
        # is let this window promise "This writes ..." as though the path were
        # empty. Found by the inspector, 2026-08-30, as the residue of its own
        # finding 6, and my first fix for it was one parser short.
        body = ("This writes %s pointing at %s, fetches the Kodachi signing "
                "key if it is not already installed, checks it against the "
                "fingerprint built into this application, and then runs apt "
                "update. Nothing is installed or upgraded."
                % (managed_path, repo.CHANNELS[channel]["url"]))
        if os.path.lexists(managed_path):
            body += (
                "\n\nNOTE: %s ALREADY EXISTS and is not a Kodachi source "
                "this window recognises. It is copied to "
                "/var/backups/kodachi-apt-sources before it is replaced, and "
                "if that copy cannot be made, nothing is written at all. If it "
                "is a symbolic link nothing is written either and the helper "
                "says so." % managed_path)
        # AND AT ANY OTHER PATH, WHICH THE MANAGED-PATH TEST ABOVE DOES NOT
        # COVER AND WHICH I TWICE CLAIMED IT DID. The helper's own scan is over
        # the WHOLE directory: `_channel_sources_split` reads every
        # name-matching file containing "kodachi.cloud" and parses it far more
        # loosely than this library can, so it refuses to write beside stanzas
        # `system_sources` declines outright. Measured by the inspector: a
        # switched-off stanza at operator-added.sources with no `Components`
        # is invisible to BOTH of this window's predicates, so nothing refused,
        # nothing warned, the confirmation promised "This writes ...", the
        # helper then returned 4, and `_on_source_state` refused the row the
        # helper's advice pointed at. A dead end in three steps.
        #
        # An UNPARSED substring scan is the answer because the difference is
        # the parser, not the filter: a malformed stanza can decline a parse
        # and cannot decline a substring. It only softens a PROMISE and never
        # gates the mutation, so over-reporting costs one sentence.
        try:
            elsewhere = [p for p in repo.files_mentioning_channel(channel)
                         if p != managed_path]
        except repo.RepositoryStateError as error:
            self.append_log(
                "The configured repositories could not be listed (%s), so "
                "whether another file already mentions %s is unknown. Press "
                "Reload list. Nothing was changed.\n" % (error, label))
            return
        if elsewhere:
            body += (
                "\n\nNOTE: %s already appears in %s. This window could not "
                "read %s as a Kodachi source, but the privileged helper reads "
                "apt sources more loosely and may refuse to write a second "
                "one beside it. If it does, it will say so and nothing will "
                "have changed."
                % (repo.CHANNELS[channel]["url"], ", ".join(elsewhere),
                   "them" if len(elsewhere) > 1 else "it"))
        if not self.confirm("Add the %s repository?" % label, body):
            return
        self.run_helper(["enable", channel], "add the %s repository" % label)

    def _on_source_state(self, enable):
        entry = self.source_entry()
        if entry is None:
            self.append_log("Select a repository first.\n")
            return
        if entry["format"] in ("commented-block", "read-error", "invalid"):
            # THE ROW THAT IS NOT A REPOSITORY. system_sources() draws it so a
            # commented block the parser declined to read is never silently
            # missing from the file, and it must not be acted on: the same
            # predicate that declined it would decline it again in the helper,
            # so a verb sent here would be a guaranteed no-op. Saying so is the
            # whole point of the row.
            self.append_log(
                "%s contains a commented block this window did not read, so it "
                "cannot switch it on or off. Its first line is %r. Edit %s by "
                "hand, or delete the comment characters, and press Reload.\n"
                % (entry["filename"], entry["line"], entry["path"])
                if entry["format"] == "commented-block" else
                "%s could not be read (%s), so no mutation is allowed for "
                "that path. Fix its permissions or storage and press Reload "
                "list; nothing was changed.\n" %
                (entry["path"], entry["components"])
                if entry["format"] == "read-error" else
                "%s contains an invalid apt source entry (%s). Edit the "
                "malformed entry and press Reload; permissions and storage "
                "changes will not repair its syntax. Nothing was changed.\n" %
                (entry["path"], entry["components"]))
            return
        if entry.get("mutable", True) is False:
            self.append_log(
                "%s is read-only in this window: %s. Nothing was changed.\n"
                % (entry["path"], entry.get("mutation_reason") or
                   "the repository helper cannot mutate this path safely"))
            return
        # FAIL CLOSED ON A KEY NOBODY SET. F3, <agent> 2026-08-21,
        # latent not live: all three producers in kodachi_repo.py set
        # "switchable" explicitly (:1160 False, :1186 True, :1258 from a
        # variable), so this default never fires today. The POLARITY is the
        # finding. This leg decides whether the operator may switch a source
        # ON, so a truthy default means an entry whose switchability nobody
        # stated gets ENABLED, which is the direction that makes apt fetch
        # from something. It is the same class as the
        # `configured.get(channel, True)` bug I fixed an hour earlier: a dict
        # that carries a key only for the case it can describe must never be
        # read with a truthy default. A fourth producer added later now fails
        # safe instead of silently gaining a button.
        if enable and not entry.get("switchable", False):
            # C4, <agent> 2026-08-21, executed. `source-enable` acts on
            # the FILE, and it deliberately never switches on a deb-src line the
            # distribution shipped commented. A .list carrying a commented deb
            # and a commented deb-src for one URI draws two disabled rows, so
            # pressing Enable from the deb-src row used to switch the OTHER row
            # on, print a green "done:", and leave the clicked row disabled with
            # nothing anywhere saying which one moved. Refusing here is the only
            # answer that is true: the row is real, it is off, and this window
            # will not turn it on.
            self.append_log(
                "%s in %s is a source-code (deb-src) line that came commented "
                "out, and this window does not switch those on: it would double "
                "every index fetch and fail on repositories that publish no "
                "sources. Uncomment it in %s by hand if you need it, then press "
                "Reload.\n"
                % (entry["uri"], entry["filename"], entry["path"]))
            return
        where, name = source_selector(entry)
        # ONLY THE ENTRIES THE VERB WILL ACTUALLY MOVE. The scope sentence below
        # promises "all of them are switched on together", and counting rows the
        # enable leg walks past made that promise false by exactly the number of
        # commented deb-src lines in the file.
        siblings = [e for e in self.sources
                    if e["path"] == entry["path"]
                    and e["format"] != "commented-block"
                    # Same flip as the leg above, and it matters on the
                    # enable leg only: `not enable` already carries the whole
                    # clause when disabling.
                    and (e.get("switchable", False) or not enable)]
        deb822 = entry["format"] == "deb822"
        # BOTH LEGS ASK, AND THE ENABLE LEG ASKS HARDER. P2, raised by
        # <agent> 2026-08-21: the confirmation was on `not enable`
        # only, so DISABLING got a dialog naming the blast radius and ENABLING
        # got none, while the argv carries the FILE and not one stanza, so one
        # press switched every deliberately-disabled entry in that file back
        # on. The asymmetry ran the wrong way round: losing updates is the
        # recoverable outcome, and making apt fetch, trust and install from a
        # repository is the one with a supply-chain consequence.
        if enable:
            how = ("the Enabled: no line is removed and a stanza that is "
                   "commented out is uncommented" if deb822
                   else "every line this window switched off comes back "
                        "exactly as it was, and any other commented-out deb "
                        "line is switched on")
            scope = ("" if len(siblings) == 1 else
                     " This file defines %d entries and all of them are "
                     "switched on together." % len(siblings))
            title = "Enable %s?" % entry["filename"]
            body = ("In %s, %s. apt will then fetch this repository's index on "
                    "the next update, and packages from it become installable "
                    "and upgradable on this machine. The file is backed up to "
                    "/var/backups/kodachi-apt-sources first.%s"
                    % (entry["path"], how, scope))
        else:
            how = ("the Enabled: no line is added" if deb822
                   else "every deb line is commented out")
            scope = ("" if len(siblings) == 1 else
                     " This file defines %d entries and all of them are "
                     "switched off together." % len(siblings))
            title = "Disable %s?" % entry["filename"]
            body = ("In %s, %s. The file is backed up to "
                    "/var/backups/kodachi-apt-sources first, and you can switch "
                    "it back on from here. Packages already installed from it "
                    "stay installed but stop receiving updates.%s"
                    % (entry["path"], how, scope))
        if not self.confirm(title, body):
            return
        # THE VERB IS A LITERAL ON BOTH LEGS, DELIBERATELY. Building it with
        # `verb = "source-enable" if enable else "source-disable"` reads better
        # and cost the verb-parity test its power: that test derives what this
        # window can emit by scanning for run_helper(["<verb>", ...]), so a verb
        # held in a variable is invisible to it. MEASURED 2026-08-21, it reported
        # source-enable and source-disable as verbs the helper accepts and
        # nothing emits, which is the exact shape of a real dead-verb defect. A
        # name the checker cannot see is worth more than two saved lines.
        if enable:
            self.run_helper(["source-enable", where, name],
                            "enable %s" % entry["path"])
        else:
            self.run_helper(["source-disable", where, name],
                            "disable %s" % entry["path"])

    def _on_source_add(self, _button):
        """Ask for one repository and hand six fixed fields to the helper.

        Every field is validated again in the helper, which is where it has to
        happen: this dialog is convenience, not a security boundary. The
        keyring is chosen from the files already present in /etc/apt/keyrings
        and /usr/share/keyrings rather than typed, because this application
        never fetches or trusts a key on the user's say-so.

        The one exception is a Kodachi preset, which returns a channel name
        instead and is handed to `enable <channel>`: that verb installs and
        fingerprint-checks the archive key itself, which is exactly the thing
        this dialog refuses to do for a repository the user typed in.
        """
        fields = self.ask_for_source()
        if fields is None:
            return
        name, types, uri, suite, components, keyring, channel = fields
        # A KODACHI PRESET IS NOT SIX TYPED FIELDS, IT IS A CHANNEL. Nothing
        # the dialog collected is forwarded in this branch: `enable` derives
        # the URI, suite, components and keyring from the helper's own pinned
        # constants, so a preset cannot write a source that disagrees with the
        # fingerprint check that follows it. The fields were shown so the user
        # could read what he was agreeing to, and that is all they were for.
        if channel is not None:
            self.add_channel_source(channel)
            return
        if source_uri_has_userinfo(uri):
            self.append_log(
                "Repository URLs containing a username or password are "
                "refused. Embedded credentials would be exposed in the "
                "process list, this window's log, and the apt source file. "
                "Use a public repository URL or configure authentication in "
                "a root-only apt auth.conf.d file. Nothing was written.\n")
            return
        if not self.confirm(
                "Add %s?" % name,
                "This writes /etc/apt/sources.list.d/%s with\n\n"
                "    Types: %s\n    URIs: %s\n    Suites: %s\n"
                "    Components: %s\n    Signed-By: %s\n\n"
                "and then runs apt update. Nothing is installed or upgraded. "
                "An unsigned repository is one apt will refuse to use."
                % (name, types, uri, suite, components,
                   keyring if keyring != "none" else "(none, unsigned)")):
            return
        self.run_helper(["source-add", name, types, uri, suite, components,
                         keyring],
                        "add the repository %s" % name)

    def keyring_names(self):
        """Bare names of the keyrings apt already has, for the chooser."""
        found = []
        for directory in ("/etc/apt/keyrings", "/usr/share/keyrings"):
            try:
                entries = sorted(os.listdir(directory))
            except OSError:
                continue
            for entry in entries:
                path = os.path.join(directory, entry)
                if (entry.endswith((".gpg", ".asc")) and os.path.isfile(path)
                        and not os.path.islink(path) and entry not in found):
                    found.append(entry)
        return found

    def ask_for_source(self):
        """A seven-row dialog, or None if the user cancelled.

        Returns (name, types, uri, suite, components, keyring, channel). The
        seventh element is None for a custom repository and the channel key for
        a Kodachi preset, and it is the only one the preset path reads.
        """
        dialog = Gtk.Dialog(title="Add a repository", transient_for=self.window,
                            modal=True)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Add", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=6, column_spacing=10)
        grid.set_margin_start(14)
        grid.set_margin_end(14)
        grid.set_margin_top(12)
        grid.set_margin_bottom(12)

        # ROW 0 IS THE PRESET CHOOSER AND IT IS FIRST FOR A REASON. Everything
        # below it is the long way round for a Kodachi channel, and a user who
        # reads top to bottom should meet the short way first.
        preset_box = Gtk.ComboBoxText()
        preset_box.append_text(SOURCE_PRESET_CUSTOM)
        for value in SOURCE_PRESET_CHANNELS:
            preset_box.append_text(source_preset_label(value))
        preset_box.set_active(0)
        ui.set_row_tooltip(
            preset_box,
            "Kodachi's own channels, ready made. Choosing one fills the fields "
            "below with exactly what will be written and signs the repository "
            "with the Kodachi archive key this application pins, so there is "
            "nothing to type and nothing to get wrong. Dev additionally needs "
            "the login and password you were issued: this dialog never asks "
            "for them and never stores one. Enter them under CHANNELS, Dev "
            "credentials.")
        caption = ui.lbl("Repository:", "note")
        caption.set_xalign(1.0)
        grid.attach(caption, 0, 0, 1, 1)
        grid.attach(preset_box, 1, 0, 1, 1)

        entries = {}
        rows = (
            ("name", "File name", "example.sources",
             "Written into /etc/apt/sources.list.d. Must end in .sources."),
            ("uri", "URI", "https://deb.example.org/debian",
             "The repository root, the same string a deb line would carry."),
            ("suite", "Suite", "trixie",
             "The release name, for example trixie or stable."),
            ("components", "Components", "main",
             "One or more, separated by spaces, for example: main contrib."),
        )
        for index, (key, label, placeholder, tip) in enumerate(rows):
            row = index + 1
            caption = ui.lbl(label + ":", "note")
            caption.set_xalign(1.0)
            entry = Gtk.Entry()
            entry.set_placeholder_text(placeholder)
            entry.set_width_chars(42)
            entry.set_activates_default(True)
            ui.set_row_tooltip(entry, tip)
            grid.attach(caption, 0, row, 1, 1)
            grid.attach(entry, 1, row, 1, 1)
            entries[key] = entry

        types_box = Gtk.ComboBoxText()
        # ONE MODEL, NOT TWO. The first version listed these here and then
        # indexed a SECOND literal `("deb", "deb-src")` seventy lines below to
        # select the preset's value, which is the exact duplication the
        # keyring mirror was written to avoid, three rows further down the
        # same grid. Reordering one copy would have let the combo say
        # "Kodachi Stable" over `deb-src` with nothing to catch it. Found by
        # the inspector, 2026-08-30.
        for value in TYPES_VALUES:
            types_box.append_text(value)
        types_box.set_active(0)
        ui.set_row_tooltip(types_box, "deb is binary packages, which is what "
                                      "almost every repository is for.")
        caption = ui.lbl("Types:", "note")
        caption.set_xalign(1.0)
        grid.attach(caption, 0, len(rows) + 1, 1, 1)
        grid.attach(types_box, 1, len(rows) + 1, 1, 1)

        keyring_box = Gtk.ComboBoxText()
        # THE MODEL IS MIRRORED IN A LIST BECAUSE Gtk.ComboBoxText CANNOT BE
        # ASKED WHAT IT CONTAINS. `get_active_text` reads the selected row and
        # there is no "index of this string", so selecting the Kodachi keyring
        # by name means tracking the order it was appended in. Appending to the
        # widget without appending here would select the wrong row silently.
        keyring_values = ["none"]
        # Rows this dialog appended for a preset and must take back out again.
        borrowed = set()
        keyring_box.append_text("none")
        for value in self.keyring_names():
            keyring_box.append_text(value)
            keyring_values.append(value)
        keyring_box.set_active(0)
        ui.set_row_tooltip(
            keyring_box,
            "The signing key apt should check this repository against, chosen "
            "from the keyrings already installed in /etc/apt/keyrings and "
            "/usr/share/keyrings. This application never downloads a key for a "
            "repository you add: put the key in place first, then come back. "
            "With none, apt will refuse the repository unless it is signed by "
            "a key it already trusts.")
        caption = ui.lbl("Signed by:", "note")
        caption.set_xalign(1.0)
        grid.attach(caption, 0, len(rows) + 2, 1, 1)
        grid.attach(keyring_box, 1, len(rows) + 2, 1, 1)

        note = ui.lbl("", "note", wrap=True)
        note.set_xalign(0.0)
        grid.attach(note, 1, len(rows) + 3, 1, 1)

        def apply_preset(_combo=None):
            """Fill and freeze the fields for the chosen preset, or free them.

            THE FIELDS ARE LOCKED, NOT MERELY FILLED, and that is the whole
            difference between a preset and a shortcut. A half-edited preset,
            one whose combo still says "Kodachi Stable" while its URI points
            somewhere else, would be an application telling the user something
            untrue about what it is signing. Choose Custom and every field is
            his again, cleared, because a custom repository that starts life
            pre-filled with Kodachi's URI is the same lie the other way round.
            """
            index = preset_box.get_active()
            preset = (None if index <= 0
                      else SOURCE_PRESET_CHANNELS[index - 1])
            locked = preset is not None
            fields = preset_source_fields(preset) if locked else {}
            for key, entry in entries.items():
                entry.set_text(fields.get(key, ""))
                # READ-ONLY, NOT INSENSITIVE. Raised by <agent>,
                # 2026-08-30: `set_sensitive(False)` greys the text, which is
                # exactly the text the preset exists to let him READ, and it
                # cannot be selected or copied, so a user who wants to check
                # the URI against the playbook cannot. `set_editable(False)`
                # refuses the keystroke and leaves the widget legible and
                # copyable, which is what "preview" means.
                entry.set_editable(not locked)
            if locked:
                keyring_name = fields["keyring"]
                # A ROW BORROWED FOR THE PRESET IS REMOVED AGAIN, and this is
                # not tidiness. On a machine that does not yet carry the
                # archive key, which is the ordinary case for somebody using a
                # preset for the first time, the name is not in the list and
                # has to be appended to be shown. The first version never took
                # it back out, so switching to Custom re-enabled a combo now
                # offering a keyring that DOES NOT EXIST on this machine: pick
                # it and the helper answers with a bare
                # `die("no such keyring")`. It also broke this combo's own
                # stated invariant, that every row is a file already present.
                # Found by the inspector, 2026-08-30.
                if keyring_name not in keyring_values:
                    keyring_box.append_text(keyring_name)
                    keyring_values.append(keyring_name)
                    borrowed.add(keyring_name)
                types_box.set_active(TYPES_VALUES.index(fields["types"]))
                keyring_box.set_active(keyring_values.index(keyring_name))
            else:
                for name in sorted(borrowed):
                    index = keyring_values.index(name)
                    keyring_box.remove(index)
                    keyring_values.pop(index)
                borrowed.clear()
                types_box.set_active(0)
                keyring_box.set_active(0)
            types_box.set_sensitive(not locked)
            keyring_box.set_sensitive(not locked)
            # THE KEYRING IS NAMED IN THE NOTE, AT FULL CONTRAST, and it is
            # there because of what a screenshot of this dialog showed.
            # Measured 2026-08-30 on <lab-host> by mapping the real
            # dialog and reading the PNG: with a preset chosen, the two combo
            # rows are insensitive, and `kodachi-archive-keyring.gpg` is the
            # DIMMEST string on screen. It is also the single most important
            # one, because it is the whole difference between a signed
            # repository and a repository apt will refuse. The four Gtk.Entry
            # rows solved this by becoming read-only rather than insensitive;
            # a Gtk.ComboBoxText has no read-only state, so the value is
            # restated here in a normal label instead of being left greyed.
            note.set_text(
                ("%s The stanza will carry Signed-By: %s and "
                 "Architectures: %s."
                 % (PRESET_NOTES.get(preset, ""), ARCHIVE_KEYRING,
                    fields["architectures"]))
                if preset else "")
            note.set_visible(bool(preset))

        preset_box.connect("changed", apply_preset)

        dialog.get_content_area().pack_start(grid, True, True, 0)
        dialog.show_all()
        apply_preset()
        answer = dialog.run()
        index = preset_box.get_active()
        channel = (None if index <= 0 else SOURCE_PRESET_CHANNELS[index - 1])
        values = {key: entry.get_text().strip() for key, entry in entries.items()}
        types = types_box.get_active_text() or "deb"
        keyring = keyring_box.get_active_text() or "none"
        dialog.destroy()
        if answer != Gtk.ResponseType.OK:
            return None
        # A PRESET SKIPS THE REQUIRED-FIELD CHECK BECAUSE IT FILLED THEM AND
        # THEY ARE NOT WHAT GETS SENT. The helper's `enable` verb reads its own
        # constants; these four entries were a preview, and refusing on one of
        # them would be refusing on a value nothing is going to use.
        if channel is not None:
            return (values["name"], types, values["uri"], values["suite"],
                    values["components"], keyring, channel)
        if not values["name"] or not values["uri"] or not values["suite"] \
                or not values["components"]:
            self.append_log("Every field except the keyring is required.\n")
            return None
        return (values["name"], types, values["uri"], values["suite"],
                values["components"], keyring, None)

    def _on_source_remove(self, _button):
        entry = self.source_entry()
        if entry is None:
            self.append_log("Select a repository first.\n")
            return
        if (entry.get("format") in {"read-error", "invalid", "commented-block"}
                or entry.get("mutable", True) is False):
            self.append_log(
                "%s cannot be removed from this view: %s. Nothing was changed.\n"
                % (entry["path"], entry.get("mutation_reason") or
                   entry.get("components") or "the row is not safely mutable"))
            return
        if entry["path"] == "/etc/apt/sources.list":
            self.append_log(
                "/etc/apt/sources.list is the distribution's own file and is "
                "not removable from here. Disable it instead.\n")
            return
        if not self.confirm(
                "Remove %s?" % entry["filename"],
                "The file is copied to /var/backups/kodachi-apt-sources and "
                "then deleted. Every repository it defines disappears from "
                "apt. Installed packages stay installed."):
            return
        where, name = source_selector(entry)
        self.run_helper(["source-remove", where, name],
                        "remove %s" % entry["path"])

    def _on_apply_updates(self, _button):
        if not self.updates_checked:
            self.append_log("The update check is still running. Wait for the "
                            "result before installing updates.\n")
            return
        if self.updates_error:
            self.append_log("The update list could not be read (%s), so there "
                            "is nothing to apply yet.\n" % self.updates_error)
            return
        if not self.updates:
            self.append_log("Nothing is upgradable. Press Check for updates "
                            "first if the list looks stale.\n")
            return
        security = sum(1 for u in self.updates if u["kind"] == "security")
        detail = ("%d packages will be upgraded, %d of them security updates. "
                  "apt lists them in the output below before it acts."
                  % (len(self.updates), security))
        if not self.confirm("Install all %d updates?" % len(self.updates),
                            detail):
            return
        self.run_helper(["upgrade"], "apt update + apt upgrade")

    def _dev_attempt_guard(self):
        """Refuse a further credential attempt after repeated failures.

        WHY A CLIENT-SIDE GUARD EXISTS AT ALL, given the server is the thing
        that authenticates. Operator, 2026-08-29: "also make sure it will stop
        brute forcing". The obvious reading is "stop an attacker guessing", and
        a local dialog cannot do that: an attacker with a shell does not need
        this window, they can talk to the repository directly, and the real
        defence is the server's own Basic-Auth rejection and its ban.

        THE READING THAT MATTERS IS THE OTHER ONE. The repository playbook
        records that a small number of failed attempts bans the SOURCE ADDRESS
        from the master node, and that ban is not scoped to the dev channel. So
        the person most likely to be harmed by repeated wrong guesses through
        this dialog is the OPERATOR HIMSELF, or a customer, locking their own
        machine out by retyping a password they have slightly wrong. Without a
        guard the window is a convenient way to spend that budget three
        keystrokes at a time, and nothing on screen says so.

        So this bounds the machine's own retries and, when it stops, says
        exactly why rather than looking broken. DEV_ATTEMPT_LIMIT is
        deliberately BELOW the server's threshold, so the window gives up while
        attempts remain rather than after they are gone.

        Returns None when an attempt is allowed, or a sentence explaining the
        refusal.
        """
        now = time.monotonic()
        until = getattr(self, "_dev_locked_until", 0.0)
        if now < until:
            return ("Too many failed dev credential attempts. Further tries "
                    "are held off for %d more second(s) so this machine is "
                    "not locked out of the repository. Check the login and "
                    "password you were issued before trying again."
                    % int(until - now + 0.5))
        return None

    def _note_dev_attempt(self, code):
        """Record the outcome of a dev-credentials run and arm the guard.

        Called from `finish`, which is the ONLY place that sees the helper's
        exit code. 0 means the helper stored the credential AND the apt refresh
        that follows it succeeded, so the credential is good and the counter is
        cleared. Anything else is a failed attempt.

        NOTE THE ONE CASE THAT IS NOT A GUESS: exit 126 is a dismissed pkexec
        dialog, so nothing was sent to the server and nothing was tried. That
        must not count, or cancelling an authentication prompt three times
        would lock a user out of a channel they never attempted to reach.
        """
        if code == 0:
            self._dev_attempts = 0
            self._dev_locked_until = 0.0
            return
        if code == 126:
            return
        self._dev_attempts = getattr(self, "_dev_attempts", 0) + 1
        if self._dev_attempts >= DEV_ATTEMPT_LIMIT:
            self._dev_locked_until = time.monotonic() + DEV_ATTEMPT_COOLDOWN
            self._dev_attempts = 0
            self.append_log(
                "held off further dev credential attempts for %d seconds: "
                "repeated failures can lock this machine out of the "
                "repository\n" % DEV_ATTEMPT_COOLDOWN)

    def _offer_dev_credentials_idle(self):
        """The idle wrapper set_channel schedules. See the comment there.

        NON-BLOCKING FROM HERE DOWN, AND THE FIRST FIX WAS NOT ENOUGH.
        Deferring the prompt to an idle callback removed the hang only for a
        caller that never runs a main loop. MEASURED 2026-08-29 on
        <lab-host>, on a clean node with the idle fix in place: the suite
        passed the test that hung before and then stopped dead on
        `test_the_index_synced_cell_never_says_unknown`, which calls
        `set_channel("dev")` and then pumps the loop. The remote process was in
        state S, blocked in `do_sys_poll`, having consumed ZERO cpu ticks over
        three seconds. `do_sys_poll` is a GTK nested main loop, which is
        exactly what `Gtk.Dialog.run()` is.

        So the defect was never "the modal is called too early", it is that a
        modal is called AT ALL on a path no human necessarily triggered.
        `run()` spins its own loop and does not return until somebody answers,
        so ANY code that iterates the main loop reaches it. The fix is to stop
        blocking: show the dialog and answer its `response` signal. Nothing
        waits, nothing nests a loop, and an unattended run simply leaves a
        dialog nobody fills in.

        The `confirm()` step that used to precede this is gone for the same
        reason, and it was redundant anyway: a dialog whose two fields are
        Login and Password IS the question "do you want to enter credentials",
        so asking first was a click that bought nothing.
        """
        if not self.alive or dev_auth_file_present() or self.busy:
            return False
        held = self._dev_attempt_guard()
        if held:
            self.append_log(held + "\n")
            return False
        self._prompt_credentials_async()
        return False

    def _prompt_credentials_async(self):
        """Show the credential dialog WITHOUT blocking, and act on the answer.

        Same widgets and same handling as `_ask_credentials`; the only
        difference is that the answer arrives in a signal rather than as a
        return value, so no main loop is nested. See the docstring above for
        why that distinction is a correctness one and not a style one.
        """
        dialog, entries = self._credentials_dialog()

        def on_response(dlg, answer):
            login = secret = ""
            try:
                if answer == Gtk.ResponseType.OK:
                    login, secret = self._read_credentials(entries)
            finally:
                # DESTROY BEFORE ACTING, so the entry buffers holding the
                # secret are gone before a helper run starts, and so a second
                # activation cannot find this dialog still on screen.
                dlg.destroy()
            if not login or not secret:
                return
            self.run_helper(["dev-credentials"], "store the dev credentials",
                            secret_stdin="%s\n%s\n" % (login, secret))

        dialog.connect("response", on_response)
        dialog.show_all()

    def _offer_dev_credentials(self):
        """Offer the credential dialog on a dev click. True if one was shown.

        Shares one dialog builder, one value reader and one helper verb with
        the Dev credentials button, so there is exactly one way credentials are
        collected and one way they are stored, whichever door the user came
        through.

        NOTHING HERE BLOCKS. The confirm() that used to precede the prompt is
        gone: it nested a main loop exactly as the prompt did, so it hung an
        unattended run just as hard, and it was redundant anyway because a
        dialog whose two fields are Login and Password already asks the
        question it was asking.
        """
        held = self._dev_attempt_guard()
        if held:
            self.append_log(held + "\n")
            return False
        self._prompt_credentials_async()
        return True

    def _on_dev_auth(self, _button):
        """Collect the dev channel's Basic-Auth credentials, or clear them."""
        if dev_auth_file_present():
            if not self.confirm(
                    "Clear the stored dev credentials?",
                    "This deletes %s. The dev apt source, if you added one, is "
                    "left in place and will start answering 401 until you "
                    "store credentials again." % DEV_AUTH_FILE):
                return
            # THE ONCE-PER-WINDOW LATCH HAS TO BE RELEASED HERE. Without this,
            # clearing the key and then clicking Dev again offered no prompt
            # for the rest of the session, because `_dev_prompt_shown` was
            # still True from the visit that produced the key. The latch exists
            # so a user who CANCELS is not asked on every click; a user who has
            # just deliberately locked the channel is in a different state, and
            # re-locking then re-unlocking is exactly the round trip he asked
            # for in the screenshot.
            self._dev_prompt_shown = False
            self.run_helper(["dev-credentials-clear"],
                            "clear the stored dev credentials")
            return
        held = self._dev_attempt_guard()
        if held:
            self.append_log(held + "\n")
            return
        # THE SAME NON-BLOCKING PROMPT AS THE CHANNEL CLICK. A button press is
        # unambiguously a human, so this path could have kept the blocking
        # dialog; it does not, because leaving one `run()` in the file leaves
        # the hang CLASS in the file, and the next caller of it will not be a
        # button. The two lines of stdin and the argv discipline are unchanged
        # and live in _prompt_credentials_async.
        self._prompt_credentials_async()

    def _credentials_dialog(self):
        """Build the login/password dialog. Returns (dialog, entries).

        SPLIT OUT OF _ask_credentials so the blocking and the NON-BLOCKING
        paths cannot drift: one set of widgets, one set of accessibility
        strings, one password-field configuration. See
        _prompt_credentials_async for why a non-blocking path has to exist.

        Gtk.MessageDialog is not used: it has no room for two entries, and the
        password field needs `set_visibility(False)` plus
        `set_input_purpose(PASSWORD)` so the input method and any accessibility
        bridge treat it as a secret rather than as text to be echoed or cached.
        """
        dialog = Gtk.Dialog(title="Dev channel credentials",
                            transient_for=self.window, modal=True)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        store = dialog.add_button("Store", Gtk.ResponseType.OK)
        store.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(6)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        # ASK FOR THE TWO THINGS AND SAY NOTHING ELSE.
        # Operator, 2026-08-29, on this dialog: "no need ti [expletive] show the
        # user the sensitive paths ! and explain this stuff ! only he shoudl
        # enter correct user name and password !"
        #
        # He is right on both counts and the second is the security one. The
        # old text named the exact on-disk location of the credential store,
        # its mode, and the mechanism by which the secret travels. None of that
        # helps the person typing: they cannot act on it, they did not ask, and
        # it is a free map for anyone reading over their shoulder or looking at
        # a screenshot. Implementation detail belongs in the source, where it
        # still is, and in the tooltip on the Dev credentials button for
        # someone who goes looking. A login prompt asks for a login.
        #
        # The one sentence that survives is the one the user CAN act on: what
        # happens if they guess. See _dev_attempt_guard.
        intro = ui.lbl(
            "Enter the credentials issued for the Kodachi dev channel.",
            "note", wrap=True)
        intro.set_xalign(0.0)
        intro.set_max_width_chars(52)
        box.pack_start(intro, False, False, 0)
        warn = ui.lbl(
            "Repeated wrong attempts are refused by the server and can lock "
            "this machine out of the dev channel. Enter them once, correctly.",
            "note", wrap=True)
        warn.set_xalign(0.0)
        warn.set_max_width_chars(52)
        warn.get_style_context().add_class("repo-stale")
        box.pack_start(warn, False, False, 0)
        entries = {}
        for key, caption, secret in (("login", "Login", False),
                                     ("password", "Password", True)):
            row = ui.hbox(8)
            caption_label = ui.lbl(caption, "note")
            caption_label.set_xalign(0.0)
            caption_label.set_size_request(74, -1)
            row.pack_start(caption_label, False, False, 0)
            entry = Gtk.Entry()
            entry.set_activates_default(True)
            entry.set_width_chars(30)
            caption_label.set_mnemonic_widget(entry)
            ui.set_control_accessibility(
                entry, caption,
                ("Dev repository login name." if not secret else
                 "Dev repository password. The value is hidden and is sent "
                 "to the privileged helper only on stdin."))
            if secret:
                entry.set_visibility(False)
                entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
            entries[key] = entry
            row.pack_start(entry, True, True, 0)
            box.pack_start(row, False, False, 0)
        return dialog, entries

    def _read_credentials(self, entries):
        """Pull both values out of the entries and blank the password widget.

        Shared by both paths, because everything below this line is about what
        the VALUES mean and none of it is about how the dialog was shown.
        Returns (login, secret); either may be empty, and the caller treats an
        empty pair as "do not proceed".
        """
        # THE LOGIN IS STRIPPED AND THE PASSWORD IS NOT, AND THE ASYMMETRY IS
        # DELIBERATE. An inspector read the two lines together on 2026-08-26
        # and asked why the twelve lines below do not apply here as well, which
        # was the right question: both fields are validated by a helper regex
        # that forbids whitespace (LOGIN_BYTES_RE and SECRET_BYTES_RE), and
        # both refuse it loudly.
        #
        # The difference is what the stripped value MEANS. " hunter2 " and
        # "hunter2" are two different secrets and only the person typing knows
        # which one the server holds, so normalising picks one and can be
        # wrong. " alice " is not a login at all, because a login with a space
        # cannot be stored in auth.conf under any circumstances, so "alice" is
        # the only reading that exists and refusing the paste teaches nothing.
        #
        # WHAT IS NOT ACCEPTABLE IS DOING IT SILENTLY, which is the actual
        # complaint behind the finding. If the strip changed anything, the
        # console says so, so the value that got stored is never a secret from
        # the person who typed it.
        typed_login = entries["login"].get_text()
        login = typed_login.strip()
        if login != typed_login:
            self.append_log(
                "note: surrounding whitespace was removed from the login "
                "before storing it; apt's auth.conf cannot carry it.\n")
        # THE PASSWORD IS NOT STRIPPED, AND THAT IS THE FIX, NOT AN OVERSIGHT.
        # The helper validates it against `^[!-~]{8,512}\Z`
        # (kodachi-repo-apt:107) and refuses a value containing a space, tab or
        # newline in exactly those words at its :866. Stripping here means the
        # helper never sees the whitespace, accepts a DIFFERENT password than
        # the one typed, and writes it 0600 root:root into
        # /etc/apt/auth.conf.d/kodachi-dev.conf, which this window cannot read
        # back by design (dev_auth_file_present() says so at its own :859).
        # apt then returns 401 and nothing in the product can explain why. A
        # value with leading or trailing whitespace cannot be stored in
        # auth.conf AT ALL, so this never damages a valid password; all the
        # strip did was convert a loud correct refusal into a silent wrong
        # write.
        secret = entries["password"].get_text()
        # OVERWRITE THE WIDGET BEFORE IT IS DESTROYED. A destroyed Gtk.Entry
        # still leaves its buffer contents in freed heap; setting it empty
        # first means the only copy that outlives this call is the one going
        # down the pipe.
        entries["password"].set_text("")
        if (login and not secret) or (secret and not login):
            self.append_log("Both a login and a password are needed; nothing "
                            "was stored.\n")
            return "", ""
        return login, secret

    def confirm(self, title, body):
        dialog = Gtk.MessageDialog(
            transient_for=self.window, modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL, text=title)
        dialog.format_secondary_text(body)
        answer = dialog.run()
        dialog.destroy()
        return answer == Gtk.ResponseType.OK

    # ------------------------------------------------------------------
    # privileged execution
    # ------------------------------------------------------------------
    def append_log(self, text):
        # A BACKGROUND READER CAN OUTLIVE THE WINDOW. `_pump` marshals every
        # helper line here through GLib.idle_add from a worker thread, and the
        # queued callbacks can still run in the main loop's final iteration
        # after the window is destroyed, which writes into a destroyed
        # TextView and prints Gtk criticals. Guarded here rather than at each
        # of the five idle_add sites, because the check has to happen when the
        # callback RUNS, not when it is queued. The invariant is the file's
        # own: :3125, :3509, :4178 and :4296 all open with the same test.
        if not self.alive:
            return
        buffer = self.log.get_buffer()
        buffer.insert(buffer.get_end_iter(), text)
        # ONLY WHEN FOLLOW IS ON (G40). This used to scroll unconditionally, so
        # a reader who had scrolled up to look at an earlier apt line was
        # yanked back to the bottom by the next write, which during an install
        # is several times a second.
        if getattr(self, "log_follow", None) is None or self.log_follow.get_active():
            mark = buffer.create_mark(None, buffer.get_end_iter(), False)
            self.log.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
            buffer.delete_mark(mark)

    def set_busy(self, busy, note=""):
        self.busy = busy
        self._apply_action_lock()
        # THE ONE CONTROL THAT MUST BE LIVE WHILE BUSY. It is not in
        # self.buttons precisely so this loop cannot switch it off: a Stop that
        # goes insensitive the moment there is something to stop is furniture.
        stop = getattr(self, "log_stop", None)
        if stop is not None:
            stop.set_sensitive(busy)
        # NOT set_text: the note carries markup once a verdict has coloured it,
        # and set_text on a label whose markup is live leaves the plain string
        # rendered in the previous run's colour. _set_run_status owns both,
        # and it also owns the top action bar's copy of the same sentence.
        self._set_run_status(note or ("working" if busy else "idle"),
                             "info" if busy else None)

    def _set_action_sensitive(self, button, desired):
        """Record semantic sensitivity, then apply temporary safety overlays."""
        button.kodachi_semantic_sensitive = bool(desired)
        allowed = bool(desired) and not self.busy
        if (getattr(button, "kodachi_catalog_dependent", False)
                and not self.catalog_ready):
            allowed = False
        button.set_sensitive(allowed)

    def _apply_action_lock(self):
        """Reapply busy/catalog overlays to the latest semantic decisions."""
        def descend(widget):
            yield widget
            if isinstance(widget, Gtk.Container):
                for child in widget.get_children():
                    yield from descend(child)

        controls = set(self.buttons.values())
        if getattr(self, "window", None) is not None:
            controls.update(
                widget for widget in descend(self.window)
                if isinstance(widget, Gtk.Button)
                and getattr(widget, "kodachi_privileged_action", False))
        for button in controls:
            desired = getattr(
                button, "kodachi_semantic_sensitive", button.get_sensitive())
            self._set_action_sensitive(button, desired)

    def _catalog_action_ready(self):
        if self.catalog_ready:
            return True
        self.append_log(
            "Installed-package state is unknown because the catalogue read "
            "failed or is still running. This action is disabled until a "
            "successful refresh; nothing was changed.\n")
        return False

    def stop_helper(self):
        """Abandon the running helper and give the window back.

        NOT a kill, and the wording in the console says so. The child is
        `pkexec kodachi-repo-apt` running as root; an unprivileged killpg from
        here returns EPERM. It is attempted anyway, because DRY runs and any
        future non-pkexec verb would be signallable, but the recovery this
        button guarantees is the window, not the apt run.
        """
        if not self.busy:
            return
        self.helper_stop.set()
        proc = getattr(self, "helper_proc", None)
        if proc is None or proc.poll() is not None:
            return
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        except (OSError, ProcessLookupError):
            # Expected under pkexec. The reader is already unwinding on the
            # event above; say nothing here, `finish` prints the outcome.
            pass

    def _pump(self, proc):
        """Stream the helper's output until EOF, a bound, or Stop.

        Returns "" for a clean EOF, or the reason the read was abandoned.

        The two bounds are independent and both are needed. `last` is renewed by
        any output at all, so a long apt download that keeps printing progress
        never trips the idle bound; `deadline` is the backstop for a helper that
        prints forever and never finishes. select() is given at most a one
        second slice so the Stop event is noticed within a second even when the
        helper is completely silent.
        """
        fd = proc.stdout.fileno()
        pending = b""
        started = time.monotonic()
        last = started
        saw_output = False
        announced_wait = False
        token = self._run_token
        while True:
            if self.helper_stop.is_set():
                return "stopped"
            now = time.monotonic()
            if now - started > HELPER_WALL_SECONDS:
                return "wall"
            if now - last > HELPER_IDLE_SECONDS:
                return "idle"
            if not saw_output:
                # NOTHING HAS ARRIVED AT ALL, not even the helper's startup
                # sentinel, which it emits before it does any work. So the
                # child has not reached its root check, and the only thing
                # that can be happening is the password prompt.
                #
                # THERE IS DELIBERATELY NO "did I see the marker" FLAG HERE,
                # and one was written and removed. The sentinel does its work
                # by being BYTES: it makes `saw_output` mean "the child is
                # alive" instead of "apt has started talking", which is the
                # whole point. A separate flag would be assigned and never
                # read, which a sabotage arm proved: disabling it changed no
                # behaviour and failed no test.
                #
                # Requiring the MARKER specifically, rather than any output,
                # would be actively wrong: a helper too old to emit it still
                # prints apt's output, and demanding the marker would blame
                # the password prompt for a run that is visibly working.
                waited = now - started
                if waited > HELPER_AUTH_SECONDS:
                    return "noauth"
                if waited > HELPER_AUTH_NOTE_SECONDS and not announced_wait:
                    announced_wait = True
                    # BOUND TO THIS RUN. A queued idle callback can otherwise
                    # run after the output has started, or after the run has
                    # finished, and label a completed or a LATER run as
                    # waiting for a password.
                    GLib.idle_add(self._note_waiting_for_password, token)
            try:
                ready, _, _ = select.select([fd], [], [], 1.0)
            except (OSError, ValueError):
                break
            if not ready:
                continue
            try:
                chunk = os.read(fd, 65536)
            except OSError:
                break
            if not chunk:
                break
            last = time.monotonic()
            saw_output = True
            pending += chunk
            while b"\n" in pending:
                line, pending = pending.split(b"\n", 1)
                GLib.idle_add(self._emit_line,
                              line.decode("utf-8", "replace"))
        if pending:
            # THE TAIL IS NOT ROUTED THROUGH THE PROGRESS FILTER, on purpose.
            # This branch runs when the pipe closed without a final newline, so
            # what is here is a PARTIAL line. A half-arrived `pmstatus:` would
            # parse as a status line with a truncated description and set the
            # bar from an incomplete percentage; and since the run is over by
            # definition here, there is no bar left to drive anyway. Log it.
            GLib.idle_add(self.append_log,
                          pending.decode("utf-8", "replace") + "\n")
        return ""

    def _note_waiting_for_password(self, token=None):
        """Say that the wait is the password prompt, while it is still waiting.

        WRITTEN AS A SEPARATE METHOD SO A TEST CAN CALL IT, and reached from
        `_pump` through GLib.idle_add because it touches the console and the
        top bar and `_pump` is a worker thread.

        The wording names the window's own remedy rather than describing the
        machinery. A user who cannot see a dialog does not need the word
        polkit; they need to know a dialog is outstanding, that it can be
        behind this window, and that Stop is safe because nothing has started.
        """
        if not self.alive:
            return False
        # THE CALLBACK MAY BE LATE. It was queued from the worker thread while
        # the run was silent; by the time the main loop reaches it the run can
        # have produced output, finished, or been replaced by a newer one.
        # Writing "waiting for your password" over any of those is worse than
        # not writing it at all.
        if token is not None and token != self._run_token:
            return False
        if not self.busy:
            return False
        self.append_log(
            "waiting for your password , a prompt should have opened. It can "
            "appear BEHIND this window or on another workspace, so check "
            "there first. Nothing has started yet, so Stop is safe.\n")
        self._set_run_status("waiting for your password", "warn")
        return False

    def _emit_line(self, line):
        """One complete helper output line: progress protocol, or log text.

        Runs on the GTK thread via idle_add, which is required: it touches the
        progress bar and the text buffer, and _pump is a worker thread.
        """
        if not self.alive:
            return False
        if not self.consume_progress(line):
            # apt's own `Need to get 13.3 MB of archives.` arrives here, on the
            # LOG side, not the protocol side. It is the only place the total
            # download size is stated, and it always precedes the dlstatus
            # lines that report a percentage of it.
            self._note_download_total(line)
            self.append_log(line + "\n")
        return False

    def _drain(self, proc):
        """Read and discard until the helper is gone, then reap it.

        Returns True when the helper exited and was reaped, False when the
        pipe outlived it.

        Only the abandoned path calls this, and only because `_pump` has
        already stopped reading. See the call site for why a bare wait()
        deadlocks instead. `os.read` on the raw descriptor, NOT
        `proc.stdout.read()`: the buffered object is the one `_pump` was using
        and reading it here would interleave with nothing, but the raw fd is
        what the kernel buffer belongs to and is what `_pump` itself reads, so
        the two agree about what has been consumed.

        THIS BLOCKS FOR AS LONG AS THE HELPER LIVES, AND THAT IS THE POINT,
        NOT AN OVERSIGHT. `_pump` has a wall and an idle bound; this
        deliberately has neither, because the caller only reaches it on the
        leg where the helper CANNOT BE KILLED (it is pkexec'd to root and
        os.killpg gets EPERM), and `finish` is the one place that re-enables
        every privileged action. Giving up early would hand the buttons back
        while a root apt is still mid-transaction and let a second mutation
        overlap it, which is a worse defect than a long wait. `busy` must stay
        true for exactly as long as the helper lives, so the read is bounded by
        the helper's own lifetime and by nothing else. The window itself stays
        responsive throughout: this runs on the daemon worker thread, never on
        the GTK main loop.

        THE ONE CASE THAT IS NOT THE HELPER'S LIFETIME, and the reason for the
        poll below: a GRANDCHILD can inherit the write end and hold it open
        after the helper exits, so waiting for EOF alone could outlive the
        condition that justifies waiting at all. A second of silence is
        therefore rechecked against `proc.poll()`, and once the helper is gone
        the safety reason is gone with it and this returns. select() with a one
        second slice is what makes that recheck possible; an unconditional
        os.read cannot notice anything.
        """
        try:
            fd = proc.stdout.fileno()
        except (AttributeError, ValueError):
            fd = None
        reaped = False
        while fd is not None:
            try:
                ready, _, _ = select.select([fd], [], [], 1.0)
            except (OSError, ValueError):
                break
            if ready:
                try:
                    if not os.read(fd, 65536):
                        break
                except OSError:
                    break
                continue
            if proc.poll() is not None:
                # Helper gone, pipe still open: somebody else holds the write
                # end. Stop reading for it.
                break
        try:
            proc.wait(timeout=5)
            reaped = True
        except (subprocess.TimeoutExpired, OSError):
            reaped = False
        # CLOSE THE READ END. Without this the fd lives until Popen.__del__,
        # which for an abandoned run is an indeterminate point later, and one
        # descriptor leaks per abandonment.
        try:
            proc.stdout.close()
        except (AttributeError, OSError, ValueError):
            pass
        return reaped

    def _abandon(self, proc, reason):
        """Stop reading a helper that is not going to finish, and say so plainly.

        The signal is attempted and its failure is EXPECTED, not an error: the
        child is pkexec'd to root and this process is not. What this returns is
        the text the console shows, and it must not claim the run was killed
        when all that happened is that the window stopped listening.
        """
        killed = False
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
            killed = True
        except (OSError, ProcessLookupError):
            killed = False
        if killed:
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    pass
        if reason == "stopped":
            head = "stopped at your request"
        elif reason == "noauth":
            # SAY WHAT WAS OBSERVED, NOT WHAT HAPPENED. The helper announces
            # itself before it does any work, so its silence is real evidence
            # that it never started; but the only thing this process can
            # actually testify to is that nothing was heard. Claiming "nothing
            # ran" outright is a stronger statement than the pipe supports, and
            # it is the dangerous direction, because it invites the user to
            # retry an operation that may in fact be under way.
            head = ("nothing was heard for %d seconds and the helper never "
                    "reported starting, so the password prompt was almost "
                    "certainly not answered" % HELPER_AUTH_SECONDS)
        elif reason == "idle":
            head = ("the helper printed nothing for %d seconds"
                    % HELPER_IDLE_SECONDS)
        else:
            head = ("the helper was still running after %d seconds"
                    % HELPER_WALL_SECONDS)
        if killed:
            return (head + "; it was signalled and privileged actions are "
                    "available again", True)
        return (head + "; it runs as root under pkexec so this window cannot "
                "signal it. Navigation and read-only pages remain usable, "
                "but privileged actions stay disabled until that exact "
                "process exits. If a package operation is still running, "
                "`sudo fuser /var/lib/dpkg/lock-frontend` will name it.",
                False)

    def settle_run(self, code, extra, description):
        """Write everything a finished run must leave behind, in one place.

        PUBLIC AND NOT UNDERSCORED, because a test calling it is the point.
        Returns False so it can be the whole body of a GLib idle callback.
        """
        self._progress_end()
        if extra:
            self.append_log(extra + "\n")
        started = getattr(self, "_run_started", None)
        took = ("" if started is None
                else self._human_seconds(time.monotonic() - started))
        # THE CONSOLE LINE AND THE VERDICT ARE WRITTEN FROM ONE DECISION, so
        # the pane and the always-visible labels can never disagree about
        # whether the run worked.
        if code == 0:
            self.append_log("done in %s: %s\n" % (took, description))
            verdict = "finished OK in %s , %s" % (took, description)
            tone = "on"
        elif code == 126:
            self.append_log("cancelled: the authentication dialog was "
                            "dismissed, nothing ran\n")
            verdict = ("cancelled , the password prompt was dismissed, "
                       "nothing ran")
            tone = "off"
        elif code == HELPER_UNCHANGED:
            # A RUN THAT CORRECTLY CHANGED NOTHING IS NOT A FAILED RUN. The
            # apt refresh still happened and the machine is in the state that
            # was asked for; the only thing that did not happen is a change.
            # Tone "off" rather than "err", for the same reason a dismissed
            # password prompt is not red: nothing is wrong.
            self.append_log("nothing to change in %s: %s was already in "
                            "place\n" % (took, description))
            verdict = ("unchanged , %s , it was already in place" % description)
            tone = "off"
        elif code == 130:
            self.append_log("stopped after %s: %s\n" % (took, description))
            verdict = "stopped by you after %s , %s" % (took, description)
            tone = "warn"
        elif code == 124:
            # The `extra` line already explained which bound fired and whether
            # the helper could be signalled. Repeating "failed with exit code
            # 124" under it would read as a second, different problem.
            #
            # EXIT 124 IS TWO DIFFERENT EVENTS AND THE CAUSE MUST NOT BE
            # GUESSED. `_pump` returns "idle" when the helper printed nothing
            # for HELPER_IDLE_SECONDS, and "wall" when the whole run outlived
            # HELPER_WALL_SECONDS; the wall case can be a helper that is
            # talking steadily and simply taking too long. Saying "the helper
            # stopped printing" there is a false diagnosis of a real event,
            # which sends the reader looking for a hang that is not happening.
            # <agent>, 2026-08-30.
            cause = {"idle": "the helper stopped printing",
                     "noauth": "the password prompt was never answered",
                     "wall": "it ran past the time limit"}.get(
                         getattr(self, "_stop_reason", None), "")
            self.append_log("gave up waiting for: %s (after %s)\n"
                            % (description, took))
            verdict = ("TIMED OUT after %s , %s%s"
                       % (took, description,
                          " , " + cause if cause else ""))
            tone = "err"
        elif code == 127 and self._looks_like_a_missing_polkit_agent():
            # 127 MEANS "COULD NOT RUN THE COMMAND", AND ONE CAUSE MAY BE
            # NAMED ONLY WHEN THE OUTPUT PROVES IT. pkexec exits 127 when it
            # cannot run the command at all, and on a desktop the reachable
            # cause is that no polkit AUTHENTICATION AGENT is running, so there
            # is nothing to draw the password dialog; pkexec falls back to a
            # textual agent, finds no controlling terminal, and gives up in
            # milliseconds. MEASURED on <lab-host>, 2026-08-30, where the
            # operator pressed Install and got "FAILED , exit code 127 after
            # 0s" and no other clue:
            #   Error creating textual authentication agent: Error opening
            #   current controlling terminal for the process (`/dev/tty')
            # polkitd was running; the AGENT was not.
            #
            # GATED ON THAT SIGNATURE AND NOT ON THE CODE, because the HELPER
            # can exit 127 too, for its own reasons, and telling somebody their
            # desktop has no authentication agent when the real fault is a
            # missing binary is a false diagnosis of a real failure. That is
            # the same defect as the 124 idle-vs-wall split below, and I did
            # not carry the lesson across until <agent> said so.
            self.append_log(
                "could not ask for your password: no authentication agent is "
                "running on this desktop, so pkexec had nothing to prompt "
                "with. Nothing was installed or changed. Starting the "
                "session's polkit agent, or logging out and back in, restores "
                "it.\n")
            verdict = "FAILED , no password prompt available , nothing ran"
            tone = "err"
        else:
            self.append_log("failed with exit code %d after %s: %s\n"
                            % (code, took, description))
            verdict = ("FAILED , exit code %d after %s , %s"
                       % (code, took, description))
            tone = "err"
        if getattr(self, "_running_verb", None) == "dev-credentials":
            self._note_dev_attempt(code)
        self._running_verb = None
        # ORDER IS THE WHOLE FIX AND IT IS FRAGILE, so it is one pair of
        # adjacent lines with nothing between them. set_busy(False) writes the
        # word "idle" into the same labels, which is what an untouched window
        # says, so a verdict written BEFORE it was erased a microsecond later
        # and every finished run looked exactly like a window nobody had used.
        self.set_busy(False)                      # SETTLE-ORDER-BUSY
        self._set_run_status(verdict, tone)       # SETTLE-ORDER-VERDICT
        self._run_started = None
        self.reload()
        return False

    def run_helper(self, argv, description, secret_stdin=None):
        """Run one helper verb under pkexec, optionally feeding it a secret.

        `secret_stdin` IS NEVER LOGGED AND NEVER REACHES ARGV. The command line
        is echoed into the console pane, which the operator reads and which
        this window keeps on screen, so a password passed as an argument would
        be printed in the window as well as being visible in /proc/*/cmdline to
        every local process. It goes down the pipe, the pipe is closed, and the
        console shows only the verb.
        """
        if self.busy:
            self.append_log(
                "Another privileged repository operation is still running; "
                "this request was not started.\n")
            return
        # ASK FOR THE PROTOCOL LINE. The helper emits its startup sentinel only
        # when this flag is present, because the same verbs are run by the dock
        # and by the Tauri dashboard, both of which show its stdout verbatim
        # and neither of which parses protocol. This window is the only caller
        # that wants it.
        command = ["pkexec", helper_path(), PROTOCOL_FLAG] + list(argv)
        # WHERE THIS RUN'S OUTPUT BEGINS. Stamped BEFORE the command echo, so
        # everything from the `$ pkexec ...` line onward belongs to this run
        # and nothing before it can be read as evidence about it. See
        # _looks_like_a_missing_polkit_agent.
        self._log_cursor = len(self.console_text())
        # THE ECHO OMITS THE PROTOCOL FLAG, deliberately, and this is the one
        # place in this window where what is shown is not byte-for-byte what is
        # executed. The flag is a negotiation between this window and its
        # helper about whether one machine-readable line is printed; it changes
        # nothing about the operation. The card detail panel's "WHAT THE BUTTON
        # RUNS" shows the un-flagged form, and a user comparing the two should
        # not be shown a discrepancy that means nothing to them.
        shown = [part for part in command if part != PROTOCOL_FLAG]
        self.append_log("\n$ %s%s\n"
                        % (" ".join(shown),
                           "   (credentials sent on stdin, not shown)"
                           if secret_stdin else ""))
        if DRY:
            self.append_log("dry run, nothing was executed\n")
            return
        self.helper_stop = threading.Event()
        self.helper_proc = None
        # WHICH VERB THIS RUN IS, so `finish` can attribute the exit code. Only
        # the credential verb is tracked; everything else leaves it None and
        # the brute-force counter is untouched.
        self._running_verb = argv[0] if argv else None
        # WHEN THIS RUN STARTED, so `finish` can say how long it took. He is
        # timing these operations by hand today, which is the complaint.
        self._run_started = time.monotonic()
        self._run_token += 1
        # CLEARED PER RUN. Left over from a previous timeout it would attach
        # the wrong cause to the next one.
        self._stop_reason = None
        self.set_busy(True, description)
        # ORDER: busy first, then the bar, then the pane. _progress_pulse
        # returns False unless `self.busy` is already True, so beginning the
        # progress before set_busy would start a pulse that stops itself on its
        # first tick and leave a dead bar on screen for the whole run.
        self._progress_begin(description)
        self._auto_expand_console()
        # THE RAIL STOPS ASSERTING THE MOMENT THE OPERATION STARTS.
        # Operator, 2026-08-29: "The updates items remained 7 even though the
        # update is running". They did, and no number could have been right:
        # apt is mid-flight, so Installed, Upgradable, Pinned and the channel
        # totals are all unknowable until it exits, and there is no cheap way
        # to sample them meanwhile (a recount is a dpkg-query plus nine index
        # reads). The choice is therefore between showing a number that is
        # certainly stale and showing none, and a confident wrong number is
        # the worse of the two: it is indistinguishable from a current one.
        # `finish` calls reload(), which refills every row from the machine as
        # it is afterwards. Buttons are already locked by set_busy, so nothing
        # gates on these counts while they are blank.
        self.catalog_ready = False
        self._refresh_nav_counts()

        def worker():
            # BUSY IS CLEARED IN EXACTLY ONE PLACE, `finish`, AND THAT PLACE
            # USED TO SIT ON THE HAPPY PATH. Any exception raised below the
            # Popen killed this daemon thread with `finish` never called, so
            # `set_busy(False)` never ran and the window sat BUSY FOREVER:
            # no error, no cancel, no recovery but closing it. The traceback
            # goes to stderr, which for a dock-launched app nobody ever sees.
            # A silent permanent wedge is worse than a crash.
            #
            # The reachable producer (<agent>, 2026-08-23) is the read
            # loop: this pipes `pkexec kodachi-repo-apt`, which echoes apt's
            # Description and Maintainer fields out of THIRD-PARTY Packages
            # files. Debian policy says UTF-8; a third-party repo is not bound
            # by Debian policy, and managing third-party repos is the entire
            # purpose of this window. `errors="replace"` below removes that
            # producer. The try/finally removes the CLASS, which is the half
            # that matters: an OSError mid-read or a broken pipe wedges the
            # window just as silently and `errors=` does nothing about either.
            code, extra = 1, ""
            try:
                try:
                    # BINARY AND UNBUFFERED, and that is a bound requirement,
                    # not a style choice. The bounded read below has to ask
                    # select() whether the PIPE has data, and select() knows
                    # nothing about bytes already sitting in a Python text
                    # wrapper's buffer: with a buffered reader it can answer
                    # "nothing to read" while a complete line waits in
                    # userspace, and the idle bound would then fire on a helper
                    # that is talking. Lines are assembled here instead, and
                    # `errors="replace"` moves from the reader to the decode,
                    # which is where the third-party UTF-8 producer needs it.
                    proc = subprocess.Popen(
                        command,
                        stdin=(subprocess.PIPE if secret_stdin
                               else subprocess.DEVNULL),
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                        bufsize=0, start_new_session=True)
                except OSError as exc:
                    extra = "could not start the helper: %s" % exc
                    return
                self.helper_proc = proc
                if secret_stdin:
                    try:
                        proc.stdin.write(secret_stdin.encode("utf-8"))
                        proc.stdin.close()
                    except OSError:
                        # A pkexec the user dismissed dies before reading, so
                        # the write gets EPIPE. That is a cancel, not a
                        # failure, and the exit code below already says so.
                        pass
                stop_reason = self._pump(proc)
                if stop_reason:
                    # ABANDONED, NOT FINISHED. Do not wait on a process we
                    # just decided is not going to end: that is the wedge this
                    # whole block exists to remove, one level down.
                    code = 130 if stop_reason == "stopped" else 124
                    # WHICH BOUND FIRED, for settle_run's verdict. "idle" and
                    # "wall" both arrive as 124 and mean different things.
                    self._stop_reason = stop_reason
                    extra, killed = self._abandon(proc, stop_reason)
                    if not killed:
                        # Do not pass the unsignalable process through finish:
                        # finish is the one place that re-enables every action.
                        # The prior implementation did exactly that, allowing
                        # a second source/key/package mutation to overlap PID1.
                        GLib.idle_add(self.append_log, extra + "\n")
                        GLib.idle_add(
                            self._set_run_status,
                            # NAME THE SURPRISING FACT, NOT THE VISIBLE ONE.
                            # "actions disabled" describes something he can
                            # already see: the buttons are greyed. What he
                            # cannot see is WHY, and the why is that he pressed
                            # Stop and the process did not stop, because it runs
                            # as root under pkexec and this window has no way to
                            # signal it. Without that clause the window looks
                            # broken rather than honest, which is the whole
                            # "I pressed Stop and nothing happened" class.
                            # The full explanation is already in the log via
                            # `_abandon`; this is the one line that stays on
                            # screen. Same length as the string it replaces, and
                            # the label carries END ellipsize (:2597) anyway, so
                            # it cannot widen the window.
                            #
                            # THROUGH _set_run_status, NOT console_note.set_text.
                            # This arm wrote the console label DIRECTLY, so the
                            # top action bar and the window title kept showing
                            # "Downloading 43%" for as long as the root process
                            # lived, which can be minutes: three places
                            # disagreeing about the same run, which is exactly
                            # what _set_run_status exists to prevent. It is also
                            # the worst place to disagree, because the run has
                            # been handed back and the progress is frozen.
                            # <agent>, 2026-08-30.
                            "still running as root; Stop cannot end it",
                            "warn")
                        extra = ""
                        # KEEP DRAINING. The window is handed back here, but
                        # THE READER MUST NOT STOP. `_pump` returned because a
                        # bound fired or Stop was pressed, and it stopped
                        # reading; from this line on nothing else drains the
                        # pipe. The helper runs apt with INHERITED stdout
                        # (`run()` in kodachi-repo-apt builds its Popen with no
                        # `stdout=` argument), so apt writes into THIS pipe,
                        # blocks in write(2) once the kernel buffer fills, and
                        # blocks while holding an apt/dpkg lock. WHICH lock is
                        # NOT recorded here because it was never observed; the
                        # two `fuser /var/lib/dpkg/lock-frontend` lines
                        # elsewhere in this chain are advice to the user about
                        # where to look, not a measurement of this path. The
                        # helper's own APT_WALL_SECONDS rescue is defeated by
                        # the same full pipe, because `run()` prints a line
                        # BEFORE it signals apt, so the rescue blocks in the
                        # write it makes on the way to the kill. Draining here
                        # is therefore what lets the HELPER's rescue complete,
                        # not merely what lets this thread finish. So a bare `proc.wait()` here never
                        # returns, `finish` never runs, `busy` stays True and
                        # every privileged action is dead for the life of the
                        # window: the exact wedge the comment above says this
                        # block exists to remove, reintroduced by the one line
                        # that stopped reading. The bytes are discarded rather
                        # than logged, because the console has already said the
                        # run was abandoned and an abandoned operation must not
                        # keep writing into the pane.
                        if self._drain(proc):
                            extra = ("the previously detached helper has "
                                     "exited; privileged actions are "
                                     "available again")
                        else:
                            # SAY WHICH ONE. "available again" after a drain
                            # that gave up would assert the helper is gone
                            # when all that is known is that it stopped being
                            # reachable through this pipe.
                            extra = ("the detached helper could no longer be "
                                     "followed through its pipe; privileged "
                                     "actions are available again, but check "
                                     "for a running apt before starting "
                                     "another change")
                else:
                    proc.wait()
                    code = proc.returncode
            except BaseException as exc:
                # BaseException, not Exception, deliberately: a KeyboardInterrupt
                # or a SystemExit delivered to this thread would otherwise leave
                # the window wedged in exactly the way this block exists to
                # prevent. The exception is reported, not swallowed silently.
                code = 1
                extra = ("the helper reader failed: %s"
                         % _exc_detail(exc))
            finally:
                GLib.idle_add(finish, code, extra)

        def finish(code, extra):
            """The run is over. One line, and it delegates.

            THE BODY LIVES IN `settle_run` AND NOT HERE, and that is a
            TESTABILITY fix with teeth. As a closure over `description` this
            code was unreachable from any test without re-entering run_helper
            and spawning pkexec, so my first suite reconstructed the verdict
            table inside the test and sabotaged ITSELF: the reds proved the
            harness's ordering and a production omission would have passed.
            Found by <agent>, 2026-08-30, reviewing this change.
            """
            if not self.alive:
                return False
            return self.settle_run(code, extra, description)

        try:
            threading.Thread(target=worker, daemon=True).start()
        # `Exception`, NOT `RuntimeError`, AND THE NARROW CATCH WAS A REAL HOLE.
        # MEASURED 2026-08-26 against this machine's CPython 3.13.5:
        # `threading.Thread.start` wraps its call to `_start_joinable_thread` in
        # `except Exception: ...; raise`, i.e. the standard library itself expects a
        # non-RuntimeError out of it. `RuntimeError("can't start new thread")` is the
        # common failure, but the allocation underneath raises `MemoryError`, which is
        # precisely the condition under which a thread fails to start in the first
        # place. A MemoryError skipped this arm entirely and left the manager in the
        # busy state it had already entered. `Exception` and not `BaseException`, so a
        # KeyboardInterrupt or SystemExit still propagates rather than being rendered
        # to the operator as a repository error.
        except Exception as exc:
            finish(
                1, "could not start helper thread: %s"
                % _exc_detail(exc))


class RepoManagerApplication(Gtk.Application):
    """One session-bus owner; a second launch activates the existing window."""
    def __init__(self):
        Gtk.Application.__init__(
            self, application_id="com.kodachi.RepositoryManager",
            flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.manager = None

    def do_activate(self):
        if self.manager is None:
            ui.install_css()
            ui.install_icon()
            self.manager = RepoManager()
            self.manager.window.set_application(self)
            self.manager.window.show_all()
        self.manager.window.present()


def main():
    return RepoManagerApplication().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
