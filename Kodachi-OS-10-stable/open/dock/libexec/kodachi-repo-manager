    os.path.dirname(os.path.abspath(__file__)))), "lib", "kodachi")
if os.path.isdir(_LOCAL_LIB):
    # Running out of a worktree or a staged tree, not the installed path. The
    # installed path stays FIRST so a stale copy beside the checkout can never
    # shadow the shipped module on a real machine.
    sys.path.append(_LOCAL_LIB)

