def _exc_detail(exc):
    """Render an exception for a user-facing recovery message, never raising.

    THE RECOVERY MUST NOT BE ABLE TO RAISE. Every caller of this is the `except`
    arm of a `Thread.start()`, and by the time one runs the window has ALREADY
    committed to a busy state: an action lock is applied, a note reads
    "checking", or `set_busy(True)` has disabled the toolbar. An exception
    escaping one of those arms leaves the manager in that state permanently,
    with no way out but closing the window, which is exactly what the arm exists
    to prevent. So the class NAME is read first, which is a plain attribute of
    the type and cannot raise, and the text is attempted separately.

    Copied deliberately rather than imported: this file shares no module with
    `kodachi-command-window`, which carries the identical helper for the same
    reason at its own `start_daemon` sites. Keep the two in step.
    """
    try:
        return "%s: %s" % (type(exc).__name__, exc)
    except BaseException:
        return type(exc).__name__


def source_uri_has_userinfo(uri):
    """Reject credentials embedded in an apt URI before they reach argv."""
    try:
        parsed = urlsplit(uri)
        return parsed.username is not None or parsed.password is not None
    except (TypeError, ValueError):
        # Malformed authority syntax is not safe to treat as credential-free.
        return True

DRY = os.environ.get("KODACHI_DRY_RUN") == "1"
HELPER = "/usr/local/libexec/kodachi/kodachi-repo-apt"

# G64: THE WINDOW COULD SIT BUSY FOREVER. Reported by <agent>,
# 2026-08-23. `set_busy(True)` makes every button in the window insensitive,
# `run_helper` early-returns while `self.busy`, and busy is cleared in exactly
# one place, `finish`, reached only through the worker's `finally`. A `finally`
# runs on exception or on completion; it does not run while the thread is still
# blocked. The read loop below had no bound on either the read or the wait, so
# a stalled helper left every button dead, the console stuck on "working", and
# no exit but closing the window.
#
# That is the same user-visible state the try/finally above already fixed for
# the EXCEPTION route. This is the HANG route, which raises nothing, so the
# `finally` never fired either. Same symptom, different producer.
#
# TWO BOUNDS, NOT ONE, because a single wall clock has to choose between
# aborting a legitimate 20-minute upgrade over a slow mirror and letting a
# wedged one sit for that long. The idle bound is what a stall actually looks
# like: apt prints continuously, so silence is the signal, and a long download
# that is still printing progress renews it. The wall clock is the backstop for
# something that prints forever without finishing.
#
# The GUI CANNOT KILL THE HELPER and does not pretend to. The child is
# `pkexec kodachi-repo-apt`, so it runs as root and `os.killpg` from here gets
# EPERM. What this side owns is the WINDOW: it stops reading, says what
# happened, and gives the buttons back. Actually stopping apt is the helper's
# own APT_WALL_SECONDS, which runs as root and can signal its process group.
#
# WHICH OF THESE TWO CAN STRAND A FULL PIPE DEPENDS ON A NUMBER IN ANOTHER
# FILE, AND ON WHETHER ANYONE HAS SET THE OVERRIDE. The helper's own bound is
# APT_WALL_SECONDS = 900 and, per the paragraph above its definition, it takes
# NO environment override because pkexec sanitises the environment. These two
# DO take one. So:
#
#   for a ONE-apt verb at the defaults
#                             240 idle fires first, and 1800 wall is not
#                             reached, because the helper self-terminates at
#                             900 while this side is still reading.
#   for a TWO-apt verb        REACHABLE. verb_upgrade, verb_system and
#                             verb_enable each make two separately bounded
#                             apt calls, so one helper invocation has a
#                             2 x 900 = 1800s worst case, which is NOT less
#                             than the wall.
#   with KODACHI_REPO_WALL_TIMEOUT set lower
#                             REACHABLE for any verb. These two take an
#                             environment override and APT_WALL_SECONDS
#                             deliberately does not, because pkexec sanitises
#                             the environment and a knob that never arrives
#                             would read as present and do nothing.
#
# I FIRST WROTE THAT THE WALL ARM COULD NOT WEDGE AT ALL. That was wrong in
# both of the ways above; the second was found by an independent inspector
# counting apt calls per verb, which is a thing neither constant tells you.
# The drain below covers all three arms and always did; only this paragraph
# was ever wrong, and a paragraph is what the next maintainer reasons from.
#
# The drain below therefore covers all three arms and is not written for two.
# Recorded here rather than only at the drain, because this is the line
# somebody will be looking at when they change the number.
HELPER_IDLE_SECONDS = int(os.environ.get("KODACHI_REPO_IDLE_TIMEOUT", "240"))
# ZERO BYTES IS NOT THE SAME EVENT AS OUTPUT STOPPING, and conflating them cost
# the operator four minutes of a window that looked frozen. Measured 2026-08-30
# on <lab-host>: `pkexec kodachi-repo-apt update` sat with a password
# dialog outstanding, produced NOTHING, and the only feedback for 240 seconds
# was a pulsing bar. `apt-get update` on the same box finishes in 6 seconds, so
# every second of that wait was authentication, not work.
#
# The distinction matters because the two have different remedies. Output that
# stops mid-run is a helper problem and the advice is about dpkg locks. No
# output at all means the run never started, and the remedy is a password
# prompt the user cannot see. Announce it EARLY at the note bound, and give up
# on it far sooner than the idle bound, because there is nothing to wait for.
HELPER_AUTH_NOTE_SECONDS = int(
    os.environ.get("KODACHI_REPO_AUTH_NOTE", "20"))
HELPER_AUTH_SECONDS = int(
    os.environ.get("KODACHI_REPO_AUTH_TIMEOUT", "90"))
HELPER_WALL_SECONDS = int(os.environ.get("KODACHI_REPO_WALL_TIMEOUT", "1800"))
_LOCAL_HELPER = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "kodachi-repo-apt")

# The window, and how much of it a full-width page may use. The sidebar and
# the window chrome are the difference; a page table wider than PAGE_WIDTH is
# a page that clips on the screen the window was sized for.
# The command log's height, in pixels, from the top of its heading to the
# bottom of the window. Used twice: as the scroller's floor, and as the offset
# the vertical divider is pinned to on first allocation.
#
# RAISED FROM 96 TO 190, AND THE OLD NUMBER IS THE OPERATOR'S COMPLAINT OF
# 2026-08-29 IN ONE CONSTANT: "the long down is [expletive] hidden how can the user
# see it". 96 total minus the 44px header row is FIFTY-TWO PIXELS of text,
# which at this theme's monospace metric is three lines, and his screenshot
# shows one, because the two-row CHANNEL MIGRATION bar sits below it. apt's
# own output is what this window tells him to read before it acts, so three
# lines is not a small pane, it is an unusable one.
#
# 190 minus the header is ~146px, about nine lines: enough to see an apt
# summary ("N upgraded, N newly installed...") without scrolling, which is the
# thing the window asks him to check. It is still a MINORITY of a 700px window.
CONSOLE_HEIGHT = 190

# What the log grows to when he presses Expand, or when a run starts and the
# console is still at its default. Deliberately expressed as a FRACTION of the
# window rather than a pixel count: the whole defect being fixed here is a
# constant that was right at one window size and wrong at every other.
CONSOLE_EXPANDED_FRACTION = 0.55

# The smallest top pane worth pinning a divider around. Below
# CONSOLE_HEIGHT + MIN_TOP_PANE the divider is left alone, because taking 112
# pixels for the log out of a 200 pixel pane leaves the table unusable and
# both panes scroll anyway.
MIN_TOP_PANE = 170

