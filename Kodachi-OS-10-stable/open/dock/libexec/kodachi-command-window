    os.path.dirname(os.path.abspath(__file__)), "kodachi-firejail-launcher")
ISOLATION_LAUNCHER = "/usr/local/libexec/kodachi/kodachi-isolation-launcher"
LOCAL_ISOLATION_LAUNCHER = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "kodachi-isolation-launcher")
ISOLATION_RUNTIME_LABELS = {
    "native": "NATIVE", "firejail": "FIREJAIL", "podman": "PODMAN"}
# The two DECLARATIVE pages whose buttons need a container runtime. The three
# builtin pages read the machine themselves and carry the same banner from
# inside their own sections().
CONTAINER_DEPENDENT_SPECS = ("sandbox", "containers")
