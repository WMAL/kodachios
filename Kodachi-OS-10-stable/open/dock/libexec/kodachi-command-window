def _capture(argv, timeout, stdin_text=None):
    """Run one program and return its stdout, or None. Never raises.

    ABSENT, REFUSED AND ANSWERED-WITH-NOTHING ALL COLLAPSE TO None ON PURPOSE
    here, because every caller below treats them the same way: the section that
    reading would have filled is simply not drawn, exactly as the dock script
    does. That is the opposite of _read_lines(), which keeps them apart because
    its callers render the reason.
    """
    if not argv or not os.path.isabs(argv[0]):
        return None
    if not (os.path.isfile(argv[0]) and os.access(argv[0], os.X_OK)):
        return None
    try:
        done = subprocess.run(
            argv,
            input=stdin_text if stdin_text is not None else None,
            stdin=None if stdin_text is not None else subprocess.DEVNULL,
            capture_output=True, text=True, errors="replace", timeout=timeout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    return done.stdout or ""


def _session_remote_timezone():
    """The timezone of the public IP, or "".

    A NETWORK ROUND TRIP, NOT A SNAPSHOT READ, so it is fetched separately and
    under its own short timeout. Kodachi binaries print a progress line and box
    rules before the answer, so the LAST timezone-shaped token is taken rather
    than the first line, which is the banner. Same extraction the dock script
    uses; taking the first line was measured there to return the banner.
    """
    out = _capture(["/usr/bin/sudo", "-n", HEALTH_CONTROL, "show-remote-timezone"],
                   SESSION_REMOTE_TZ_TIMEOUT)
    if not out:
        return ""
    found = re.findall(r"[A-Za-z]+/[A-Za-z_+-]+", out)
    return found[-1] if found else ""


def _session_report_stream(fresh):
    """(tagged report, "") on success, or (None, why) naming what failed.

    ONE conky-status CALL FEEDS EVERY ROW. Collecting a fresh snapshot walks
    eight adapters and was measured at 10.45s on the test VM, so a report that
    asked per field would cost that many times over. The pool is a SECOND call
    on purpose: it is tor-switch state and is the one thing about Tor that
    cannot be inferred from the exit IP, and a machine with no pool then simply
    has no section rather than a section full of unknown.
    """
    argv = [STATUS_REFRESH_EXECUTABLE, "panel", "all", "--ttl", SESSION_SNAPSHOT_TTL]
    if fresh:
        argv.append("--refresh")
    argv.append("--json")
    snapshot = _capture(
        argv, SESSION_FRESH_TIMEOUT if fresh else SESSION_SNAPSHOT_TIMEOUT)
    if not snapshot or not snapshot.strip():
        return None, ("The status snapshot could not be read, so there is "
                      "nothing to show. conky-status did not answer.")
    # NAME THE PRODUCER THAT ACTUALLY FAILED. Raised by the inspector: every
    # None used to come back as "conky-status did not answer", including the
    # case where conky-status answered perfectly and the RENDERER was missing
    # or broken. The renderer runs through subprocess.run directly rather than
    # through _capture, so it never gets _capture's executable check either.
    # Telling somebody the wrong half failed is worse than telling them
    # nothing, because it sends them to look at the wrong file.
    if not os.path.isfile(SESSION_REPORT_RENDERER):
        return None, ("The report renderer is not installed at %s, so the "
                      "snapshot cannot be laid out. conky-status answered "
                      "normally." % SESSION_REPORT_RENDERER)
    env_flag = dict(os.environ)
    env_flag["STATUS_WAS_REFRESHED"] = "1" if fresh else "0"
    try:
        done = subprocess.run(
            [sys.executable or "python3", SESSION_REPORT_RENDERER,
             "report", _session_remote_timezone()],
            input=snapshot, capture_output=True, text=True, errors="replace",
            timeout=SESSION_SNAPSHOT_TIMEOUT, env=env_flag)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        return None, ("The report renderer could not be started: %s"
                      % _exc_detail(exc))
    if done.returncode != 0 or not (done.stdout or "").strip():
        return None, ("The report renderer exited %d without output. "
                      "conky-status answered normally."
                      % done.returncode)
    body = done.stdout.rstrip("\n")

    pool_json = _capture(
        ["/usr/bin/sudo", "-n", TOR_SWITCH, "list-instances-with-ip", "--json"],
        SESSION_POOL_TIMEOUT)
    if pool_json and pool_json.strip():
        try:
            pool = subprocess.run(
                [sys.executable or "python3", SESSION_POOL_RENDERER, "rows"],
                input=pool_json, capture_output=True, text=True,
                errors="replace", timeout=SESSION_POOL_TIMEOUT)
            if pool.returncode == 0 and (pool.stdout or "").strip():
                body = body + "\n" + pool.stdout.rstrip("\n")
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    return body, ""


def run_session_report(fresh):
    """Open the session report in kodachi-status-window. (code, message).

    DETACHED, for the reason the dock path already documents: this is a window
    the user reads and closes in their own time, so waiting on it would hold
    the row for the whole reading and burn the timeout. Measured 2026-08-17 on
    the test VM, the blocking version was killed at 90s every time and reported
    the control FAILED while the window sat there working perfectly.

    THE FALLBACK RETURNS THE REPORT, NEVER AN APOLOGY. If the window cannot be
    spawned the tagged stream is handed back as the row output, where
    render_report_stream() lays it out as text. That is worse than the window
    and infinitely better than losing the answer, which is exactly the shape of
    loss this whole function exists to undo.
    """
    body, why = _session_report_stream(fresh)
    if body is None:
        return 1, why
    if DRY:
        print("WOULD OPEN SESSION REPORT WINDOW:", SESSION_STATUS_WINDOW)
        return 0, body
    if not os.access(SESSION_STATUS_WINDOW, os.X_OK):
        return 0, body
    try:
        proc = subprocess.Popen(
            [SESSION_STATUS_WINDOW], stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            text=True, start_new_session=True)
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0, body
    try:
        proc.stdin.write(body + "\n")
        proc.stdin.close()
    except (OSError, ValueError):
        # The child died before it read its input. Hand the report back rather
        # than reporting a failure for a window the user never needed to see.
        return 0, body
    return 0, ("Session status window opened. It carries every reading in this "
               "report, laid out, with a Copy button.")


def run_circuit_monitor():
    """Open nyx in a terminal, as the control has always claimed. (code, msg).

    nyx IS A CURSES PROGRAM. The direct binding runs /usr/bin/nyx with an empty
    argv, so after 96ad39b0b this control started a process with no terminal to
    draw on and the button did nothing visible, while its own note still read
    "Opens nyx in a terminal". The identity is preserved exactly as the
    contract declares it, run-as debian-tor under sudo -n; only the terminal
    the contract cannot express is added back.
    """
    if not os.access(TERMINAL_EMULATOR, os.X_OK):
        return 1, ("%s is not installed on this system, so nyx has no terminal "
                   "to run in." % TERMINAL_EMULATOR)
    argv = [TERMINAL_EMULATOR, "--disable-server", "--hold", "-T", "Tor Circuits",
            "-e", "sudo -n -u debian-tor nyx"]
    if DRY:
        print("WOULD OPEN:", shlex.join(argv))
        return 0, "Opened (dry run)."
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        return 1, "Could not open the circuit monitor: %s" % _exc_detail(exc)
    return 0, "Tor circuit monitor opened in its own terminal window."


def run_tor_instances():
    """The Tor instance pool as a laid-out table in the status window.

    RETRIED ONCE, for the reason kodachi-dock-status documents: tor-switch
    serialises against its own instance operations, so a pool query issued while
    another tor-switch call holds the lock comes back EMPTY rather than late. One
    retry after a short pause turns that transient into an answer instead of into
    a red result about a pool that is perfectly healthy.
    """
    payload = _capture(
        ["/usr/bin/sudo", "-n", TOR_SWITCH, "list-instances-with-ip", "--json"],
        SESSION_POOL_TIMEOUT)
    if not payload or not payload.strip():
        time.sleep(3)
        payload = _capture(
            ["/usr/bin/sudo", "-n", TOR_SWITCH, "list-instances-with-ip", "--json"],
            SESSION_POOL_TIMEOUT)
    if not payload or not payload.strip():
        return 1, ("tor-switch did not report an instance pool. It answers "
                   "nothing while another Tor instance operation holds its lock, "
                   "so try again in a moment.")
    try:
        done = subprocess.run(
            [sys.executable or "python3", SESSION_POOL_RENDERER, "rows"],
            input=payload, capture_output=True, text=True, errors="replace",
            timeout=SESSION_POOL_TIMEOUT)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        return 1, "Could not render the instance pool: %s" % _exc_detail(exc)
    if done.returncode != 0 or not (done.stdout or "").strip():
        return 1, "The instance pool could not be rendered from tor-switch output."
    body = "#TITLE\tTOR INSTANCE POOL\n" + done.stdout.rstrip("\n")
    if DRY:
        print("WOULD OPEN TOR INSTANCE WINDOW:", SESSION_STATUS_WINDOW)
        return 0, body
    if not os.access(SESSION_STATUS_WINDOW, os.X_OK):
        return 0, body
    try:
        proc = subprocess.Popen(
            [SESSION_STATUS_WINDOW], stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            text=True, start_new_session=True)
        proc.stdin.write(body + "\n")
        proc.stdin.close()
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0, body
    return 0, ("Tor instance pool opened in its own window, one row per "
               "instance with its exit country and status.")


def native_presentation(key):
    """The presentation callable for one registry key, or None.

    A LOOKUP, NOT A GUESS. Only the three keys above are served, so a control
    whose answer genuinely is text keeps going through the direct contract.
    """
    key = tuple(key or ())
    if key in SESSION_REPORT_KEYS:
        return lambda: run_session_report(SESSION_REPORT_KEYS[key])
    if key == TOR_CIRCUIT_KEY:
        return run_circuit_monitor
    if key == TOR_INSTANCES_KEY:
        return run_tor_instances
    return None


# ── THE ACTION COLUMN IS A COLUMN, SO IT MUST NOT MOVE ─────────────────────
#
# Operator, 2026-09-04, pointing at one row in a list of nine: "all buttons to
# be aligned the same ... why this one is [expletive] occuard ! review all gtk and
# mae sure things are aligned".
#
# He is right and the cause is mechanical. Each row packs the state pill first
# with pack_end (so it sits rightmost) and the button second (to its left), so
# THE BUTTON IS POSITIONED BY THE PILL WIDTH. The pill text is not fixed: "OK"
# is two characters, "not run" is seven, "Not detected" is twelve, so a row
# whose command has run sits at a different x from the row above it that has
# not. Nine rows, four different pill words, four different button positions,
# and every one of them individually correct.
#
# A FIXED-WIDTH SLOT for the pill turns the pill into a real column and makes
# every button in the window share one right edge. The pill keeps its natural
# size inside the slot and is left-aligned in it, so the pills line up too
# rather than each floating at its own offset.
#
# A FLOOR IS NOT ENOUGH AND THE FIRST VERSION OF THIS COMMENT WAS WRONG, found
# by the inspector. It claimed the widest state word is "Not detected" and that
# "if a longer state word is ever added, the slot grows and the column moves as
# one". BOTH HALVES WERE FALSE:
#
#   - The labels are not only the nine `ui.pill("literal")` sites. classify_exit
#     also returns "sign-in needed" (14 characters, two more than the claimed
#     maximum), "not applied", "cancelled", "findings", finish() adds
#     "no output", and one branch returns an f-string, `f"{skipped} step(s)
#     skipped"`, which has NO BOUND at all. Every one of them reaches the row
#     pill through the single site in make_runner.
#   - `set_size_request` is a MINIMUM. A pill wider than the floor grows ITS OWN
#     slot and nothing else, which moves ITS OWN button and no other, which is
#     precisely the defect this was written to remove.
#
# So the floor stays, because it fixes the common case where every pill is
# SHORTER than the column, and a Gtk.SizeGroup is added on top, because that is
# the only thing that makes the sentence true: a SizeGroup asks every member for
# its natural width and gives them all the LARGEST, so one long pill widens the
# whole column and every button in the window moves together.
#
# The group is per WINDOW, attached to the ui.Window/ui.Page object, so a tabbed
# window aligns across its tabs rather than each tab drifting on its own.
PILL_COLUMN_PX = 104

# The button keeps a floor and a group for the same two reasons: "Run", "Show"
# and "Open" must not draw three widths down one column, and "Open sandboxed"
# must still get the room it needs without stranding the others.
ACTION_BUTTON_PX = 76


def _size_group(owner, attribute):
    """One horizontal Gtk.SizeGroup per window, created on first use.

    Attached to the owner rather than held module-side, because two windows open
    at once must not be forced to the same column width by each other.
    """
    group = getattr(owner, attribute, None)
    if group is None:
        group = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
        try:
            setattr(owner, attribute, group)
        except AttributeError:
            # A GTK object that refuses a python attribute still gets the floor
            # below; it simply does not join the group. Degrading is correct
            # here, since the alternative is no row at all.
            return None
    return group


def action_slot(pill_slot, owner=None):
    """Make one row pill a real column, so the button beside it cannot move."""
    pill_slot.set_size_request(PILL_COLUMN_PX, -1)
    pill_slot.set_halign(Gtk.Align.START)
    group = _size_group(owner, "kodachi_pill_group") if owner is not None else None
    if group is not None:
        group.add_widget(pill_slot)
    return pill_slot


def action_button(button, owner=None):
    """Give one row action button the shared width."""
    button.set_size_request(ACTION_BUTTON_PX, -1)
    group = _size_group(owner, "kodachi_action_group") if owner is not None else None
    if group is not None:
        group.add_widget(button)
    return button


def row_effect(row):
    """Return one declared side-effect class, or unknown for malformed rows."""
    effect = row.get("effect") if isinstance(row, dict) else None
    return effect if effect in ("mutating", "read-only", "launch") else "unknown"


def _wrap_tooltip_atoms(prefix, atoms, separator=" ", width=72):
    """Wrap a tooltip without splitting profile names, words, or path parts."""
    atoms = [str(atom) for atom in atoms]
    if not atoms:
        atoms = ["none"]
    units = [
        atom + (separator if index < len(atoms) - 1 else "")
        for index, atom in enumerate(atoms)
    ]
    lines = []
    current = prefix
    continuation = "    "
    for unit in units:
        candidate = current + unit
        if len(candidate) > width and current != prefix:
            lines.append(current.rstrip())
            current = continuation + unit
        elif len(candidate) > width and current == prefix:
            lines.append(prefix.rstrip())
            current = continuation + unit
        else:
            current = candidate
    lines.append(current.rstrip())
    return lines


def _wrap_tooltip_line(line, width=72):
    return _wrap_tooltip_atoms("", str(line).split(), " ", width)


def workflow_tooltip_lines(row):
    """Render generator-owned workflow facts without inventing runtime state."""
    metadata = row.get("workflow_meta") if isinstance(row, dict) else None
    if not isinstance(metadata, dict):
        return []
    if metadata.get("kind") == "utility":
        return [
            metadata.get("description", "Workflow utility."),
            "utility command: " + metadata.get("command", "unknown"),
        ]
    if metadata.get("kind") != "run":
        return ["Workflow metadata is invalid; profile details are unavailable."]
    top_level = tuple(metadata.get("top_level_includes", ()))
    inline = tuple(metadata.get("inline_includes", ()))
    inherited = tuple(metadata.get("inherited_profiles", ()))
    flags = tuple(metadata.get("flags", ()))
    source = metadata.get("profile_path", "unknown")
    source_parts = source.split("/")
    source_atoms = [
        part + ("/" if index < len(source_parts) - 1 else "")
        for index, part in enumerate(source_parts)
    ]
    lines = []
    lines.extend(_wrap_tooltip_line(
        "profile: " + metadata.get("profile_id", "unknown")))
    lines.extend(_wrap_tooltip_atoms("source: ", source_atoms, ""))
    lines.extend(_wrap_tooltip_line(
        "body steps: {steps} ({commands} commands, {pauses} pauses, "
        "{includes} inline includes)".format(
            steps=metadata.get("body_steps", "unknown"),
            commands=metadata.get("body_commands", "unknown"),
            pauses=metadata.get("body_pauses", "unknown"),
            includes=len(inline))))
    lines.extend(_wrap_tooltip_atoms(
        f"top-level includes: {len(top_level)} (", top_level, ", "))
    lines[-1] += ")"
    lines.extend(_wrap_tooltip_atoms(
        f"inline includes: {len(inline)} (", inline, ", "))
    lines[-1] += ")"
    lines.extend(_wrap_tooltip_line(
        "total direct include edges: "
        + str(metadata.get("direct_include_edges", "unknown"))))
    lines.extend(_wrap_tooltip_line(
        "expanded steps: {steps} ({commands} commands, {pauses} pauses)".format(
            steps=metadata.get("expanded_steps", "unknown"),
            commands=metadata.get("expanded_commands", "unknown"),
            pauses=metadata.get("expanded_pauses", "unknown"))))
    lines.extend(_wrap_tooltip_line(
        "inherited executions: {executions}; distinct profiles: {count}".format(
            executions=metadata.get("inherited_executions", "unknown"),
            count=len(inherited))))
    lines.extend(_wrap_tooltip_atoms(
        "inherited profile names: ", inherited, ", "))
    lines.extend(_wrap_tooltip_atoms(
        "profile description: ",
        (metadata.get("description") or "No description supplied.").split(),
        " "))
    lines.extend(_wrap_tooltip_atoms("reachable flags: ", flags, ", "))
    return lines


def mutates(row):
    """Mutation is declared by the row, never inferred from presentation."""
    return row_effect(row) == "mutating"


def display_output(row, output, success=False):
    """Render useful producer output while withholding credential-shaped lines."""
    if success:
        summary = row.get("success_summary")
        if summary is not None:
            if not isinstance(summary, str) or not summary.strip():
                return ""
            return redact_secrets(summary)
    elif isinstance(row, dict) and row.get("failure_summary") is not None:
        summary = row.get("failure_summary")
        if not isinstance(summary, str) or not summary.strip():
            return ""
        return redact_secrets(summary)
    # Presentation happens BEFORE redaction. Structured producer fields such as
    # ``"password": "..."`` become ordinary labelled lines, and the same
    # line-oriented credential gate then withholds them. Redacting JSON first
    # makes the document invalid and leaves its braces and protocol syntax on
    # screen, which is both unreadable and harder to protect consistently.
    return redact_secrets(render_report_stream(output or ""))


# ── SUCCESS OUTPUT IS VISIBLE AFTER ONE SHARED SAFETY FILTER ────────────────
#
# THIS EXISTS BECAUSE I SHIPPED A CREDENTIAL DISCLOSURE. Commit b2d5a1925 made
# run_sequence_async() append every successful command's stdout to the visible
# result panel, to fix the operator's "nothing happens when you enable it" on
# Decoy traffic. <agent> found what that generalised to: `Connect dante`
# is an ordinary generic row (`sudo routing-switch connect dante`), and
# routing-switch prints the live SOCKS5 credentials on its SUCCESS path,
# `println!("• Username: {}", user)` and `• Password: {}` at
# commands/connect.rs:1371-1376, with the same pair formatted into the usage
# text at :1236-1256. So the fix for a silent switch put a working proxy
# password into a panel that stays on screen until the window is closed.
#
# The operator's later WireGuard reproduction established the opposite product
# contract: an exit-zero command must not look like it did nothing. Declarative
# rows therefore show useful producer stdout after report rendering and this
# shared credential-line filter. `success_output` remains declarative metadata
# for compatibility and auditing; it is not a visibility gate. A non-empty
# `success_summary` still deliberately replaces producer text, and a non-empty
# `failure_summary` still protects failure paths whose raw diagnostics expose
# identifiers.
#
# The redactor is now the common security boundary for BOTH success and failure
# text. Any newly supported credential spelling belongs here with a regression
# fixture, not in a per-row hidden-output exception that recreates silent GTK
# controls.
# THE MARKER IS SEARCHED ANYWHERE IN THE LINE, NOT ANCHORED TO ITS START.
#
# <agent> reviewed the first version of this and rejected it: it matched
# `^Password:` and therefore missed a one-line JSON `{"username":"u",
# "password":"p"}`, a debug line `result: username=u password=p`, a quoted key,
# and an inline `Authentication username: u password: p`. Failure output is
# rendered for most rows, so a backend printing structured credentials before a
# nonzero exit still leaked. An anchored pattern is the shape of redactor that
# passes its own friendly fixture and fails on real output.
# THE PLURAL IS A DIFFERENT STRING TO A REGEX, AND IT WAS THE ONE REAL
# OUTPUT USED. `credential` did not match `Credentials:` because the next
# character is `s`, so a dante Connect line reading
#     Credentials: https://proxy.invalid/alice:hunter2
# was rendered verbatim in the GTK result panel while the `Username:` and
# `Password:` lines beside it were correctly withheld. `_SECRET_URL` cannot
# cover it either: that pattern needs userinfo `user:pass@`, and this URL
# carries the pair in its PATH, so there is no `@` to anchor on. Calibrated
# both directions before landing: `Credential:` and `Credentials:` both match
# now, and `Considerations:` still does not, so the `s?` does not widen the
# marker into ordinary prose.
_CRED_MARKER = re.compile(r"""(?ix)
    (?: pass (?: word | phrase )?
      | secret | token | credentials?
      | api [\s_-]? key
      | private [\s_-]? key
      | auth (?: orization )?
      | user (?: name )? )
    \s* ["\']? \s* [:=]
""")
_SECRET_URL = re.compile(r"(?i)\b([a-z][a-z0-9+.-]*://)[^\s/@:]{1,256}:[^\s/@]{1,256}@")
WITHHELD = "[withheld: this line contains credential-shaped text]"


def redact_secrets(text):
    """Withhold the WHOLE line when it carries a credential marker.

    Value surgery was the first design and it cannot be made safe: to blank a
    value you must first parse the shape it is in, and the shapes are JSON,
    shell `k=v`, prose `Label: value`, quoted keys and URL userinfo, in any
    combination and any order. Withholding the line needs only to RECOGNISE
    that a credential is present, which is a much weaker requirement, and it
    fails in the safe direction: a false positive costs one line of diagnostics.

    Lines with no marker are untouched, so the useful half of an error message
    survives. A credential-bearing URL is rewritten rather than withheld when it
    carries no other marker, because the host and port are the diagnostic.
    """
    out = []
    for line in (text or "").splitlines():
        line = _SECRET_URL.sub(r"\1[redacted]@", line)
        if _CRED_MARKER.search(line):
            line = WITHHELD
        out.append(line)
    return "\n".join(out)


def run_sequence_async(button, surface, title, commands, execute, on_done=None,
                       show_output=None, show_failure=None,
                       verify_success=None, render_output=None,
                       render_failure=None):
    """Run an ordered command sequence off the GTK thread and report exactly.

    ``commands`` contains ``(preview, payload)`` pairs. Execution stops at the
    first non-zero result, so a later command can never hide an earlier failure.
    ``on_done`` receives the successfully completed pairs and the failed pair,
    or ``None`` after complete success, on the GTK thread.

    ``show_output`` decides, per command, whether that command's SUCCESS stdout
    may be shown. It receives the payload half of the pair. Declarative GTK
    controls pass an explicit true policy so useful success output is visible;
    specialised callers may still pass ``None`` to suppress a transcript.

    ``show_failure`` is the same decision for the FAILURE text, which has always
    been rendered and is therefore the older half of the same exposure. ``None``
    means the failure text is withheld too. Every call site passes one.

    ``render_failure`` lets a row replace producer failure text with a fixed,
    value-free receipt. Rows without one retain the established redacted output.

    ``verify_success`` defers the green success state until a caller with a
    postcondition can prove it. It receives the completed pairs and the success
    body. A command exit code alone is not proof that a requested switch state
    landed.
    """
    original = button.get_label()
    button.set_sensitive(False)
    button.set_label("working")
    previews = [preview for preview, _payload in commands]
    preview_text = "\n".join(previews)
    surface.result().show(title, preview_text, "Running, please wait...",
                          "running", "info")
    progress = {"alive": True, "seconds": 0}

    def tick():
        if not progress["alive"]:
            return False
        progress["seconds"] += 1
        button.set_label(f"{progress['seconds']}s")
        return True

    GLib.timeout_add_seconds(1, tick)

    # WHAT A SUCCESSFUL COMMAND SAID USED TO BE THROWN AWAY.
    #
    # The failure arm below has always shown `output`. The success arm showed
    # "Applied 1 of 1 change(s)." and discarded it, so every switch and every
    # radio in every window was silent about what actually happened. The
    # operator hit it on Decoy traffic, 2026-08-23: "now nothing happens when
    # you enable it". Something did happen. `kodachi-decoy-traffic start` prints
    # "Decoy traffic started, running until stopped (pid 12345)", and this
    # function dropped that line on the floor.
    #
    # It is not specific to that row: "Decoy traffic is already running (pid N)"
    # and "Decoy traffic is already being started" are also exit-0 messages, and
    # both are answers the user needs and could not see. A count of changes is a
    # receipt, not a result.
    #
    # The transcript keeps the commands that produced NO output out of it, so a
    # silent command still reads as a clean "Applied 1 of 1" rather than gaining
    # an empty heading.
    def finish(completed, failed, code, output, transcript):
        progress["alive"] = False
        button.set_sensitive(True)
        button.set_label(original)
        spoke = "\n\n".join("%s\n%s" % (preview, text)
                             for preview, text in transcript)
        if failed is None:
            body = f"Applied {len(completed)} of {len(commands)} change(s)."
            if spoke:
                body = body + "\n\n" + spoke
            if verify_success is None:
                surface.result().show(title, preview_text, body, "OK", "on")
                # G21. Every command in this path came from a switch or a choice
                # being applied, so reaching here means the machine changed.
                refresh_status_cache()
            else:
                surface.result().show(
                    title, preview_text,
                    "Command finished. Verifying requested state...",
                    "verifying", "info")
        else:
            failed_preview, failed_payload = failed
            if (isinstance(failed_payload, dict)
                    and failed_payload.get("_reporting_failure")):
                # The failure may itself be redact_secrets(), so do not call
                # that same presentation path again while reporting it. This
                # text is fixed here and contains no command output.
                detail = output
            elif show_failure is not None and show_failure(failed_payload):
                presented = (
                    render_failure(failed_payload, output or "")
                    if render_failure is not None
                    else redact_secrets(output or ""))
                detail = (presented.strip()
                          or "the command produced no error text")
            else:
                # Named, not silent. "Nothing appeared" is the complaint that
                # started this whole thread, so a withheld panel says why and
                # says where the text is.
                detail = ("The output of this command is not shown here because "
                          "it can contain credentials.\nRun it in a terminal to "
                          "see the full error.")
            body = (f"Stopped after {len(completed)} of {len(commands)} change(s).\n"
                    f"Failed: {failed_preview}\n\n{detail}")
            # What the EARLIER commands said still matters on this path: they
            # already ran, and their output is the only record of what the
            # machine did before the sequence stopped.
            if spoke:
                body = body + "\n\nBefore that:\n\n" + spoke
            surface.result().show(title, preview_text, body, "failed", "err")
        if failed is None and verify_success is not None:
            verify_success(completed, body)
        elif on_done is not None:
            on_done(completed, failed)
        return False

    def worker():
        completed = []
        transcript = []
        failed = None
        code, output = 0, ""
        try:
            for item in commands:
                try:
                    code, output = execute(item[1])
                except Exception as exc:
                    code, output = 1, ("the window could not run this: %s"
                                      % _exc_detail(exc))
                if code != 0:
                    failed = item
                    break
                # Execution success is a machine transition, so account for it
                # BEFORE any policy or presentation callback can fail. If one
                # of those callbacks raises, on_done must still receive this
                # item as completed so reconciliation reflects what happened.
                completed.append(item)
                try:
                    spoken = (output or "").strip()
                    # The caller owns transcript visibility. Declarative GTK
                    # passes True for every success and the renderer applies
                    # the shared credential-line filter before appending it.
                    if (show_output is not None and show_output(item[1])):
                        presented = (
                            render_output(item[1], spoken)
                            if render_output is not None
                            else redact_secrets(spoken))
                        if presented:
                            transcript.append((item[0], presented))
                except Exception:
                    code = 1
                    output = ("The command completed, but its result could not "
                              "be safely presented. Later commands were not "
                              "attempted.")
                    failed = (
                        "Present the completed result for %s" % item[0],
                        {"_reporting_failure": True})
                    break
        except Exception as exc:
            code = 1
            output = ("the window could not complete this sequence: %s"
                      % _exc_detail(exc))
            failed = item if "item" in locals() else ("command sequence", {})
        finally:
            # Delivery belongs in finally: a bad payload, policy callback or
            # iterator must never strand the button in its disabled working
            # state for the life of the window.
            GLib.idle_add(
                finish, completed, failed, code, output, transcript)

    def start_failed(exc):
        try:
            detail = "%s: %s" % (type(exc).__name__, exc)
        except BaseException:
            detail = "an exception whose details could not be rendered"
        GLib.idle_add(
            finish, [], ("command sequence", {}), 1,
            "the command sequence could not start: " + detail, [])

    start_daemon(threading.Thread(target=worker, daemon=True), start_failed)


class PreparedCommand(dict):
    """Mutable Apply payload whose repr never exposes confidential stdin."""

    def __repr__(self):
        visible = dict(self)
        if visible.get("stdin_values") not in (None, b"", ""):
            visible["stdin_values"] = "[withheld mutable input]"
        return repr(visible)


def seen_of(widget):
    """True once a human has moved this switch. See _mark_touched."""
    seen = getattr(widget, "seen", None)
    return bool(seen and seen.get("touched"))


def _mark_touched(widget, *_args):
    """Record that a HUMAN moved this switch.

    Module level and named, not a lambda, because settle() has to block it with
    handler_block_by_func() while it writes the value the worker just read.
    GTK cannot tell a programmatic set_active() from a click: both emit
    notify::active. Before this existed the arriving live state marked every
    ON switch as touched, and Apply, whose whole contract is "runs only what
    you changed", would then have run a command for each of them.
    """
    seen = getattr(widget, "seen", None)
    if seen is not None:
        seen["touched"] = True
        seen["generation"] += 1


# The ONLY producers whose --json payload is allowed to be read UNWRAPPED.
#
# <agent>, ROUND 3 finding 2: "the key `data` is absent" was too wide a
# door. It admitted any flat producer, present or future, and a flat shape is
# usually a producer that failed before it built its envelope rather than one
# that never had it. Measured on <lab-host>, 2026-08-23, over all 31
# non-systemd switch check commands in the product: exactly ONE is flat,
# `online-auth license-status`, and the other 30 use the standard envelope. So
# the allowlist is that one name, and it is a name, not a shape test.
FLAT_PAYLOAD_SUBCOMMANDS = ("license-status",)


def read_switch(key):
    """Live state for one switch, plus WHY when it cannot be read.

    Returns (state, reason). state is True/False/None; reason is None when the
    state is known, else "no-status" (this feature has no status command at all),
    "refused" (the command was rejected before it ran, almost always because the
    binary or its trusted path is not root-owned) or "unreadable".

    A bare "unknown" pill could not tell those apart, and they are not the same
    fact: "no status command exists" is a gap in the product, while "refused" is
    something the USER can act on. Six of six Devices switches read unknown on
    <lab-host> purely because 47 binaries there are not root-owned.

    THE CONTRACT, read out of health-control's own source rather than guessed:
    `offline-<thing> --action check --json` returns the standard envelope whose
    `data` is an OfflineActionStatus, and that struct carries

        is_enabled:   Option<bool>
        is_blocked:   Option<bool>
        is_installed: Option<bool>

    each with #[serde(skip_serializing_if = "Option::is_none")]. So an ABSENT
    key genuinely means the binary could not determine it, which is exactly the
    unknown this function reports. An earlier version of this code sniffed the
    prose output for words like "enabled", which would have read a sentence such
    as "not enabled" as enabled and shown a confident, wrong switch.

    systemd units are asked with `is-active` and answer on stdout.
    Anything else stays unknown rather than guessing.
    """
    if not key:
        return None, "no-status"
    command = resolve(key)
    if not command or DRY:
        return None, "no-status"

    # systemd answers plainly, and `status` prints a line we can key on exactly.
    if "systemctl" in command:
        code, out = shell(bind_command(command, key))
        if looks_auth_refused(out):
            return None, "refused"
        if "is-active" in command:
            answer = out.strip()
            if code == 0 and answer == "active":
                return True, None
            if code in (0, 3) and answer in ("inactive", "failed", "deactivating"):
                return False, None
            return None, "unreadable"
        for line in out.splitlines():
            if line.strip().startswith("Active:"):
                if code not in (0, 3):
                    return None, "unreadable"
                return ("active (running)" in line
                        or line.strip().startswith("Active: active")), None
        return None, "unreadable"

    # A status command written for a HUMAN often ends `--json | kodachi-json-report`,
    # which renders the envelope into prose and destroys the very structure this
    # function needs. For a state read, keep the producer and drop the renderer.
    command = command.split("|")[0].strip()
    command_tokens = command.split()
    subcommand = next(
        (token for token in command_tokens
         if token.endswith("-status")
         or token in ("check-login", "verify-tor-dns")),
        "",
    )

    # Everything else: ask for the JSON envelope and read a boolean out of it.
    # Requesting --json on a command that does not support it fails, and a
    # failure here is UNKNOWN rather than false, which is the whole point.
    try:
        bindings = kd.registry().bindings(key)
    except kd.DirectContractError:
        return None, "unreadable"
    json_declared = any(
        parameter.get("name") == "json"
        and parameter.get("type") == "boolean"
        and parameter.get("flag") == "--json"
        for binding in bindings
        for parameter in binding.get("parameters", ())
    )
    json_fixed = any("--json" in binding.get("argv", ())
                     for binding in bindings)
    if not json_declared and not json_fixed:
        return None, "unreadable"
    code, out = shell(
        bind_command(command, key), key=key,
        parameters={"json": True} if json_declared and not json_fixed else {})
    if looks_auth_refused(out):
        return None, "refused"
    # PARSEABLE IS NOT AUTHORITATIVE. <agent>, ROUND 3 finding 2: this
    # function read a boolean out of any JSON it could parse, whatever the
    # process exit code said and whatever the envelope said about itself. So a
    # failing `license-status` that still printed `has_license:false` painted a
    # confident OFF switch from an ERROR, which is the same class of defect as
    # the prose sniffing this function's docstring was written about.
    #
    # MEASURED on <lab-host>, 2026-08-23, all 31 non-systemd switch check
    # commands in the product: 31 of 31 exit 0 AND carry status "success",
    # `tor-switch verify-tor-dns` included, which was the one I expected to
    # report a nonzero exit for a negative answer and does not. So this gate
    # costs nothing today and closes the hole. If a future producer needs a
    # nonzero exit to mean a real answer, it is added here deliberately, by
    # name, with its measurement.
    if code != 0:
        return None, "unreadable"
    try:
        payload = json.loads(out[out.index("{"):out.rindex("}") + 1])
    except Exception:
        return None, "unreadable"
    # The envelope's own verdict, when it carries one. `status` is a string in
    # every producer measured; anything that is not a success value means the
    # payload below describes a failure and its booleans are not state.
    if isinstance(payload, dict):
        declared = payload.get("status")
        if isinstance(declared, str) and declared.strip().lower() not in (
                "success", "ok"):
            return None, "unreadable"
    data = payload.get("data") if isinstance(payload, dict) else None
    if (data is None and isinstance(payload, dict) and "data" not in payload
            and any(token in FLAT_PAYLOAD_SUBCOMMANDS
                    for token in command.split())):
        # NOT EVERY PRODUCER WRAPS ITS PAYLOAD, AND ONE OF THEM IS A SWITCH.
        #
        # Measured on <lab-host>, 2026-08-23: `online-auth license-status
        # --json` emits its fields at the TOP LEVEL (has_license, hardware_id,
        # tier_claim_v2, message, status) with no `data` object anywhere, unlike
        # `online-auth check-login --json`, which does use the standard envelope.
        # So the Licence row read "unreadable" while the machine knew the answer.
        #
        # The predicate is deliberately "the key is ABSENT", not "the value is
        # not a dict". A producer that emits `"data": null` or `"data": []` is
        # saying something about its own payload and should keep reading as
        # unreadable; a producer that never had the key is simply flat, and the
        # only place to look is the top level. Falling back on the wrong one of
        # those two would let an explicitly empty payload paint a switch.
        #
        # This does NOT change either CLI contract. The unwrapped shape is what
        # the dashboard already consumes, so rewriting the envelope to fix a GTK
        # symptom would be the tail wagging the dog; the non-conformance is
        # reported separately instead. Nothing here can misread envelope
        # metadata as state either: none of the names looked up below
        # (is_enabled, enabled, is_active, active, is_running, running,
        # is_blocked, and the per-command table) is an envelope field.
        data = payload
    if not isinstance(data, dict):
        return None, "unreadable"
    for key_name in ("is_enabled", "enabled", "is_active", "active",
                     "is_running", "running"):
        if isinstance(data.get(key_name), bool):
            return data[key_name], None
    if isinstance(data.get("is_blocked"), bool):
        return (not data["is_blocked"]), None

    # PER-COMMAND STATE KEYS, EXPLICIT AND NOT A HEURISTIC.
    #
    # Four status commands answer with a boolean that carries none of the names
    # above, so their switches read "unreadable" while the machine knew the
    # answer perfectly well. The tempting fix is "take the first key ending in
    # _enabled", and it is wrong: `dpms-status` returns BOTH `dpms_enabled` and
    # `blanking_enabled`, and `screensaver-status` returns THREE booleans
    # (`screensaver_autostart_enabled`, `screensaver_binary_available`,
    # `screensaver_running`). A heuristic picks one by accident and paints a
    # confident switch from it, which is exactly the failure the prose-sniffing
    # note above this function was written about.
    #
    # So each entry below was read out of that command's actual --json payload
    # on <lab-host> and chosen to MIRROR WHAT ITS OWN Enable/Disable PAIR
    # DOES, which is the only thing the switch is allowed to claim:
    #   ipv6-status         ipv6_enabled           the single top-level boolean
    #   dpms-status         dpms_enabled           the row is "Screen blanking
    #                                              (DPMS)", so DPMS, not blanking
    #   screensaver-status  screensaver_autostart_enabled
    #                                              Enable/Disable set autostart;
    #                                              `screensaver_running` is a
    #                                              different question
    #   ram-wipe-status     systemd_hook_installed OR sysv_hook_installed
    #                                              the wipe is on when EITHER
    #                                              init hook is installed
    # `check-login` ends in neither `-status` nor any prefix the scan below
    # knows, so without this set the Session switch never even reached the
    # per-command table and reported unreadable for a payload it could read.
    # `license-status` does end in `-status` and is listed only so the pair is
    # findable together; the membership test is harmless for it.
    single = {
        "ipv6-status": "ipv6_enabled",
        "dpms-status": "dpms_enabled",
        "screensaver-status": "screensaver_autostart_enabled",
        # coldboot-defense-status. THIS ENTRY IS A FALLBACK AND IT IS CURRENTLY
        # UNREACHABLE, which is worth saying rather than leaving as a comment
        # that reads like the mechanism.
        #
        # cold_boot_defense.rs get_status() builds json!({"protection_active":
        # false, ...}) and flips it, so `protection_active` is the semantic key.
        # But hardware_security.rs:340 ALSO copies it out as
        # output_result["enabled"], and "enabled" is the second name in the
        # generic tuple above, so the generic path answers first and this line
        # never runs. It stays because it is the key the producing module owns:
        # if the `enabled` alias is ever dropped, this keeps the switch readable
        # instead of silently turning it unknown again.
        #
        # WHAT ACTUALLY FIXED THE ROW was giving it a `check` at all. It drew
        # unknown because kodachi_windows.py passed None, not because the payload
        # could not be parsed. I published the wrong mechanism for a fix that
        # works, which is only possible because the outcome agreed with me.
        "coldboot-defense-status": "protection_active",
        # THE TWO ACCOUNT SWITCHES, both measured on <lab-host> 2026-08-23.
        #
        #   check-login     -> {"data":{"is_logged_in":true,"message":
        #                       "Session is valid","status":"success"}}
        #   license-status  -> {"has_license":false,"hardware_id":...,
        #                       "tier_claim_v2":{...},"message":"No license
        #                       activated.","status":"success"}     (no envelope)
        #
        # Each key mirrors exactly what its own pair of buttons does, which is
        # the only claim a switch is allowed to make: Authenticate/Sign Out move
        # is_logged_in, and Activate License/Release License move has_license.
        #
        # `has_license` and NOT `tier_claim_v2`. The claim is present on this
        # unlicensed device (a signed free-tier grant), so keying on it would
        # paint the Licence switch ON for every machine that has ever talked to
        # the server. Presence of a claim is not proof it is valid, current or
        # bound to this device, and this command does not verify any of that.
        "check-login": "is_logged_in",
        "license-status": "has_license",
        "conky-mask-status": "masked",
        # health-control swap-status owns this boolean. The generic names above
        # do not include it, so without this explicit producer contract a Swap
        # switch can execute but can never truthfully render its live state.
        "swap-status": "swap_enabled",
    }.get(subcommand)
    if single and isinstance(data.get(single), bool):
        return data[single], None
    if subcommand == "ram-wipe-status":
        hooks = [data.get("systemd_hook_installed"),
                 data.get("sysv_hook_installed")]
        if any(isinstance(h, bool) for h in hooks):
            return any(h is True for h in hooks), None
    if subcommand == "verify-tor-dns":
        # THE SWITCH'S PAIR ADDS AND REMOVES THE SYSTEM DNS REDIRECT, so the
        # only state it may claim is whether that redirect exists. The two
        # probes (`direct_method`, `port_method`) prove that Tor's DNSPort
        # answers, which is a different question: measured on <lab-host>,
        # 2026-09-05, resolv.conf pointed at dnscrypt on 127.0.0.1, no redirect
        # rule existed, both probes answered true and this switch read ON.
        #
        # tor-switch now publishes `system_dns_redirected` (and `is_enabled`
        # from it), read out of the firewall tables, which only root can do.
        # This registry binding runs UNPRIVILEGED (needsSudo false, the probe
        # itself needs nothing), so the key arrives as null: the producer is
        # saying "I could not read the redirect", not "off". Ask once more
        # through sudo -n, exactly as the session pool reader above does, and
        # read `is_enabled` from that answer. A refusal is reported as refused,
        # never painted from the probe. `is_enabled` from a root run never
        # reaches this branch: the generic loop above returns it first.
        if "system_dns_redirected" in data and data.get("system_dns_redirected") is None:
            privileged = _capture(
                ["/usr/bin/sudo", "-n", TOR_SWITCH, "verify-tor-dns", "--json"],
                SWITCH_PRIVILEGED_READ_TIMEOUT)
            if privileged is None:
                return None, "refused"
            try:
                envelope = json.loads(
                    privileged[privileged.index("{"):privileged.rindex("}") + 1])
            except Exception:
                return None, "unreadable"
            # PARSEABLE IS NOT AUTHORITATIVE here either: the same envelope
            # gate the unprivileged read enforces above. verify-tor-dns exits
            # 0 on its error arm and still carries the booleans, so a payload
            # whose own status is not a success value is not state.
            declared = envelope.get("status") if isinstance(envelope, dict) else None
            if not isinstance(declared, str) or declared.strip().lower() not in ("success", "ok"):
                return None, "unreadable"
            inner = envelope.get("data") if isinstance(envelope, dict) else None
            if isinstance(inner, dict) and isinstance(inner.get("is_enabled"), bool):
                return inner["is_enabled"], None
            return None, "unreadable"
        # A producer that never carried the key is an older tor-switch: ANY-OF
        # of its two probes, mirroring its own success arm
        # `if direct_result || port_result`. The Tor-inactive arm returns both
        # false, which reads as off.
        probes = [data.get("direct_method"), data.get("port_method")]
        if any(isinstance(v, bool) for v in probes):
            return any(v is True for v in probes), None
    if subcommand == "tor-status":
        service_status = data.get("service_status")
        if service_status in ("active", "active-non-systemd"):
            return True, None
        if service_status == "inactive":
            return False, None
    return None, "unreadable"


def requested_state_issue(name, requested, state):
    """Return why a switch postcondition is unproven, else ``None``.

    Exit zero is only the producer saying it accepted the command. The control
    may publish success only when its independent status command observes the
    requested boolean.
    """
    if state is None:
        return "%s: current state is unknown." % name
    if bool(state) != requested:
        return ("%s: requested %s, read back %s."
                % (name, "on" if requested else "off",
                   "on" if state else "off"))
    return None


def confirm_dialog(parent, title, body):
    dialog = Gtk.MessageDialog(transient_for=parent, modal=True,
                               message_type=Gtk.MessageType.WARNING,
                               buttons=Gtk.ButtonsType.OK_CANCEL, text=title)
    dialog.format_secondary_text(body)
    answer = dialog.run()
    dialog.destroy()
    return answer == Gtk.ResponseType.OK


def _append_utf8(buffer, codepoint):
    """Encode one Unicode codepoint into a mutable buffer without a str copy."""
    if codepoint <= 0x7F:
        buffer.append(codepoint)
    elif codepoint <= 0x7FF:
        buffer.extend((0xC0 | (codepoint >> 6),
                       0x80 | (codepoint & 0x3F)))
    elif codepoint <= 0xFFFF:
        buffer.extend((0xE0 | (codepoint >> 12),
                       0x80 | ((codepoint >> 6) & 0x3F),
                       0x80 | (codepoint & 0x3F)))
    else:
        buffer.extend((0xF0 | (codepoint >> 18),
                       0x80 | ((codepoint >> 12) & 0x3F),
                       0x80 | ((codepoint >> 6) & 0x3F),
                       0x80 | (codepoint & 0x3F)))


class _SecretEntry:
    """A masked GTK input whose widget stores bullets, never the secret."""

    def __init__(self, label):
        self.widget = Gtk.Entry()
        self.widget.set_visibility(True)
        self.widget.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.buffer = bytearray()
        self.widths = []
        self._painting = False
        self.widget.connect("key-press-event", self._key)
        # Key events are not the only insertion path.  IME commits, primary
        # selection, drag-and-drop and accessibility APIs reach insert-text
        # directly, so block every native insertion except our bullet repaint.
        self.widget.connect("insert-text", self._reject_insert)
        self.widget.connect(
            "button-press-event", lambda _widget, event: event.button == 3)
        ui.set_control_accessibility(self.widget, label, label)

    def _paint(self):
        self._painting = True
        try:
            self.widget.set_text("\u2022" * len(self.widths))
        finally:
            self._painting = False
        self.widget.set_position(-1)

    def _reject_insert(self, editable, _text, _length, _position):
        if not self._painting:
            editable.stop_emission_by_name("insert-text")

    def _key(self, _widget, event):
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter,
                            Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            return False
        if event.keyval == Gdk.KEY_BackSpace:
            if self.widths:
                width = self.widths.pop()
                del self.buffer[-width:]
                self._paint()
            return True
        if event.keyval == Gdk.KEY_Delete:
            return True
        blocked = (Gdk.ModifierType.CONTROL_MASK
                   | Gdk.ModifierType.MOD1_MASK
                   | Gdk.ModifierType.SUPER_MASK)
        if event.state & blocked:
            return True
        codepoint = Gdk.keyval_to_unicode(event.keyval)
        if not codepoint or codepoint < 32 or codepoint == 127:
            return True
        if len(self.buffer) >= 4096:
            return True
        before = len(self.buffer)
        _append_utf8(self.buffer, codepoint)
        self.widths.append(len(self.buffer) - before)
        self._paint()
        return True

    def take(self):
        owned = self.buffer
        self.buffer = bytearray()
        self.widths = []
        self._paint()
        return owned

    def wipe(self):
        kd.wipe_secret(self.buffer)
        self.widths = []
        self._paint()


def _entry_dialog(parent, title, text, fields):
    """Collect fixed GTK fields without invoking zenity or another UI."""
    dialog = Gtk.Dialog(
        title=title,
        transient_for=parent,
        modal=True,
        destroy_with_parent=True,
    )
    dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
    dialog.add_button("Continue", Gtk.ResponseType.OK)
    box = dialog.get_content_area()
    box.set_spacing(10)
    note = Gtk.Label(label=text)
    note.set_xalign(0.0)
    note.set_line_wrap(True)
    note.set_max_width_chars(72)
    box.pack_start(note, False, False, 0)
    entries = []
    for label, secret in fields:
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        caption = Gtk.Label(label=label)
        caption.set_xalign(0.0)
        if secret:
            entry = _SecretEntry(label)
            widget = entry.widget
        else:
            entry = Gtk.Entry()
            widget = entry
            ui.set_control_accessibility(widget, label, label)
        row.pack_start(caption, False, False, 0)
        row.pack_start(widget, False, False, 0)
        box.pack_start(row, False, False, 0)
        entries.append((entry, secret))
    dialog.show_all()
    answer = dialog.run()
    if answer == Gtk.ResponseType.OK:
        values = [entry.take() if secret else entry.get_text()
                  for entry, secret in entries]
    else:
        values = None
        for entry, secret in entries:
            if secret:
                entry.wipe()
    dialog.destroy()
    return values


def _trim_ascii_space(secret):
    while secret and secret[0] in b" \t\r\n":
        del secret[0]
    while secret and secret[-1] in b" \t\r\n":
        secret.pop()


def _json_secret_object(values):
    """Build a UTF-8 JSON object in one wipeable bytearray owner."""
    output = bytearray(b"{")
    for index, (name, secret) in enumerate(values):
        if index:
            output.append(ord(","))
        output.extend(json.dumps(name, ensure_ascii=True).encode("ascii"))
        output.append(ord(":"))
        output.append(ord('"'))
        for byte in secret:
            if byte in (ord('"'), ord("\\")):
                output.extend((ord("\\"), byte))
            elif byte == 8:
                output.extend(b"\\b")
            elif byte == 9:
                output.extend(b"\\t")
            elif byte == 10:
                output.extend(b"\\n")
            elif byte == 12:
                output.extend(b"\\f")
            elif byte == 13:
                output.extend(b"\\r")
            elif byte < 32:
                output.extend((b"\\u00" + ("%02x" % byte).encode("ascii")))
            else:
                output.append(byte)
        output.append(ord('"'))
    output.extend(b"}\n")
    return output


def _block_device_dialog(parent, title, text):
    """Select one kernel-reported block device through native GTK."""
    try:
        result = subprocess.run(
            ["/usr/bin/lsblk", "-J", "-p", "-o",
             "NAME,SIZE,TYPE,MOUNTPOINT"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            timeout=5,
        )
        payload = json.loads(result.stdout) if result.returncode == 0 else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        payload = {}

    choices = []

    def walk(devices):
        for item in devices or ():
            if not isinstance(item, dict):
                continue
            path = item.get("name")
            kind = item.get("type")
            if (isinstance(path, str) and path.startswith("/dev/")
                    and kind in {"disk", "part", "crypt", "lvm"}):
                label = "  ".join(str(value or "-") for value in (
                    path, item.get("size"), kind, item.get("mountpoint")))
                choices.append((path, label))
            walk(item.get("children"))

    walk(payload.get("blockdevices") if isinstance(payload, dict) else ())
    if not choices:
        return None, "No selectable block device was reported by /usr/bin/lsblk."

    dialog = Gtk.Dialog(
        title=title,
        transient_for=parent,
        modal=True,
        destroy_with_parent=True,
    )
    dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
    dialog.add_button("Continue", Gtk.ResponseType.OK)
    box = dialog.get_content_area()
    box.set_spacing(10)
    note = Gtk.Label(label=text)
    note.set_xalign(0.0)
    note.set_line_wrap(True)
    note.set_max_width_chars(72)
    box.pack_start(note, False, False, 0)
    picker = Gtk.ComboBoxText()
    for path, label in choices:
        picker.append(path, label)
    picker.set_active(-1)
    ui.set_control_accessibility(
        picker, "Block device", "Choose the exact kernel-reported target device.")
    box.pack_start(picker, False, False, 0)
    dialog.show_all()
    answer = dialog.run()
    selected = picker.get_active_id()
    dialog.destroy()
    if answer != Gtk.ResponseType.OK:
        return None, "cancelled"
    if not selected:
        return None, "Select a block device before continuing."
    return selected, None


def collect_direct_input(parent, key):
    """Collect only the typed values required by interactive registry rows."""
    key = tuple(key or ())
    if key == ("Authentication", "Activate License"):
        values = _entry_dialog(
            parent,
            "Activate Kodachi Licence",
            "Enter the licence key. It is delivered only on the direct "
            "online-auth stdin channel and is never placed in argv.",
            [("Licence key", True)],
        )
        if values is None:
            return {}, None, "cancelled"
        key_value = values[0]
        _trim_ascii_space(key_value)
        if not key_value:
            kd.wipe_secret(key_value)
            return {}, None, "Enter a licence key before continuing."
        key_value.append(10)
        return {}, key_value, None

    if key == ("Storage & USB", "USB Safety Check"):
        device, issue = _block_device_dialog(
            parent,
            "USB Safety Check",
            "Choose the exact device to inspect. This check does not modify it.",
        )
        return ({"path": device} if device else {}), None, issue

    if key == ("Storage & USB", "Storage Encrypt"):
        device, issue = _block_device_dialog(
            parent,
            "Encrypt A Drive",
            "Everything already on the selected device is destroyed.",
        )
        if issue:
            return {}, None, issue
        values = _entry_dialog(
            parent,
            "Encrypt A Drive",
            "Set and confirm the new LUKS password.",
            [("New LUKS password", True), ("Confirm LUKS password", True)],
        )
        if values is None:
            return {}, None, "cancelled"
        password, confirmation = values
        if not password:
            kd.wipe_secret(values)
            return {}, None, "The new LUKS password cannot be empty."
        if password != confirmation:
            kd.wipe_secret(values)
            return {}, None, "The two LUKS passwords do not match."
        if len(password) < 12:
            kd.wipe_secret(values)
            return {}, None, "The new LUKS password must be at least 12 bytes."
        kd.wipe_secret(confirmation)
        password.append(10)
        return {"device": device}, password, None

    if key == ("Emergency", "LUKS Nuke Arm"):
        values = _entry_dialog(
            parent,
            "Arm LUKS Nuke",
            "Typing the nuke password at boot destroys the LUKS header. "
            "Keep the GPG password because the encrypted backup cannot be "
            "restored without it.",
            [
                ("LUKS device, for example /dev/sda3", False),
                ("Nuke password", True),
                ("GPG password for the header backup", True),
                ("Current LUKS password", True),
            ],
        )
        if values is None:
            return {}, None, "cancelled"
        device, nuke, gpg, current = values
        if not (device.startswith("/dev/") and nuke and gpg and current):
            kd.wipe_secret((nuke, gpg, current))
            return {}, None, "All fields are required and the device must be under /dev/."
        stdin_payload = _json_secret_object((
            ("nuke_password", nuke),
            ("gpg_password", gpg),
            ("luks_password", current),
        ))
        kd.wipe_secret((nuke, gpg, current))
        return {"device": device}, stdin_payload, None

    if key == ("Emergency", "LUKS Nuke Disarm"):
        device, issue = _block_device_dialog(
            parent,
            "Remove LUKS Nuke Password",
            "Choose the LUKS device whose nuke keyslot should be removed. "
            "Data and the normal LUKS password remain unchanged.",
        )
        if issue:
            return {}, None, issue
        return {"device": device}, None, None

    return {}, None, None


def build_declarative(name, target=None, parent=None):
    """Render a declarative window spec into `target`.

    `target` is anything offering section/card/state_strip/footer, so it is
    either a ui.Window (the standalone case, unchanged) or a ui.Page (one tab of
    a grouped window). `parent` is the real Gtk.Window used for dialogs and for
    the output viewer, which a Page is not. Both default to None so the original
    one-argument call still builds a standalone window exactly as before.
    """
    spec = kw.WINDOWS[name]
    if target is None:
        # A WINDOW MAY DECLARE ITS OWN WIDTH, and 640 stays the default for
        # every window that does not. TABBED already honours spec width and
        # height; standalone windows hardcoded 640 and so could not be widened
        # without moving all 25 of them. The Applications window needs it: its
        # content measures 852px minimum, so 640 + SIDEBAR_WIDTH resolved to
        # 940, which is 96px BELOW the width this window can draw.
        #
        # READ THE CONSEQUENCE CAREFULLY. THE FIRST VERSION OF THIS COMMENT
        # SAID THE WINDOW "OPENED 96px NARROWER THAN IT CAN DRAW", and that is
        # WRONG. It is the third surviving copy of a claim already retracted in
        # kodachi_ui.py and kodachi-repo-manager by b5036f669 on 2026-08-26.
        # That commit named this line explicitly and routed it to the lane that
        # owned this file; the lane stopped before landing it, so the retraction
        # never reached here. GTK3 will not map a toplevel below its content
        # minimum (<agent> proved it with a positive control on
        # 2026-08-26), so a window whose minimum exceeds its requested default
        # simply OPENS AT THE MINIMUM. Nothing was ever clipped on open and
        # nothing ever opened narrow.
        #
        # THE DEFECT THAT WAS REAL is the DISAGREEMENT between the geometry
        # this file declares and the geometry GTK produces. The product then
        # reasons about a width the user never gets, and any contract that
        # compares against the declared number fails while the window on screen
        # is fine. Letting a window declare its own width is what closes it.
        win = ui.Window(spec["title"], spec["subtitle"],
                        width=spec.get("width", 640),
                        height=spec.get("height", 800))
        target = win
        parent = win
    else:
        win = parent

    switches = []      # (row, widget, cell, seen); cell holds the live state, filled by settle()
    fact_rows = []     # (section, row, handle) for every `mode: "facts"` reading
    choice_groups = []  # (section, group_leader, {radio: key})
    unknown = 0
    refused = 0
    pending = []  # switches whose live state is still being read on a worker

    # ONE RADIO GROUP PER WINDOW, NOT PER SECTION.
    #
    # These were inside the section loop, so every section started a FRESH
    # Gtk.RadioButton group. A group always holds exactly one active member, so
    # a window with three choice sections had THREE active radios, and Apply
    # appended one command per group. Measured on <lab-host> by
    # <agent> driving the real footer button: the vpn window ran
    #     sudo routing-switch connect amneziawg
    #     sudo routing-switch connect wireguard
    #     sudo routing-switch connect remote-tor
    # in one click, having touched nothing, under a footer reading "runs only
    # what you changed". Kill Switch DISARMED itself the same way. Six of the
    # thirteen windows were affected.
    #
    # The sections of a choice window are one question with grouped answers
    # (Not obfuscated / Obfuscated / Through Tor are all "which transport"), so
    # the group spans the window and the answer is singular.
    group = [None]
    picks = {}
    chose = {"touched": False, "label": None, "generation": 0}
    # The Tor mode is a single-choice operation, so its footer must name the
    # actual answer instead of collapsing every radio to "1 change pending".
    # Keep this as widget state, not a rebuild: the selected control, focus and
    # scroll position remain intact while the footer and result are patched.
    choice_status = {"preview": None, "applied": None}
    # THE PREREQUISITE BANNER, ON THE TWO PAGES THAT DEPEND ON A RUNTIME.
    #
    # Applications and Containers are declarative tables, so they cannot read
    # the machine the way the three builtin pages do, and that is exactly why
    # they were the two pages that said nothing. The banner is drawn HERE, from
    # the disk, at the moment the page is built, and it disappears entirely on
    # a machine where Podman is present.
    if name in CONTAINER_DEPENDENT_SPECS:
        banner = container_prerequisite_section()
        if banner:
            caption, note, rows = banner
            target.section(caption, note)
            banner_card = target.card()
            for label, detail, tone, tag in rows:
                brow = ui.cls(ui.hbox(13), "row")
                btext = ui.vbox(2)
                btext.set_valign(Gtk.Align.CENTER)
                btext.pack_start(ui.lbl(label, "row-name"), False, False, 0)
                btext.pack_start(ui.lbl(detail, "row-note", wrap=True),
                                 False, False, 0)
                brow.pack_start(btext, True, True, 0)
                bslot = ui.hbox(6)
                bslot.set_valign(Gtk.Align.CENTER)
                bslot.pack_start(ui.pill(tag, tone), False, False, 0)
                brow.pack_end(bslot, False, False, 0)
                ui.set_row_tooltip(brow, "%s\n%s" % (label, detail))
                banner_card.pack_start(brow, False, False, 0)

    for section in spec["sections"]:
        # A SECTION WITH NO ROWS MUST NOT RENDER ITS HEADING.
        # `section()` was called unconditionally, so an empty rows list drew a
        # caption with an empty card underneath and nothing in it, which reads
        # to a user as a feature that failed to load rather than one that was
        # never there. Removing the one empty section in the data fixes today;
        # this stops the next one rendering at all. Found by an inspector.
        if not section["rows"]:
            continue
        section_icon = section_nav_icon(name, section)
        target.section(section["caption"], section.get("note"),
                       icon_path=section_icon)
        card = target.card()
        for row in section["rows"]:
            leading = ui.icon(os.path.join(ICONS, row["icon"]), 22) if row.get("icon") else None
            kind = row["kind"]

            if kind == "switch":
                # LIVE STATE IS READ ON A WORKER, NOT HERE.
                #
                # This used to call read_switch() inline, so the window did not
                # appear until every status command in it had run to completion,
                # one after another, on the UI thread. Measured on
                # <lab-host> once the auth chain was repaired and the
                # commands actually ran: one `health-control offline-wifi
                # --action check --json` costs 1579ms, and the windows took
                #     harden 2.2s   status 2.7s   identity 6.4s
                #     devices 11.4s   services 16.0s
                # to put a single pixel on screen. Before the auth repair every
                # check failed instantly, which is the only reason this was not
                # visible earlier: the bug was PAID FOR by a second bug.
                #
                # So the row is drawn immediately in a "reading" state and the
                # real value is filled in when it arrives. `cell` is the mutable
                # box Apply reads, because the initial state is no longer known
                # at build time and a captured value would be permanently None,
                # which the touched-flag logic below would then treat as unknown
                # for the life of the window.
                has_check = bool(row.get("check"))
                # A row with no status command is never read, so it must not
                # start life as "pending": paint_strip() counts pending cells
                # and the Hardening window said "READING 1 of 7" for as long as
                # it stayed open, the 1 being "Answer ping", which has no check
                # by design (measured 2026-09-05 on <lab-host>).
                cell = {"state": None, "why": "pending" if has_check else "no-status"}
                widget = ui.switch_row(
                    card, row["name"], row.get("note"), leading=leading,
                    active=False,
                    state_text="reading" if has_check else "no status",
                    tone="info" if has_check else "off",
                    badges=row.get("badges"))
                # WHY A TOUCHED FLAG AND NOT JUST A COMPARISON.
                # An unknown row has state None and is DRAWN off, so `now`
                # is False and `False == None` is False: a plain comparison
                # reads every untouched unknown row as CHANGED and fires its
                # OFF command. Eleven rows here have no status command at all,
                # so they are permanently unknown, and opening the window and
                # pressing Apply without touching anything would have torn down
                # Tirdad, cold-boot defence, RAM wipe, the USB guard, ICMP
                # blocking, the Tor DNS redirect, IPv6 handling, system logs,
                # the screensaver, DPMS and network tuning. Under a footer that
                # reads "runs only what you changed".
                #
                # The flag records a real user interaction, so an unknown row
                # stays silent until touched, and a user who DOES want it off
                # can still toggle it on and back off to say so deliberately.
                seen = {"touched": False, "generation": 0}
                widget.seen = seen
                widget.connect("notify::active", _mark_touched)
                on_cmd = direct_preview(row["on"]) if resolve(row["on"]) else None
                off_cmd = direct_preview(row["off"]) if resolve(row["off"]) else None
                if has_check:
                    pending.append((row, widget, cell))
                # A TOOLTIP ON EVERY CONTROL, operator: "add proper tool tips to
                # all controls". It names what the switch does in words first,
                # then the exact commands, then why it cannot be read if it
                # cannot, so hovering always answers "what will this do to me".
                # The command half of the tooltip is fixed and can be built now;
                # the state half is appended by settle() when the read lands.
                tip = [row["name"]]
                if row.get("note"):
                    tip.append(row["note"])
                if not has_check:
                    tip.append("This feature has no status command, so its "
                               "current state is unknown.")
                if on_cmd:
                    tip.append(f"on:   {on_cmd}")
                if off_cmd:
                    tip.append(f"off:  {off_cmd}")
                # AND THE COMMAND THAT PRODUCED THE STATE ON THE PILL.
                # A switch showing "on" is making a claim, and until now the
                # hover said which commands would CHANGE the setting but never
                # which one was ASKED. That is the half a reader needs when the
                # pill disagrees with what they believe, which is exactly the
                # situation the operator photographed on a20/a30: the row said
                # Torrify Off while the browser was demonstrably on Tor, and
                # nothing on screen or in the hover named the command whose
                # answer that was, so the claim could not be checked.
                check_cmd = (direct_preview(row["check"])
                             if row.get("check") and resolve(row["check"])
                             else None)
                if check_cmd:
                    tip.append(f"read: {check_cmd}")
                widget.base_tip = list(tip)
                ui.set_row_tooltip(widget, "\n".join(tip))
                launcher = row.get("launcher")
                if launcher:
                    launch_legacy = resolve(launcher["act"])
                    launch_command = (direct_preview(launcher["act"])
                                      if launch_legacy else None)
                    launch_missing = missing_required_tools(
                        launcher, launch_legacy, launcher["act"])
                    launch_button = ui.cls(
                        Gtk.Button(label=(
                            "Not detected" if launch_missing else "Open")),
                        "ghost")
                    launch_button.set_valign(Gtk.Align.CENTER)
                    launch_button.spec_row = launcher
                    launch_tip = [
                        launcher["name"],
                        "Opens the graphical control beside this service.",
                    ]
                    if launch_command:
                        launch_tip.append(f"runs: {launch_command}")
                    if launch_missing:
                        launch_tip.append(
                            "Not detected: " + ", ".join(launch_missing))
                        launch_button.set_sensitive(False)
                    else:
                        launch_button.connect(
                            "clicked", make_runner(
                                win, launcher, target, None, widget.row))
                    launch_button.set_tooltip_text("\n".join(launch_tip))
                    ui.set_control_accessibility(
                        launch_button, launcher["name"],
                        "\n".join(launch_tip[1:]))
                    widget.row.pack_end(launch_button, False, False, 0)
                if not has_check:
                    unknown += 1
                switches.append((row, widget, cell, seen))

            elif kind == "fact":
                # A READING, NOT A CONTROL, and drawn before its value is known.
                #
                # The row appears immediately showing "reading" and the real verdict lands from
                # the section's single worker below. That ordering is the same lesson the switch
                # arm records twenty lines up: reading state inline blocked the window for
                # seconds per row, and a firmware panel has fourteen of them behind one command
                # that takes about five seconds.
                handle = ui.fact_row(
                    card, row["name"], row.get("note"), leading=leading,
                    state_text="reading", tone="info")
                fact_rows.append((section, row, handle))

            elif kind == "choice":
                radio = ui.radio_row(card, group[0], row["name"], row.get("note"),
                                     leading=leading, badges=row.get("badges"))
                # A TOOLTIP ON EVERY CONTROL, and the radio rows were the one
                # kind that had none: switches and action rows both got one, so
                # a protocol row was the only control in the product that could
                # not tell you what it would run. The badges are repeated in
                # words here because a pill is a summary and the hover is where
                # the reader goes when the summary is not enough.
                tip = [row["name"]]
                if row.get("note"):
                    tip.append(row["note"])
                for btext, _btone in (row.get("badges") or ()):
                    tip.append(btext)
                preview = (direct_preview(row["act"])
                           if resolve(row["act"]) else None)
                if preview:
                    tip.append(f"runs: {preview}")
                ui.set_row_tooltip(radio, "\n".join(tip))
                if group[0] is None:
                    group[0] = radio
                    radio.set_active(False)
                    # AND IT DID NOT WORK, because a GtkRadioButton created from
                    # a NULL group is the only member of that group and GTK will
                    # not leave a one-member group empty: set_active(False) on it
                    # is a no-op. So the FIRST protocol in the window was drawn
                    # filled in, and the window silently claimed a transport was
                    # selected when nothing was. The operator saw AmneziaWG
                    # "selected" on a machine that was not connected to it.
                    # A hidden leader nobody can see or reach owns the group
                    # instead, so every visible radio starts genuinely empty and
                    # the first click is the first choice. It is never added to
                    # `picks`, so Apply cannot resolve it to a command.
                    hidden = Gtk.RadioButton.new_from_widget(radio)
                    hidden.set_no_show_all(True)
                    hidden.set_active(True)
                    radio.set_active(False)
                picks[radio] = row["act"]
                radio.spec_row = row      # so Apply can read `recovery` off it
                # Same reasoning as the switch touched-flag: a radio is drawn in
                # SOME position, and drawing is not choosing. Without this, an
                # untouched window still reports one active radio and Apply runs
                # it. Only a real toggle counts as the user answering.
                def mark_choice(button, selected_row=row):
                    if not button.get_active():
                        return
                    chose["touched"] = True
                    chose["generation"] += 1
                    # The Apply button must name THIS choice, not the window's
                    # build-time default. `act` is (category, label) and its
                    # label is already the imperative the row promises.
                    act = selected_row.get("act") or ()
                    chose["label"] = act[1] if len(act) > 1 else None
                    if name == "torrify":
                        choice_status["preview"] = direct_preview(
                            selected_row["act"])
                        choice_status["applied"] = None

                radio.connect("toggled", mark_choice)

            elif kind == "surface":
                inner = ui.mark_control(ui.cls(ui.hbox(13), "row"))
                if leading is not None:
                    leading.set_valign(Gtk.Align.CENTER)
                    inner.pack_start(leading, False, False, 0)
                text = ui.vbox(2)
                text.set_valign(Gtk.Align.CENTER)
                text.pack_start(ui.lbl(row["name"], "row-name"), False, False, 0)
                if row.get("note"):
                    text.pack_start(ui.lbl(row["note"], "row-note"), False, False, 0)
                inner.pack_start(text, True, True, 0)
                # A SURFACE ROW HAS NO PILL, AND WITHOUT THIS IT WOULD BE THE
                # ONE ROW WHOSE BUTTON SITS FLUSH RIGHT while every pilled row
                # beside it sits PILL_COLUMN_PX further left. An EMPTY slot of
                # the same width keeps one right edge down the whole card. It
                # holds no pill on purpose: this row opens a window, it does not
                # run anything, so it has no state to report and inventing a
                # "ready" pill here would be a control reporting on nothing.
                inner.pack_end(action_slot(ui.hbox(6), win), False, False, 0)
                button = action_button(ui.cls(Gtk.Button(label="Open"), "ghost"), win)
                button.set_valign(Gtk.Align.CENTER)
                tip = [row["name"], "Opens the full control window."]
                if row.get("tab"):
                    tip.append(f"Opens the {row['tab']} tab.")
                button.set_tooltip_text("\n".join(tip))
                ui.set_control_accessibility(
                    button, row["name"], "\n".join(tip[1:]))
                inner.set_tooltip_text("\n".join(tip))
                button.connect("clicked", make_surface_opener(win, row, target))
                inner.pack_end(button, False, False, 0)
                card.pack_start(inner, False, False, 0)

            elif kind == "sandbox":
                inner = ui.mark_control(ui.cls(ui.hbox(13), "row"))
                if leading is not None:
                    leading.set_valign(Gtk.Align.CENTER)
                    inner.pack_start(leading, False, False, 0)
                text = ui.vbox(2)
                text.set_valign(Gtk.Align.CENTER)
                text.pack_start(
                    ui.lbl(row["name"], "row-name"), False, False, 0)
                if row.get("note"):
                    text.pack_start(
                        ui.lbl(row["note"], "row-note"), False, False, 0)
                inner.pack_start(text, True, True, 0)
                pill_slot = action_slot(ui.hbox(6), win)
                pill_slot.set_valign(Gtk.Align.CENTER)
                # `ready` for the same reason as the isolated rows below:
                # this is a launcher, and an unpressed launcher has not failed.
                pill_slot.pack_start(
                    ui.pill("ready", "off"), False, False, 0)
                inner.pack_end(pill_slot, False, False, 0)
                button = action_button(
                    ui.cls(Gtk.Button(label="Open sandboxed"), "ghost"), win)
                button.set_valign(Gtk.Align.CENTER)
                button.spec_row = row
                missing = []
                try:
                    launcher = canonical_firejail_launcher()
                except RuntimeError:
                    launcher = FIREJAIL_LAUNCHER
                    missing.append("Kodachi Firejail launcher")
                if shutil.which("firejail") is None:
                    missing.append("firejail")
                if shutil.which(row["executable"]) is None:
                    missing.append(row["executable"])
                preview = shlex.join([launcher, row["app_id"]])
                tip = [
                    row["name"],
                    row.get("note") or "Launches this application through Firejail.",
                    "Profile: " + row["profile"],
                    "runs: " + preview,
                ]
                if missing:
                    tip.append("Not detected: " + ", ".join(missing))
                    for child in pill_slot.get_children():
                        pill_slot.remove(child)
                    pill_slot.pack_start(
                        ui.pill("Not detected", "warn"), False, False, 0)
                    button.set_label("Not detected")
                    button.set_sensitive(False)
                else:
                    button.connect(
                        "clicked",
                        make_sandbox_runner(
                            win, row, target, pill_slot, inner))
                button.set_tooltip_text("\n".join(tip))
                ui.set_control_accessibility(
                    button, row["name"], "\n".join(tip[1:]))
                inner.set_tooltip_text("\n".join(tip))
                inner.pack_end(button, False, False, 0)
                card.pack_start(inner, False, False, 0)

            elif kind == "isolated":
                # ONE ROW, THREE RUNTIMES, ONE LAUNCH BUTTON.
                #
                # The three arms are a Gtk.RadioButton group with set_mode(False)
                # so they render as a segmented chip strip rather than three
                # bullets. They are a GROUP and not three independent toggles on
                # purpose: exactly one runtime is in force at any moment, and a
                # group is the widget that cannot represent zero or two.
                #
                # THE SELECTED ARM CARRIES A NON-COLOUR MARK. The accent fill on
                # `button.statetoggle:checked` is the only difference between
                # selected and not, and colour alone fails a colourblind reader
                # and a greyscale screenshot, which is the same argument
                # ui.state_toggle() already makes for the switches next door.
                # THE CHIP STRIP GETS ITS OWN LINE, AND THAT IS A WIDTH FIX.
                #
                # MEASURED 2026-09-04 on the live ISO, <lab-host>,
                # DISPLAY=:0, sandbox page at its real opening width of 1064,
                # every child of one catalog row:
                #
                #     child                       min   nat   alloc  expand
                #     icon                         22    22      22   no
                #     name + note                  55   424      88   YES
                #     chips NATIVE/FIREJAIL/PODMAN 338   338     338   no
                #     pill "ready"                104   104     104   no
                #     button "Launch in Firejail" 150   150     150   no
                #
                # The three fixed controls take 592 of the row's 786px while
                # the ONE column that says WHICH application the row is about
                # gets 88, so `Monero Wallet GUI` rendered `Monero ...`
                # (is_ellipsized True, measured) and its note wrapped to SEVEN
                # lines in the same 88px. Every other element is a fixed-width
                # control, so the name is always the first thing to go.
                #
                # Ellipsizing the chips does NOT fix it: GTK hands a non-expand
                # child its NATURAL width and only the remainder to the expand
                # child, so capping the chips' MINIMUM (measured 338 -> 182)
                # left the name at 88 unchanged. Only removing the chips from
                # this line frees their natural width.
                #
                # `inner` stays the row_box the runners style with `sel` and
                # append to `_result_rows`, and stays the one `mark_control`
                # tag, so the sidebar control census is unchanged. It is now a
                # vbox holding the text line and the chip line.
                inner = ui.mark_control(ui.cls(ui.vbox(8), "row"))
                line = ui.hbox(13)
                if leading is not None:
                    leading.set_valign(Gtk.Align.CENTER)
                    line.pack_start(leading, False, False, 0)
                text = ui.vbox(2)
                text.set_valign(Gtk.Align.CENTER)
                text.pack_start(ui.lbl(row["name"], "row-name"), False, False, 0)
                # THE NOTE IS THE ONE THE OPERATOR ACTUALLY READS, so the
                # Podman sentence is composed HERE, where the machine's state
                # is known, rather than baked into kodachi_windows.py where it
                # is not. The two terminal rows used to carry the promise in
                # their static prose and kept promising it on a box with no
                # container runtime.
                note = row.get("note")
                if row["podman"]:
                    note = " ".join(part for part
                                    in (note, podman_row_sentence(row)) if part)
                if note:
                    text.pack_start(ui.lbl(note, "row-note"), False, False, 0)
                line.pack_start(text, True, True, 0)

                chosen = {"runtime": row["default_runtime"]}
                adapter_missing = []
                try:
                    adapter = canonical_isolation_launcher()
                except RuntimeError:
                    adapter = ISOLATION_LAUNCHER
                    adapter_missing.append("Kodachi isolation launcher")

                pill_slot = action_slot(ui.hbox(6), win)
                pill_slot.set_valign(Gtk.Align.CENTER)
                # `ready`, NOT `not run`. On an action row `not run` is right:
                # it separates an unperformed check from a passing one. On a
                # LAUNCHER it reads as a refusal, and next to a greyed PODMAN
                # chip it read as one loudly enough that the operator asked
                # "why i cant run pdaman and it says not run". Nothing has
                # failed here; the row is simply waiting to be pressed.
                pill_slot.pack_start(ui.pill("ready", "off"), False, False, 0)

                button = action_button(ui.cls(Gtk.Button(label="Launch"), "ghost"), win)
                button.set_valign(Gtk.Align.CENTER)
                button.spec_row = row

                seg = ui.cls(ui.hbox(4), "seg")
                seg.set_valign(Gtk.Align.CENTER)
                seg_leader = [None]
                arms = {}
                for runtime in kw.ISOLATION_RUNTIMES:
                    label = ISOLATION_RUNTIME_LABELS[runtime]
                    arm = (Gtk.RadioButton.new_with_label_from_widget(
                               seg_leader[0], label)
                           if seg_leader[0] is not None
                           else Gtk.RadioButton.new_with_label(None, label))
                    arm.set_mode(False)
                    ui.cls(arm, "chip", "statetoggle")
                    if seg_leader[0] is None:
                        seg_leader[0] = arm
                    arms[runtime] = arm
                    missing = isolation_arm_missing(
                        row, runtime, adapter_missing)
                    # TWO DIFFERENT REFUSALS, AND THEY ARE NOT INTERCHANGEABLE.
                    #
                    # A graphical row is refused because the shipped container
                    # has no display socket, which is permanent and true on
                    # every machine. ANY row is refused when Podman itself is
                    # not installed, which is a property of THIS machine and
                    # the user can fix it. Until 2026-08-25 both said the
                    # first sentence, so a workstation with no Podman was told
                    # its container lacked a display socket.
                    #
                    # It also left the two container-capable rows (the two
                    # terminals) ENABLED with no Podman on the box, so the one
                    # arm that was allowed to be pressed was the one that
                    # failed after the click.
                    if runtime == "podman" and not row["podman"]:
                        available, reason = False, kw.NO_DISPLAY_REASON
                    elif missing:
                        available = False
                        reason_parts = []
                        if runtime == "podman" and "Podman" in missing:
                            reason_parts.append(kw.PODMAN_ABSENT_REASON)
                        other_missing = [item for item in missing
                                         if item != "Podman"]
                        if other_missing:
                            reason_parts.append(
                                "Not detected: " + ", ".join(other_missing))
                        reason = " ".join(reason_parts)
                    else:
                        available, reason = True, ""
                    # THE CHIP ITSELF CARRIES THE SHORT REASON. A disabled
                    # control whose reason is only in hover text is a control
                    # the operator reads as broken, and he did: "why i cant run
                    # pdaman and it says not run".
                    display_label = label if available else "%s , %s" % (
                        label, "no display" if runtime == "podman"
                        and not row["podman"] else "not installed")
                    arm_tip = [f"{row['name']}: {label}",
                               ISOLATION_RUNTIME_TIPS[runtime]]
                    if not available:
                        arm_tip.append(reason)
                        # INSENSITIVE WITH ITS REASON, NEVER HIDDEN. A hidden
                        # control leaves the reader asking whether Kodachi can
                        # do this at all; a disabled one with hover text
                        # answers, and the answer is a property of the shipped
                        # container rather than of this application.
                        arm.set_sensitive(False)
                    else:
                        arm_tip.append(
                            "runs: " + shlex.join([adapter, runtime, row["app_id"]]))
                    arm.missing_prerequisites = tuple(missing)
                    arm.display_label = display_label
                    arm.set_label(display_label)
                    arm.set_tooltip_text("\n".join(arm_tip))
                    ui.set_control_accessibility(
                        arm, f"{row['name']} {label}", "\n".join(arm_tip[1:]))
                    seg.pack_start(arm, False, False, 0)

                tip = [row["name"],
                       row.get("note") or "Choose a runtime, then launch it.",
                       "Firejail profile: " + row["profile"],
                       "Podman: " + podman_row_sentence(row)]

                def paint_arms(_widget=None, arms=arms, chosen=chosen,
                               button=button, row=row, pill_slot=pill_slot):
                    for runtime, arm in arms.items():
                        mark = (ui.TOGGLE_ON_MARK if arm.get_active()
                                else ui.TOGGLE_OFF_MARK)
                        arm.set_label(
                            "%s %s" % (mark, getattr(
                                arm, "display_label",
                                ISOLATION_RUNTIME_LABELS[runtime])))
                        if arm.get_active():
                            chosen["runtime"] = runtime
                    selected = arms[chosen["runtime"]]
                    enabled = selected.get_sensitive()
                    button.set_sensitive(enabled)
                    for child in pill_slot.get_children():
                        pill_slot.remove(child)
                    pill_slot.pack_start(
                        ui.pill("ready" if enabled else "Not detected",
                                "off" if enabled else "warn"),
                        False, False, 0)
                    pill_slot.show_all()
                    if enabled:
                        button.set_label(
                            "Launch in a container"
                            if chosen["runtime"] == "podman"
                            else "Launch natively"
                            if chosen["runtime"] == "native"
                            else "Launch in Firejail")
                    else:
                        button.set_label("Not detected")
                    arm_states = [arm.get_tooltip_text() or ""
                                  for arm in arms.values()]
                    button_tip = "\n".join(tip + arm_states)
                    button.set_tooltip_text(button_tip)
                    ui.set_control_accessibility(
                        button, row["name"],
                        "\n".join(tip[1:] + arm_states))

                for arm in arms.values():
                    arm.connect("toggled", paint_arms)
                arms[row["default_runtime"]].set_active(True)
                button.connect(
                    "clicked",
                    make_isolated_runner(
                        win, row, chosen, target, pill_slot, inner))
                paint_arms()

                arm_states = [arm.get_tooltip_text() or ""
                              for arm in arms.values()]
                inner.set_tooltip_text("\n".join(tip + arm_states))
                line.pack_end(button, False, False, 0)
                line.pack_end(pill_slot, False, False, 0)
                inner.pack_start(line, False, False, 0)
                # Left-aligned under the name rather than stretched, so the
                # strip reads as one control and not as a spread-out toolbar.
                seg.set_halign(Gtk.Align.START)
                inner.pack_start(seg, False, False, 0)
                card.pack_start(inner, False, False, 0)

            elif kind == "launch":
                inner = ui.mark_control(ui.cls(ui.hbox(13), "row"))
                if leading is not None:
                    leading.set_valign(Gtk.Align.CENTER)
                    inner.pack_start(leading, False, False, 0)
                text = ui.vbox(2)
                text.set_valign(Gtk.Align.CENTER)
                text.pack_start(ui.lbl(row["name"], "row-name"), False, False, 0)
                if row.get("note"):
                    text.pack_start(ui.lbl(row["note"], "row-note"), False, False, 0)
                inner.pack_start(text, True, True, 0)
                pill_slot = action_slot(ui.hbox(6), win)
                pill_slot.set_valign(Gtk.Align.CENTER)
                # `ready` for the same reason as the isolated rows above.
                pill_slot.pack_start(ui.pill("ready", "off"), False, False, 0)
                inner.pack_end(pill_slot, False, False, 0)
                button = action_button(
                    ui.cls(Gtk.Button(label="Open" if row["terminal"] else "Run"),
                           "danger" if row["danger"] else "ghost"), win)
                button.set_valign(Gtk.Align.CENTER)
                button.spec_row = row
                program = row["argv"][0]
                absent = (which_including_sbin(program) is None
                          and not os.path.isfile(program))
                # THE MANAGER BEING PRESENT IS NOT THE SAME AS PODMAN BEING
                # PRESENT, and only the first was ever checked. Every verb on
                # the Containers tab is kodachi-container-manager, which ships
                # with Kodachi and is therefore always detected, so all six
                # buttons stayed enabled on a machine with no container runtime
                # and each one failed AFTER the click, in a terminal, with the
                # manager's own message. A button that can only fail is the
                # defect the greyed PODMAN chip was already avoiding one tab
                # over; this makes the two pages behave the same way.
                needs_podman = (program == kw.CONTAINER_MANAGER
                                and not container_runtime_ready())
                tip = [row["name"],
                       row.get("note") or "Runs one fixed Kodachi command.",
                       "runs: " + shlex.join(list(row["argv"]))]
                if row["terminal"]:
                    tip.append("Opens in a terminal window titled "
                               + row["terminal"] + ", because it needs a shell.")
                if absent:
                    tip.append("Not detected: " + program)
                    for child in pill_slot.get_children():
                        pill_slot.remove(child)
                    pill_slot.pack_start(
                        ui.pill("Not detected", "warn"), False, False, 0)
                    button.set_label("Not detected")
                    button.set_sensitive(False)
                elif needs_podman:
                    tip.append(kw.PODMAN_ABSENT_REASON)
                    tip.append("The Kodachi container manager itself IS "
                               "installed at " + program + ". It is the "
                               "runtime underneath it that is missing.")
                    for child in pill_slot.get_children():
                        pill_slot.remove(child)
                    pill_slot.pack_start(
                        ui.pill("needs Podman", "warn"), False, False, 0)
                    button.set_label("Needs Podman")
                    button.set_sensitive(False)
                else:
                    button.connect(
                        "clicked",
                        make_launch_runner(win, row, target, pill_slot, inner))
                button.set_tooltip_text("\n".join(tip))
                ui.set_control_accessibility(
                    button, row["name"], "\n".join(tip[1:]))
                inner.set_tooltip_text("\n".join(tip))
                inner.pack_end(button, False, False, 0)
                card.pack_start(inner, False, False, 0)

            else:  # action and report both run on click
                inner = ui.mark_control(ui.cls(ui.hbox(13), "row"))
                if leading is not None:
                    leading.set_valign(Gtk.Align.CENTER)
                    inner.pack_start(leading, False, False, 0)
                text = ui.vbox(2)
                text.set_valign(Gtk.Align.CENTER)
                text.pack_start(ui.lbl(row["name"], "row-name"), False, False, 0)
                if row.get("note"):
                    text.pack_start(ui.lbl(row["note"], "row-note"), False, False, 0)
                inner.pack_start(text, True, True, 0)
                # A PERSISTENT RESULT PILL ON THE ROW ITSELF.
                #
                # The exit code was computed, shown once in a throwaway window
                # and discarded. Keeping it on the row turns a menu of buttons
                # into a status board: run six checks in this window and six
                # coloured pills stay visible at a glance, with the panel below
                # showing whichever was clicked last. On a privacy OS that is the
                # product's job rather than decoration.
                #
                # The pill starts in a NEUTRAL "not run" state, distinct from
                # both pass and fail, so an untouched row can never be mistaken
                # for a passing one. Same reasoning as the unknown switch state.
                pill_slot = action_slot(ui.hbox(6), win)
                pill_slot.set_valign(Gtk.Align.CENTER)
                pill_slot.pack_start(ui.pill("not run", "off"), False, False, 0)
                inner.pack_end(pill_slot, False, False, 0)
                prints_a_report = kind == "report"
                effect = row_effect(row)
                opens_application = row.get("execution") == "launch"
                label = "Open" if opens_application else (
                    "Show" if prints_a_report else "Run")
                button = action_button(ui.cls(Gtk.Button(label=label),
                                              "danger" if row.get("danger") else "ghost"), win)
                button.set_valign(Gtk.Align.CENTER)
                button.spec_row = row
                # Show the command this row resolves to, so the window never
                # asks anyone to press a button whose effect is invisible.
                legacy_preview = resolve(row["act"])
                preview = direct_preview(row["act"]) if legacy_preview else None
                missing_tools = missing_required_tools(
                    row, legacy_preview, row["act"])
                tip = [row["name"]]
                if row.get("note"):
                    tip.append(row["note"])
                tip.extend(workflow_tooltip_lines(row))
                if opens_application:
                    tip.append(
                        "Opens a detached application. This window checks the "
                        "launch briefly, then leaves it running.")
                else:
                    tip.append({
                        "mutating": "Changes settings or system state.",
                        "read-only": "Shows a report. Nothing is changed.",
                        "launch": "Opens another application.",
                    }.get(effect, "Effect is not classified; success is not assumed."))
                if preview:
                    tip.append(f"runs: {preview}")
                if missing_tools:
                    missing_text = ", ".join(missing_tools)
                    tip.append("Not detected: " + missing_text)
                    for child in pill_slot.get_children():
                        pill_slot.remove(child)
                    pill_slot.pack_start(
                        ui.pill("Not detected", "warn"), False, False, 0)
                    button.set_label("Not detected")
                    button.set_sensitive(False)
                if row.get("workflow_meta"):
                    tip = [
                        wrapped
                        for line in tip
                        for wrapped in _wrap_tooltip_line(line)
                    ]
                button.set_tooltip_text("\n".join(tip))
                ui.set_control_accessibility(
                    button, row["name"], "\n".join(tip[1:]))
                inner.set_tooltip_text("\n".join(tip))
                if not missing_tools:
                    button.connect(
                        "clicked", make_runner(win, row, target, pill_slot, inner))
                inner.pack_end(button, False, False, 0)
                card.pack_start(inner, False, False, 0)

    if picks:
        choice_groups.append(picks)

    # ── `mode: "facts"` sections: one command per section, not one per row ──────
    #
    # WHY A SINGLE READ. Fourteen rows against fourteen invocations of a privileged command that
    # measures about five seconds would be seventy seconds of subprocess for one panel. The
    # section declares ONE source, the driver runs it once, and every row takes its value out of
    # that one reply.
    #
    # WHY THE COMMAND STILL COMES FROM THE REGISTRY. `source` is a (Category, Label) pair resolved
    # exactly like any other row's, so the command a fact panel runs is visible in the same place
    # as every other command this window can run, and the direct-execution contract still governs
    # it. Hardcoding the command here would put one command outside the allowlist that exists to
    # describe them all.
    if fact_rows:
        def unavailable(rows, reason):
            """Every row says it could not read, and the strip says why. Never a zero score.

            THE DEFECT THIS EXISTS TO PREVENT, found by an inspector on 2026-09-02 and it was
            real: with no `available` check, a missing fwupd produced an EMPTY attribute list,
            every row fell through the per-row "no matching attribute" arm and rendered a grey
            "not offered", and the strip totalled "CHECKS 0 / 0 pass". Fourteen confident
            statements about a platform nothing had read, plus a zero that looks like a clean
            machine. The Rust producer refuses exactly this at firmware_security.rs:237-249 and
            hands up a `reason`; the panel was throwing that away.
            """
            for _r, h in rows:
                try:
                    ui.set_pill(h.pill, "unreadable", "off")
                    ui.set_row_tooltip(h, reason)
                except Exception:
                    pass
            try:
                target.state_strip([("FIRMWARE", "unreadable", "off"),
                                    ("WHY", reason, "warn")])
                target._state_slot.show_all()
            except Exception:
                pass

        def settle_facts(section_key, payload, error):
            """Land one section's reply on the UI thread. Never call off-thread."""
            rows = [(r, h) for sec, r, h in fact_rows if id(sec) == section_key]
            if error is not None:
                unavailable(rows, error)
                return

            data = (payload or {}).get("data") or {}
            hsi = data.get("hsi") or {}

            # FAIL CLOSED, AND SAY WHY. Four gates, cheapest first. The producer distinguishes
            # "fwupd is not installed", "it could not be executed", "its JSON did not parse" and
            # "it returned no attributes"; every one of those must reach the user as a reason,
            # never as a verdict about their hardware.
            envelope_status = str((payload or {}).get("status") or "").lower()
            if envelope_status and envelope_status != "success":
                unavailable(rows, "health-control reported %s" % envelope_status)
                return
            if hsi.get("available") is not True:
                unavailable(rows, str(hsi.get("reason")
                                      or "the firmware reader returned no result"))
                return
            attributes = hsi.get("attributes") or []
            if not attributes:
                unavailable(rows, "the firmware reader returned no attributes")
                return

            by_name = {}
            duplicates = set()
            for attribute in attributes:
                name = str(attribute.get("name", "")).strip().lower()
                if not name:
                    continue
                # FINDING 6: fwupd genuinely emits "Platform debugging" TWICE, once under HSI-1
                # and once under HSI-2, measured on this host. No key in the panel collides with
                # a duplicated name today, but last-wins would silently pick one of two rows if
                # one ever did, so a collision is recorded and surfaced in the tooltip rather
                # than resolved by luck.
                if name in by_name:
                    duplicates.add(name)
                by_name[name] = attribute

            for r, h in rows:
                attribute = by_name.get(str(r.get("key", "")).strip().lower())
                if attribute is None:
                    # ABSENT IS NOT FAILED. The HSI attribute set differs by machine: a
                    # legacy-BIOS box reports 21 where a UEFI box reports 24, so a missing
                    # attribute means fwupd has nothing to say about this check on this
                    # hardware. Drawing that as a failure would be a lie about the platform.
                    try:
                        ui.set_pill(h.pill, "not offered", "off")
                        ui.set_row_tooltip(
                            h, "%s: fwupd reports no such check on this platform." % r["name"])
                    except Exception:
                        pass
                    continue
                passed = attribute.get("pass") is True
                verdict = str(attribute.get("result", "unknown")).replace("-", " ")
                try:
                    ui.set_pill(h.pill, verdict.upper(), "on" if passed else "danger")
                    tip = [r["name"]]
                    if attribute.get("description"):
                        tip.append(str(attribute["description"]))
                    tip.append("fwupd reports: %s" % attribute.get("result", "unknown"))
                    # FINDING 2. Unprivileged, the SPI family degrades from a real reading to
                    # `not-found`, which is indistinguishable from a genuine absence. The
                    # producer records which kind of run this was; hiding that here would let a
                    # degraded reading be read as a measurement.
                    if hsi.get("privileged") is False:
                        tip.append("Read WITHOUT root: the SPI checks report not-found when "
                                   "they cannot be read, which looks the same as absent.")
                    if str(r.get("key", "")).strip().lower() in duplicates:
                        tip.append("fwupd lists this name more than once; this row shows the "
                                   "last of them.")
                    ui.set_row_tooltip(h, "\n".join(tip))
                except Exception:
                    pass

            # The header strip and the score, from the same single reply.
            try:
                platform = data.get("platform") or {}
                summary = hsi.get("summary") or {}
                total = int(summary.get("total") or 0)
                passed_n = int(summary.get("pass") or 0)
                virt = (platform.get("virtualization") or {}).get("virtual") is True
                # THE STRIP THE MOCKUP SPECIFIES, in its order. The approved design names
                # PLATFORM, CHASSIS, BIOS, BOOT MODE, SECURE BOOT and TPM, and carries the score
                # as a `LABEL n/m` badge, which badge() renders as the ten-dot scale. An earlier
                # version of this shipped four of the six and no score, which is the same class
                # of miss as the panel that was two rows and a button.
                boot = data.get("boot") or {}
                secure_boot = (boot.get("secure_boot") or {}).get("enabled")
                tpm = by_name.get("tpm v2.0")
                chassis = str(platform.get("chassis_type") or "unknown")
                facts = [
                    ("PLATFORM", str(platform.get("cpu_model") or "unknown"), "state-val"),
                    # FINDING 4. Collected and documented as load-bearing since fwupd stamps
                    # `chassis[other]` into an INVALID id, and previously rendered nowhere, so
                    # the id had no visible cause.
                    ("CHASSIS", chassis, "warn" if chassis.lower() in ("other", "unknown") else "state-val"),
                    ("BIOS", "%s %s" % (platform.get("bios_vendor") or "unknown",
                                        platform.get("bios_version") or ""), "state-val"),
                    ("BOOT MODE", str(platform.get("boot_mode") or "unknown"),
                     "on" if platform.get("uefi") else "warn"),
                    ("SECURE BOOT",
                     "unknown" if secure_boot is None else ("enabled" if secure_boot else "disabled"),
                     "off" if secure_boot is None else ("on" if secure_boot else "warn")),
                    ("TPM", "not found" if tpm is None else str(tpm.get("result", "unknown")),
                     "on" if (tpm or {}).get("pass") is True else "warn"),
                    # The score, as a badge shaped `LABEL n/m` so badge() draws the dot scale.
                    ("FIRMWARE", "%d/%d" % (passed_n, total),
                     "on" if total and passed_n == total else "warn"),
                ]
                if virt:
                    facts.append(("VIRTUAL", str((platform.get("virtualization") or {}).get("kind")
                                                 or "yes"), "warn"))
                if hsi.get("privileged") is False:
                    facts.append(("PRIVILEGE", "read without root", "warn"))
                if hsi.get("id"):
                    facts.append(("HOST SECURITY ID", str(hsi["id"]), "warn"))
                target.state_strip(facts)
                target._state_slot.show_all()
            except Exception:
                pass

        def read_facts():
            groups = {}
            for sec, _r, _h in fact_rows:
                groups.setdefault(id(sec), sec)
            for key, sec in groups.items():
                source = sec.get("source")
                if not source:
                    GLib.idle_add(settle_facts, key, None,
                                  "this section declares no source command")
                    continue
                # SAME RESOLVER EVERY OTHER ROW USES. `resolve()` returns the registry's command
                # string for a (Category, Label) pair, so a fact panel cannot run anything the
                # registry does not already publish.
                command = resolve(tuple(source))
                if not command:
                    GLib.idle_add(settle_facts, key, None,
                                  "no registry row for %s / %s" % (source[0], source[1]))
                    continue
                # ARGV COMES FROM THE BINDING, NEVER FROM THE REGISTRY STRING.
                #
                # This panel used to `shlex.split(command)` the registry's own
                # payload and hand the pieces to subprocess.run, which is the
                # one place in this file that parsed and executed a registry
                # string. `shell()` a thousand lines up says the payload "is
                # deliberately never parsed or executed", and the comment above
                # this reader claimed the direct-execution contract governed it
                # while the code beneath consulted no contract at all.
                #
                # It was not only a purity problem. Many sibling registry rows
                # carry a pipe (`... | kodachi-json-report`), and shlex.split
                # would have passed `|` and the second program to
                # health-control as literal arguments: no shell, so no pipe,
                # and the reader would report a confusing failure rather than
                # refusing. Nothing stops such a row reaching this key.
                #
                # `argv_for` is the validated builder every other control uses:
                # it refuses partial interpolation, requires the executable to
                # exist and be executable at its ABSOLUTE contract path, and
                # prefixes `sudo -n` itself when the binding declares
                # needsSudo, so the hand-rolled `-n` insertion below it is gone
                # with the split it was patching.
                #
                # NOTE FOR A FUTURE READER: `kd.run(key, parameters={"json":
                # True})` does NOT work here and was the first thing tried.
                # This operation's binding declares `"parameters": []`, so a
                # `json` parameter is rejected as unexpected, and `run()`
                # returns a TRANSCRIPT with stderr appended rather than clean
                # stdout, which json.loads cannot read. `--json` is appended to
                # the contract's argv instead, and the binding's own declared
                # timeout replaces the local 180 literal.
                try:
                    contract = kd.registry()
                    bindings = contract.bindings(tuple(source))
                    if len(bindings) != 1:
                        raise ValueError(
                            "this reader runs one binding, the contract declares %d"
                            % len(bindings))
                    binding = bindings[0]
                    argv = contract.argv_for(binding, {}) + ["--json"]
                    fact_timeout = binding["timeoutSeconds"]
                except (kd.DirectContractError, ValueError) as exc:
                    GLib.idle_add(settle_facts, key, None, str(exc))
                    continue
                try:
                    out = subprocess.run(argv, capture_output=True, text=True,
                                         timeout=fact_timeout)
                    if out.returncode != 0:
                        # An exit code is evidence and was being ignored. health-control can exit
                        # non-zero with partial stdout, which JSON-parsed into a plausible reply.
                        raise ValueError(
                            "the reader exited %d: %s"
                            % (out.returncode, (out.stderr or "").strip().splitlines()[0]
                               if (out.stderr or "").strip() else "no error text"))
                    payload = json.loads(out.stdout) if out.stdout.strip() else None
                    if payload is None:
                        raise ValueError("the command produced no JSON")
                    GLib.idle_add(settle_facts, key, payload, None)
                except Exception as exc:
                    GLib.idle_add(settle_facts, key, None, str(exc))

        def facts_start_failed(_exc):
            for sec, _r, _h in fact_rows:
                GLib.idle_add(settle_facts, id(sec), None, "the reader could not be started")

        start_daemon(threading.Thread(target=read_facts, daemon=True), facts_start_failed)

    def staged_count():
        count = 0
        for _row, widget, cell, seen in switches:
            initial = cell["state"]
            if initial is None:
                count += int(seen["touched"])
            else:
                count += int(widget.get_active() != bool(initial))
        if chose["touched"] and any(
                radio.get_active()
                for picks_group in choice_groups
                for radio in picks_group):
            count += 1
        return count

    def current_apply_label():
        """What Apply should be called RIGHT NOW, given what is staged."""
        if chose["touched"] and chose["label"]:
            return chose["label"]
        return spec.get("apply_label", "Apply")

    def refresh_pending(*_args):
        # Retitle BEFORE set_footer_pending: that helper rebuilds the tooltip
        # and the accessible name from the button's current label, so setting
        # the label second would leave both describing the previous choice.
        ui.set_footer_primary_label(target, current_apply_label())
        ui.set_footer_pending(target, staged_count())
        if name != "torrify":
            return
        note = getattr(target, "footer_note", None)
        if note is None:
            return
        if chose["touched"] and choice_status["preview"]:
            note.set_text(choice_status["preview"])
        elif choice_status["applied"]:
            note.set_text(choice_status["applied"])

    def paint_strip():
        """Summarise the switches. Called once now and again as reads land."""
        if not switches:
            return
        unread = sum(1 for _, _, c, _ in switches if c["state"] is None)
        denied = sum(1 for _, _, c, _ in switches if c["why"] == "refused")
        busy = sum(1 for _, _, c, _ in switches if c["why"] == "pending")
        if busy:
            target.state_strip([
                ("Controls", str(len(switches)), "state-val"),
                ("Reading", f"{busy} of {len(switches)}", "warn"),
            ])
        elif denied:
            # The most useful thing this window can say when nothing reads: the
            # machine refused, and here is the one-line reason.
            target.state_strip([
                ("Controls", str(len(switches)), "state-val"),
                ("Cannot read", f"{denied} refused, sign in", "warn"),
            ])
        elif unread:
            target.state_strip([("Controls", str(len(switches)), "state-val"),
                                ("State unknown", str(unread), "warn")])
        else:
            on = sum(1 for _, w, _, _ in switches if w.get_active())
            target.state_strip([("Controls", str(len(switches)), "state-val"),
                                ("On now", str(on), "on" if on else "off")])
        target._state_slot.show_all()

    paint_strip()

    def settle(row, widget, cell, state, why):
        """Land one worker's answer on the UI thread. Never call off-thread."""
        # ORDER MATTERS HERE, AND GETTING IT WRONG ARMS APPLY.
        #
        # This used to commit cell["state"] on its FIRST line and move the switch
        # forty lines later. Anything that raised in between (measured: a stale
        # kodachi_ui on the VM with no set_pill, AttributeError out of the
        # idle_add callback) left the cell saying ON while the widget still read
        # OFF. Apply compares exactly those two, sees a change nobody made, and
        # on the Devices window that is FIVE `--action disable` commands against
        # WiFi, Bluetooth, webcam, microphone and USB storage, from a window the
        # user only opened. It is the BUG-02 shape rediscovered through a
        # different door: state that disagrees with what is drawn.
        #
        # So the widget moves FIRST, the cell is committed only after, and
        # everything cosmetic below is wrapped: a failed pill or tooltip must
        # never be able to leave those two disagreeing.
        if (state is not None and not seen_of(widget)
                and bool(state) != widget.get_active()):
            widget.handler_block_by_func(_mark_touched)
            widget.set_active(bool(state))
            widget.handler_unblock_by_func(_mark_touched)
        cell["state"], cell["why"] = state, why
        if state is None:
            text, tone = {
                "refused": ("sign-in needed", "warn"),
                "no-status": ("no status", "off"),
            }.get(why, ("unreadable", "off"))
        else:
            text, tone = ("on", "on") if state else ("off", "off")
        # AN UNREADABLE STATE MUST NOT BE DRAWN AS A DEFINITE "OFF".
        #
        # A Gtk.Switch has two looks and defaults to off, so every row whose
        # probe was refused was drawn exactly like a row that is genuinely
        # disabled. The operator reported it as lost settings on 2026-08-23:
        # two Tuning controls he had turned on came back off after a reopen,
        # while the strip above them said "CANNOT READ 2 refused, sign in".
        # Nothing was unsaved. The read failed and the widget asserted a value
        # it did not have. `.unknown` draws it dashed and faded instead.
        #
        # Cosmetic-only, and wrapped for the same reason the pill below is: the
        # widget position and cell["state"] were already committed above, and
        # nothing down here may be able to leave those two disagreeing.
        try:
            style = widget.get_style_context()
            if state is None:
                style.add_class("unknown")
            else:
                style.remove_class("unknown")
        except Exception:
            pass
        try:
            ui.set_pill(widget.pill, text, tone)
        except Exception:
            pass        # cosmetic only: never let it break the state above
        # (The widget was moved above, before the cell was committed. The user
        # still wins a race against the read: `seen_of` means a switch they
        # already touched keeps their position, because silently undoing a
        # deliberate action a second after they took it is worse than showing a
        # stale value. And the write is made with the touched-signal BLOCKED,
        # since set_active fires notify::active exactly like a click does.)
        tip = list(getattr(widget, "base_tip", []))
        if state is None:
            tip.insert(1, {
                "refused": "State could not be read: the command was refused. "
                           "Sign in and reopen.",
                "no-status": "This feature has no status command, so its "
                             "current state is unknown.",
            }.get(why, "State could not be read."))
        ui.set_row_tooltip(widget, "\n".join(tip))
        paint_strip()
        refresh_pending()
        return False

    if pending:
        # ONE WORKER PER CHECK, CAPPED. Serial reads were the whole cost: six
        # checks at ~1.6s each is the 11.4s the Devices window took to appear.
        # The cap keeps a 12-switch window from launching twelve sudo processes
        # at once on a VM with two cores, which trades a slow window for a
        # thrashing one.
        def read_all():
            # THE PER-JOB ARM WAS NEVER THE EXPOSURE. `job.result()` is caught
            # below and one unreadable switch settles as unreadable, which is
            # correct. What was unguarded is the DRIVER around it: `r.get()`
            # on a row that is not a dict, a raise out of `pool.submit`, a
            # raise out of `as_completed`, or the executor's own __exit__.
            # Any of those kills this thread with NOT ONE row settled, and
            # every pending switch then sits in its loading state for the life
            # of the window. That is worse than a single wedged button because
            # one thread death takes out the whole batch. Reported by
            # <agent> 2026-08-23 as the third G51 vector.
            #
            # `sent` is keyed on id(w) because the widget is the identity the
            # settle callback acts on, and a row dict is not hashable.
            sent = set()
            try:
                with futures.ThreadPoolExecutor(max_workers=4) as pool:
                    jobs = {pool.submit(read_switch, r.get("check")): (r, w, c)
                            for r, w, c in pending}
                    for job in futures.as_completed(jobs):
                        r, w, c = jobs[job]
                        try:
                            state, why = job.result()
                        except Exception:
                            state, why = None, "unreadable"
                        sent.add(id(w))
                        GLib.idle_add(settle, r, w, c, state, why)
            finally:
                # Whatever went wrong, no switch is left loading. A row that
                # already settled is not settled twice.
                for r, w, c in pending:
                    if id(w) not in sent:
                        GLib.idle_add(settle, r, w, c, None, "unreadable")

        def read_start_failed(_exc):
            for row, widget, cell in pending:
                GLib.idle_add(
                    settle, row, widget, cell, None, "unreadable")

        start_daemon(
            threading.Thread(target=read_all, daemon=True),
            read_start_failed)

    def apply(_button):
        commands = []
        for row, widget, cell, seen in switches:
            now = widget.get_active()
            # Read the CURRENT value out of the mutable cell, never a value
            # captured at build time: the live state now arrives on a worker
            # after this window is already on screen, so a captured `initial`
            # would be None forever and every row would look unknown.
            initial = cell["state"]
            if initial is None:
                # State unknown. Only a deliberate interaction is actionable;
                # never infer intent from the position it was drawn in.
                if not seen["touched"]:
                    continue
            elif now == initial:
                continue        # known and unchanged, so nothing runs
            key = row["on"] if now else row["off"]
            commands.append({
                "key": key,
                "command": resolve(key),
                "row": row,
                "switch": (widget, cell, seen),
                "requested_active": now,
                "owner_generation": seen["generation"],
            })
        # An untouched choice runs NOTHING. See the group comment above: a radio
        # group always has an active member, so "is active" cannot mean "the user
        # picked this" until the user has actually interacted.
        if chose["touched"]:
            for picks_group in choice_groups:
                for radio, key in picks_group.items():
                    if radio.get_active():
                        commands.append({
                            "key": key,
                            "command": resolve(key),
                            "row": getattr(radio, "spec_row", {}),
                            "choice": True,
                            "choice_radio": radio,
                            "owner_generation": chose["generation"],
                        })
        commands = [item for item in commands if item["command"]]
        if not commands:
            return

        # APPLY ASKS FOR THE THREE SESSION-ENDING ACTIONS ONLY. It does NOT obey
        # the registry's confirm column, and the dock cell and rofi still do, so
        # this window and those two deliberately DISAGREE. See the block above
        # SESSION_ENDING_CONFIRM_KEYS for the operator's 2026-08-22 ruling and
        # what it costs.
        #
        # G96-b, <agent>, 2026-08-23. This comment used to say Apply
        # "OBEYS THE REGISTRY'S confirm COLUMN, exactly as the dock cell and rofi
        # do", which `row_needs_confirm()` eleven lines below has contradicted
        # since the ruling landed: it consults the three-key allowlist and
        # `del row`s the row. The comment described the state this file was in
        # BEFORE the change in the same commit that made it false, which is the
        # direction that misleads, because it reads as the safer behaviour.
        #
        # The history the comment was recording is still true and still worth
        # keeping: switch and radio rows had NO confirmation path at all, so
        # "Paranoid", every kill-switch level, every torrify mode, WiFi off and
        # SSH off ran on one click of Apply while the same actions asked first
        # from a dock cell. That gap is closed; what closed it is the allowlist,
        # not the column.
        #
        # ONE dialog for the whole Apply rather than one per command, and it
        # NAMES every command it is about to run: this window can queue several
        # in a single press, so asking N times trains the user to click through,
        # and asking once without the list is not informed consent.
        risky = [direct_preview(item["key"]) for item in commands
                 if row_needs_confirm(item["row"], item["key"])]
        if risky:
            body = ("This will run %d command%s that Kodachi asks you to confirm:"
                    "\n\n%s\n\nRun %s?"
                    % (len(risky), "" if len(risky) == 1 else "s",
                       "\n".join("  " + c for c in risky),
                       "it" if len(risky) == 1 else "them"))
            if not confirm_dialog(win, spec.get("apply_label", "Apply"), body):
                return

        prepared = []
        for source_item in commands:
            item = PreparedCommand(source_item)
            parameters, stdin_values, input_issue = collect_direct_input(
                win, item["key"])
            if input_issue:
                kd.wipe_secret(stdin_values)
                for earlier in prepared:
                    kd.wipe_secret(earlier.get("stdin_values"))
                    earlier["stdin_values"] = None
                target.result().show(
                    spec.get("title", name), direct_preview(item["key"]),
                    ("Nothing was run." if input_issue == "cancelled"
                     else input_issue),
                    "cancelled" if input_issue == "cancelled" else "input needed",
                    "off" if input_issue == "cancelled" else "warn")
                return
            item["parameters"] = parameters
            item["stdin_values"] = stdin_values
            prepared.append(item)
        commands = prepared

        def execute(item):
            try:
                code, output = shell(
                    bind_command(item["command"], item["key"]),
                    key=item["key"], parameters=item["parameters"],
                    stdin_values=item["stdin_values"])
                if code == 0 and looks_not_applied(output):
                    return 1, output
                return code, output
            finally:
                kd.wipe_secret(item.get("stdin_values"))
                item["stdin_values"] = None

        def done(completed, failed, success_body=None):
            for item in commands:
                kd.wipe_secret(item.get("stdin_values"))
                item["stdin_values"] = None
            completed_choice_preview = next(
                (preview for preview, item in completed
                 if item.get("choice")),
                None)
            verify = {"remaining": 0, "issues": []}

            def finish_verify():
                if verify["remaining"] or failed is not None:
                    return
                if verify["issues"]:
                    target.result().show(
                        spec.get("title", name),
                        "\n".join(item[0] for item in sequence),
                        "The command returned success, but the resulting state "
                        "was not confirmed:\n\n" + "\n".join(verify["issues"]),
                        "not confirmed", "warn")
                elif success_body is not None:
                    visible_body = success_body
                    if name == "torrify":
                        generic = "Applied %d of %d change(s)." % (
                            len(completed), len(commands))
                        if visible_body == generic:
                            visible_body = completed_choice_preview or generic
                        elif visible_body.startswith(generic + "\n\n"):
                            visible_body = visible_body[len(generic) + 2:]
                    target.result().show(
                        spec.get("title", name),
                        "\n".join(item[0] for item in sequence),
                        visible_body, "OK", "on")
                    # A checked switch is not successful until its status
                    # producer reports the requested value. Only now may the
                    # shared status cache advertise the change.
                    refresh_status_cache()

            def land_readback(row, widget, cell, requested, state, why):
                settle(row, widget, cell, state, why)
                widget.set_sensitive(True)
                issue = requested_state_issue(row["name"], requested, state)
                if issue:
                    verify["issues"].append(issue)
                verify["remaining"] -= 1
                finish_verify()
                return False

            def read_back(row, widget, cell, requested):
                try:
                    state, why = read_switch(row.get("check"))
                except Exception:
                    state, why = None, "unreadable"
                GLib.idle_add(land_readback, row, widget, cell,
                              requested, state, why)

            readbacks = []
            for _preview, item in completed:
                if "switch" in item:
                    widget, cell, seen = item["switch"]
                    requested = item["requested_active"]
                    completion_still_owns_intent = (
                        seen["generation"] == item["owner_generation"]
                        and widget.get_active() == requested)
                    if completion_still_owns_intent:
                        seen["touched"] = False
                    if not item["row"].get("check"):
                        settle(item["row"], widget, cell, None, "no-status")
                        verify["issues"].append(
                            "%s: no status command exists." % item["row"]["name"])
                    else:
                        # Read the machine even when a newer click owns the
                        # widget. The completed command may have changed the
                        # baseline underneath that click. settle() preserves a
                        # touched widget while committing the observed state,
                        # so the newer intent remains pending against reality.
                        cell["state"], cell["why"] = None, "pending"
                        widget.set_sensitive(False)
                        readbacks.append((item["row"], widget, cell, requested))
            # Register the WHOLE denominator before any worker can settle. A
            # fast first readback must not take remaining to zero and publish
            # success while a later switch has not even been launched yet.
            verify["remaining"] = len(readbacks)
            for readback in readbacks:
                row, widget, cell, requested = readback
                start_daemon(
                    threading.Thread(
                        target=read_back, args=readback, daemon=True),
                    lambda _exc, values=readback: GLib.idle_add(
                        land_readback, values[0], values[1], values[2],
                        values[3], None, "unreadable"))
            if failed is None:
                completed_choice = next(
                    (item for _preview, item in completed if item.get("choice")),
                    None)
                choice_still_owned = bool(
                    completed_choice
                    and chose["generation"] == completed_choice["owner_generation"]
                    and completed_choice["choice_radio"].get_active())
                if name == "torrify" and completed_choice_preview:
                    # Bind the receipt to the immutable sequence that actually
                    # completed. A newer radio selection remains pending and
                    # actionable instead of being cleared by the older worker.
                    choice_status["applied"] = completed_choice_preview
                    if (choice_still_owned
                            and choice_status["preview"] == completed_choice_preview):
                        chose["touched"] = False
                elif choice_still_owned:
                    chose["touched"] = False
            # Repaint the summary strip too: "On now 0" beside a row that just
            # turned on is the same contradiction one line higher up.
            try:
                paint_strip()
            except Exception:
                pass
            refresh_pending()
            finish_verify()

        sequence = [(direct_preview(item["key"], item["parameters"]), item)
                    for item in commands]
        # Every successful command may show its producer output. The renderer
        # still humanises reports and withholds credential-shaped lines.
        try:
            run_sequence_async(_button, target, spec.get("title", name),
                               sequence, execute, on_done=done,
                               show_output=lambda _payload: True,
                               show_failure=lambda _payload: True,
                               render_output=lambda payload, output: display_output(
                                   payload.get("row", {}), output, success=True),
                               render_failure=lambda payload, output: display_output(
                                   payload.get("row", {}), output, success=False),
                               verify_success=lambda completed, body: done(
                                   completed, None, body))
        except BaseException as exc:
            for item in commands:
                kd.wipe_secret(item.get("stdin_values"))
                item["stdin_values"] = None
            _button.set_sensitive(True)
            _button.set_label(current_apply_label())
            target.result().show(
                spec.get("title", name), "\n".join(item[0] for item in sequence),
                # `_exc_detail` here too. This one is milder than the
                # worker-start sites, because `_button.set_sensitive(True)`
                # four lines above has already run, so the operator is not
                # left with a dead button. What a raising `__str__` costs
                # here is the explanation plus an exception escaping a GTK
                # callback, which lands in the console and nowhere the
                # operator can see. A `start_daemon`-call-site census cannot
                # see this site at all: it is an ordinary `except` around a
                # sequence runner, not a thread start.
                "Nothing was run because the direct worker could not "
                "start: " + _exc_detail(exc), "failed", "err")

    if switches or choice_groups:
        target.footer("No changes pending",
                      spec.get("apply_label", "Apply"), apply,
                      primary_enabled=False)
        for _row, widget, _cell, _seen in switches:
            widget.connect("notify::active", refresh_pending)
        for picks_group in choice_groups:
            for radio in picks_group:
                radio.connect("toggled", refresh_pending)
        refresh_pending()
    else:
        target.footer(None, "Close", lambda *_: Gtk.main_quit())
    return win


def _human_json_label(key):
    text = re.sub(r"[_-]+", " ", str(key)).strip()
    return text[:1].upper() + text[1:]


def _human_json_scalar(value):
    if value is None:
        return "Not available"
    if isinstance(value, bool):
        return "Yes" if value else "No"
    return str(value)


def _human_json_lines(value, level=0):
    """Render parsed JSON without exposing JSON punctuation to the GTK user."""
    indent = "  " * level
    lines = []
    if isinstance(value, dict):
        if not value:
            return [indent + "No details"]
        for key, child in value.items():
            label = _human_json_label(key)
            if isinstance(child, (dict, list)):
                lines.append(f"{indent}{label}")
                lines.extend(_human_json_lines(child, level + 1))
                continue
            rendered = _human_json_scalar(child).splitlines() or [""]
            lines.append(f"{indent}{label}: {rendered[0]}")
            lines.extend(f"{indent}  {line}" for line in rendered[1:])
        return lines
    if isinstance(value, list):
        # Blank strings are padding, never information: conky-status keeps
        # data.dns.nameservers at exactly three slots for the panel, so the
        # Status window's "DNS Servers In Use" row printed "• 127.0.0.1" and
        # then two empty bullets (measured 2026-09-05 on <lab-host>).
        value = [child for child in value
                 if not (isinstance(child, str) and not child.strip())]
        if not value:
            return [indent + "None"]
        for child in value:
            if isinstance(child, (dict, list)):
                lines.append(indent + "•")
                lines.extend(_human_json_lines(child, level + 1))
            else:
                rendered = _human_json_scalar(child).splitlines() or [""]
                lines.append(f"{indent}• {rendered[0]}")
                lines.extend(f"{indent}  {line}" for line in rendered[1:])
        return lines
    return [indent + _human_json_scalar(value)]


def _parsed_json_container(text):
    try:
        value = json.loads(text)
    except (TypeError, ValueError):
        return None
    return value if isinstance(value, (dict, list)) else None


def render_report_stream(text):
    """Turn structured report output into something a person can read.

    Cells that end in `| kodachi-json-report` emit a TAGGED stream meant for
    kodachi-status-window to lay out:

        #TITLE   Security Score
        #SECTION Summary
        #ROW     Max score    93.0    neutral

    The old path piped that to the status window, which rendered it. My inline
    panel printed it verbatim, so the user saw a wall of "#ROW" markup. The
    operator's words were "[expletive] ugly output", and he was right: showing a
    presentation protocol to a human is not showing them their answer.

    Same transformation kodachi-dock-action:strip_report_tags() already applies
    for the notification path, so the two surfaces agree rather than each
    inventing a format. Valid JSON is a second presentation protocol used by
    real Verify producers. Whole documents and standalone JSON lines are
    rendered as labelled, indented text. Arbitrary untagged text still passes
    through unchanged.
    """
    if not text:
        return text
    parsed = _parsed_json_container(text.strip())
    if parsed is not None:
        return "\n".join(_human_json_lines(parsed))

    tagged = ("#ROW\t" in text or "#SECTION\t" in text
              or "#TITLE\t" in text)
    if tagged:
        out = []
        for line in text.splitlines():
            parts = line.split("\t")
            tag = parts[0]
            if tag == "#TITLE":
                continue
            if tag == "#AGE":
                out.append(parts[1] if len(parts) > 1 else "")
            elif tag == "#SECTION":
                out.append("")
                out.append((parts[1] if len(parts) > 1 else "").upper())
            elif tag == "#ROW":
                label = parts[1] if len(parts) > 1 else ""
                value = parts[2] if len(parts) > 2 else ""
                out.append(f"  {value}" if not label else f"  {label:<28} {value}")
            else:
                out.append(line)
        return "\n".join(out).strip("\n")

    # Some producers mix ordinary diagnostics with one compact JSON result per
    # line. Humanise only independently valid containers; malformed JSON-like
    # error text remains intact instead of being silently discarded.
    out = []
    changed = False
    for line in text.splitlines():
        stripped = line.strip()
        label, separator, candidate = stripped.partition(":")
        labelled = (_parsed_json_container(candidate.strip())
                    if separator and label.strip()
                    and candidate.lstrip().startswith(("{", "[")) else None)
        if labelled is not None:
            prefix = line[:len(line) - len(line.lstrip())]
            out.append(prefix + _human_json_label(label))
            out.extend(prefix + "  " + rendered
                       for rendered in _human_json_lines(labelled))
            changed = True
            continue
        parsed = (_parsed_json_container(stripped)
                  if stripped.startswith(("{", "[")) else None)
        if parsed is None:
            out.append(line)
            continue
        prefix = line[:len(line) - len(line.lstrip())]
        out.extend(prefix + rendered for rendered in _human_json_lines(parsed))
        changed = True
    return "\n".join(out) if changed else text


AUTH_REFUSED_MARKERS = (
    "authentication failed",
    "trusted authentication path is not root-owned",
    "access denied",
)

CANCELLED_MARKERS = (
    "cancelled, no key entered",
    "cancelled, nothing was changed",
    "cancelled, no device chosen",
)

# THE THIRD MEMBER OF THE EXIT-ZERO-IS-NOT-SUCCESS FAMILY, after the cancelled
# exits above and the skipped-workflow count below.
#
# A binary that could not honour the request, fell back to something else and
# still exited 0. `dns-switch switch random` is the measured case: when the
# random provider cannot be reached it applies the fallback servers, says so in
# `message`, and sets the envelope's `status` to "warning". None of that reaches
# this window, because `execute_random` returns Ok whatever the payload says and
# registry rows run in TEXT mode, so the JSON envelope is never printed and a
# predicate reading `status` would be dead code. The exit code is 0 and the pill
# was green, so a user who asked for random DNS, did not get it, and got fallback
# instead saw a green cell and had to read the output to find out.
#
# MATCHED ON THE SENTENCE, NOT ON THE WORD "warning". "warning" is the
# envelope's vocabulary and text mode never prints it; the sentence is what the
# user actually sees. Both markers are past-tense statements about the REQUEST,
# so a command that merely mentions applying something in passing does not match.
#
# A SWEEP OF EVERY .rs UNDER dashboard/hooks/rust FOUND EXACTLY ONE OTHER
# PRODUCER OF EITHER SENTENCE: health-control/src/cli_commands/usb_security.rs
# :853 prints "USB policy for device {} was NOT applied (USBGuard rejected it)".
# The comparison is lower-cased, which is why that line's capitalised NOT
# matches.
#
# I FIRST WROTE THAT IT WAS A SECOND MEMBER OF THE CLASS. IT IS NOT, AND THE
# ERROR WAS NOT IN THE SWEEP. <agent> re-derived the sweep over the same
# 1160 .rs files and reproduced my file list EXACTLY, then read the one thing I
# had not: that println sits in the `_` arm of the match on `outcome_status`,
# i.e. the FAILED arm, and outcome.rs:87 maps `Partial | Failed` to exit 1. So
# it is a HARD FAILURE that already paints red correctly, a DIFFERENT class, and
# never an exit-0 lie. The sweep agreed with my hypothesis and I stopped there
# instead of reading the exit code, which is the "distrust agreement" failure in
# the project rule file. The correction is in `classify_exit`, which now carries the class
# definition in the predicate: `code == 0 and looks_not_applied(text)`.
NOT_APPLIED_MARKERS = (
    "was not applied",
    "could not be applied",
)

# kodachi-repo-apt's `enable` when the channel is already configured. It exits
# REPO_UNCHANGED_EXIT rather than 0 so the Repository Manager stops printing a
# green "done: add the Stable repository" over an operation that added nothing.
#
# ITS OWN TUPLE, NOT A ROW IN NOT_APPLIED_MARKERS, and the difference is the
# whole gate. Adding it there and widening the code test to
# `code in (0, REPO_UNCHANGED_EXIT)` made ANY command exiting 3 while printing
# "was not applied" read as neutral, which is exactly the reopening that the
# comment eight lines below preserves against for code 0. My own contract
# tested exit 3 with "Segmentation fault" and never exit 3 with "was not
# applied", so the widening had no detector. Latent when found (0 files under
# dashboard/hooks/rust print "already configured by"), armed for the next one.
# Found by the inspector, 2026-08-30.
REPO_UNCHANGED_MARKERS = (
    "is already configured by",
)


def looks_repo_unchanged(text):
    """Did kodachi-repo-apt say the channel was ALREADY configured?"""
    low = (text or "").lower()
    return any(marker in low for marker in REPO_UNCHANGED_MARKERS)

# kodachi-repo-apt's EXIT_UNCHANGED: "the requested state already holds", which
# is neither a success nor a failure.
#
# WHY IT IS DUPLICATED HERE RATHER THAN IMPORTED: this window has no import
# path to the helper, exactly as kodachi-repo-manager does not, so the number
# lives in three files and a contract pins them together. And why the branch
# below is gated on the TEXT as well as the code: `classify_exit` grades every
# dock cell, not only the repository ones, and 3 from some other binary means
# whatever that binary decided it means. A bare `code == 3` would repaint
# unrelated failures as neutral, which is the same over-broad reading that
# made a plain nonzero look like a crash. Found by the inspector, 2026-08-30:
# fixing the false green in one consumer had installed a false RED in this one.
REPO_UNCHANGED_EXIT = 3


def looks_auth_refused(text):
    """Was this command REFUSED before it ran, rather than run and failed?

    Measured on <lab-host>: 47 binaries under /opt/kodachi/dashboard/hooks
    are not root-owned, so every auth-gated verb answers
        "Authentication failed: Trusted authentication path is not root-owned"
    and the switch that asked reads UNKNOWN. The operator saw six of six Devices
    switches say `unknown` and reasonably asked why. "Unknown" and "refused" are
    different facts and only the second one tells the user what to do about it.
    """
    low = (text or "").lower()
    return any(m in low for m in AUTH_REFUSED_MARKERS)


def looks_cancelled(text):
    """Recognise the registry's explicit no-change exits as neutral outcomes."""
    low = (text or "").lower()
    return any(marker in low for marker in CANCELLED_MARKERS)


def looks_not_applied(text):
    """Did the command exit 0 having NOT done the thing that was asked?"""
    low = (text or "").lower()
    return any(marker in low for marker in NOT_APPLIED_MARKERS)


def _workflow_skipped_count(text):
    """How many workflow steps did NOT run, read from the runner's own summary.

    workflow-manager prints a fixed block at the end of a text-mode run:

        Workflow completed: PartialSuccess
           Executed: 1
           Skipped: 4
           Failed: 0

    The count is taken from `Skipped:` rather than inferred from the status
    word, because the status word is exactly what is misleading: PartialSuccess
    is printed with a tick. Returns 0 for anything that is not a workflow run,
    so ordinary commands are unaffected.
    """
    if not text or "Skipped:" not in text:
        return 0
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("Skipped:"):
            try:
                return int(stripped.split(":", 1)[1].strip())
            except (ValueError, IndexError):
                return 0
    return 0


def classify_exit(code, text, action=False):
    """Return (pill label, tone) for a finished command.

    Nonzero output can be a valid report finding, but it can never be a valid
    action result. ``action=True`` therefore maps any non-auth failure to the
    terminal failed state even when the command printed useful diagnostics.

    A NON-ZERO EXIT IS NOT AUTOMATICALLY A FAILURE HERE. Measured on
    <lab-host>: `deps-checker check-all` exits 1 after 15.9s because it
    FOUND missing dependencies, and `permission-guard scan` exits 1 because it
    FOUND three files needing attention. In both cases the exit code IS the
    answer and the payload is complete. Painting those the same colour as a
    crash trains the user to ignore the colour.

    THE PREDICATE IS THE PRESENCE OF A PAYLOAD KEY, NOT THE NON-EMPTINESS OF A
    STRING. <agent> shipped a length check on an `output` field this
    afternoon and it inverted their diagnosis, because the HEALTHY envelope has
    no `output` key at all while the FAILED one has `"output": ""`. A length
    check reads 0 for both and cannot tell absence from emptiness. So: parse the
    envelope, look for a payload key, and fall back to "did it say anything at
    all" only when the output is not JSON.
    """
    # NO RAW EXIT CODES. Operator: "what does exist 0 mean user will not
    # understand it". The number is developer detail; the user needs the verdict.
    # The exact code still reaches them, in the tooltip, so nothing is hidden.
    # A WORKFLOW THAT SKIPPED ITS DESTRUCTIVE STEPS EXITS 0 AND SAYS
    # "COMPLETED". THAT IS NOT A SUCCESS AND MUST NOT BE PAINTED GREEN.
    #
    # workflow-manager prompts [y/N] in TEXT mode for any step carrying
    # `confirm: true`. This window has no tty and passes stdin=DEVNULL, so that
    # read returns EOF, runner.rs:779 treats the empty answer as "no", and the
    # step returns `exit_code: Some(0), skipped: true`. runner.rs:697 then sees
    # `steps_failed == 0 && steps_skipped > 0`, calls it PartialSuccess, and
    # runner.rs:705 prints "Workflow completed".
    #
    # `--yes` (now on all 94 `run` rows) rescues the ORDINARY confirm steps, and
    # deliberately cannot rescue the dangerous ones: runner.rs:766 gates it on
    # `!step_has_strong_risk(step)`, which is true whenever
    # colonyops_safety.destructive is set or danger_level is high, extreme or
    # critical. Those steps will ALWAYS be skipped from a GUI, by design.
    #
    # So the honest outcome is not to force them through, it is to STOP CALLING
    # IT SUCCESS. Measured before this: "Wipe traces" ran 1 of 5 steps, wiped
    # nothing, and showed a green pill under a dialog the user had just accepted
    # saying the data would be destroyed. Same class as the Firejail launcher
    # that promised a sandbox it did not provide.
    if looks_cancelled(text):
        return "cancelled", "off"
    skipped = _workflow_skipped_count(text)
    if skipped:
        return f"{skipped} step(s) skipped", "warn"
    # BEFORE the exit-code test, for the same reason the two above are: the
    # whole family is defined by exiting 0 while saying it did not do the job,
    # so a predicate placed after `code == 0` could never run.
    #
    # AND THE `code == 0` IS PART OF THE PREDICATE, NOT A REDUNDANT GUARD.
    # G47, <agent> 2026-08-23. The class is "exited 0 while saying it
    # did not do the job", and that definition was written in the comment above
    # instead of in the test, so the test admitted a member the class excludes.
    # health-control's `usb-policy` prints "was NOT applied (USBGuard rejected
    # it)" from the FAILED arm of its match and exits 1 (outcome.rs:87 maps
    # Partial|Failed to 1). Reaching this line before `if action: return
    # "failed", "err"` below, that hard failure painted the ORANGE
    # "not applied" pill instead of the RED "failed" one, which is G44's own
    # defect running the other way: G44 stopped a refusal being painted as a
    # success, and without this clause it started painting a failure as a
    # refusal. Latent rather than live today (0 of 82 dock-actions.tsv rows
    # invoke health-control), and armed for the next row that does.
    if code == REPO_UNCHANGED_EXIT and looks_repo_unchanged(text):
        return "not applied", "warn"
    if code == 0 and looks_not_applied(text):
        return "not applied", "warn"
    if code == 0:
        return "OK", "on"
    if looks_auth_refused(text):
        return "sign-in needed", "warn"
    if action:
        return "failed", "err"
    payload = False
    stripped = (text or "").lstrip()
    if stripped.startswith("{"):
        try:
            envelope = json.loads(stripped)
            payload = any(
                k in envelope for k in ("data", "report", "clusters", "binaries"))
        except (ValueError, TypeError):
            payload = False
    else:
        payload = bool((text or "").strip())
    if payload:
        return "findings", "warn"
    return "failed", "err"


def show_output(parent, title, command, code, text):
    """Put long command output in a transient Design 1 surface.

    Every Show and Run row used to throw stdout, stderr AND the exit code away,
    so a report button was indistinguishable from a no-op and a failed action
    looked exactly like a successful one. A dock cell whose answer is longer
    than a line gets a WINDOW with a Close button, not a notification and not
    silence.

    `quit_on_destroy=False` keeps closing this transient from taking the control
    window behind it down. The same shared shell now styles secondary output
    instead of leaving it as the one visually unrelated GTK window.
    """
    win = ui.Window(title, command, width=880, height=620,
                    quit_on_destroy=False)
    win.set_transient_for(parent)
    win.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    label, tone = classify_exit(code, text)
    win.state_strip([("Result", label, tone)])
    win.section("Command output",
                icon_path=os.path.join(ICONS, "papirus/utilities-terminal.svg"))

    body = (text or "").rstrip() or "(the command produced no output)"
    view = Gtk.TextView()
    view.set_editable(False)
    view.set_cursor_visible(False)
    view.set_monospace(True)
    view.set_left_margin(18)
    view.set_right_margin(18)
    view.set_top_margin(12)
    view.get_buffer().set_text(body)
    ui.cls(view, "mono")

    # AUTOMATIC on BOTH axes. A horizontal policy of NEVER makes the window as
    # wide as the longest line in the output, and command output is exactly the
    # content whose longest line nobody can predict: one 4826px line would push
    # the Close button off a 3440px screen.
    scroll = ui.scroller(Gtk.PolicyType.AUTOMATIC,
                         Gtk.PolicyType.AUTOMATIC)
    scroll.set_size_request(-1, 420)
    scroll.add(view)
    card = win.card()

    # ── OUTPUT CONTROLS ────────────────────────────────────────────────────
    # This window is the surface that holds the BIGGEST answers in the dock: it
    # is opened for everything past INLINE_MAX_LINES, and `kodachi-soc snapshot`
    # is 24,935 lines of it. It shipped with a Close button and nothing else, so
    # the two things a reader always wants to do with that much text, take it
    # somewhere else and make it fit, were both impossible. Its two sibling
    # surfaces already have exactly these controls (ResultPanel, and the apt
    # console in the Repository Manager); this one was missed because it is
    # built by a bare function rather than by a class anyone had re-read.
    #
    # Wrap is not decoration here. The comment above chooses horizontal
    # scrolling deliberately, to stop one 4826px line making the window wider
    # than the screen, and that choice is what leaves the reader dragging
    # sideways through a single line. Wrap is the other half of it.
    #
    # Follow and Clear are NOT offered: the text is written once when the
    # window opens and the window is thrown away when it closes, so neither
    # control would ever have anything to do.
    controls = ui.hbox(8)

    copy_button = ui.cls(Gtk.Button(label="Copy"), "ghost")
    copy_button.set_valign(Gtk.Align.CENTER)
    copy_tip = ("Copy everything in this window to the clipboard. Nothing is "
                "run and nothing is changed.")
    copy_button.set_tooltip_text(copy_tip)
    ui.set_control_accessibility(copy_button, "Copy output", copy_tip)
    copy_button.connect("clicked", lambda b: ui.copy_with_feedback(b, body))
    controls.pack_end(copy_button, False, False, 0)

    wrap_toggle = ui.state_toggle(ui.cls(Gtk.ToggleButton(), "ghost"), "Wrap")
    wrap_toggle.set_valign(Gtk.Align.CENTER)
    wrap_tip = ("Wrap long lines to the window width instead of scrolling "
                "sideways. Display only: the output itself is unchanged.")
    wrap_toggle.set_tooltip_text(wrap_tip)
    ui.set_control_accessibility(wrap_toggle, "Wrap long lines", wrap_tip)

    def apply_wrap(*_args):
        wrap = wrap_toggle.get_active()
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR if wrap
                           else Gtk.WrapMode.NONE)
        # The horizontal policy has to move with it, for the same reason
        # ResultPanel._apply_wrap moves it: left on AUTOMATIC while wrapping,
        # the view reports a natural width nothing can satisfy and the bar
        # appears and disappears as the text reflows.
        scroll.set_policy(
            Gtk.PolicyType.NEVER if wrap else Gtk.PolicyType.AUTOMATIC,
            Gtk.PolicyType.AUTOMATIC)

    wrap_toggle.connect("toggled", apply_wrap)
    controls.pack_end(wrap_toggle, False, False, 0)
    card.pack_start(controls, False, False, 0)

    card.pack_start(scroll, True, True, 0)
    close = win.footer(None, "Close", lambda *_: win.destroy())
    close.set_tooltip_text(
        "Close this output window. The control window behind it stays open and "
        "nothing is undone.")

    win.show_all()
    return win


# An answer longer than this many lines keeps the separate scrollable window as
# well as filling the inline panel. `kodachi-soc snapshot` emits 24,935 lines on
# a real host, and a 220px panel is the wrong container for that even though it
# scrolls. Everything shorter stays entirely inline, which is the common case.
INLINE_MAX_LINES = int(os.environ.get("KODACHI_INLINE_MAX_LINES", "400"))


def make_runner(win, row, target=None, pill_slot=None, row_box=None):
    """Run a row's command and put the answer in the SAME surface.

    `target` is the Window or Page that owns the inline result panel. It defaults
    to `win` so a standalone window behaves as before; a tabbed window passes the
    Page, so the DNS tab keeps its own last answer and switching tabs does not
    show you another tab's output.
    """
    surface = target if target is not None else win

    def run_it(button):
        command = resolve(row["act"])
        if not command:
            return
        preview = direct_preview(row["act"])
        if row_needs_confirm(row, row["act"]) and not confirm_dialog(
                win, row["name"],
                (row.get("note") or "This runs straight away.")
                + "\n\nruns:  " + preview):
            return
        parameters, stdin_values, input_issue = collect_direct_input(
            win, row["act"])
        if input_issue:
            surface.result().show(
                row["name"], preview,
                ("Nothing was run." if input_issue == "cancelled"
                 else input_issue),
                "cancelled" if input_issue == "cancelled" else "input needed",
                "off" if input_issue == "cancelled" else "warn",
            )
            return
        preview = direct_preview(row["act"], parameters)

        # THE COMMAND RUNS ON A WORKER THREAD, NOT THE UI THREAD.
        #
        # shell() used to be called straight from the click handler, which is the
        # GTK main loop. `workflow-manager state` takes 20.2s and
        # `deps-checker check-all` 15.9s, measured on <lab-host>, and for
        # every one of those seconds the whole window was frozen: no scrolling,
        # no other button, no close. The operator hit it immediately, in his
        # words "the window freezed i cant click anything after clicking on the
        # show full report". It also made a progress indicator impossible,
        # because a frozen main loop cannot animate anything.
        #
        # So: disable the button, say "working", run off-thread, and come back to
        # the UI through GLib.idle_add, which is the only thread-safe way to
        # touch GTK from a worker.
        # A BARE "working" IS INDISTINGUISHABLE FROM A HUNG BUTTON.
        #
        # `integrity-check check-signatures --json` takes 149 SECONDS on
        # <lab-host> (measured, 30 binaries). For 149 seconds the only
        # feedback was the word "working", which is exactly what a dead button
        # would show, and the operator reported those rows as "some buttons
        # return nothing they dont work". A running clock is the difference
        # between "this is slow" and "this is broken", and it costs one timer.
        def begin_working():
            original = button.get_label()
            button.set_sensitive(False)
            button.set_label("working")
            if pill_slot is not None:
                for child in pill_slot.get_children():
                    pill_slot.remove(child)
                pill_slot.pack_start(
                    ui.pill("running", "info"), False, False, 0)
                pill_slot.show_all()
            surface.result().show(
                row["name"], preview, "Running, please wait...",
                "running", "info")
            state = {"alive": True, "secs": 0}

            def tick():
                if not state["alive"]:
                    return False
                state["secs"] += 1
                button.set_label(f"{state['secs']}s")
                if state["secs"] == 20:
                    surface.result().show(
                        row["name"], preview,
                        "Still running. Some integrity checks take over two "
                        "minutes on this machine; the window stays usable "
                        "while it works.", "running", "info")
                return True

            GLib.timeout_add_seconds(1, tick)
            return original, state

        try:
            original, state = begin_working()
        except BaseException:
            kd.wipe_secret(stdin_values)
            raise

        def worker():
            code, out = 1, "the window could not run this command"
            try:
                # PRESENTATION FIRST, and only for the three keys whose ANSWER
                # is a window. See native_presentation(): the direct contract
                # describes the business operation, which is right, and cannot
                # express that this particular answer belongs in a laid-out
                # window rather than in the inline text panel. A row carrying
                # typed parameters or a secret never takes this path, so the
                # form-driven controls are untouched.
                native = (native_presentation(row.get("act"))
                          if not parameters and stdin_values in (None, b"", "")
                          else None)
                if native is not None:
                    code, out = native()
                elif row.get("execution") == "launch":
                    bound = bind_command(command, row["act"])
                    if parameters or stdin_values not in (None, b"", ""):
                        code, out = launch(
                            bound, key=row["act"], parameters=parameters,
                            stdin_values=stdin_values)
                    else:
                        code, out = launch(bound)
                else:
                    bound = bind_command(command, row["act"])
                    if parameters or stdin_values not in (None, b"", ""):
                        code, out = shell(
                            bound, key=row["act"], parameters=parameters,
                            stdin_values=stdin_values)
                    else:
                        code, out = shell(bound)
            except BaseException as exc:        # never leave the button dead
                try:
                    detail = "%s: %s" % (type(exc).__name__, exc)
                except BaseException:
                    detail = "an exception whose details could not be rendered"
                code, out = 1, "the window could not run this: %s" % detail
            finally:
                try:
                    kd.wipe_secret(stdin_values)
                except BaseException:
                    pass
                GLib.idle_add(done, code, out)

        def done(code, out, safe_failure=False):
            state["alive"] = False              # stops the clock
            button.set_sensitive(True)
            button.set_label(original)
            finish(code, out, preview, safe_failure=safe_failure)
            return False

        def worker_start_failed(exc):
            # THE `try` BELOW COVERS THE SECRET WIPE, NOT THE MESSAGE, AND THE
            # 2026-08-26 CENSUS SCORED THIS SITE AS GUARDED BECAUSE THE FUNCTION
            # CONTAINS A `Try` AT ALL. It asked "does this callback contain a
            # try?" where the question is "is the FORMAT inside a try body?".
            # This one is worse than the four lambdas that census did fix: the
            # format is an ARGUMENT to `done(...)`, so a raising `__str__` means
            # `done` is never entered, and `done`'s own
            # `button.set_sensitive(True)` / `set_label(original)` above never
            # run. That is exactly the permanently dead button `_exc_detail`
            # exists to prevent, on the kodachi_direct worker path. Found by an
            # independent inspector re-deriving the census with the correct
            # predicate.
            try:
                kd.wipe_secret(stdin_values)
            except BaseException:
                pass
            done(1, "the direct worker could not start: " + _exc_detail(exc),
                 safe_failure=True)

        start_daemon(
            threading.Thread(target=worker, daemon=True),
            worker_start_failed)

    def finish(code, out, command, safe_failure=False):
        if row.get("execution") == "launch" and code == 0:
            label, tone = "opened", "on"
        else:
            label, tone = classify_exit(code, out, action=mutates(row))
        # G21. Only on a real success, only for a row that DOES something, and
        # never for a launcher: `execution == "launch"` means an application was
        # opened, which has changed nothing yet.
        if (tone == "on" and mutates(row)
                and row.get("execution") != "launch"):
            refresh_status_cache()
        # A successful launcher never exposes child stdout or stderr: launch()
        # redirects both to DEVNULL and returns one of its own fixed lifecycle
        # messages. Show that safe acknowledgement through the same redactor
        # used by every other successful declarative action.
        safe_out = (
            redact_secrets(out)
            if safe_failure or (row.get("execution") == "launch" and code == 0)
            else display_output(row, out, success=(tone == "on")))
        body = safe_out.rstrip()
        if tone == "on" and row.get("kind") == "report" and not body:
            # A report that returns no readable content did not satisfy the
            # button the user pressed. Exit zero alone must not paint it green.
            label, tone = "no output", "err"
            body = "The report returned no readable output."
        # Persist the outcome on the row, and mark this row as the one whose
        # answer the panel is currently showing. One shared panel plus twenty
        # rows loses that binding immediately without it.
        if pill_slot is not None:
            for child in pill_slot.get_children():
                pill_slot.remove(child)
            pill_slot.pack_start(ui.pill(label, tone), False, False, 0)
            pill_slot.show_all()
        if row_box is not None:
            for other in getattr(surface, "_result_rows", []):
                other.get_style_context().remove_class("sel")
            row_box.get_style_context().add_class("sel")
            if not hasattr(surface, "_result_rows"):
                surface._result_rows = []
            if row_box not in surface._result_rows:
                surface._result_rows.append(row_box)
        lines = body.count("\n") + 1 if body else 0
        if lines > INLINE_MAX_LINES:
            head = "\n".join(body.split("\n")[:INLINE_MAX_LINES])
            surface.result().show(
                row["name"], command,
                head + f"\n\n... {lines - INLINE_MAX_LINES} more line(s), "
                       "opened in a separate window because it is too long to read here.",
                label, tone)
            # The pop-out is a second renderer, not permission to bypass the
            # row's output policy. Passing raw `out` here reintroduced every
            # credential the inline panel had just removed whenever an error
            # exceeded INLINE_MAX_LINES.
            show_output(win, row["name"], command, code, safe_out)
        else:
            surface.result().show(row["name"], command, body, label, tone)
    return run_it


def make_sandbox_runner(win, row, target=None, pill_slot=None, row_box=None):
    """Launch one fixed application ID through the dedicated Firejail wrapper."""
    surface = target if target is not None else win

    def run_it(button):
        try:
            launcher = canonical_firejail_launcher()
        except RuntimeError as exc:
            surface.result().show(
                row["name"], FIREJAIL_LAUNCHER, str(exc),
                "failed", "err")
            return
        argv = [launcher, row["app_id"]]
        preview = shlex.join(argv)
        original = button.get_label()
        button.set_sensitive(False)
        button.set_label("opening")
        if pill_slot is not None:
            for child in pill_slot.get_children():
                pill_slot.remove(child)
            pill_slot.pack_start(
                ui.pill("opening", "info"), False, False, 0)
            pill_slot.show_all()
        surface.result().show(
            row["name"], preview, "Opening through Firejail...",
            "opening", "info")

        def done(ok, body):
            button.set_sensitive(True)
            button.set_label(original)
            if pill_slot is not None:
                for child in pill_slot.get_children():
                    pill_slot.remove(child)
                pill_slot.pack_start(
                    ui.pill("opened" if ok else "failed",
                            "on" if ok else "err"),
                    False, False, 0)
                pill_slot.show_all()
            if row_box is not None:
                for other in getattr(surface, "_result_rows", []):
                    other.get_style_context().remove_class("sel")
                row_box.get_style_context().add_class("sel")
                if not hasattr(surface, "_result_rows"):
                    surface._result_rows = []
                if row_box not in surface._result_rows:
                    surface._result_rows.append(row_box)
            surface.result().show(
                row["name"], preview, body,
                "opened" if ok else "failed", "on" if ok else "err")
            return False

        def worker():
            # Delivery from a `finally`, for the reason spelled out on
            # _spawn_detached.worker.
            ok, body = False, "the window could not open this"
            try:
                if DRY:
                    print("WOULD OPEN SANDBOXED:", preview)
                    ok, body = True, "Opened through Firejail (dry run)."
                else:
                    proc = subprocess.Popen(
                        argv, stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        start_new_session=True)
                    try:
                        code = proc.wait(timeout=LAUNCH_SURVIVAL_SECONDS)
                    except subprocess.TimeoutExpired:
                        ok, body = True, ("Opened through Firejail. The "
                                          "application is still running.")
                    else:
                        ok, body = False, ("The Firejail launcher exited with "
                                           "code %d." % code)
            except BaseException as exc:    # never leave the button dead
                try:
                    detail = "%s: %s" % (type(exc).__name__, exc)
                except BaseException:
                    detail = "an exception whose details could not be rendered"
                ok, body = False, ("Could not open the Firejail launcher: %s"
                                   % detail)
            finally:
                GLib.idle_add(done, ok, body)

        start_daemon(
            threading.Thread(target=worker, daemon=True),
            lambda exc: done(
                False,
                "Could not start the Firejail worker: "
                + _exc_detail(exc)))

    return run_it


def _run_reporting(argv, surface, title, preview, pill_slot, button,
                   original_label, after=None):
    """Run one CONTROL verb that terminates, say what it said, then re-read.

    Deliberately not _spawn_detached. That one answers "did this application
    survive its first moment", which is the right question for a window and the
    wrong one for `stop`: a control verb EXITS, and exiting is its success, so
    the survival heuristic would score every successful stop as a failure. This
    one waits for the exit code and shows the command's own words.

    `after` re-reads the page. Without it the operator stops a container and the
    row still says running, so he presses it again. A control surface that does
    not refresh itself is a control surface that lies for as long as he looks
    at it.
    """
    def done(ok, body):
        button.set_sensitive(True)
        button.set_label(original_label)
        if pill_slot is not None:
            for child in pill_slot.get_children():
                pill_slot.remove(child)
            pill_slot.pack_start(
                ui.pill("done" if ok else "failed", "on" if ok else "err"),
                False, False, 0)
            pill_slot.show_all()
        surface.result().show(title, preview, body,
                              "done" if ok else "failed",
                              "on" if ok else "err")
        if after is not None:
            # AFTER the result is shown, so a refresh that finds nothing still
            # leaves the reason on screen.
            after()
        return False

    def worker():
        # Delivery from a `finally`, same contract as every other worker here.
        ok, message = False, "the window could not run it"
        try:
            if DRY:
                print("WOULD RUN:", preview)
                ok, message = True, "Ran (dry run)."
            else:
                done_proc = subprocess.run(
                    argv, stdin=subprocess.DEVNULL, capture_output=True,
                    text=True, errors="replace", timeout=CONTROL_TIMEOUT)
                said = ((done_proc.stdout or "").strip()
                        or (done_proc.stderr or "").strip())
                ok = done_proc.returncode == 0
                message = said or ("It reported nothing and exited %d."
                                   % done_proc.returncode)
        except BaseException as exc:        # never leave the button dead
            try:
                detail = "%s: %s" % (type(exc).__name__, exc)
            except BaseException:
                detail = "an exception whose details could not be rendered"
            ok, message = False, "Could not run it: %s" % detail
        finally:
            GLib.idle_add(done, ok, message)

    button.set_sensitive(False)
    button.set_label("working")
    if pill_slot is not None:
        for child in pill_slot.get_children():
            pill_slot.remove(child)
        pill_slot.pack_start(ui.pill("working", "info"), False, False, 0)
        pill_slot.show_all()
    surface.result().show(title, preview, "Running...", "working", "info")
    # THE ONLY DAEMON START IN THIS FILE THAT WAS NOT SETTLED ON FAILURE.
    # The button is already dead by this point: `set_sensitive(False)` and
    # `set_label("working")` ran ten lines up. If `Thread.start()` raises,
    # nothing re-enables it, so the operator is left with a control that reads
    # "working" forever and cannot be pressed again, which is precisely the
    # state `start_daemon` exists to prevent. The other ten thread starts in
    # this file already route through it; this one was missed, and the arm that
    # was supposed to catch it counted a SPELLING (`threading.Thread(` appearing
    # once in the whole file) that stopped being true the day `start_daemon`
    # began ACCEPTING a prepared thread instead of constructing one. A stale
    # count fails on the day of the refactor and then gets re-typed, so it never
    # gets to fail on the day of the defect.
    #
    # THE RECOVERY ITSELF MUST NOT BE ABLE TO RAISE. An exception whose
    # `__str__` raises would escape this callback and leave the button in the
    # exact dead state the fix exists to prevent, so the message goes through
    # `_exc_detail`, which reads the class NAME (always safe) and attempts the
    # text separately.
    #
    # AN EARLIER VERSION OF THIS COMMENT SAID "the ten sibling `start_daemon`
    # recoveries in this file do not [defend], and that shared shape is
    # REPORTED rather than swept". Both halves were wrong. An independent
    # inspector took the claim at face value and repeated it, which is how a
    # wrong denominator written in a comment becomes a wrong finding. Measured
    # by AST rather than by reading, over all eleven `start_daemon` sites:
    # three named callbacks were ALREADY guarded, four callbacks ignore the
    # exception entirely and cannot be hurt by it, and FOUR lambdas formatted
    # it unguarded. Those four now call `_exc_detail` too, so the class is
    # swept rather than reported, and it is a helper call at each site rather
    # than a refactor of the surrounding code.
    def reporting_start_failed(exc):
        done(False, "Could not start it: " + _exc_detail(exc))

    start_daemon(
        threading.Thread(target=worker, daemon=True),
        reporting_start_failed)


def _spawn_detached(argv, surface, title, preview, pill_slot, row_box, button,
                    original_label, running_text, failed_text,
                    handoff_text=None):
    """Start one detached argv and report whether it survived its first moment.

    Shared by the isolated and launch runners because they answer the same
    question: a desktop application and a terminal both DETACH, so waiting for
    them is wrong, and not waiting at all cannot tell a launch from an instant
    crash. Waiting LAUNCH_SURVIVAL_SECONDS and treating the timeout as success
    is the honest middle: an exit inside that window is a real failure with a
    real exit code, and surviving it is the strongest claim available without
    following the process for its whole life.
    """
    def done(ok, body):
        button.set_sensitive(True)
        button.set_label(original_label)
        if pill_slot is not None:
            for child in pill_slot.get_children():
                pill_slot.remove(child)
            pill_slot.pack_start(
                ui.pill("opened" if ok else "failed", "on" if ok else "err"),
                False, False, 0)
            pill_slot.show_all()
        if row_box is not None:
            for other in getattr(surface, "_result_rows", []):
                other.get_style_context().remove_class("sel")
            row_box.get_style_context().add_class("sel")
            if not hasattr(surface, "_result_rows"):
                surface._result_rows = []
            if row_box not in surface._result_rows:
                surface._result_rows.append(row_box)
        surface.result().show(title, preview, body,
                              "opened" if ok else "failed",
                              "on" if ok else "err")
        return False

    def worker():
        # DELIVERY COMES FROM A `finally`, NEVER FROM THE ARMS. Each arm
        # calling GLib.idle_add itself leaves paths that reach none of them:
        # the DRY `print` sat outside the try, and `except Exception` does not
        # catch a BaseException. A GUI worker that dies undelivered wedges the
        # button it disabled for the life of the window. Same shape as
        # make_runner.run_it.worker, which is the accepted one in this file.
        ok, message = False, "the window could not start it"
        try:
            if DRY:
                print("WOULD RUN DETACHED:", preview)
                ok, message = True, running_text + " (dry run)."
            else:
                proc = subprocess.Popen(
                    argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, start_new_session=True)
                try:
                    code = proc.wait(timeout=LAUNCH_SURVIVAL_SECONDS)
                except subprocess.TimeoutExpired:
                    # It outlived the survival window, which for a detached
                    # application is exactly the success signal.
                    ok, message = True, running_text
                else:
                    if code == 0:
                        # AN EXIT OF 0 INSIDE THE SURVIVAL WINDOW IS A HANDOFF,
                        # NOT A FAILURE, AND THIS ARM CALLED IT ONE.
                        #
                        # The docstring's model is "an exit inside that window
                        # is a real failure with a real exit code". That holds
                        # for an argv that IS the application, and it is wrong
                        # for an argv that HANDS THE WORK OVER and returns. Two
                        # of the three call sites are the second kind:
                        #
                        #   kodachi-isolation-launcher podman <app>
                        #     os.execv's xfce4-terminal, which is a
                        #     single-instance D-Bus client: it asks the running
                        #     terminal server for the window and exits 0 in a
                        #     few milliseconds.
                        #   make_launch_runner's `row["terminal"]` path
                        #     spawns the same xfce4-terminal directly.
                        #
                        # Observed on the .198 test VM 2026-08-28: clicking
                        # "Launch in a container" on the XFCE Terminal row
                        # opened a window titled "Kodachi Disposable Container
                        # Shell", `podman ps` showed
                        # kodachi-disposable-275430-12508 Up 17 seconds, and
                        # this window drew a red `failed` pill over the sentence
                        # "The isolation launcher exited with code 0." A
                        # successful launch reported as a failure is worse than
                        # a silent one: it teaches the operator to distrust the
                        # arm that just worked.
                        #
                        # A non-zero code keeps its old meaning exactly, so the
                        # real failure this arm was written for still reports as
                        # one, with its code.
                        ok, message = True, handoff_text or running_text
                    else:
                        ok, message = False, failed_text % code
        except BaseException as exc:        # never leave the button dead
            try:
                detail = "%s: %s" % (type(exc).__name__, exc)
            except BaseException:
                detail = "an exception whose details could not be rendered"
            ok, message = False, "Could not start it: %s" % detail
        finally:
            GLib.idle_add(done, ok, message)

    start_daemon(
        threading.Thread(target=worker, daemon=True),
        lambda exc: done(
            False, "Could not start the worker: " + _exc_detail(exc)))


def make_isolated_runner(win, row, chosen, target=None, pill_slot=None,
                         row_box=None):
    """Launch one approved application under the runtime the user selected."""
    surface = target if target is not None else win

    def run_it(button):
        runtime = chosen["runtime"]
        # RE-CHECKED AT CLICK TIME, NOT ONLY AT BUILD TIME. The arm is already
        # insensitive, so this cannot normally fire, but the window's answer to
        # "may this application run in a container" must not live only in a
        # widget's sensitivity: a widget is presentation and this is policy.
        if runtime == "podman" and not row["podman"]:
            surface.result().show(row["name"], "", kw.NO_DISPLAY_REASON,
                                  "refused", "err")
            return
        # THE SECOND HALF OF THE SAME POLICY, AND IT WAS MISSING. The comment
        # above says the window's answer must not live only in a widget's
        # sensitivity, and then only the no-display half was re-checked here:
        # "Podman is not installed on this machine" lived ONLY in the chip,
        # decided ONCE when the window was built. This window is a dock
        # destination the operator leaves open, so the runtime can be removed,
        # or the build-time detection can be wrong, and the arm stays sensitive
        # because nothing rebuilt it. Measured 2026-08-26 on a box with no
        # Podman: the click spawned
        #   kodachi-isolation-launcher podman xfce-terminal
        # and the adapter does not check either, so it surfaced as a raw
        # podman-not-found instead of the sentence this window already owns.
        if runtime == "podman" and not container_runtime_ready():
            surface.result().show(row["name"], "", kw.PODMAN_ABSENT_REASON,
                                  "refused", "err")
            return
        try:
            adapter = canonical_isolation_launcher()
        except RuntimeError as exc:
            surface.result().show(row["name"], ISOLATION_LAUNCHER, str(exc),
                                  "failed", "err")
            return
        argv = [adapter, runtime, row["app_id"]]
        preview = shlex.join(argv)
        original = button.get_label()
        button.set_sensitive(False)
        button.set_label("opening")
        if pill_slot is not None:
            for child in pill_slot.get_children():
                pill_slot.remove(child)
            pill_slot.pack_start(ui.pill("opening", "info"), False, False, 0)
            pill_slot.show_all()
        surface.result().show(row["name"], preview,
                              "Opening under %s..."
                              % ISOLATION_RUNTIME_LABELS[runtime].lower(),
                              "opening", "info")
        _spawn_detached(
            argv, surface, row["name"], preview, pill_slot, row_box, button,
            original,
            "Opened under %s. It is still running."
            % ISOLATION_RUNTIME_LABELS[runtime].lower(),
            "The isolation launcher exited with code %d.",
            # The podman arm always lands here, so it gets its own sentence
            # rather than borrowing the survival one, which would claim more
            # than was measured: the launcher's own success is what was seen,
            # not the container's continued life.
            "Handed off under %s. The launcher exited cleanly."
            % ISOLATION_RUNTIME_LABELS[runtime].lower())

    return run_it


def make_launch_runner(win, row, target=None, pill_slot=None, row_box=None):
    """Run one fixed Kodachi command this declaration owns, as argv."""
    surface = target if target is not None else win

    def run_it(button):
        argv = list(row["argv"])
        if row["terminal"]:
            terminal = shutil.which("xfce4-terminal") or "/usr/bin/xfce4-terminal"
            argv = [terminal, "--title=" + row["terminal"], "--hold",
                    "--command=" + shlex.join(list(row["argv"]))]
        preview = shlex.join(argv)
        original = button.get_label()
        button.set_sensitive(False)
        button.set_label("running")
        if pill_slot is not None:
            for child in pill_slot.get_children():
                pill_slot.remove(child)
            pill_slot.pack_start(ui.pill("running", "info"), False, False, 0)
            pill_slot.show_all()
        surface.result().show(row["name"], preview, "Running...", "running", "info")
        if row["terminal"]:
            _spawn_detached(
                argv, surface, row["name"], preview, pill_slot, row_box, button,
                original, "Opened in a terminal window.",
                "The terminal exited with code %d.",
                # xfce4-terminal hands the window to its running server and
                # exits 0, so this path reached the failure arm too.
                "Opened in a terminal window.")
            return

        # A READ-ONLY VERB REPORTS INTO THIS WINDOW, which is the whole reason
        # these six controls left the dock: `xfce4-terminal --hold` was being
        # used as a result pane, and this window already has one.
        def finish(ok, body):
            button.set_sensitive(True)
            button.set_label(original)
            if pill_slot is not None:
                for child in pill_slot.get_children():
                    pill_slot.remove(child)
                pill_slot.pack_start(
                    ui.pill("done" if ok else "failed", "on" if ok else "err"),
                    False, False, 0)
                pill_slot.show_all()
            surface.result().show(row["name"], preview, body,
                                  "done" if ok else "failed",
                                  "on" if ok else "err")
            return False

        def worker():
            # Delivery from a `finally`, for the reason spelled out on
            # _spawn_detached.worker above.
            ok, body = False, "the window could not run this command"
            try:
                if DRY:
                    print("WOULD RUN:", preview)
                    ok, body = True, "Ran (dry run)."
                else:
                    # errors="replace" IS NOT DECORATION. Text mode decodes
                    # STRICTLY, and this reads the stdout of an arbitrary
                    # local command. DO NOT write the keyword literally in
                    # a comment here: the payload contract that audits this
                    # file scans the SOURCE TEXT for that token and walks
                    # back to the enclosing open paren, so a comment sitting
                    # outside any call walks off the top of the file, is
                    # reported as line 1, and reads as an unguarded strict
                    # decode that does not exist. Measured 2026-08-25.
                    done = subprocess.run(
                        argv, stdin=subprocess.DEVNULL, capture_output=True,
                        text=True, errors="replace", timeout=SHELL_TIMEOUT)
                    said = ((done.stdout or "").strip()
                            or (done.stderr or "").strip())
                    ok = done.returncode == 0
                    body = said or ("Finished with no output." if ok
                                    else "Exited with code %d and said "
                                         "nothing." % done.returncode)
            except subprocess.TimeoutExpired:
                ok, body = False, ("It did not finish within %d seconds."
                                   % SHELL_TIMEOUT)
            except BaseException as exc:    # never leave the button dead
                try:
                    detail = "%s: %s" % (type(exc).__name__, exc)
                except BaseException:
                    detail = "an exception whose details could not be rendered"
                ok, body = False, "Could not run it: %s" % detail
            finally:
                GLib.idle_add(finish, ok, body)

        start_daemon(
            threading.Thread(target=worker, daemon=True),
            lambda exc: finish(
                False, "Could not start the worker: " + _exc_detail(exc)))

    return run_it


def make_surface_opener(parent, row, target=None):
    """Open one existing command surface off-thread and report startup failure."""
    surface = target if target is not None else parent

    def open_it(button):
        argv = [COMMAND_WINDOW, row["surface"]]
        if row.get("tab"):
            argv.append(row["tab"])
        original = button.get_label()
        button.set_sensitive(False)
        button.set_label("opening")
        preview = shlex.join(argv)
        surface.result().show(row["name"], preview, "Opening, please wait...",
                              "opening", "info")

        def done(ok, body):
            button.set_sensitive(True)
            button.set_label(original)
            surface.result().show(
                row["name"], preview, body,
                "opened" if ok else "failed", "on" if ok else "err")
            return False

        def worker():
            try:
                proc = subprocess.Popen(
                    argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, start_new_session=True)
                try:
                    code = proc.wait(timeout=LAUNCH_SURVIVAL_SECONDS)
                except subprocess.TimeoutExpired:
                    GLib.idle_add(
                        done, True,
                        "Opened. The control window is still running.")
                    return
                GLib.idle_add(
                    done, False,
                    "Could not open the control window: the launcher exited "
                    f"with code {code}.")
            # Exception, NOT OSError. Its three siblings (:205, :1006, :2120)
            # all catch Exception, and the comment at :2124 states the intent
            # this one shares: "never leave the button dead". A non-OSError out
            # of Popen (a TypeError from a non-str element in argv) skipped
            # `done` entirely, leaving the button desensitised and labelled
            # "opening" for the life of the window, with no error and no
            # recovery but closing it. Same mechanism as G51: a handler that
            # reads on the page as "launch failure is handled" while being
            # blind to a sibling exception type. Reported by <agent>
            # 2026-08-23, who also killed both operator-reachable triggers
            # they could find, so this is uniformity rather than a live bug.
            # `_exc_detail`, NOT AN f-STRING, AND THE PAIR IS THE POINT.
            # The `start_daemon` lambda five lines below already routes through
            # the helper; this arm, which handles the SAME failure once the
            # worker is running, did not. If the f-string raises, this thread
            # dies without queueing `done`, so the button stays desensitised
            # reading "opening" for the life of the window, which is the very
            # state the lambda below was hardened against.
            except Exception as exc:
                GLib.idle_add(done, False,
                              "Could not open the control window: "
                              + _exc_detail(exc))

        start_daemon(
            threading.Thread(target=worker, daemon=True),
            lambda exc: done(
                False,
                "Could not open the control window: the worker could not "
                "start: " + _exc_detail(exc)))
    return open_it


# ── grouped windows: one dock icon, several surfaces as tabs ────────────
#
# A tab entry names an EXISTING definition rather than restating it, so the nine
# windows the Network icon replaces are still exactly the nine specs in
# kodachi_windows.WINDOWS, and a fix to one of them fixes the tab too. A `@`
# prefix means one of the two hand-written pickers above instead of a spec.
# ── the three destinations that READ the machine ──────────────────────────
#
# Applications and Containers are fixed sets and belong in a reviewable table.
# These three are READINGS, and declaring a reading is exactly how the product
# ends up claiming a dedicated Firejail profile that is not installed.
#
# ALL THREE FAIL LOUD, NEVER EMPTY. An absent runtime and a runtime with nothing
# running produce the same empty list, and only one of those means "nothing is
# running". Every one of these says which it measured.

PODMAN_BIN = "/usr/bin/podman"
FIREJAIL_BIN = "/usr/bin/firejail"
CONTAINER_TERMINAL = "/usr/bin/xfce4-terminal"
CONTAINER_ASSET_DIR = "/usr/share/kodachi/containers"
CONTAINER_ARCHIVE = os.path.join(CONTAINER_ASSET_DIR, "kodachi-workbench.oci.tar")
CONTAINER_METADATA = os.path.join(CONTAINER_ASSET_DIR, "kodachi-workbench.json")
FIREJAIL_PROFILE_DIR = "/etc/firejail"
# ── ONE ANSWER ABOUT THE CONTAINER RUNTIME, SHARED BY FIVE SURFACES ───────
#
# "why [expletive] absent and unknown !!!", the operator, 2026-08-25, on the Images
# page. He was right, and the answer was one fact reported five different ways
# in five local vocabularies, none of which said the fact:
#
#   Applications   a greyed PODMAN chip whose reason lived in a tooltip,
#                  and the reason it gave was the WRONG one (see
#                  kodachi_windows.PODMAN_ABSENT_REASON)
#   Containers     six enabled buttons that fail after the click
#   Running now    a warn pill reading `unknown`
#   Images         two warn pills reading `absent` and one reading `unknown`
#
# There is exactly ONE cause behind all of it on a workstation: Podman is not
# installed. It IS in the ISO package list
# (livebuilds/kodachi-terminal-build/config/package-lists/live.list.chroot),
# so a Kodachi live session has every one of these pages working, and this
# banner is what tells the reader which of the two machines they are on.
#
# THE BANNER IS DRAWN FROM THE DISK, NEVER DECLARED. Declaring it is how a
# window ends up announcing a missing runtime that is installed, which is the
# same defect the Profiles page was written to avoid.
def podman_binary():
    """Use the manager's override only inside its explicitly gated test world."""
    if os.environ.get("KODACHI_CONTAINER_TEST_ASSET_DIR"):
        return (os.environ.get("KODACHI_CONTAINER_TEST_PODMAN_BIN")
                or PODMAN_BIN)
    return PODMAN_BIN


CONTAINER_PREREQUISITES = (
    ("Podman", podman_binary(),
     "The rootless container runtime. Every button on the Containers tab "
     "calls it, and the PODMAN choice on the Applications tab needs it."),
    ("Offline image archive", CONTAINER_ARCHIVE,
     "The image Kodachi loads. Kodachi never pulls from a registry, so "
     "without this archive there is nothing to run."),
    ("Image metadata", CONTAINER_METADATA,
     "The digest that archive is verified against before it is loaded."),
)
CONTAINER_REMEDY = (
    "On a Kodachi live session all three are already present. On an installed "
    "workstation, Podman comes from  sudo apt install podman  and the image "
    "archive is seeded by the Kodachi container assets. Firejail is NOT "
    "affected: every application on the Applications tab still launches "
    "natively and under Firejail."
)


def container_prerequisites():
    """(ready, rows, missing_labels) read from this machine, never declared."""
    rows, missing = [], []
    for label, path, why in CONTAINER_PREREQUISITES:
        present = os.path.exists(path) and (
            os.access(path, os.X_OK) if label == "Podman" else True)
        if present:
            rows.append((label, "%s , %s" % (why, path), "on", "installed"))
        else:
            missing.append(label)
            rows.append((label, "%s  NOT on this system at %s." % (why, path),
                         "warn", "not installed"))
    return (not missing), rows, missing


def container_runtime_ready():
    """True only when Podman itself can be executed on this machine."""
    binary = podman_binary()
    return os.path.isfile(binary) and os.access(binary, os.X_OK)


def _trusted_program_stat(file_stat, *, executable=False):
    if file_stat.st_uid != 0 or file_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        return False
    return bool(not executable or (
        stat.S_ISREG(file_stat.st_mode) and file_stat.st_mode & 0o111
    ))


def _trusted_program_ancestry(path):
    current = os.path.dirname(path)
    while True:
        if not _trusted_program_stat(os.stat(current, follow_symlinks=True)):
            return False
        if current == "/":
            return True
        current = os.path.dirname(current)


def trusted_program(path):
    """Match the isolation adapters' root-owned executable predicate."""
    if not os.path.isabs(path):
        return False
    try:
        configured = os.lstat(path)
        if configured.st_uid != 0:
            return False
        if not stat.S_ISLNK(configured.st_mode) and not _trusted_program_stat(
                configured, executable=True):
            return False
        if not _trusted_program_ancestry(path):
            return False

        resolved = os.path.realpath(path)
        if not _trusted_program_stat(
                os.stat(resolved, follow_symlinks=True), executable=True):
            return False
        return _trusted_program_ancestry(resolved)
    except OSError:
        return False


def isolation_arm_missing(row, runtime, common_missing=()):
    """Return only the prerequisites the adapter uses for this runtime arm."""
    missing = list(common_missing)

    def require(label, path, *, trusted=True):
        present = (trusted_program(path) if trusted else
                   os.path.isfile(path) and os.access(path, os.X_OK))
        if not present:
            missing.append(label)

    if runtime == "native":
        require(row["executable"], row["executable"])
    elif runtime == "firejail":
        require("Firejail", FIREJAIL_BIN)
        require("Kodachi Firejail launcher", FIREJAIL_LAUNCHER)
        require(row["executable"], row["executable"])
    elif runtime == "podman" and row["podman"]:
        # The adapter and manager intentionally apply only the fixed-path
        # executable check to Podman itself. Every program the adapter execs
        # directly uses the stronger root-owned path predicate above.
        require("Podman", podman_binary(), trusted=False)
        require("Kodachi container manager", kw.CONTAINER_MANAGER)
        require("XFCE Terminal", CONTAINER_TERMINAL)
    return missing


def podman_row_sentence(row):
    """What THIS MACHINE can honestly say about Podman for one reviewed row.

    THREE PRESENTATION SITES USED TO DERIVE THIS FROM row["podman"] ALONE, and
    only the chip was corrected on 2026-08-25. So on a workstation with no
    Podman the XFCE Terminal row drew, at the same instant, on the same row:

        "Podman opens the offline disposable container shell instead."   note
        "Podman: offline disposable container shell"                     tooltip
        "PODMAN , not installed"                                         chip

    Two of the three contradicted the third, which is the same wrong-cause
    defect the 2026-08-25 fix existed to remove, surviving on its siblings.

    The split that makes it impossible to reintroduce: `row["podman"]` is a
    property of the ROW and belongs in kodachi_windows.py, whether a container
    can start at all is a property of the MACHINE and cannot be known there.
    Every site that wants a sentence about Podman asks this function, so there
    is one place to be wrong instead of three.
    """
    if not row["podman"]:
        return kw.NO_DISPLAY_REASON
    if not container_runtime_ready():
        return kw.PODMAN_ABSENT_REASON
    return "Podman opens the offline disposable container shell instead."


def container_prerequisite_section():
    """The banner as a (caption, note, rows) section, or None when all present.

    Returns None rather than a green banner on a healthy machine, because a
    page that spends its top third telling a working system that it works is
    the noise this window was built to remove.
    """
    ready, rows, missing = container_prerequisites()
    if ready:
        return None
    return ("Podman is not ready on this machine",
            "%d of %d container prerequisites are missing here: %s. That one "
            "fact is why the PODMAN choice is refused on Applications, why "
            "Running now cannot list containers, and why Images reports "
            "nothing loaded. %s"
            % (len(missing), len(CONTAINER_PREREQUISITES),
               ", ".join(missing), CONTAINER_REMEDY),
            rows)


ISOLATION_EXPERT_TOOLS = (
    ("Firejail Configuration Wizard", "/usr/bin/firejail-ui",
     "Build or edit a Firejail profile by hand. Expert tool."),
    ("Firetools", "/usr/bin/firetools",
     "The Firejail sandbox manager applet. Expert tool."),
)


def _read_lines(argv, timeout=8):
    """Return (ok, lines, why). `ok` is False when the tool could not answer.

    THE THREE OUTCOMES ARE KEPT APART on purpose: absent, answered-with-nothing
    and refused are three different facts, and collapsing them into an empty
    list is what makes a window claim nothing is running when it simply could
    not look.
    """
    program = argv[0]
    if not os.path.isfile(program) or not os.access(program, os.X_OK):
        return False, [], "%s is not installed on this system." % program
    try:
        done = subprocess.run(argv, stdin=subprocess.DEVNULL,
                              capture_output=True, text=True,
                              errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, [], "%s did not answer within %ds." % (program, timeout)
    except Exception as exc:
        return False, [], ("Could not run %s: %s"
                           % (program, _exc_detail(exc)))
    if done.returncode != 0:
        return False, [], ((done.stderr or "").strip()
                           or "%s exited with code %d."
                           % (program, done.returncode))
    return True, [line for line in (done.stdout or "").splitlines() if line.strip()], ""


def _live_page(target, title, subtitle, sections_fn, extra_top=None):
    """One live destination with a Refresh that actually re-reads.

    Only the CARD HOLDER is rebuilt on refresh, never the page. That is the
    narrow, allowed version of the rule that a surface must not re-render
    itself: there is no text entry, no selection and no scroll container inside
    these cards, so replacing their children cannot take anything out of the
    operator's hands. The header, the Refresh button and the footer are built
    once and are never touched again.

    `extra_top` is how a page that DOES need a text entry keeps that promise.
    It is called once with the repaint callback, and whatever it returns is
    packed ABOVE the holder and never touched again, so the operator can be
    halfway through typing a program name while the cards below him re-read.
    Putting the entry inside the holder instead would destroy the widget he is
    typing into on every refresh, which is the exact defect the rule exists to
    prevent.

    A row is (name, detail, tone, tag) and may carry two more elements:
    (..., argv) draws an Open button that DETACHES, for a program; and
    (..., argv, label) draws a labelled control button that WAITS for the
    command, shows what it said, and re-reads the page afterwards.
    """
    surface = target if target is not None else ui.Window(
        title, subtitle, width=760, height=820)

    head = ui.hbox(10)
    head.set_margin_top(4)
    stamp = ui.lbl("", "row-note", wrap=True)
    head.pack_start(stamp, True, True, 0)
    refresh = ui.cls(Gtk.Button(label="Refresh"), "ghost")
    refresh.set_valign(Gtk.Align.CENTER)
    refresh_tip = ("Read this destination from the machine again. Reading "
                   "changes nothing.")
    refresh.set_tooltip_text(refresh_tip)
    ui.set_control_accessibility(refresh, "Refresh", refresh_tip)
    head.pack_end(refresh, False, False, 0)
    surface.body.pack_start(head, False, False, 0)

    holder = ui.vbox(0)
    generation = {"value": 0}

    def render(sections, token):
        if token != generation["value"]:
            return False
        for child in holder.get_children():
            holder.remove(child)
            child.destroy()
        for caption, note, rows in sections:
            holder.pack_start(ui.lbl(caption.upper(), "section"), False, False, 0)
            if note:
                holder.pack_start(ui.lbl(note, "section-note", wrap=True),
                                  False, False, 0)
            card = ui.cls(ui.vbox(), "card")
            holder.pack_start(card, False, False, 0)
            for row in rows:
                name, detail, tone, tag = row[:4]
                argv = row[4] if len(row) > 4 else None
                control_label = row[5] if len(row) > 5 else None
                inner = ui.cls(ui.hbox(13), "row")
                text = ui.vbox(2)
                text.set_valign(Gtk.Align.CENTER)
                text.pack_start(ui.lbl(name, "row-name"), False, False, 0)
                if detail:
                    text.pack_start(ui.lbl(detail, "row-note", wrap=True),
                                    False, False, 0)
                inner.pack_start(text, True, True, 0)
                slot = ui.hbox(6)
                slot.set_valign(Gtk.Align.CENTER)
                if tag:
                    # The word IS the state. Tone only colours a fact the pill
                    # already spells out, so colour is never the only channel.
                    slot.pack_start(ui.pill(tag, tone), False, False, 0)
                if callable(argv) and control_label:
                    # AN IN-PROCESS CONTROL. Editing the operator's own catalog
                    # is this window's own state, so shelling out to a helper
                    # binary purely to satisfy the row shape would add a payload
                    # file, an overlay twin and a parity contract to express
                    # "remove a line from a JSON file we already have open".
                    button = ui.cls(Gtk.Button(label=control_label), "ghost")
                    button.set_valign(Gtk.Align.CENTER)
                    ui.set_control_accessibility(
                        button, "%s %s" % (control_label, name), detail or name)

                    def on_local(_b, fn=argv, n=name, lb=control_label):
                        ok, said = fn()
                        surface.result().show(
                            n, lb, said, "done" if ok else "failed",
                            "on" if ok else "err")
                        repaint()

                    button.connect("clicked", on_local)
                    slot.pack_start(button, False, False, 0)
                elif argv and control_label:
                    # A CONTROL, not a launch. It waits, reports, and re-reads.
                    preview = shlex.join(argv)
                    button = ui.cls(Gtk.Button(label=control_label), "ghost")
                    button.set_valign(Gtk.Align.CENTER)
                    button.set_tooltip_text("Runs %s" % preview)
                    ui.set_control_accessibility(
                        button, "%s %s" % (control_label, name),
                        "Runs " + preview)
                    button.connect(
                        "clicked",
                        lambda _b, a=argv, n=name, pv=preview, sl=slot,
                        lb=control_label: _run_reporting(
                            a, surface, n, pv, sl, _b, lb, repaint))
                    slot.pack_start(button, False, False, 0)
                elif argv:
                    # A destination that can only DESCRIBE the expert tools
                    # would be a downgrade from the dock cells it replaces, so
                    # the two that exist are launchable from here.
                    preview = shlex.join(argv)
                    button = ui.cls(Gtk.Button(label="Open"), "ghost")
                    button.set_valign(Gtk.Align.CENTER)
                    button.set_tooltip_text("Runs %s" % preview)
                    ui.set_control_accessibility(
                        button, "Open " + name, "Runs " + preview)
                    button.connect(
                        "clicked",
                        lambda _b, a=argv, n=name, pv=preview, sl=slot,
                        rb=inner: _spawn_detached(
                            a, surface, n, pv, sl, rb, _b, "Open",
                            "%s is open." % n,
                            "It exited immediately with code %d."))
                    slot.pack_start(button, False, False, 0)
                if slot.get_children():
                    inner.pack_end(slot, False, False, 0)
                ui.set_row_tooltip(inner, "%s\n%s" % (name, detail or tag))
                card.pack_start(inner, False, False, 0)
        stamp.set_text("Read from this machine at %s. Nothing on this page "
                       "changes anything." % time.strftime("%H:%M:%S"))
        holder.show_all()
        return False

    def repaint(_button=None):
        generation["value"] += 1
        token = generation["value"]

        def collect():
            sections = [("Could not read this page",
                         "the page reader did not complete",
                         [("Refresh failed", "the page reader did not complete",
                           "err", "unreadable")])]
            try:
                sections = sections_fn()
            except BaseException as exc:
                sections = [("Could not read this page", _exc_detail(exc),
                             [("Refresh failed", _exc_detail(exc),
                               "err", "unreadable")])]
            finally:
                GLib.idle_add(render, sections, token)

        def start_failed(exc):
            sections = [("Could not read this page", _exc_detail(exc),
                         [("Refresh failed", _exc_detail(exc),
                           "err", "unreadable")])]
            GLib.idle_add(render, sections, token)

        start_daemon(threading.Thread(target=collect, daemon=True),
                     start_failed)

    # ORDER IS LOAD-BEARING. `extra_top` is built AFTER repaint exists so it can
    # call it, and packed BEFORE the holder so it sits above the cards and
    # outside everything repaint() destroys.
    if extra_top is not None:
        surface.body.pack_start(extra_top(repaint), False, False, 0)
    surface.body.pack_start(holder, False, False, 0)

    refresh.connect("clicked", repaint)
    repaint()
    surface.footer(None, "Close", lambda *_: Gtk.main_quit())
    return surface


# ── THE CATALOG IS READ FROM THE MACHINE, NOT TYPED INTO THIS FILE ────────
#
# "we shoudl nto limit the user with few applications only .. work on this to
# make a good isolation manager that can grow based on the user needs", the
# operator, 2026-08-25. The Applications tab is eight reviewed entries and that
# is correct for what it is: eight programs somebody chose, with Kodachi
# specific Firejail arguments attached. It is wrong as the WHOLE catalog,
# because it can only grow when somebody edits kodachi_windows.py.
#
# So there are three sources now, and only the first is hand-written:
#
#   Applications        the eight reviewed entries, unchanged
#   More applications   every program on THIS machine that Firejail already
#                       ships a profile for AND that the adapter will accept.
#                       HOW MANY IS A PROPERTY OF THE MACHINE, so it is not
#                       written down here: it moves with every apt run, and the
#                       three hand-maintained copies of this one quantity had
#                       already drifted apart (this file said 206, the adapter
#                       said 208, the truth was 207).
#                       `discovered_applications()` below is the only place it
#                       is computed. Nobody maintains the list; firejail and
#                       apt do.
#                       THE COUNTING COMMAND IS IN kodachi-firejail-launcher'S
#                       HEADER AND THE TWO ARE KEPT IN STEP. It must resolve on
#                       the fixed CATALOG_SAFE_PATH and walk the ancestry, not
#                       use `command -v`: the inherited PATH answer is 2 higher
#                       here (cargo and two npm-global entries) and the naive
#                       fixed-path answer is 1 higher (obsidian, whose target
#                       under /opt/Obsidian is mode 775). Both of those are
#                       programs this window must NOT offer, so an instrument
#                       that counts them is not measuring this row.
#   My applications     whatever the operator adds, in his own file
#
# The identity rule is untouched: this window sends a NAME to
# kodachi-firejail-launcher, which resolves and validates it. The window never
# hands over a path to execute, before or after this change.

CATALOG_SAFE_PATH = ("/usr/local/sbin", "/usr/local/bin", "/usr/sbin",
                     "/usr/bin", "/sbin", "/bin")
# THE SAME HOME THE ADAPTER WILL USE, RESOLVED THE SAME WAY. The launcher
# derives the catalog path from pwd.getpwuid(os.geteuid()).pw_dir, which
# ignores $HOME; os.path.expanduser("~") honours it. With HOME overridden the
# two disagree, so this window would write a catalog the adapter never reads
# and every "My applications" row would fail with "cannot read ...". The
# adapter's choice is the correct one, because the passwd entry is not
# something the environment can move, so this file follows it rather than the
# other way round.
_HOME = pwd.getpwuid(os.geteuid()).pw_dir
DESKTOP_DIRS = ("/usr/local/share/applications", "/usr/share/applications",
                os.path.join(_HOME, ".local", "share", "applications"))
USER_APPS_PATH = os.path.join(_HOME, ".config", "kodachi",
                              "isolation-apps.json")
USER_APP_ID_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._+@-]{0,63}\Z")
# The same 64 the expression above encodes, named so `user_app_slug` can
# reserve room for its collision suffix instead of hardcoding the number
# twice. The launcher's IDENTITY_RE is the identical expression, so this
# bound belongs to the ADAPTER and this file merely has to respect it.
USER_APP_ID_MAX = 64


def _catalog_trusted(path):
    """Would the ADAPTER accept this program, not merely: does it exist?

    THE ROW MUST NOT OFFER A LAUNCH THE ADAPTER WILL REFUSE. `profile:` goes
    through validate_program in kodachi-firejail-launcher, which requires the
    file AND every directory above it to be root-owned and not group- or
    other-writable. A bare isfile + X_OK test is weaker than that, so it
    rendered a Launch button for anything installed outside a system-owned
    tree: measured 2026-08-25, `obsidian` under /opt/Obsidian (mode 775) was
    1 of 207 discovered rows in exactly that state. It fails closed, so the
    click was safe and simply did nothing, which is the worst kind of button.
    This mirrors the adapter's predicate rather than importing it, because the
    window must never load the adapter: they are separate trust domains and
    only one of them is allowed to decide what runs.
    """
    def trusted(entry, executable=False):
        if entry.st_uid != 0 or entry.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return False
        return bool(not executable or (stat.S_ISREG(entry.st_mode)
                                       and entry.st_mode & 0o111))

    def ancestry(of):
        current = os.path.dirname(of)
        while True:
            if not trusted(os.stat(current, follow_symlinks=True)):
                return False
            if current == "/":
                return True
            current = os.path.dirname(current)

    if not os.path.isabs(path):
        return False
    try:
        # THE UNRESOLVED PATH IS CHECKED FIRST, AND SO IS ITS OWN ANCESTRY.
        # This used to stat with follow_symlinks=True and walk only the
        # RESOLVED ancestry, which is weaker than the adapter in two ways an
        # operator would feel: a symlink at /usr/local/bin/foo owned by
        # somebody other than root, pointing at a perfectly good root-owned
        # binary, passed here and is refused by validate_program's lstat, so
        # the window rendered a Launch button that could not work. Whoever
        # owns that symlink chooses what the name means, which is precisely
        # what the adapter refuses to delegate. Found 2026-08-25 by an
        # independent reviewer, who also noted 0 rows on this host are in
        # that state today: the divergence was latent, not live.
        configured = os.lstat(path)
        if configured.st_uid != 0:
            return False
        if (not stat.S_ISLNK(configured.st_mode)
                and not trusted(configured, executable=True)):
            return False
        if not ancestry(path):
            return False
        resolved = os.path.realpath(path)
        if not trusted(os.stat(resolved, follow_symlinks=True),
                       executable=True):
            return False
        return ancestry(resolved)
    except OSError:
        return False


def _catalog_which(name):
    """Resolve a program name on a FIXED path, never on the inherited one."""
    for directory in CATALOG_SAFE_PATH:
        candidate = os.path.join(directory, name)
        if (os.path.isfile(candidate) and os.access(candidate, os.X_OK)
                and _catalog_trusted(candidate)):
            return candidate
    return None


def _desktop_index():
    """Program basename -> human name, for everything with a desktop entry.

    This is what separates "an application he can open" from "a command line
    tool that happens to have a profile". 7z, cksum and bunzip2 all have
    Firejail profiles and none of them is something you launch from a window.
    Both groups are still SHOWN, because hiding half the machine is the defect
    being fixed, but the ones with a desktop entry are listed first and named
    the way the desktop names them.
    """
    index = {}
    for directory in DESKTOP_DIRS:
        try:
            entries = sorted(os.listdir(directory))
        except OSError:
            continue
        for entry in entries:
            if not entry.endswith(".desktop"):
                continue
            try:
                # A CONTEXT MANAGER, because this loop runs once per .desktop
                # file on the machine and the bare .read() left every one of
                # them open until the garbage collector got to it. On a live
                # session that is ~1300 handles opened by drawing one tab.
                with io.open(os.path.join(directory, entry),
                             encoding="utf-8", errors="replace") as handle:
                    text = handle.read()
            except OSError:
                continue
            if re.search(r"^NoDisplay\s*=\s*true", text, re.M | re.I):
                continue
            command = re.search(r"^Exec\s*=\s*(\S+)", text, re.M)
            label = re.search(r"^Name\s*=\s*(.+)$", text, re.M)
            if command is None:
                continue
            index.setdefault(os.path.basename(command.group(1)),
                             label.group(1).strip() if label else None)
    return index


def declared_executables():
    """The eight reviewed entries, so the discovered list never repeats them."""
    return {os.path.basename(row["executable"])
            for section in kw.WINDOWS["sandbox"]["sections"]
            for row in section["rows"]}


def discovered_applications():
    """Every Firejail-profiled program installed here, minus the reviewed ones.

    Returns (windowed, other, profile_total). Both lists are
    (program_name, human_name, path) and are already sorted.
    """
    try:
        names = sorted(entry[:-8] for entry in os.listdir(FIREJAIL_PROFILE_DIR)
                       if entry.endswith(".profile"))
    except OSError:
        return [], [], 0
    already = declared_executables()
    desktop = _desktop_index()
    windowed, other = [], []
    for name in names:
        if name in already:
            continue
        path = _catalog_which(name)
        if path is None:
            continue
        if name in desktop:
            windowed.append((name, desktop[name] or name, path))
        else:
            other.append((name, name, path))
    return windowed, other, len(names)


def read_user_applications():
    """The operator's own catalog. Returns (entries, reason_it_is_empty)."""
    try:
        with io.open(USER_APPS_PATH, encoding="utf-8", errors="replace") as fh:
            document = json.load(fh)
    except FileNotFoundError:
        return [], ""
    except (OSError, ValueError) as exc:
        return [], "%s could not be read: %s" % (USER_APPS_PATH, exc)
    if not isinstance(document, dict) or not isinstance(
            document.get("applications"), list):
        return [], "%s does not hold an applications list" % USER_APPS_PATH
    entries = []
    for item in document["applications"]:
        if not isinstance(item, dict):
            continue
        slug, program = item.get("id"), item.get("executable")
        if not isinstance(slug, str) or not USER_APP_ID_RE.match(slug):
            continue
        if not isinstance(program, str) or not program:
            continue
        entries.append({
            "id": slug,
            "name": item["name"] if isinstance(item.get("name"), str)
                    and item["name"] else slug,
            "executable": program,
            "runtime": "firejail",
        })
    return entries, ""


@contextlib.contextmanager
def _user_applications_lock():
    """Serialize the complete catalog read-transform-write transaction."""
    path = USER_APPS_PATH + ".lock"
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            raise OSError("catalog lock is not a private regular file")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def _write_user_applications_unlocked(entries):
    """Replace the catalog atomically. Returns "" or the reason it failed.

    os.replace, not a plain write, because the launcher reads this file and a
    half-written catalog is one the launcher refuses wholesale: the operator
    would lose every entry to a crash during the save of one.
    """
    # REFUSE AT THE BOUNDARY WHAT THE CONSUMER CANNOT ACCEPT. `user_app_slug`
    # is the only producer today and it now respects the cap, but this file
    # writes the catalog and the launcher's IDENTITY_RE reads it, and an id
    # that fails there gives the operator a row whose Launch button is dead
    # with no explanation attached to the row itself. Better a save that says
    # why than a catalog entry that silently cannot be launched.
    unusable = [str(entry.get("id")) for entry in entries
                if not isinstance(entry.get("id"), str)
                or not USER_APP_ID_RE.match(entry["id"])]
    if unusable:
        return ("cannot save: %d application id(s) the launcher would refuse "
                "(they must start with a letter or digit, use only letters, "
                "digits, dot, underscore, plus, at or hyphen, and be at most "
                "%d characters): %s"
                % (len(unusable), USER_APP_ID_MAX, ", ".join(unusable)))
    directory = os.path.dirname(USER_APPS_PATH)
    document = {"schema": 1, "applications": entries}
    temporary = USER_APPS_PATH + ".partial"
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        # CREATED 0600, NOT CREATED-THEN-TIGHTENED. io.open() creates at
        # 0666 & ~umask, which is 0664 under this machine's 0002 umask, so a
        # plain open followed by chmod leaves the partial file group-writable
        # for the whole duration of the write. The launcher only ever checks
        # the FINAL inode, and os.makedirs does not tighten a directory that
        # already exists (the real ~/.config/kodachi is 0755), so neither of
        # the two later defences covers that window. An fd opened with an
        # explicit mode cannot be widened by the umask: 0o600 & ~0o002 is
        # still 0o600.
        # O_NOFOLLOW, AND DELIBERATELY NOT O_EXCL. `kodachi-repo-apt`'s
        # open_new() uses both and its contract at test_repo_manager.py pins
        # all three flags, so the sibling doctrine here is explicit: a link
        # pre-planted at the derived temporary name would otherwise make this
        # helper write through it to a target somebody else chose. That is a
        # weak threat at this particular path, because ~/.config/kodachi is
        # the operator's own directory, but the flag costs nothing and the
        # rule is to fix the class rather than argue the instance.
        #
        # O_EXCL is the one flag that would be WRONG here. This temporary is
        # a fixed name, not a unique one, so a crash between create and
        # os.replace leaves a stale `.partial` behind, and O_EXCL would then
        # refuse every future save until somebody deleted a file they have
        # never heard of. open_new() can afford O_EXCL because its callers
        # allocate a fresh random sibling first. Reuse is intentional here,
        # and O_TRUNC plus the chmod below cover the reused inode.
        descriptor = os.open(temporary,
                             os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                             | os.O_NOFOLLOW, 0o600)
        with io.open(descriptor, "w", encoding="utf-8") as fh:
            json.dump(document, fh, indent=2, sort_keys=True)
            fh.write("\n")
        # Kept for the case the file already existed with a wider mode, since
        # O_CREAT's mode argument is ignored for an existing inode.
        os.chmod(temporary, 0o600)
        os.replace(temporary, USER_APPS_PATH)
    except (OSError, ValueError) as exc:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        return "could not save %s: %s" % (USER_APPS_PATH, exc)
    return ""


def write_user_applications(entries):
    try:
        with _user_applications_lock():
            return _write_user_applications_unlocked(entries)
    except OSError as exc:
        return "could not lock %s: %s" % (USER_APPS_PATH, exc)


def mutate_user_applications(transform):
    """Apply one catalog mutation while holding the stable sibling lock."""
    try:
        with _user_applications_lock():
            entries, reason = read_user_applications()
            if reason:
                return False, reason
            changed, message = transform(entries)
            if not changed:
                return False, message
            failed = _write_user_applications_unlocked(entries)
            return (False, failed) if failed else (True, message)
    except OSError as exc:
        return False, "could not lock %s: %s" % (USER_APPS_PATH, exc)


def _forget_user_application(slug, human):
    """A zero-argument callable that drops one entry and says what happened."""
    def forget():
        def remove(entries):
            before = len(entries)
            entries[:] = [entry for entry in entries if entry["id"] != slug]
            if len(entries) == before:
                return False, "%s was already gone from your catalog." % human
            return True, ("%s is no longer in your list. The program itself "
                          "is untouched." % human)
        return mutate_user_applications(remove)
    return forget


def user_app_slug(name, program, taken):
    """A stable id from what he typed, never from what he could type.

    THE COLLISION SUFFIX HAS TO FIT INSIDE THE ID, and it used not to.
    `USER_APP_ID_RE` caps an id at 64 characters and the launcher's own
    `IDENTITY_RE` is the same expression, so a 64-character basename that
    collided with an existing entry produced a 66-character id: written into
    the catalog happily, refused by the launcher forever, and the operator got
    a row whose Launch button could never work and whose message said only
    "unsupported application ID". Measured 2026-08-25, and it is the producer
    that has to give way, because the consumer's cap is the security bound.
    """
    base = re.sub(r"[^A-Za-z0-9._+@-]", "-",
                  (os.path.basename(program) or name or "app")).strip("-")
    if not base or not USER_APP_ID_RE.match(base):
        base = "app"
    slug, suffix = base, 2
    while slug in taken:
        tail = "-%d" % suffix
        # Trim from the END so the human-recognisable head of the name
        # survives, and re-strip in case the cut left a trailing separator
        # that `USER_APP_ID_RE` would accept but a reader would not.
        head = base[:USER_APP_ID_MAX - len(tail)].rstrip("-.") or "app"
        slug = head + tail
        suffix += 1
    return slug


def _catalog_rows(items, kind):
    """One control row per discovered or custom application."""
    launcher = FIREJAIL_LAUNCHER
    try:
        launcher = canonical_firejail_launcher()
    except RuntimeError:
        pass
    rows = []
    for name, human, path in items:
        rows.append((human, path, "on", "profiled" if kind == "profile"
                     else "yours",
                     [launcher, "%s:%s" % (kind, name)], "Launch"))
    return rows


def win_isolation_catalog(target=None, tor_loader=None):
    """Every Firejail-profiled application installed on this machine."""
    del tor_loader

    def sections():
        windowed, other, total = discovered_applications()
        if not total:
            return [("Firejail profiles",
                     "%s could not be read, so nothing can be discovered here."
                     % FIREJAIL_PROFILE_DIR,
                     [("Cannot read the profile directory", FIREJAIL_PROFILE_DIR,
                       "warn", "unknown")])]
        out = []
        if windowed:
            out.append((
                "Desktop applications",
                "%d of the %d Firejail profiles on this system name a program "
                "that is installed here AND has a desktop entry. Each one "
                "launches under the profile Firejail ships for it."
                % (len(windowed), total),
                _catalog_rows(windowed, "profile")))
        else:
            out.append((
                "Desktop applications",
                "None of the %d installed Firejail profiles names a desktop "
                "application that is installed here." % total,
                [("Nothing to show", "", "off", "none")]))
        if other:
            out.append((
                "Command line tools",
                "%d more profiled programs are installed but have no desktop "
                "entry, so they open no window of their own. They are listed "
                "because hiding half of what this machine can sandbox is worse "
                "than a long list." % len(other),
                _catalog_rows(other, "profile")))
        out.append((
            "Why this list is not hand written",
            "It is read from %s every time you open this tab. Install a "
            "program that Firejail already has a profile for and it appears "
            "here by itself; the eight entries on the Applications tab are the "
            "reviewed ones and are not repeated." % FIREJAIL_PROFILE_DIR,
            [("Profiles installed", str(total), "on", "read from disk"),
             ("Launchable from here", str(len(windowed) + len(other)),
              "on", "installed"),
             ("Already on the Applications tab",
              str(len(declared_executables())), "info", "reviewed")]))
        return out

    return _live_page(target, "More applications",
                      "Everything else this machine can already sandbox.",
                      sections)


def win_isolation_custom(target=None, tor_loader=None):
    """The operator's own applications, added from inside this window."""
    del tor_loader

    def sections():
        entries, reason = read_user_applications()
        launcher = FIREJAIL_LAUNCHER
        try:
            launcher = canonical_firejail_launcher()
        except RuntimeError:
            pass
        if reason:
            body = [("Your catalog could not be read", reason, "err", "broken")]
        elif not entries:
            body = [("You have not added anything yet",
                     "Use the box above. Anything you add is written to %s and "
                     "is yours to edit by hand as well." % USER_APPS_PATH,
                     "off", "empty")]
        else:
            body = []
            for entry in entries:
                # THE ROW SAYS WHETHER IT WOULD ACTUALLY RUN, read from disk
                # now, not from what was true when he added it. A program he
                # uninstalled last week must not still offer a Launch button.
                usable, refusal = custom_program_preflight(entry["executable"])
                if not usable:
                    body.append((entry["name"],
                                 "%s is not safe for the Firejail adapter: %s"
                                 % (entry["executable"], refusal),
                                 "err", "missing"))
                    continue
                body.append((entry["name"], entry["executable"], "on",
                             "firejail" if entry["runtime"] == "firejail"
                             else "native",
                             [launcher, "custom:" + entry["id"]], "Launch"))
        out = [("Your applications",
                "%d application%s you added. Kodachi launches these through "
                "the same adapter as every other entry: this window sends the "
                "name, the adapter finds and checks the program."
                % (len(entries), "" if len(entries) == 1 else "s"), body)]
        if entries:
            out.append((
                "Remove an application",
                "Removing an entry deletes nothing and uninstalls nothing. It "
                "only takes the application out of this list.",
                [(entry["name"], entry["executable"], "off", "listed",
                  _forget_user_application(entry["id"], entry["name"]),
                  "Remove") for entry in entries]))
        out.append((
            "What is refused, and why",
            "The adapter will not run a set-user-ID or set-group-ID program, "
            "and will not run anything whose directory is writable by another "
            "user, because either one means somebody other than you could "
            "choose what actually starts. It WILL run a program you own, "
            "including one you downloaded: containing an untrusted program is "
            "the entire point of a sandbox.",
            [("Catalog file", USER_APPS_PATH, "info", "0600"),
             ("Adapter", launcher, "info", "resolves the name")]))
        return out

    def add_form(repaint):
        """Built ONCE, above the cards, so a refresh never eats what he typed."""
        holder = ui.vbox(6)
        holder.pack_start(ui.lbl("ADD AN APPLICATION", "section"),
                          False, False, 0)
        holder.pack_start(ui.lbl(
            "Give it a name and the command that starts it. A bare name is "
            "looked up on the system path; anything else must be a full path.",
            "section-note", wrap=True), False, False, 0)
        card = ui.cls(ui.vbox(8), "card")
        holder.pack_start(card, False, False, 0)

        line = ui.hbox(8)
        name_entry = Gtk.Entry()
        name_entry.set_placeholder_text("Name, for example Tor Browser")
        name_entry.set_hexpand(True)
        program_entry = Gtk.Entry()
        program_entry.set_placeholder_text("Command or full path")
        program_entry.set_hexpand(True)
        line.pack_start(name_entry, True, True, 0)
        line.pack_start(program_entry, True, True, 0)
        card.pack_start(line, False, False, 0)

        foot = ui.hbox(8)
        said = ui.lbl("", "row-note", wrap=True)
        foot.pack_start(said, True, True, 0)
        add = ui.cls(Gtk.Button(label="Add"), "ghost")
        add.set_valign(Gtk.Align.CENTER)
        ui.set_control_accessibility(
            add, "Add application",
            "Adds this application to your own isolation catalog")
        foot.pack_end(add, False, False, 0)
        card.pack_start(foot, False, False, 0)

        def on_add(_button):
            name = name_entry.get_text().strip()
            typed = program_entry.get_text().strip()
            if not typed:
                said.set_text("Type the command that starts it.")
                return
            program = typed
            if not os.path.isabs(typed):
                found = _catalog_which(typed)
                if found is None:
                    said.set_text(
                        "%s is not on the system path. Give the full path to "
                        "it instead." % typed)
                    return
                program = found
            usable, refusal = custom_program_preflight(program)
            if not usable:
                said.set_text("%s was refused: %s" % (program, refusal))
                return
            def append(entries):
                if any(entry["executable"] == program for entry in entries):
                    return False, "%s is already in your catalog." % program
                slug = user_app_slug(name, program,
                                     {entry["id"] for entry in entries})
                entries.append({"id": slug,
                                "name": name or os.path.basename(program),
                                "executable": program,
                                "runtime": "firejail"})
                return True, "Added %s. It is in the list below." % (
                    name or os.path.basename(program))
            saved, message = mutate_user_applications(append)
            if not saved:
                said.set_text(message)
                return
            said.set_text(message)
            name_entry.set_text("")
            program_entry.set_text("")
            repaint()

        add.connect("clicked", on_add)
        program_entry.connect("activate", on_add)
        return holder

    return _live_page(target, "My applications",
                      "Applications you added yourself, sandboxed the same way.",
                      sections, extra_top=add_form)


def win_isolation_running(target=None, tor_loader=None):
    """Every Firejail sandbox and every Kodachi container running right now."""
    del tor_loader

    def sections():
        out = []
        banner = container_prerequisite_section()
        if banner:
            out.append(banner)
        ok, lines, why = _read_lines([FIREJAIL_BIN, "--list"])
        if not ok:
            out.append(("Firejail sandboxes", why,
                        [("Cannot read Firejail", why, "warn", "unknown")]))
        elif not lines:
            out.append(("Firejail sandboxes",
                        "Firejail answered and reported no sandbox running.",
                        [("No Firejail sandbox is running", "", "off", "none")]))
        else:
            rows = []
            for line in lines:
                parts = line.split(":", 3)
                pid = parts[0].strip() if parts else line
                command = parts[3].strip() if len(parts) > 3 else line
                # SHUT DOWN BY PID, never by name. firejail --shutdown takes
                # either, and a name matches EVERY sandbox sharing it, so
                # stopping one LibreWolf window by name stops all of them. The
                # pid came out of the same line as the row, so the button can
                # only ever reach the sandbox the operator is looking at.
                if pid.isdigit():
                    rows.append((command, "pid " + pid, "on", "running",
                                 [FIREJAIL_BIN, "--shutdown=" + pid],
                                 "Shut down"))
                else:
                    rows.append((command, line, "on", "running"))
            out.append(("Firejail sandboxes",
                        "%d sandbox%s reported by firejail --list. Shutting "
                        "one down closes the application inside it."
                        % (len(rows), "" if len(rows) == 1 else "es"), rows))

        ok, lines, why = _read_lines([
            podman_binary(), "ps", "--all",
            "--filter", "label=io.kodachi.managed=true",
            "--format", "{{.Names}}\t{{.Status}}\t{{.Image}}\t{{.ID}}"])
        if not ok:
            out.append(("Kodachi containers", why,
                        [("Cannot read Podman", why, "warn", "unknown")]))
        elif not lines:
            out.append(("Kodachi containers",
                        "Podman answered and owns no Kodachi container.",
                        [("No Kodachi container exists", "", "off", "none")]))
        else:
            rows = []
            for line in lines:
                fields = line.split("\t")
                name = fields[0] if fields else line
                status = fields[1] if len(fields) > 1 else ""
                image = fields[2] if len(fields) > 2 else ""
                ident = fields[3] if len(fields) > 3 else ""
                running = status.startswith("Up")
                # ACT ON THE ID, NOT THE NAME. The listing is already filtered
                # to io.kodachi.managed=true, but a name is mutable and an ID
                # is not, so an ID cannot come to mean a different container
                # between reading this page and pressing the button.
                if ident:
                    rows.append((name, image, "on" if running else "off",
                                 status or "unknown",
                                 [podman_binary(),
                                  "stop" if running else "start",
                                  ident],
                                 "Stop" if running else "Start"))
                else:
                    rows.append((name, image, "on" if running else "off",
                                 status or "unknown"))
            out.append(("Kodachi containers",
                        "%d container%s labelled io.kodachi.managed=true. "
                        "Start and Stop act on the container ID, so they "
                        "cannot reach anything this page did not list."
                        % (len(rows), "" if len(rows) == 1 else "s"), rows))

        # THE TWO FLEET VERBS GO THROUGH THE MANAGER, NOT THROUGH PODMAN.
        # kodachi-container-manager re-checks the managed label on every id it
        # touches; a bare `podman stop --all` here would stop containers the
        # operator started himself for something unrelated.
        if container_runtime_ready() and os.path.isfile(kw.CONTAINER_MANAGER):
            out.append((
                "All Kodachi containers at once",
                "Both verbs are limited to containers labelled "
                "io.kodachi.managed=true and never touch anything else "
                "Podman is running for you.",
                [("Start every Kodachi container",
                  "%s start-all" % kw.CONTAINER_MANAGER, "off", "ready",
                  [kw.CONTAINER_MANAGER, "start-all"], "Start all"),
                 ("Stop every Kodachi container",
                  "%s stop-all" % kw.CONTAINER_MANAGER, "off", "ready",
                  [kw.CONTAINER_MANAGER, "stop-all"], "Stop all")]))
        return out

    return _live_page(target, "Running now",
                      "Everything isolated that is alive on this machine.",
                      sections)


def win_isolation_images(target=None, tor_loader=None):
    """The bundled offline image, and whatever Podman has actually loaded."""
    del tor_loader

    def sections():
        banner = container_prerequisite_section()
        shipped = []
        for label, path in (("Offline image archive", CONTAINER_ARCHIVE),
                            ("Image metadata", CONTAINER_METADATA)):
            if os.path.isfile(path):
                size = os.path.getsize(path)
                shipped.append((label, "%s, %.1f MB" % (path, size / 1048576.0),
                                "on", "present"))
            else:
                shipped.append((label, "%s is not on this system." % path,
                                "warn", "absent"))
        out = [("Shipped with the image",
                "Kodachi loads only this archive and never pulls from a "
                "registry.", shipped)]
        if banner:
            out.insert(0, banner)

        ok, lines, why = _read_lines([
            podman_binary(), "images", "--format",
            "{{.Repository}}:{{.Tag}}\t{{.Size}}\t{{.ID}}"])
        if not ok:
            out.append(("Loaded into Podman", why,
                        [("Cannot read Podman", why, "warn", "unknown")]))
        elif not lines:
            out.append(("Loaded into Podman",
                        "Podman answered and has no image loaded yet. The "
                        "first workspace you open loads the bundled archive.",
                        [("No image is loaded", "", "off", "none")]))
        else:
            rows = []
            for line in lines:
                fields = line.split("\t")
                rows.append((fields[0] if fields else line,
                             " ".join(fields[1:]), "on", "loaded"))
            out.append(("Loaded into Podman",
                        "%d image%s in the rootless store."
                        % (len(rows), "" if len(rows) == 1 else "s"), rows))
        return out

    return _live_page(target, "Images",
                      "The offline container image this system carries.",
                      sections)


def win_isolation_profiles(target=None, tor_loader=None):
    """Which reviewed applications have a dedicated Firejail profile installed."""
    del tor_loader

    def sections():
        rows = []
        declared = [row for section in kw.WINDOWS["sandbox"]["sections"]
                    for row in section["rows"]]
        for row in declared:
            base = os.path.basename(row["executable"])
            path = os.path.join(FIREJAIL_PROFILE_DIR, base + ".profile")
            installed = os.path.isfile(path)
            # THE DECLARATION IS COMPARED AGAINST THE DISK, NOT TRUSTED.
            # `profile="dedicated"` is what the table SAYS; this is what the
            # machine HAS. When they disagree the row says so, because a window
            # that claims a dedicated profile it does not have is the exact
            # defect the Firejail capability was written to prevent.
            if row["profile"] == "dedicated" and installed:
                rows.append((row["name"], path, "on", "dedicated"))
            elif row["profile"] == "dedicated" and not installed:
                rows.append((row["name"],
                             "Declared dedicated, but %s is not installed. "
                             "Firejail will fall back to its default profile."
                             % path, "err", "missing"))
            elif installed:
                rows.append((row["name"],
                             "%s is installed even though the table only "
                             "promises the default profile." % path,
                             "info", "dedicated"))
            else:
                rows.append((row["name"],
                             "No %s. Firejail's default profile applies."
                             % path, "off", "default"))
        dedicated = sum(1 for _n, _d, tone, tag in rows if tag == "dedicated")
        out = [("Firejail profiles",
                "%d of %d reviewed applications have a dedicated profile "
                "installed on this machine." % (dedicated, len(rows)), rows)]

        tools = []
        for name, program, note in ISOLATION_EXPERT_TOOLS:
            if os.path.isfile(program) and os.access(program, os.X_OK):
                tools.append((name, "%s , %s" % (note, program), "on", "ready",
                              (program,)))
            else:
                # ABSENT IS SAID, NEVER HIDDEN. A missing expert tool is a fact
                # about this system, and dropping the row would leave the
                # operator hunting for a button that was never drawn.
                tools.append((name, "%s is not installed on this system."
                              % program, "warn", "absent"))
        out.append(("Expert tools",
                    "These edit and inspect profiles. They are not needed for "
                    "an ordinary launch.", tools))
        return out

    return _live_page(target, "Profiles",
                      "What Firejail actually has installed for each application.",
                      sections)


BUILTIN = {
    "tor-exit": win_tor_exit,
    "tor-exclude": win_tor_exclude,
    "isolation-catalog": win_isolation_catalog,
    "isolation-custom": win_isolation_custom,
    "isolation-running": win_isolation_running,
    "isolation-images": win_isolation_images,
    "isolation-profiles": win_isolation_profiles,
}

ISOLATION_NAV_ICONS = {
    "sandbox": "custom/firejail-brick.png",
    "containers": "dashboard-icons/podman.png",
    "@isolation-catalog": "papirus/applications-all.svg",
    "@isolation-custom": "custom/appmenu-penguin-tux.png",
    "@isolation-running": "papirus/utilities-system-monitor.svg",
    "@isolation-images": "fluent-emoji/card-index.png",
    "@isolation-profiles": "custom/firejail-wizard.png",
}

NETWORK_NAV_ICONS = {
    "vpn": "fluent-emoji/vpn-shield.png",
    "routing": "fluent-emoji/shuffle-tracks-button.png",
    "torrify": "papirus/tor.svg",
    "@tor-exit": "fluent-emoji/world-map.png",
    "@tor-exclude": "fluent-emoji/prohibited.png",
    "tor-service": "fluent-emoji/satellite-antenna.png",
    "killswitch": "fluent-emoji/police-car-light.png",
    "dns": "fluent-emoji/magnifying-glass-tilted-right.png",
    "nettune": "fluent-emoji/wrench.png",
}

SECTION_NAV_ICONS = {
    ("workflows", "Connection and session"):
        "fluent-emoji/counterclockwise-arrows-button.png",
}


def nav_icon_for(ref):
    """Return one explicit shipped icon path for a grouped destination."""
    relative = NETWORK_NAV_ICONS.get(ref) or ISOLATION_NAV_ICONS.get(ref)
    if relative:
        return os.path.join(ICONS, relative)
    for section in kw.WINDOWS.get(ref, {}).get("sections", ()):
        for row in section.get("rows", ()):
            if row.get("icon"):
                return os.path.join(ICONS, row["icon"])
    return None


def section_nav_icon(name, section):
    """Return a unique semantic icon for one standalone destination."""
    relative = SECTION_NAV_ICONS.get((name, section["caption"]))
    if relative:
        return os.path.join(ICONS, relative)
    return next(
        (os.path.join(ICONS, row["icon"]) for row in section["rows"]
         if row.get("icon")),
        None)


def build_tabbed(name, initial_tab=None):
    spec = kw.TABBED[name]
    win = ui.Window(spec["title"], spec["subtitle"],
                    width=spec.get("width", 760), height=spec.get("height", 840),
                    tabbed=True)
    tor_loader = TorStateLoader()
    for key, label, ref in spec["tabs"]:
        # A TAB IS A CONTROL AND IT HAD NO HOVER TEXT. The window each tab holds
        # already carries a one-line subtitle written for exactly this purpose,
        # so use it rather than inventing a second description that can drift.
        # The two hand-written pickers have no spec, hence the fallback.
        sub = kw.WINDOWS.get(ref, {}).get("subtitle") if not ref.startswith("@") else None
        page = win.add_tab(
            key, label,
            tooltip=(f"{label}: {sub}" if sub else None),
            icon_path=nav_icon_for(ref))
        if ref.startswith("@"):
            BUILTIN[ref[1:]](page, tor_loader=tor_loader)
        else:
            build_declarative(ref, target=page, parent=win)
    if initial_tab is not None:
        valid_tabs = {key for key, _label, _ref in spec["tabs"]}
        if initial_tab not in valid_tabs:
            raise KeyError(f"unknown tab {initial_tab!r} for {name!r}")
        win.show_tab(initial_tab)
    return win


WINDOWS = {
    "tor-exit": win_tor_exit,
    "tor-exclude": win_tor_exclude,
}
for _name in kw.WINDOWS:
    WINDOWS[_name] = (lambda n: lambda: build_declarative(n))(_name)
for _name in getattr(kw, "TABBED", {}):
    WINDOWS[_name] = (lambda n: lambda tab=None: build_tabbed(n, tab))(_name)


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in WINDOWS:
        print("usage: kodachi-command-window <" + "|".join(sorted(WINDOWS)) + ">",
              file=sys.stderr)
        sys.exit(2)
    ui.install_css()
    initial_tab = sys.argv[2] if len(sys.argv) > 2 else None
    if initial_tab is not None and sys.argv[1] not in kw.TABBED:
        print(f"{sys.argv[1]} does not accept a tab argument", file=sys.stderr)
        sys.exit(2)
    builder = WINDOWS[sys.argv[1]]
    window = builder(initial_tab) if initial_tab is not None else builder()
    # THE SIDEBAR COUNTS ARE FILLED IN HERE AND NOWHERE ELSE, because this is
    # the single point every one of the three window shapes passes through: the
    # two hand-written Tor pickers, the declarative windows and the tabbed ones
    # all arrive as `builder()` results. Counting inside `section()` instead
    # would read zero for every section in the product, since a section
    # registers its nav row before the card under it holds a single control.
    window.refresh_nav_counts()
    window.show_all()
    Gtk.main()
