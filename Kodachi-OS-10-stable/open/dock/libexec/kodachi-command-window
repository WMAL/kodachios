DRY = os.environ.get("KODACHI_DRY_RUN") == "1"
# Upper bound on any single registry command, in seconds. 240 clears the slowest
# thing measured on the product (check-signatures at 149s) with headroom, while
# still guaranteeing every button answers.
SHELL_TIMEOUT = 240
# A control verb (start, stop, shutdown, remove) is not a shell and not a
# launch. `podman stop` waits its own 10 second grace period before it
# kills, so anything under about 20 seconds would report a timeout for a
# stop that was working correctly.
CONTROL_TIMEOUT = 45
LAUNCH_SURVIVAL_SECONDS = 0.75
DISPLAY_PLAN_TIMEOUT = 0.25
DISPLAY_PLAN_CACHE_SECONDS = 1.0
_DISPLAY_PLAN_CACHE = {}


def canonical_tor_switch():
    """Return the explicit Tor binary or fail closed without PATH lookup."""
    if (not os.path.isabs(TOR_SWITCH)
            or not os.path.isfile(TOR_SWITCH)
            or not os.access(TOR_SWITCH, os.X_OK)):
        raise RuntimeError(
            "canonical tor-switch is absent or not executable: " + TOR_SWITCH)
    return TOR_SWITCH


def canonical_firejail_launcher():
    """Return the shipped allowlist wrapper, with a checkout-local test path."""
    for candidate in (FIREJAIL_LAUNCHER, LOCAL_FIREJAIL_LAUNCHER):
        if (os.path.isabs(candidate) and os.path.isfile(candidate)
                and os.access(candidate, os.X_OK)):
            return candidate
    raise RuntimeError("Kodachi Firejail launcher is absent or not executable")


def custom_program_preflight(program):
    """Ask the launch adapter itself whether one custom path is acceptable."""
    try:
        launcher = canonical_firejail_launcher()
        result = subprocess.run(
            [launcher, "--validate-custom", program],
            stdin=subprocess.DEVNULL, capture_output=True, text=True,
            errors="replace", timeout=5)
    except (OSError, subprocess.TimeoutExpired, RuntimeError) as exc:
        return False, _exc_detail(exc)
    if result.returncode != 0:
        return False, ((result.stderr or result.stdout or "").strip()
                       or "the Firejail adapter refused this program")
    return True, ""


def canonical_isolation_launcher():
    """Return the shipped runtime adapter, with a checkout-local test path."""
    for candidate in (ISOLATION_LAUNCHER, LOCAL_ISOLATION_LAUNCHER):
        if (os.path.isabs(candidate) and os.path.isfile(candidate)
                and os.access(candidate, os.X_OK)):
            return candidate
    raise RuntimeError("Kodachi isolation launcher is absent or not executable")


def flag(code, px=22):
    return ui.icon(os.path.join(FLAGS, f"{code.lower()}.svg"), px)


# ── the two country pickers, and why they are NOT registry-driven ──────
#
# Every other row in every other window names a (Category, Label) pair and the
# driver resolves it against menu-actions.sh, so no command string is ever
# copied. The two Tor pickers below are the one deliberate exception, and the
# reason is structural rather than convenient: the registry maps a FIXED label
# to a FIXED command line. It cannot express "set-exclude-node-main <any of 76
# country codes>", and enumerating the parameter would mean 76 include rows plus
# 76 exclude rows of near-identical registry entries whose only purpose is to
# carry an argument, in a file the headless terminal image also reads.
#
# So these two build their argv directly, from kodachi_countries, which is
# itself checked against tor.rs by `kodachi_countries.py --verify`. The binary
# name still comes from one place (TOR_SWITCH), and the country list from one
# place (the verified mirror), so the indirection the registry buys elsewhere is
# preserved by different means rather than abandoned.
def _country_routerset(value, allow_none=False):
    """Parse only country-code Tor routersets, never nicknames or fingerprints."""
    if not isinstance(value, str):
        return None
    value = value.strip()
    if allow_none and value.lower() == "none":
        return []
    if not value:
        return None
    countries = []
    for token in value.split(","):
        token = token.strip()
        if len(token) != 4 or token[0] != "{" or token[-1] != "}":
            return None
        code = token[1:-1]
        if len(code) != 2 or not code.isascii() or not code.isalpha():
            return None
        countries.append(code.lower())
    return countries or None


def _successful_json(text):
    """Return a successful JSON object, accepting one standard data envelope."""
    try:
        payload = json.loads((text or "").strip())
    except (TypeError, ValueError):
        return None
    if not isinstance(payload, dict) or payload.get("status") != "success":
        return None
    if "data" in payload:
        data = payload.get("data")
        return data if isinstance(data, dict) else None
    return payload


def read_tor_state():
    """Ask the router what is pinned and what is excluded, before drawing.

    Returns (exit_pin, excluded_set, ok). `ok` is FALSE when the read failed,
    and the caller MUST honour it, because the exclude window applies its state
    by clearing every exclusion and re-adding the ticked ones. A failed read
    draws every switch off, so a user who ticks one country and presses Apply
    would silently DELETE every exclusion already in force. Losing protection
    the user configured earlier, without being told, is the worst outcome this
    window can produce, so a failed read disables Apply rather than guessing.

    The window still OPENS on a failed read. Refusing to appear because a status
    call was slow is worse than appearing and admitting it does not know.
    """
    if DRY:
        return None, set(), True
    try:
        proc = subprocess.run([kd.SUDO, "-n", canonical_tor_switch(),
                               "list-exit-exclude-main", "--json"],
                              capture_output=True, text=True,
                              errors="replace", timeout=8)
    except Exception:
        return None, set(), False
    if proc.returncode != 0:
        return None, set(), False
    data = _successful_json(proc.stdout)
    if data is None:
        return None, set(), False
    exit_codes = _country_routerset(data.get("exit_nodes"), allow_none=True)
    exclude_codes = _country_routerset(data.get("exclude_nodes"), allow_none=True)
    if exit_codes is None or exclude_codes is None:
        return None, set(), False
    pin = None if not exit_codes else (
        exit_codes[0] if len(exit_codes) == 1
        else ",".join("{%s}" % code for code in exit_codes))
    return pin, {code.upper() for code in exclude_codes}, True


def _exclude_set_from_status(value):
    """Extract one exact exclusion set only when both Tor directives agree."""
    if not isinstance(value, str):
        return None
    value = value.strip()
    if value in {"", "No exit/exclude configuration", "No restrictions"}:
        return set()

    def directive(name, following=None):
        tail = "|".join(re.escape(item) for item in (following or []))
        boundary = rf"(?=,\s*(?:{tail}):|$)" if tail else r"(?=$)"
        match = re.search(
            rf"(?:^|,\s*){re.escape(name)}:\s*(.*?){boundary}", value)
        if match is None:
            return None
        parsed = _country_routerset(match.group(1), allow_none=True)
        return None if parsed is None else {code.upper() for code in parsed}

    excluded = directive("ExcludeNodes", ["ExcludeExitNodes"])
    excluded_exit = directive("ExcludeExitNodes")
    if excluded is None or excluded_exit is None or excluded != excluded_exit:
        return None
    return excluded


def read_pooled_tor_exclusions():
    """Return every configured pooled instance's exact exclusion set."""
    if DRY:
        return {}, True
    try:
        proc = subprocess.run(
            [kd.SUDO, "-n", canonical_tor_switch(),
             "list-instances", "--json"],
            capture_output=True, text=True, errors="replace", timeout=8)
    except Exception:
        return {}, False
    if proc.returncode != 0:
        return {}, False
    data = _successful_json(proc.stdout)
    instances = data.get("instances") if data else None
    if (not isinstance(instances, list)
            or type(data.get("count")) is not int
            or data["count"] != len(instances)):
        return {}, False
    result = {}
    for instance in instances:
        if not isinstance(instance, dict):
            return {}, False
        tag = instance.get("tag")
        if not isinstance(tag, str) or not tag or tag in result:
            return {}, False
        try:
            status_proc = subprocess.run(
                [kd.SUDO, "-n", canonical_tor_switch(),
                 "get-tor-custom-status",
                 "--instance", tag, "--json"],
                capture_output=True, text=True, errors="replace",
                timeout=8)
        except Exception:
            return {}, False
        if status_proc.returncode != 0:
            return {}, False
        status = _successful_json(status_proc.stdout)
        if not status or status.get("instance") != tag:
            return {}, False
        excluded = _exclude_set_from_status(status.get("tor_custom_status"))
        if excluded is None:
            return {}, False
        result[tag] = excluded
    return result, True


def run_tor_command(args):
    """Run one bounded Tor mutation and preserve its own failure text."""
    if DRY:
        print("WOULD RUN: sudo", TOR_SWITCH, *args)
        return 0, ""
    try:
        proc = subprocess.Popen(
            [kd.SUDO, "-n", canonical_tor_switch(), *args],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            start_new_session=True)
    except (OSError, RuntimeError, ValueError) as exc:
        return 1, f"Direct Tor execution refused: {exc}"
    try:
        stdout, stderr = proc.communicate(timeout=SHELL_TIMEOUT)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            stdout, stderr = proc.communicate(timeout=1.0)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = proc.communicate(timeout=1.0)
        partial = (stdout or "") + (stderr or "")
        return 124, (partial + f"\nTor did not answer within {SHELL_TIMEOUT} seconds.")
    return proc.returncode, (stdout or "") + (stderr or "")


def _wrap_country_names(names, width=72):
    """Wrap comma-separated country names without splitting a country name."""
    lines = []
    current = ""
    for name in names:
        candidate = name if not current else f"{current}, {name}"
        if current and len(candidate) > width:
            lines.append(current)
            current = name
        else:
            current = candidate
    if current:
        lines.append(current)
    return lines


def _exit_group_members(group_key):
    """Resolve the same static or derived country set the Tor selector uses."""
    if group_key == "low-volume":
        return sorted(
            set(cc.GROUPS["all-world"])
            - set(cc.GROUPS["high-volume"])
            - set(cc.GROUPS["14eyes"]))
    return list(cc.GROUPS[group_key])


def _exc_detail(exc):
    """Render an exception for a user-facing recovery message, never raising.

    THE RECOVERY IS THE LAST THING BETWEEN THE OPERATOR AND A DEAD BUTTON, so it
    is the one place that must not be able to fail. `"%s" % exc` calls the
    exception's `__str__`, and an exception whose `__str__` raises (a subclass
    with a broken `args`, or one carrying an object whose `__repr__` throws)
    turns the recovery itself into an unhandled exception inside the caller of
    `start_daemon`. The button then stays disabled and relabelled "working" for
    ever, which is exactly the state every one of these callbacks exists to
    prevent. The class NAME is always safe to read; the text is attempted
    separately and dropped if it misbehaves.

    MEASURED BY AST, 2026-08-26, over this file's eleven `start_daemon` sites,
    and deliberately NAMED rather than numbered, because a line number in a
    comment is the same staleness trap as a count in a test method name:
    WHY THIS FUNCTION CATCHES `BaseException` WHILE THE RECOVERY HANDLERS THAT
    CALL IT CATCH ONLY `Exception`, BECAUSE THE ASYMMETRY LOOKS LIKE AN
    OVERSIGHT AND A FUTURE SWEEP WILL OTHERWISE "CORRECT" IT IN ONE DIRECTION
    OR THE OTHER, AND BOTH DIRECTIONS ARE WRONG. A recovery handler must NOT
    swallow `KeyboardInterrupt` or `SystemExit`: the operator pressing Ctrl-C
    has to reach the interpreter, so those handlers catch `Exception`, which
    is also what a refused thread start can actually raise. This helper is not
    a handler, it is a GUARD that runs INSIDE one, and its entire contract is
    that it cannot itself raise; if it did, the handler around it would abort
    half-committed and leave the control saying "checking" forever, which is
    the defect it exists to prevent. A guard that must never raise catches
    `BaseException`. A handler that must not hide an interrupt catches
    `Exception`. Raised by inspector a8570375f5aaf1a73 as G5, 2026-08-26;
    neither catch was changed, because both are already right.

    THE ELEVEN `start_daemon` CALL SITES, CLASSIFIED BY THE ONLY PREDICATE
    THAT IS NOT WRONG, "is this exception-format node inside a `Try.body`?":

        SIX call this helper       reporting_start_failed, worker_start_failed,
                                   and the lambdas at the podman, firejail,
                                   control-window and grouped-window sites
        FOUR ignore the exception  the run_and_report `start_failed`,
                                   read_start_failed, and the two `_exc`
                                   lambdas: they never render it, so a raising
                                   `__str__` cannot reach them
        ONE guards it inline       the status-refresh `start_failed`, which
                                   carries its own try/except around the format
        ------------------------------------------------------------------
        6 + 4 + 1 = 11, and ZERO now format a bound exception unguarded.

    THAT LAST CLAUSE USED TO BE SCOPED TO THOSE ELEVEN, AND THE SCOPING WAS
    HIDING A REAL GAP. IT IS NOW WHOLE-FILE AND UNCONDITIONAL, because the
    sites it used to exclude have been fixed rather than excused.

    NO LINE NUMBERS APPEAR BELOW, DELIBERATELY. The previous version of this
    paragraph listed ten of them and every one went +17 stale within a day of
    being written, from a comment insertion in this same docstring; eight then
    pointed at unrelated code and the load-bearing citation pointed at a bare
    `presented = (`. A comment that names a line number is a comment with an
    expiry date. Re-derive instead, and the exact predicate is the point:

        for every `ExceptHandler` ANYWHERE in the file (nested ones included),
        with a bound name, find every `%`-format / f-string in its body that
        mentions that name OUTSIDE a `type(name).__name__` and OUTSIDE an
        `_exc_detail(name)` call, and that does not also carry `__name__`.

    WALK EVERY HANDLER, NOT ONLY THE TOP-LEVEL ONES. The predicate that
    produced the old count asked its question about handlers reachable from a
    `Try.body` at one level, and MISSED a handler nested inside a for-loop
    inside an outer try. The real count was ELEVEN, not ten. An independent
    inspector re-derived the membership and got the same ten, because it
    re-derived with MY predicate: reproducing a census with the predicate that
    produced it reproduces its blind spot, and agreement is not independence.

    The old paragraph also claimed each of those sites "catches a narrow
    concrete type whose `__str__` is a plain format". Measured 2026-08-26, that
    was false for FIVE of the eleven: they caught `Exception`, which admits
    `MemoryError`, whose `str()` is the empty string. Those five plus one in
    `kodachi-repo-manager` (the favourites worker, which caught `BaseException`
    and could additionally leave its `error` variable empty and report a
    FAILURE AS A SUCCESS if the format itself raised) now go through
    `_exc_detail`.

    AND THAT WAS STILL NOT THE END OF IT: THE VERY NEXT RE-DERIVATION FOUND
    THREE MORE, ALL IN `kodachi-repo-manager`, AND THIS CENSUS HAD WAVED ALL
    THREE THROUGH BECAUSE THEY PRINT THE CLASS NAME. The class name was never
    the property. `"%s: %s" % (type(exc).__name__, exc)` still evaluates
    `str(exc)`, so an exception whose `__str__` raises takes the handler out
    from the inside, and all three delivered through an unconditional
    `finally: GLib.idle_add(...)`, which then publishes the variable's INITIAL
    value. At the updates worker that value was `""`, i.e. the same
    failure-reported-as-success as the favourites worker above. So a message
    naming the class is NOT thereby guarded, and the damage is decided by the
    DELIVERY, not by the wording.

    WHAT SURVIVES, in both payloads, in exactly two shapes. Narrowly caught
    bare formats (`OSError`, `ValueError`, `subprocess` errors,
    `kd.DirectContractError`, `FileNotFoundError`), which cannot be a
    `MemoryError` and always carry a message; and widely caught ones that
    wrap their own format in a nested `try` WHICH ITSELF CATCHES SOMETHING
    WIDE, that being `_exc_detail` written out by hand and the one real
    exemption. THE COUNT IS DELIBERATELY NOT WRITTEN HERE, for the same reason
    the line numbers above are not. It legitimately FALLS every time one of
    those sites is converted to call this helper, which is an improvement, so
    a hand-maintained number here would be stale on the next good change and
    would then be re-typed rather than re-derived. The contract named below
    carries it as a FLOOR and never as an equality.

    DO NOT RE-DERIVE THIS BY HAND. It has now been wrong THREE times, and each
    time the predicate was the defect. It is executable code:
    `tests/test_repo_manager.py`, in the payload-source class, method
    `test_no_widely_caught_exception_is_formatted_without_the_guard`. It
    carries a positive control built from this file (revert one real guard,
    require one new finding), a negative control, and floors on both the
    exempted and the total populations. It walks EVERY Python payload in the
    tree, discovered rather than hand-listed, because the first version of it
    enforced two payloads while this very docstring reported a twelve-payload
    census. Calibration arms in `tests/calibrate_repo_manager.py` prove it can
    fail, one per guarded site plus one that mutates the contract's own
    exemption clause; they are not counted here either.

    The defect this census is about is not "an exception is formatted", it is
    "an exception is formatted AFTER the recovery has half-committed the
    visible state and BEFORE it finishes". The five widened the class from
    "strands the UI" to "prints a message with nothing after the colon", which
    is milder and was still worth closing, because the operator reading
    `the window could not run this: ` learns nothing at all.

    THIS COUNT HAS BEEN WRONG TWICE, IN OPPOSITE DIRECTIONS, AND BOTH TIMES THE
    PREDICATE WAS THE DEFECT RATHER THAN THE ARITHMETIC. First it said "the ten
    sibling recoveries do not defend", a number nobody had derived; an
    independent inspector repeated it at face value. Then it said THREE were
    already guarded, from a walk that asked "does this CALLBACK contain a
    `Try`?" , and `worker_start_failed` contains one, around its secret wipe,
    with the format outside it and passed as an ARGUMENT to `done(...)`, so a
    raising `__str__` meant `done` was never entered at all and its
    `button.set_sensitive(True)` never ran. A second inspector re-derived it
    with the node-level question and found that site. Re-derive it that way or
    not at all.

    AND A CALL-SITE CENSUS IS STRUCTURALLY THE WRONG INSTRUMENT HERE, which is
    the more useful half. Two recovery formats in this file are not at a
    `start_daemon` site and no such census can reach them: the control-window
    worker's own `except Exception`, five lines above a lambda that WAS
    hardened, and `apply`'s `except BaseException` around the sequence runner.
    Both now call this helper too. Five further sites (the four "never leave
    the button dead" workers and the sequence runner) already carry an inline
    equivalent of this helper, written before it existed; they are correct as
    they stand and are deliberately not rewritten to call it.
    """
    try:
        return "%s: %s" % (type(exc).__name__, exc)
    except BaseException:
        return type(exc).__name__


def start_daemon(thread, on_start_error):
    """Start one prepared daemon thread and settle its owner on start failure."""
    try:
        thread.start()
    except BaseException as exc:
        on_start_error(exc)
        return False
    return True


class TorStateLoader:
    """One shared, refreshable state read for both Tor picker surfaces."""

    def __init__(self):
        self._callbacks = []
        self._result = None
        self._running = False
        self._queued_callbacks = []
        self._queue_all = False

    def subscribe(self, callback):
        if callback not in self._callbacks:
            self._callbacks.append(callback)
        if self._result is not None:
            GLib.idle_add(callback, *self._result)
        elif not self._running:
            self.refresh()

    def refresh(self, callback=None):
        if self._running:
            if callback is None:
                self._queue_all = True
                self._queued_callbacks.clear()
            elif not self._queue_all and callback not in self._queued_callbacks:
                self._queued_callbacks.append(callback)
            return
        targets = None if callback is None else (callback,)
        self._start_refresh(targets)

    def _start_refresh(self, targets):
        self._running = True
        self._result = None

        def worker():
            try:
                result = read_tor_state()
            except Exception:
                result = (None, set(), False)
            GLib.idle_add(self._finish, result, targets)

        start_daemon(
            threading.Thread(target=worker, daemon=True),
            lambda _exc: GLib.idle_add(
                self._finish, (None, set(), False), targets))

    def _finish(self, result, targets=None):
        self._running = False
        self._result = result
        callbacks = list(self._callbacks) if targets is None else targets
        for callback in callbacks:
            try:
                callback(*result)
            except Exception as exc:
                print("Tor state could not update one surface: %s"
                      % _exc_detail(exc), file=sys.stderr)
        if self._queue_all:
            self._queue_all = False
            self._queued_callbacks.clear()
            self._start_refresh(None)
        elif self._queued_callbacks:
            queued = tuple(self._queued_callbacks)
            self._queued_callbacks.clear()
            self._start_refresh(queued)
        return False


# ── window: pin one exit country ────────────────────────────────────────
def win_tor_exit(target=None, tor_loader=None):
    # `target` lets this same picker render into ONE TAB of the grouped Network
    # window. Nothing below this line changes, because a ui.Page offers the same
    # state_strip / section / card / footer API a ui.Window does. That is the
    # whole reason Page exists: 133 lines of hand-written widget code in this
    # file and its sibling did not have to be rewritten to be grouped.
    win = target if target is not None else ui.Window(
        "Tor Exit Country",
        "Where your traffic leaves the Tor network.",
        width=640, height=820)
    loader = tor_loader or TorStateLoader()
    state = {"ok": False, "loaded": False, "initial": "",
             "force_server": False, "draft": None}
    choice = {"value": None}
    controls = []
    radios = {}
    group = [Gtk.RadioButton.new(None)]
    group[0].set_no_show_all(True)
    win.state_strip([
        ("Pinned exit", "loading", "info"),
        ("Countries available", str(len(cc.ALL)), "state-val"),
    ])

    def staged_count():
        if not state["ok"] or not state["loaded"] or choice["value"] is None:
            return 0
        return int(choice["value"] != state["initial"])

    def refresh_pending(*_args):
        ui.set_footer_pending(win, staged_count())

    def choose(button, value):
        if button.get_active():
            choice["value"] = value
            refresh_pending()

    def add(card, value, name, note=None, leading=None, tag=None, tone=None,
            group_key=None):
        radio = ui.radio_row(card, group[0], name, note=note, leading=leading,
                             code=value.upper() if value else "AUTO",
                             active=False,
                             state_text=tag, tone=tone)
        radio.set_sensitive(False)
        controls.append(radio)
        radios[value] = radio
        radio.connect("toggled", choose, value)
        # EVERY CONTROL GETS A TOOLTIP, and these hand-written pickers were the
        # biggest gap in the product: roughly 100 country rows in this window and
        # 90 switches in the exclusion window, none of them with any hover text,
        # while the declarative windows next door tooltip every row.
        tip = [name]
        if note:
            tip.append(note)
        if group_key is not None:
            members = _exit_group_members(group_key)
            member_lines = _wrap_country_names(
                [cc.NAME.get(code, code) for code in members])
            tip.extend(
                [f"Can choose any one of these {len(members)} countries:"]
                + ["    " + line for line in member_lines])
        verb = "clear-exit-node" if not value else "set-exit-node"
        arg = "" if not value else " " + value
        if value:
            tip.append("Apply resolves the selector once with: sudo %s %s-main%s --json, "
                       "then mirrors that exact country set with %s %s-all."
                       % (TOR_SWITCH, verb, arg, TOR_SWITCH, verb))
        else:
            tip.append("Apply runs: sudo %s %s-main, then sudo %s %s-all"
                       % (TOR_SWITCH, verb, TOR_SWITCH, verb))
        ui.set_row_tooltip(radio, "\n".join(tip))
        return radio

    win.section("Let Tor decide", icon_path=os.path.join(ICONS, "papirus/tor.svg"))
    card = win.card()
    add(card, "", "Any country", "Fastest, and the least fingerprintable choice.")
    add(card, "random", "Random country", "A different country every time you apply.")

    win.section("Regions", "Pins one country picked at random inside the region.",
                icon_path=os.path.join(ICONS, "flags/fi.svg"))
    card = win.card()
    for alias, note in cc.ALIASES:
        if alias in ("all-world", "high-volume", "low-volume"):
            continue
        add(card, f"random-{alias}", note.replace("Anywhere in ", ""), note,
            tag=str(len(cc.GROUPS[alias])), tone="info", group_key=alias)

    win.section("Relay volume",
                icon_path=os.path.join(ICONS, "papirus/speed-dreams.svg"))
    card = win.card()
    add(card, "high-volume", "High volume relays",
        "Countries with the most exits. Faster, more shared.",
        tag=str(len(cc.GROUPS["high-volume"])), tone="info",
        group_key="high-volume")
    add(card, "low-volume", "Low volume relays",
        "Rare exits. Slower, and a smaller crowd to blend into.",
        tag="live", tone="warn", group_key="low-volume")

    for region, members in cc.by_region():
        win.section(region, f"{len(members)} countries",
                    icon_path=os.path.join(FLAGS, f"{members[0].lower()}.svg"))
        card = win.card()
        for code in members:
            add(card, code.lower(), cc.NAME.get(code, code), leading=flag(code))

    def apply(_button):
        value = choice["value"]
        # A FAILED READ IS NOT AN EMPTY PIN, and treating it as one DESTROYS the
        # pin. When read_tor_state() fails, `pin` is empty, so "Any country" is
        # drawn selected and this function's `not value` branch fires
        # `clear-exit-node-main`, clearing an exit the user could not see and did
        # not choose. Its sibling win_tor_exclude already refuses to apply on the
        # identical failure and says why. Same file, same read, opposite policy:
        # the exclusion list was protected and the pin was not.
        #
        # The refusal is belt and braces with the disabled footer below, because
        # a disabled button is a UI state and this is the guard that has to hold
        # even if some future path re-enables it.
        if not state["ok"] or value is None or not staged_count():
            return
        # BOTH SCOPES, DELIBERATELY. tor-switch has three and no combined one:
        # a bare command hits the default instance, `-main` writes /etc/tor/torrc
        # (the SYSTEM daemon) and `-all` fans out over the POOLED instances that
        # carry traffic under round-robin / weighted / consistent-hashing.
        # Reported through <agent> as G30-A: this window pinned `-main`
        # only, so the pooled instances kept NO exit restriction while the radio
        # said Germany. The operator ruled it: picking a country must make ALL of
        # them exit from there. Main runs first because its exit status is the one
        # that means something (G49: the fan-out exits 0 on partial success).
        verb = "clear-exit-node" if not value else "set-exit-node"
        resolved = {"routerset": None}
        if value:
            payloads = [
                {"scope": "main", "args": [verb + "-main", value, "--json"]},
                {"scope": "all", "args": None},
            ]
            previews = [
                "sudo %s %s-main %s --json" % (TOR_SWITCH, verb, value),
                "sudo %s %s-all <the exact selection returned by main>"
                % (TOR_SWITCH, verb),
            ]
        else:
            payloads = [
                {"scope": "main", "args": [verb + "-main"]},
                {"scope": "all", "args": [verb + "-all"]},
            ]
            previews = ["sudo %s %s-main" % (TOR_SWITCH, verb),
                        "sudo %s %s-all" % (TOR_SWITCH, verb)]

        def execute(payload):
            args = payload["args"]
            if payload["scope"] == "all" and value:
                if resolved["routerset"] is None:
                    return 1, "Main Tor did not return a concrete exit selection."
                args = [verb + "-all", resolved["routerset"], "--json"]
            code, output = run_tor_command(args)
            if code == 0 and payload["scope"] == "all" and value:
                data = _successful_json(output)
                total = data.get("total_instances") if data else None
                succeeded = data.get("success_count") if data else None
                failed = data.get("failed_instances") if data else None
                if (type(total) is not int or type(succeeded) is not int
                        or total < 0 or succeeded != total or failed != []):
                    return 1, (output or
                               "Pooled Tor did not confirm every instance.")
            if code != 0 or payload["scope"] != "main" or not value:
                return code, output
            data = _successful_json(output)
            routerset = data.get("exit_node") if data else None
            if _country_routerset(routerset) is None:
                return 1, "Main Tor returned no valid country routerset."
            resolved["routerset"] = routerset
            return 0, ""

        def done(_completed, failed):
            if failed is None:
                state["force_server"] = True
                state["draft"] = None
                set_loading()
                loader.refresh(settle)
            else:
                refresh_pending()

        # These two windows do not go through the registry: `argv` is built
        # right here and is always tor-switch set-exit-node / clear-exit-node,
        # which report which instances were changed and take no credential of
        # any kind. Named explicitly rather than defaulting on, so the deny
        # default keeps meaning something.
        run_sequence_async(_button, win, "Tor Exit Country",
                           list(zip(previews, payloads)), execute, done,
                           show_output=lambda _payload: True,
                           show_failure=lambda _payload: True)

    primary = win.footer("No changes pending",
                         "Apply exit", apply, primary_enabled=False)

    def set_loading():
        state["ok"] = False
        primary.set_sensitive(False)
        for control in controls:
            control.set_sensitive(False)
        win.state_strip([
            ("Pinned exit", "loading", "info"),
            ("Countries available", str(len(cc.ALL)), "state-val"),
        ])
        win._state_slot.show_all()
        refresh_pending()

    def settle(pin, _excluded, ok):
        draft = state["draft"]
        if (draft is None and state["loaded"] and state["ok"]
                and staged_count() and not state["force_server"]):
            draft = choice["value"]
        state["ok"] = ok
        if ok:
            server_value = pin or ""
            state["initial"] = server_value
            state["loaded"] = True
            if draft is None:
                choice["value"] = server_value
                selected = radios.get(server_value)
                if selected is not None:
                    selected.set_active(True)
            else:
                choice["value"] = draft
            state["draft"] = None
        elif not state["loaded"]:
            choice["value"] = None
        elif draft is not None:
            state["draft"] = draft
        state["force_server"] = False
        for control in controls:
            control.set_sensitive(ok)
        win.state_strip([
            ("Pinned exit",
             (pin.upper() if pin else "none, Tor chooses") if ok else "could not read",
             ("on" if pin else "off") if ok else "warn"),
            ("Countries available", str(len(cc.ALL)), "state-val"),
        ])
        win._state_slot.show_all()
        if not ok:
            win.result().show(
                "Tor Exit Country", f"sudo -n {TOR_SWITCH} list-exit-exclude-main",
                "The current exit pin could not be read. Apply stays disabled so "
                "a failed read cannot clear a pin that may still be in force.",
                "unreadable", "warn")
        refresh_pending()

    loader.subscribe(settle)
    return win


# ── window: exclude many countries ──────────────────────────────────────
def win_tor_exclude(target=None, tor_loader=None):
    # See win_tor_exit: `target` is a ui.Page when this is one tab of Network.
    win = target if target is not None else ui.Window(
        "Countries To Avoid",
        "Tor will not route through any country switched on here.",
        width=640, height=830)
    loader = tor_loader or TorStateLoader()
    state = {"ok": False, "loaded": False, "initial": set(),
             "force_server": False, "settling": False, "draft": None}
    win.state_strip([
        ("Excluded now", "loading", "info"),
        ("Countries available", str(len(cc.EXCLUDABLE)), "state-val"),
    ])
    switches = {}
    presets = {}
    controls = []

    def chosen_set():
        return {code for code, switch in switches.items()
                if switch.get_active()}

    def staged_count():
        if not state["ok"] or not state["loaded"]:
            return 0
        return len(chosen_set().symmetric_difference(state["initial"]))

    def refresh_pending(*_args):
        if not state["settling"]:
            ui.set_footer_pending(win, staged_count())

    def sync_presets(*_args):
        """Keep group summaries truthful while individual countries are edited."""
        if state["settling"]:
            return
        for key, (preset, handler_id) in presets.items():
            members = [code for code in cc.GROUPS[key] if code in switches]
            active = bool(members) and all(
                switches[code].get_active() for code in members)
            if preset.get_active() != active:
                preset.handler_block(handler_id)
                try:
                    preset.set_active(active)
                finally:
                    preset.handler_unblock(handler_id)

    def drive(group_key, active):
        """A group switch drives its members, so the two views cannot disagree."""
        for code in cc.GROUPS[group_key]:
            if code in switches:
                switches[code].set_active(active)

    win.section("Preset groups",
                "One switch drives every country in the group.",
                icon_path=os.path.join(ICONS, "papirus/tor.svg"))
    card = win.card()
    for key, name, note in cc.EXCLUDE_PRESETS:
        members = cc.GROUPS[key]
        strip = ui.hbox(3)
        strip.set_valign(Gtk.Align.CENTER)
        for code in members[:6]:
            strip.pack_start(flag(code, 17), False, False, 0)
        if len(members) > 6:
            strip.pack_start(ui.lbl(f"+{len(members) - 6}", "row-code"), False, False, 0)
        switch = ui.switch_row(card, name, f"{note}, {len(members)} countries",
                               leading=strip, active=False)
        switch.set_sensitive(False)
        controls.append(switch)
        handler_id = switch.connect(
            "notify::active",
            lambda s, _p, k=key: drive(k, s.get_active()))
        switch.connect("notify::active", refresh_pending)
        presets[key] = (switch, handler_id)
        # EVERY MEMBER, WRAPPED. NOT THE FIRST EIGHT.
        #
        # This used to print `members[:8]` and then "and N more", which withheld
        # the countries the switch actually moves from exactly the groups where
        # knowing matters. Five of the presets here hold more than eight, and
        # "Switches every country in the group at once" followed by a truncated
        # list is a tooltip that contradicts its own first clause. Reported by
        # <agent> 2026-08-23.
        #
        # A tooltip is not a place for a scroll bar, so the answer is wrapping,
        # not truncation: atom-preserving wrapping at 72 columns, indented, so a
        # 30-country group reads as a short block instead of one unreadable line.
        # A country name is an atom, and splitting "United Arab Emirates" or
        # "Guinea-Bissau" across lines is worse than a slightly ragged line.
        member_names = [cc.NAME.get(c, c) for c in members]
        member_lines = _wrap_country_names(member_names)
        ui.set_row_tooltip(switch, "\n".join(
            [
                name,
                f"{note}, {len(members)} countries",
                "Switches every country in the group at once:",
            ]
            + ["    " + line for line in member_lines]
            + [
                "Apply then runs:  sudo %s clear-exclude-node-main, then one "
                "set-exclude-node-main per country left on, then "
                "one set-exclude-node-all call carrying the complete selected "
                "country list for the pooled Tor instances"
                % TOR_SWITCH,
            ]))

    for region, members in cc.by_region(cc.EXCLUDABLE):
        win.section(region, f"{len(members)} countries",
                    icon_path=os.path.join(FLAGS, f"{members[0].lower()}.svg"))
        card = win.card()
        for code in members:
            switches[code] = ui.switch_row(
                card, cc.NAME.get(code, code), leading=flag(code),
                trailing_code=code, active=False)
            switches[code].set_sensitive(False)
            controls.append(switches[code])
            switches[code].connect("notify::active", refresh_pending)
            switches[code].connect("notify::active", sync_presets)
            ui.set_row_tooltip(switches[code], "\n".join([
                cc.NAME.get(code, code),
                f"Country code: {code}.",
                "On means Tor will not route through this country.",
                "Apply runs:  sudo %s set-exclude-node-main %s. Apply also "
                "passes the complete selected country set once to "
                "set-exclude-node-all, which replaces the pooled Tor "
                "instances with that exact set."
                % (TOR_SWITCH, code.lower()),
            ]))

    def apply(_button):
        if not state["ok"] or not staged_count():
            return
        chosen = sorted(c.lower() for c, s in switches.items() if s.get_active())
        original = set(state["initial"])

        def exact_scope_commands(countries):
            lowered = sorted(code.lower() for code in countries)
            commands = [["clear-exclude-node-main"]]
            commands.extend(["set-exclude-node-main", code]
                            for code in lowered)
            commands.append(
                ["set-exclude-node-all", ",".join(lowered), "--json"]
                if lowered else ["clear-exclude-node-all", "--json"])
            return commands

        argv = exact_scope_commands(chosen)
        if DRY:
            manifest = ["sudo %s %s" % (TOR_SWITCH, " ".join(args))
                        for args in argv]
            win.result().show(
                "Countries To Avoid", "Exact dry-run command manifest",
                "DRY RUN manifest only. No Tor state changed or was claimed "
                "as read back:\n" + "\n".join(manifest),
                "DRY RUN", "info")
            return
        # THE POOLED SCOPE TAKES EXACTLY ONE CALL, AND THE TWO SCOPES DO NOT
        # BEHAVE THE SAME WAY. G55, found by <agent> against the first
        # version of this fix: set-exclude-node-main MERGES (merge_exclude_nodes
        # appends to the current ExcludeNodes value), while set-exclude-node-all
        # REPLACES (tor.rs set_exclude_node drops every existing ExcludeNodes /
        # ExcludeExitNodes line and writes one new pair). Mirroring the -main
        # chain onto -all would therefore have left the pooled instances
        # excluding whichever country happened to be LAST, while this window said
        # fourteen: a privacy claim that is false on the path that carries the
        # traffic. So the -all leg is one call carrying a deterministic comma
        # list. tor-switch's current set_exclude_node parser normalises both one
        # code and comma lists to Tor's per-entry routerset syntax
        # (`de,fr` -> `{de},{fr}`) before replacing every pooled torrc.
        def all_scope_succeeded(args, output):
            if not args[0].endswith("-all"):
                return True
            data = _successful_json(output)
            return bool(
                data is not None
                and type(data.get("total_instances")) is int
                and type(data.get("success_count")) is int
                and data["total_instances"] >= 0
                and data.get("success_count") == data["total_instances"]
                and data.get("failed_instances") == [])

        def exact_readback(expected):
            _pin, main, main_ok = read_tor_state()
            pooled, pooled_ok = read_pooled_tor_exclusions()
            return bool(
                main_ok and main == expected and pooled_ok
                and all(excluded == expected for excluded in pooled.values()))

        def execute(_payload):
            _pin, current_main, main_ok = read_tor_state()
            if not main_ok or current_main != original:
                return 1, ("No changes were applied because main Tor no longer "
                           "matches the exclusion set shown in this window.")
            pooled, pooled_ok = read_pooled_tor_exclusions()
            if not pooled_ok:
                return 1, ("No changes were applied because the pooled Tor "
                           "exclusions could not be read.")
            if any(excluded != original for excluded in pooled.values()):
                return 1, ("No changes were applied because main and pooled "
                           "Tor do not share one exact exclusion baseline.")

            failed = None
            for args in argv:
                code, output = run_tor_command(args)
                if code != 0 or not all_scope_succeeded(args, output):
                    failed = "%s failed: %s" % (
                        " ".join(args), output.strip() or f"exit {code}")
                    break
            expected = {code.upper() for code in chosen}
            if failed is None and not exact_readback(expected):
                failed = "post-apply readback did not match the selected set"
            if failed is None:
                return 0, "Main and every pooled Tor instance read back the exact set."

            rollback_failure = None
            for args in exact_scope_commands(original):
                code, output = run_tor_command(args)
                if code != 0 or not all_scope_succeeded(args, output):
                    rollback_failure = "%s failed: %s" % (
                        " ".join(args), output.strip() or f"exit {code}")
                    break
            if rollback_failure is None and exact_readback(original):
                return 1, (f"{failed}. The original exclusions were restored "
                           "and read back on main and every pooled instance.")
            return 1, ("PRIVACY-CRITICAL PARTIAL APPLICATION: %s. Original "
                       "exclusions could not be restored and proven on every "
                       "Tor scope: %s" %
                       (failed, rollback_failure or "rollback readback differed"))

        def done(_completed, failed):
            state["force_server"] = failed is None
            state["draft"] = None if failed is None else chosen_set()
            set_loading()
            loader.refresh(settle)

        # Same as the exit picker above: locally built tor-switch exclude
        # commands, no registry row and no credential on any branch.
        run_sequence_async(_button, win, "Countries To Avoid",
                           [("Apply one exact exclusion set to every Tor scope",
                             None)], execute, done,
                           show_output=lambda _payload: True,
                           show_failure=lambda _payload: True)

    primary = win.footer(
        "No changes pending", "Apply exclusions", apply,
        primary_enabled=False)

    def set_loading():
        state["ok"] = False
        primary.set_sensitive(False)
        for control in controls:
            control.set_sensitive(False)
        win.state_strip([
            ("Excluded now", "loading", "info"),
            ("Countries available", str(len(cc.EXCLUDABLE)), "state-val"),
        ])
        win._state_slot.show_all()
        refresh_pending()

    def settle(_pin, excluded, ok):
        draft = state["draft"]
        if (draft is None and state["loaded"] and state["ok"]
                and staged_count() and not state["force_server"]):
            draft = chosen_set()
        state["ok"] = ok
        if ok:
            state["initial"] = set(excluded)
            state["loaded"] = True
            if draft is None:
                state["settling"] = True
                try:
                    for code, switch in switches.items():
                        switch.set_active(code in excluded)
                    for key, (switch, handler_id) in presets.items():
                        members = cc.GROUPS[key]
                        switch.handler_block(handler_id)
                        try:
                            switch.set_active(
                                bool(members) and all(c in excluded for c in members))
                        finally:
                            switch.handler_unblock(handler_id)
                finally:
                    state["settling"] = False
            state["draft"] = None
        elif draft is not None:
            state["draft"] = draft
        state["force_server"] = False
        for control in controls:
            control.set_sensitive(ok)
        win.state_strip([
            ("Excluded now",
             (str(len(excluded)) if excluded else "none") if ok else "could not read",
             ("warn" if excluded else "off") if ok else "warn"),
            ("Countries available", str(len(cc.EXCLUDABLE)), "state-val"),
        ])
        win._state_slot.show_all()
        if not ok:
            win.result().show(
                "Countries To Avoid", f"sudo -n {TOR_SWITCH} list-exit-exclude-main",
                "The current exclusion list could not be read. Apply stays disabled "
                "so a failed read cannot clear exclusions that may still be in force.",
                "unreadable", "warn")
        refresh_pending()

    loader.subscribe(settle)
    return win


# ── the declarative windows ─────────────────────────────────────────────
REGISTRY_PATHS = [
    os.environ.get("KODACHI_MENU_ACTIONS"),
    "/usr/local/lib/kodachi-rofi/menu-actions.sh",
    os.path.join(os.path.dirname(os.path.abspath(__file__)),
                 "../../lib/kodachi-rofi/menu-actions.sh"),
]


def load_registry():
    """(Category, Label) -> command, from the one file that owns them.

    The window definitions carry keys, never command strings. An earlier draft
    copied the strings and almost every one was subtly wrong, so resolution is
    deliberately late and deliberately single-sourced.
    """
    for path in REGISTRY_PATHS:
        if not path or not os.path.exists(path):
            continue
        table = {}
        # errors="replace" IS NOT DECORATION HERE, IT IS WHAT KEEPS THE APP
        # ALIVE. This is the registry: menu-actions.sh, 1539 lines of
        # hand-edited shell, and load_registry() is called at MODULE SCOPE
        # below. One non-UTF-8 byte anywhere in that file raised
        # UnicodeDecodeError at IMPORT TIME, before a single window existed,
        # and the traceback goes to stderr, which a dock-launched app
        # discards. The blast radius was not one button and not one window:
        # kodachi-command-window did not start AT ALL, so every dock cell
        # that opens one did nothing when clicked, with no error anywhere the
        # operator could see. Reported by <agent> 2026-08-23 as the
        # worst instance of the G51 class found so far, and it is worse than
        # the wedge that class is named for.
        with open(path, encoding="utf-8", errors="replace") as registry_file:
            lines = registry_file.readlines()
        for line in lines:
            if line.startswith("#") or "\t" not in line:
                continue
            f = line.rstrip("\n").split("\t")
            if len(f) >= 5:
                # Column 4 is the HANDLER and it already says whether this row
                # produces a report or does something. Keeping it here is what
                # lets the button label be derived rather than guessed.
                #
                # COLUMN 3 IS `confirm`, AND DROPPING IT WAS A SAFETY HOLE.
                # kodachi-dock-action and rofi both read it and refuse to run a
                # confirm=1 row without asking through zenity. This driver read
                # columns 5 and 4 and threw column 3 away, so the SAME action
                # asked when clicked from a dock cell and ran instantly when
                # clicked from a window row. Measured 2026-08-19 by
                # <agent> and re-derived here: 95 registry rows carry
                # confirm=1, and 40 of the window's references to them had no
                # confirmation of any kind, including Harden Paranoid (which the
                # registry's own comment records as having taken two VMs off the
                # network), WiFi Disable, SSH Disable, all four kill-switch
                # levels and every torrify mode.
                #
                # Reading the column here rather than hand-marking rows in
                # kodachi_windows.py is deliberate: a hand-marked list is a
                # SECOND source of truth that drifts, and the drift is exactly
                # what produced the 40. Now a row added to the registry with
                # confirm=1 is protected in this window the day it lands.
                table[(f[0], f[1])] = (f[4], f[3], f[2].strip() == "1")
        if table:
            return table
    return {}


# ERRORS= STOPS THE DECODE, IT DOES NOT STOP AN OSError ON THE SAME READ, and
# a raise here is still a dead icon rather than a degraded window. A registry
# this app could not read is a real condition and the app has a correct
# answer for it, the empty table load_registry() already returns when no
# candidate path exists. Say so once on stderr for whoever is reading a
# journal, then carry on: every surface still opens, `resolve()` returns None
# and `needs_confirm()` falls back to its own default, which is the safe
# direction.
try:
    REGISTRY = load_registry()
except Exception as _registry_error:      # noqa: BLE001 - see above
    print("kodachi-command-window: the action registry could not be read, "
          "continuing without it: %s" % _exc_detail(_registry_error),
          file=sys.stderr)
    REGISTRY = {}


def resolve(key):
    entry = REGISTRY.get(tuple(key))
    return entry[0] if entry else None


_SUDO_OPTIONS_WITH_VALUES = {
    "-C", "-D", "-g", "-h", "-p", "-R", "-T", "-u",
    "--chdir", "--group", "--host", "--prompt", "--role", "--type",
    "--user",
}


def command_program(command):
    """Return the executable a registry command asks the shell to launch.

    Verify rows are deliberately simple, but sudo flags and leading environment
    assignments are still parsed so the availability result describes the
    producer rather than the wrapper around it.  An unparseable command fails
    closed through ``missing_required_tools`` instead of leaving a dead button.
    """
    try:
        tokens = shlex.split(command or "")
    except ValueError:
        return None
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token == "sudo":
            index += 1
            while index < len(tokens) and tokens[index].startswith("-"):
                option = tokens[index]
                if option == "--":
                    index += 1
                    break
                name = option.split("=", 1)[0]
                index += 1
                if name in _SUDO_OPTIONS_WITH_VALUES and "=" not in option:
                    index += 1
            continue
        if token == "env":
            index += 1
            continue
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", token):
            index += 1
            continue
        return token
    return None


def executable_is_available(program):
    """Check one declared executable without running it."""
    if not program:
        return False
    if os.path.sep in program:
        return os.path.isfile(program) and os.access(program, os.X_OK)
    return which_including_sbin(program) is not None


# The login user's PATH on Debian has no sbin directory, and lynis, ufw and
# chkrootkit live in /usr/sbin. A presence check through shutil.which() alone
# reported "Not detected" for all three on <lab-host> with all three
# installed (measured 2026-09-05), so the Verify window's Full Audit and
# Scan Security Findings rows were greyed out on a machine that could run them.
# The rows RUN through sudo, which resolves sbin itself, so presence has to be
# tested where the command will actually be found.
SBIN_SEARCH_PATH = "/usr/local/sbin:/usr/sbin:/sbin"


def which_including_sbin(program):
    """shutil.which() over the caller's PATH and then over the sbin directories."""
    found = shutil.which(program)
    if found is None:
        found = shutil.which(program, path=SBIN_SEARCH_PATH)
    return found


def missing_required_tools(row, command, key=None):
    """Return missing direct executables and declared nested requirements."""
    del command
    if not isinstance(row, dict) or not row.get("check_tools"):
        return ()
    missing = []
    try:
        bindings = kd.registry().bindings(key)
    except kd.DirectContractError:
        bindings = ()
        missing.append("the direct operation contract")
    for binding in bindings:
        executable = binding["executable"]
        if not executable_is_available(executable) and executable not in missing:
            missing.append(executable)
    for program in row.get("required_all", ()):
        if not executable_is_available(program) and program not in missing:
            missing.append(program)
    for group in row.get("required_any", ()):
        if group and not any(executable_is_available(program) for program in group):
            label = " or ".join(group)
            if label not in missing:
                missing.append(label)
    return tuple(missing)


def needs_confirm(key):
    """Reads the registry's confirm column. THIS WINDOW NO LONGER CONSULTS IT.

    G96-a, <agent>, 2026-08-23, filed this as dead code with a false
    docstring. Half right, and the half that is wrong is the half that matters:
    the docstring WAS false, and deleting the function would have silently
    disarmed a red control.

    WHAT THE DOCSTRING USED TO CLAIM, all of it now untrue for this app: that
    this is the single source of truth, that it is shared with the GTK window's
    decision, and that a row can raise but never lower it. Since the operator's
    2026-08-22 ruling the window asks `row_needs_confirm()` instead, which
    consults SESSION_ENDING_CONFIRM_KEYS and nothing else. `kodachi-dock-action`
    and rofi still read column 3 for themselves, so the column is not dead, this
    app's use of it is.

    WHY THIS FUNCTION STAYS. `tests/test_packet1_ui.py:295` rebuilds the OLD
    policy out of it to sabotage `test_g04_confirm_allowlist`:

        driver.row_needs_confirm = (
            lambda row, key: bool(row.get("confirm")) or driver.needs_confirm(key))

    That is the registered mutation `g04-registry-bit-back`
    (test_packet1_ui.py:465), and it is what proves the G04 arm can still go red.
    Delete this and the mutation silently becomes a no-op: the arm stays green,
    and a green arm that cannot fail is worth less than no arm at all. If the
    registry bit is ever genuinely wanted back, this is the function to call.
    """
    entry = REGISTRY.get(tuple(key))
    return bool(entry[2]) if entry and len(entry) > 2 else False


# ── WHICH ROWS STILL ASK BEFORE THEY RUN ────────────────────────────────────
#
# THREE, AND ONLY THREE. Operator ruling, 2026-08-22, on screenshots a2/a3/a4:
# "remove [expletive] confirmation windows from all controls its [expletive] annoying",
# with an explicit carve-out for the three actions that END THE SESSION YOU ARE
# CLICKING FROM. Those three are different in kind rather than in degree: every
# other action in this product can be inspected, undone or re-run from the same
# window a second later, and these three take the window away.
#
# WHAT THIS DELIBERATELY OVERRIDES, so nobody re-derives it from the file below
# and quietly puts it back. Until this change the answer came from column 3 of
# the shipped registry, where 95 rows carry confirm=1, qualified per row by
# `confirm=True` and `recovery=True` in kodachi_windows.py. That machinery was
# built for a real defect (the 2026-08-19 audit found 40 window rows running
# registry confirm=1 actions with no prompt at all, including Harden Paranoid,
# which the registry's own comment records as having taken two VMs off the
# network) and it worked. The operator has now weighed the same trade the other
# way for the GTK surface and asked for the prompts gone. That is his call to
# make: the prompt is friction, not a safety mechanism, and nothing about
# removing it makes an action less reversible than it already was.
#
# THE BLAST RADIUS IS NAMED RATHER THAN HIDDEN. After this, these run on one
# click with no dialog: all four kill-switch levels, every torrify and detorrify
# mode, Harden Paranoid, WiFi Disable, SSH Disable, USB Guard Enable, Block
# Internet and the rest of the 95. The dock cell and the rofi menu are NOT
# changed by this file and still ask, so the same action asks from the dock and
# runs instantly from a window row. That asymmetry is now intentional and
# operator-directed, where in 2026-08-19 it was an oversight.
#
# THE SCOPE IS THE GTK WINDOW ONLY. kodachi-dock-action and rofi read column 3
# for themselves and are untouched.
SESSION_ENDING_CONFIRM_KEYS = {
    ("Emergency", "Shutdown"),
    ("Emergency", "Reboot"),
    ("Emergency", "Logout"),
}


def _audit_confirm_allowlist():
    """Warn if an allowlisted key no longer exists in the shipped registry.

    THE FAILURE THIS EXISTS TO CATCH IS SILENT AND POINTS THE WRONG WAY. The
    allowlist is matched on an exact (Category, Label) pair, so renaming
    `Emergency | Shutdown` in the registry does not raise anything: it simply
    stops matching, and the machine powers off on one click with no prompt. A
    confirmation that disappears looks exactly like a confirmation that was
    never wanted, which is precisely the change this commit is making
    everywhere else, so no reader would question it.

    stderr rather than an exception on purpose: a window that refuses to open
    because of a registry rename is a worse outcome than a window that opens
    and says so, and these run from a dock cell where an exception is invisible.
    """
    missing = sorted(key for key in SESSION_ENDING_CONFIRM_KEYS
                     if REGISTRY.get(key) is None)
    if missing:
        print("kodachi-command-window: WARNING, confirm allowlist no longer "
              "matches the registry, these actions will run WITHOUT asking: "
              + ", ".join(" | ".join(key) for key in missing), file=sys.stderr)
    return missing


_audit_confirm_allowlist()


def row_needs_confirm(row, key):
    """Does THIS ROW need a confirmation before running `key`?

    Only the three session-ending actions above. The registry's confirm bit,
    the per-row `confirm=True` and the per-row `recovery=True` exemption are all
    deliberately NOT consulted here any more; see the block above for why and
    for what that costs.

    `row` is still in the signature because both call sites pass it and because
    a future per-row override would land here rather than in the call sites,
    which is where the 2026-08-19 drift came from the first time.
    """
    del row
    return tuple(key) in SESSION_ENDING_CONFIRM_KEYS


def handler_for(key):
    """`rofi-output` means it prints an answer; anything else DOES something.

    The button used to be labelled from the window spec's row kind, and the
    generated windows made every row a report, so "Root Terminal" and "File
    Manager as Root" both offered a button marked "Show". The operator asked the
    obvious question: "is it [expletive] show or run!".

    The registry already knows, and it is spot-checked against the ones he
    pointed at: File Manager as Root and Root Terminal are generic (they open
    something), while Generate Password and Security Score are rofi-output (they
    print something). So the verb is DERIVED from the same file the command
    comes from rather than hand-classified, which is the kind of list that goes
    stale the day after it is written.

    THIS DOCSTRING PROVED THAT POINT AGAINST ITSELF. It used to name a split of
    238 rofi-output and 376 generic, a total of 614 and a second mention of 242,
    and every one of those was wrong: measured 2026-08-23 by running this file's
    own load_registry() against the shipped registry, the split is 396 generic,
    242 rofi-output, plus the two singleton handlers `microsocks-enable` and
    `ifspeed-enable` that the old text omitted entirely, for 640 rows. Reported
    by <agent> and re-derived here independently. So the numbers are not
    restated here, because a count written into prose beside a DERIVED assertion
    can only rot: re-derive it in one command instead, and note that the
    argument above does not depend on the value.

        python3 -c "import ast,io,collections;S='<this file>';\
    src=io.open(S).read();p=[ast.get_source_segment(src,n) for n in ast.parse(src).body \
    if getattr(n,'name','')=='load_registry'];ns={'__file__':S};\
    exec('import os,io,re,sys,json,subprocess\n'+chr(10).join(p),ns);\
    print(collections.Counter(v[1] for v in ns['load_registry']().values()))"
    """
    entry = REGISTRY.get(tuple(key))
    return entry[1] if entry else None


def direct_preview(key, parameters=None):
    """Show the typed business argv, never the legacy registry payload."""
    try:
        preview = kd.registry().preview(key, parameters=parameters)
    except kd.DirectContractError as exc:
        return f"direct operation unavailable: {exc}"
    display_mode = {
        ("Desktop", "Display Single Screen"): "single",
        ("Desktop", "Display Extend"): "extend",
        ("Desktop", "Display Mirror"): "mirror",
    }.get(tuple(key or ()))
    if not display_mode:
        return preview
    # Display outputs are discovered at click time, so the helper path alone is
    # not the command the user asked to inspect. The helper's non-mutating plan
    # verb uses the same argv builders as execution and prints the exact xrandr
    # argv for the current topology. Cache the short construction burst: one
    # display window asks for three previews, and synchronous topology probes
    # must not stall the GTK thread three times.
    now = time.monotonic()
    cached = _DISPLAY_PLAN_CACHE.get(display_mode)
    if cached is not None and now - cached[0] <= DISPLAY_PLAN_CACHE_SECONDS:
        return cached[1]
    # THE REPLACING ERROR HANDLER BELOW IS NOT DECORATION. Text mode decodes
    # STRICTLY, so one non-UTF-8 byte on this helper's stdout raises inside the
    # construction path instead of returning a preview, and the caller is
    # building a tooltip. Every other text-mode read in this file already
    # carries it; this one was missed.
    #
    # AND THIS COMMENT LIVES ABOVE THE CALL, OUTSIDE ITS PARENTHESES, ON
    # PURPOSE. The contract that enforces the handler walks back from the
    # text-mode keyword to the enclosing open paren and then searches that
    # region for the handler keyword. A comment INSIDE the parens that spells
    # the handler keyword satisfies that search by itself, so the real keyword
    # on the argument line stops being load-bearing and the site can be
    # mutated to a strict decode with the suite still green. Measured
    # 2026-08-25 by an independent reviewer: this exact comment, sitting one
    # line inside the call, disarmed the check for this call alone.
    try:
        planned = subprocess.run(
            ["/usr/local/libexec/kodachi/kodachi-display-mode",
             "plan", display_mode],
            capture_output=True, text=True, errors="replace",
            timeout=DISPLAY_PLAN_TIMEOUT, check=False)
    except (OSError, subprocess.SubprocessError):
        _DISPLAY_PLAN_CACHE[display_mode] = (now, preview)
        return preview
    command = planned.stdout.strip()
    result = (command if planned.returncode == 0
              and command.startswith("xrandr ") else preview)
    _DISPLAY_PLAN_CACHE[display_mode] = (now, result)
    return result


class BoundCommand(str):
    """Display-only registry payload carrying a separate typed identity."""

    def __new__(cls, display, key):
        value = super().__new__(cls, display or "")
        value.direct_key = tuple(key or ())
        return value


def bind_command(display, key, parameters=None, stdin_values=None):
    if parameters or stdin_values not in (None, b"", ""):
        raise kd.DirectContractError(
            "typed values cannot be retained on a display command")
    return BoundCommand(display, key)


def shell(command, key=None, parameters=None, stdin_values=None):
    """Run one generated direct operation.

    ``command`` remains in the signature because callers display the registry
    source evidence.  It is deliberately never parsed or executed.  A missing
    registry identity is an error rather than permission to fall back to a
    shell.
    """
    if isinstance(command, BoundCommand):
        key = key or command.direct_key
    if not key:
        return 1, "Direct execution refused: the registry identity is missing."
    if DRY:
        print("WOULD RUN:", direct_preview(key))
        return 0, ""
    try:
        return kd.run(
            key,
            parameters=parameters,
            stdin_values=stdin_values,
            timeout=SHELL_TIMEOUT,
        )
    except kd.DirectContractError as exc:
        return 1, f"Direct execution refused: {exc}"


def launch(command, key=None, parameters=None, stdin_values=None):
    """Open one generated direct operation without a shell or UI proxy."""
    if isinstance(command, BoundCommand):
        key = key or command.direct_key
    if not key:
        return 1, "Direct launch refused: the registry identity is missing."
    if DRY:
        print("WOULD OPEN:", direct_preview(key))
        return 0, "Opened (dry run)."
    try:
        return kd.launch(
            key,
            parameters=parameters,
            stdin_values=stdin_values,
            survival_seconds=LAUNCH_SURVIVAL_SECONDS,
        )
    except kd.DirectContractError as exc:
        return 1, f"Direct launch refused: {exc}"


# ---------------------------------------------------------------------------
# G21: a row that CHANGES something must not leave the dock reporting the old
# answer.
#
# Every status field in this product reads ONE cached conky-status snapshot, and
# that cache is allowed to be STATUS_TTL seconds old (90 by default,
# kodachi-dock-status:39). So the sequence the operator hit is: change a thing,
# ask the dock what the thing is, and get told the previous value, with nothing
# on screen admitting the answer is 90 seconds stale.
#
# The fix is a targeted RE-COLLECTION after a mutation, and it is deliberately
# none of the three obvious alternatives:
#   - not a blanket --refresh on the read path: a fresh 8 adapter snapshot was
#     measured at 10.45s on <lab-host>, so that puts a ten second freeze in
#     front of every status click,
#   - not deleting the cache file, which converts the next read into that same
#     ten second wait and races anything already reading it,
#   - not a per-row opt-in column, because `command` is the last field of an
#     IFS-tab read in menu-actions.sh and a sixth column is therefore impossible.
#
# Firing it in the BACKGROUND after the mutation succeeds means the collection
# overlaps the seconds the user spends reading the result they just got, and the
# next status read hits a warm and correct cache.
STATUS_REFRESH_EXECUTABLE = "/opt/kodachi/dashboard/hooks/conky-status"
STATUS_REFRESH_ARGV = [STATUS_REFRESH_EXECUTABLE, "panel", "all", "--ttl", "0"]
STATUS_REFRESH_TIMEOUT = 60.0

_status_refresh_lock = threading.Lock()
_status_refresh_state = {"running": False, "pending": False}


def refresh_status_cache():
    """Re-collect the status snapshot in the background. Never raises.

    COALESCED, NOT DROPPED, and the difference matters. The obvious guard is
    "if one is already running, do nothing", and it is WRONG: a collection that
    started after mutation 1 can finish reading its adapters before mutation 2
    lands, so dropping the second request leaves the cache describing a state
    that has already been superseded. That is the exact bug this function
    exists to fix, reintroduced by the guard meant to make it cheap.

    So a request arriving mid-flight sets `pending`, and the worker loops once
    more when it finishes. At most two collections are ever outstanding and the
    last one provably starts after the last mutation.

    Failure is swallowed on purpose. A stale cache is a wrong number in a status
    field; a dialog about a background refresh the user never asked for is a
    wrong number PLUS an interruption. The staleness is still visible, because
    every status window prints the snapshot age.
    """
    if DRY:
        print("would refresh status cache: " + shlex.join(STATUS_REFRESH_ARGV))
        return
    with _status_refresh_lock:
        if _status_refresh_state["running"]:
            _status_refresh_state["pending"] = True
            return
        _status_refresh_state["running"] = True

    def worker():
        # A FOURTH INSTANCE OF THE G51 CLASS, AND THE ONLY ONE THAT IS NOT A
        # REPORTING WORKER, WHICH IS WHY NO CONTRACT KEYED ON GLib.idle_add
        # WILL EVER SEE IT. This thread does not talk to the GUI; it owns a
        # LATCH. `running` is set True by the caller before the thread starts
        # and is cleared on exactly one path, the `return` below. Anything
        # raising outside the inner try, an error taking the lock or a KeyError
        # on the state dict, kills the thread with the latch still set, and the
        # caller's `if running: return` then refuses to start another refresh
        # for the life of the process. The status panel simply stops updating,
        # with nothing in the UI to say so. Found here 2026-08-23 while fixing
        # the two reporting vectors <agent> reported in this file.
        try:
            while True:
                try:
                    if (not os.path.isabs(STATUS_REFRESH_EXECUTABLE)
                            or not os.path.isfile(STATUS_REFRESH_EXECUTABLE)
                            or not os.access(STATUS_REFRESH_EXECUTABLE, os.X_OK)):
                        raise OSError(
                            "canonical conky-status is absent or not executable")
                    subprocess.run(STATUS_REFRESH_ARGV,
                                   stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL,
                                   timeout=STATUS_REFRESH_TIMEOUT)
                except (OSError, ValueError, subprocess.SubprocessError):
                    pass
                with _status_refresh_lock:
                    if not _status_refresh_state["pending"]:
                        _status_refresh_state["running"] = False
                        return
                    _status_refresh_state["pending"] = False
        finally:
            # Idempotent: the `return` path above has already cleared it under
            # the same lock, and clearing an already-clear latch is a no-op.
            with _status_refresh_lock:
                _status_refresh_state["running"] = False

    def start_failed(_exc):
        with _status_refresh_lock:
            _status_refresh_state["running"] = False
            _status_refresh_state["pending"] = False

    start_daemon(threading.Thread(target=worker, daemon=True), start_failed)


# ── NATIVE PRESENTATION: the controls whose ANSWER IS A WINDOW ──────────────
#
# THE DIRECT-EXECUTION LAYER TOOK THE PRESENTATION AWAY WITH THE PROXY, AND
# NOBODY NOTICED FOR TEN DAYS. 59bd5fc96 made shell() stop executing the
# registry payload and 96ad39b0b mapped every payload to a business binary, so
# three controls whose payload WAS a presentation wrapper lost the thing they
# were wrapping:
#
#   Session Status / Everything About This Session   kodachi-dock-status report
#   Session Status / Everything, Fresh Data          kodachi-dock-status report --refresh
#   Privacy Tools  / Tor Circuit Monitor             xfce4-terminal ... nyx
#
# The first two used to pipe a tagged #SECTION/#ROW stream into
# kodachi-status-window and the operator got a laid-out report: IP with its
# country flag, the Tor exit, and one row per Tor instance with its own flag.
# After the remap the row ran `conky-status panel all`, whose non-JSON form is
# `key=value` lines (cli.rs panel_text), and that landed verbatim in the inline
# result panel. His words, 2026-09-04: "where did that window go why now it
# just [expletive] shows text". The third launched `nyx` with no terminal, which is
# a curses program with nothing to draw on, while its own note still read
# "Opens nyx in a terminal".
#
# THE FIX IS NOT TO POINT A BINDING BACK AT THE WRAPPER, and that is not a
# preference: kodachi_direct._validate_binding refuses PROXY_BASENAMES, so a
# binding naming kodachi-dock-status makes the WHOLE contract fail to load and
# every GTK window with it. The contract is right that a GTK control must run a
# business executable. What it cannot express is that the ANSWER of some of
# them belongs in a window rather than in a panel, so that part lives here, in
# the program that owns presentation, and the contract keeps describing the
# business operation for the ColonyOps mirror exactly as it does today.
#
# The renderer is SHARED, never copied: kodachi_session_report.py and
# kodachi_session_pool.py are the same modules kodachi-dock-status runs, so the
# dock, rofi and this window cannot drift into three descriptions of one
# machine.
SESSION_REPORT_KEYS = {
    ("Session Status", "Everything About This Session"): False,
    ("Session Status", "Everything, Fresh Data"): True,
}
TOR_CIRCUIT_KEY = ("Privacy Tools", "Tor Circuit Monitor")

# THE FOURTH ONE, FOUND BY THE OPERATOR CLICKING IT: "i tried instances and
# their ip no gtk window was laucnhed". This key is NOT a remap casualty, its
# payload was always `sudo tor-switch list-instances-with-ip` and no wrapper was
