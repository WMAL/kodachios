[Unit]
Description=Kodachi Conky Snapshot Refresh
After=graphical-session.target
# audit 2026-05-08 (macOS-Ventura bundle): After= alone is advisory, it
# orders the unit AFTER graphical-session.target IF that target is active,
# but does not block activation when the target is not yet reached. On
# installed systems with a 134 s xfce4-session bring-up, the timer fired
# at +40 s and the service ran while xfce4-session was still starting,
# spawning 30+ sudo children that starved the desktop of PAM/dbus/disk.
# Requisite= refuses activation if the target isn't already active, # unlike Requires=, it does NOT pull graphical-session.target in. Combined
# with the timer's OnActiveSec=240 first-fire, this gives us belt-and-
# suspenders against firing during desktop startup: timer waits 240 s,
# service refuses to start if graphical-session.target still isn't up.
Requisite=graphical-session.target
# Only run when conky panels are active
ConditionPathExists=%h/.config/kodachi/conky/scripts/conky-gateway-common.sh
# Extra runtime gate: the kodachi-session-token.json is created by
# kodachi-session-helper once the desktop is interactive. Skip the
# refresh until that handshake completes, prevents wasted refresh
# cycles on a cold session.
ConditionPathExists=%t/kodachi-session-token.json

[Service]
Type=oneshot
# Find a healthy conky-status binary dynamically.
# Do not run the whole snapshot under sudo: it writes the cache into the
# desktop user's XDG config tree and must remain user-owned/readable.
# CFA-04 FIX 2026-09-01: take the SAME single-flight lock focus-alert.sh uses.
# THREE producers call `snapshot --refresh`, and each one forks 30+ sudo
# children (see conky-launcher.sh's own comment). Until now only
# focus-alert.sh locked, so this timer, firing every 90 s, stacked a second
# full refresh on top of an in-flight one. Measured on <lab-host>:
# two concurrent `snapshot --refresh` from different binary paths, and 1295
# distinct pids in a 45 s census.
# The lock file is named after focus-alert for HISTORICAL reasons only. It
# guards the REFRESH, not that caller, and naming it after one caller is
# precisely why the other two producers never took it. Do not rename it
# without changing every holder in the same commit: a split name would
# reintroduce this bug silently, with both sides believing they are locked.
# FD 9 survives the exec below (shell redirections are not close-on-exec),
# so the lock is held for the entire lifetime of the refresh, not just the
# wrapper. Skipping with exit 0 keeps Type=oneshot from logging a failure.
ExecStart=/bin/bash -c '\
  mkdir -p "%h/.config/kodachi/conky/data" 2>/dev/null || true; \
  exec 9>"%h/.config/kodachi/conky/data/.focus-alert-refresh.lock" 2>/dev/null || exit 0; \
  flock -n 9 || exit 0; \
  resolved_bin="$(command -v conky-status 2>/dev/null || true)"; \
  for bin in \
    "$resolved_bin" \
    /usr/local/bin/conky-status \
    "%h/k900/dashboard/hooks/conky-status" \
    "%h/dashboard/hooks/conky-status" \
    /opt/kodachi/dashboard/hooks/conky-status; do \
    [ -n "$bin" ] || continue; \
    [ -x "$bin" ] || continue; \
    "$bin" --version >/dev/null 2>&1 || continue; \
    exec "$bin" snapshot --refresh --quiet; \
  done; \
  exit 0'
TimeoutSec=90
TimeoutStopSec=10
# KillMode=process (FIX 2026-06-09, supersedes the earlier mixed variant):
#   conky-status runs as the desktop user (uid != 0) and shells out to sudo'd
#   ROOT children (health-control net-check, and the curl it fans out) that can
#   briefly outlive the main bash wrapper on a slow network. The user-level
#   systemd manager (also uid != 0) CANNOT signal those root processes, so
#   KillMode=mixed/control-group made it try to SIGKILL the whole cgroup at
#   stop and fail on every cycle:
#       conky-snapshot-refresh.service: Killing process N (health-control) ...
#       Failed to kill control group ...: Operation not permitted
#       Unit process N (health-control) remains running after unit stopped
#   That EPERM/leak triple spammed the journal on every refresh.
#
#   KillMode=process kills only the main process (the bash wrapper) and does
#   NOT walk the cgroup, so systemd never attempts the impossible root-kill, #   the noise is gone entirely (VM-proven 2026-06-09: 0 "Failed to kill control
#   group", 0 "Operation not permitted", 0 "remains running", 0 process pile-up).
#
#   This does NOT reproduce the old KillMode=none OOM (none was deprecated, did
#   not even kill the main process, and leaked the WHOLE tree every cycle until
#   memory blew past MemoryMax, BlackwolfOZ Pixel-7-Pro 2026-05-04). With
#   process: the main proc is reaped each cycle; conky-status itself already
#   SIGTERM+SIGKILLs its child PROCESS GROUP on completion/timeout (adapters/
#   mod.rs), which reaps the non-root grandchildren (curl); and the only thing
#   left, an abandoned root health-control, self-drains within its own net
#   timeout (seconds), well inside the 240 s timer gap. Why not a root-side
#   `sudo timeout` wrapper to kill it: Kodachi's production sudoers allowlists
#   exact binaries only, and permitting `sudo timeout <x>` would be a trivial
#   root-shell escalation on a security distro, rejected.
KillMode=process
SendSIGKILL=yes
# Keep stderr in the journal so unhealthy/badly signed binaries are diagnosable.
StandardOutput=null
StandardError=journal
Nice=15
IOSchedulingClass=idle
# Memory guard: prevent snapshot refresh from starving the desktop session.
MemoryHigh=200M
MemoryMax=300M
