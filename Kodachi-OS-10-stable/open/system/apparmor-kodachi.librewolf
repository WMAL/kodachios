# AppArmor profile for LibreWolf
# Per audit 2026-04-24: 12 LibreWolf processes were listed under
# "unconfined but have a profile defined" in aa-status.txt. No dedicated
# profile existed in /etc/apparmor.d/. This profile confines LibreWolf
# with browser-appropriate restrictions, using abstractions already
# present on Trixie.

#include <tunables/global>

profile kodachi-librewolf /usr/{lib,lib64,share}/librewolf/librewolf{,-bin} flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/audio>
  #include <abstractions/cups-client>
  #include <abstractions/dbus-session-strict>
  #include <abstractions/dconf>
  #include <abstractions/fonts>
  #include <abstractions/gnome>
  #include <abstractions/ibus>
  #include <abstractions/mesa>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/p11-kit>
  #include <abstractions/ssl_certs>
  # NOTE: <abstractions/user-download> is intentionally NOT included. Its
  # `owner @{HOME}/[^.]* rwl` rule grants read/write to any loose top-level
  # non-dot file sitting directly in $HOME (e.g. ~/report.pdf), which leaks
  # beyond Kodachi's "expose only Desktop + Downloads" intent. We instead
  # grant Desktop/Downloads (recursively) explicitly below, so the rest of
  # $HOME, loose files, dotfiles, Documents/Pictures/Videos, etc., stays
  # confined. <abstractions/user-tmp> (below) still covers /tmp.
  #include <abstractions/user-tmp>
  #include <abstractions/X>

  # Required by LibreWolf's content-process sandbox: it clones a nested
  # user namespace to confine each content process. Debian 13 / AppArmor 4
  # enforces userns mediation per-profile even when the global sysctl
  # kernel.apparmor_restrict_unprivileged_userns is 0, so this rule must
  # exist in the profile or the browser falls back to "no sandbox" and
  # logs `Sandbox: CanCreateUserNamespace() clone() failure: EACCES`.
  userns,

  # LibreWolf executable
  /usr/bin/librewolf{,-bin}                 ix,
  /usr/{lib,lib64,share}/librewolf/**       mr,
  /usr/{lib,lib64,share}/librewolf/librewolf{,-bin} ix,
  /usr/{lib,lib64,share}/librewolf/minidump-analyzer ix,
  /usr/{lib,lib64,share}/librewolf/updater ix,

  # Fork glxtest + rdd + utility sandboxes
  # NB: Debian ships LibreWolf's glxtest under /usr/share/librewolf, not /usr/lib*.
  /usr/{lib,lib64,share}/librewolf/glxtest  ix,
  # Newer LibreWolf builds renamed the GPU probe to gfxtest. Without this rule
  # the probe is denied on every start (.xsession-errors: "FireTestProcess
  # failed: Failed to spawn child process /usr/share/librewolf/gfxtest
  # (Permission denied)"), so hardware acceleration is never detected.
  /usr/{lib,lib64,share}/librewolf/gfxtest  ix,

  # User profile
  owner @{HOME}/.librewolf/                 rw,
  owner @{HOME}/.librewolf/**               rwk,
  owner @{HOME}/.cache/librewolf/           rw,
  owner @{HOME}/.cache/librewolf/**         rwk,
  owner @{HOME}/.config/librewolf/          rw,
  owner @{HOME}/.config/librewolf/**        rwk,
  # GIO reads the gvfs metadata tree directly (the gvfs-metadata daemon does
  # all writes over D-Bus). Denying the read logged "can't init metadata tree
  # ~/.local/share/gvfs-metadata/home: open: Permission denied" on every file
  # dialog. Read-only and owner-scoped: it holds file-manager metadata only.
  owner @{HOME}/.local/share/gvfs-metadata/  r,
  owner @{HOME}/.local/share/gvfs-metadata/* r,

  # User data directories the browser may read/write for uploads and
  # downloads. These are the SOLE $HOME data-folder grants (the stock
  # <abstractions/user-download> include is deliberately omitted above -
  # see the note there). The `**` glob is fully recursive, so the file
  # picker can descend into any nested subfolder (e.g. ~/Desktop/sub/file),
  # which the abstraction's single-level `@{XDG_DESKTOP_DIR}/*` rule denied.
  # Everything else under $HOME, loose top-level files, dotfiles, and
  # sibling dirs like Documents/Pictures/Videos, stays confined.
  owner @{HOME}/Desktop/                     r,
  owner @{HOME}/Desktop/**                   rwl,
  owner @{HOME}/Downloads/                   r,
  owner @{HOME}/Downloads/**                 rwl,

  # System integration
  /etc/librewolf/                           r,
  /etc/librewolf/**                         r,
  /usr/share/hunspell/                      r,
  /usr/share/hunspell/**                    r,
  /usr/share/myspell/                       r,
  /usr/share/myspell/**                     r,
  /usr/share/mime/                          r,
  /usr/share/mime/**                        r,
  # Per live-ISO log audit 2026-09-06 (<lab-host> build 8): 24 AVC DENIED records in
  # a single 40-minute session for "open /etc/mime.types". The profile granted
  # /usr/share/mime/** but never the flat /etc/mime.types that ships on every
  # Debian system, so LibreWolf could not resolve MIME types for downloads and
  # attachment handling. The file is world-readable (0644) and non-sensitive.
  /etc/mime.types                           r,
  /usr/share/xdg-desktop-portal/            r,
  /usr/share/xdg-desktop-portal/**          r,
  /usr/share/pipewire/                      r,
  /usr/share/pipewire/**                    r,

  # Hardware info for WebGL/acceleration
  /sys/bus/pci/devices/                     r,
  /sys/bus/pci/devices/**                   r,
  /sys/devices/pci**/                       r,
  /sys/devices/pci**/**                     r,
  /sys/devices/system/cpu/                  r,
  /sys/devices/system/cpu/**                r,
  /sys/class/drm/                           r,
  /sys/class/drm/**                         r,
  /sys/class/input/                         r,
  /sys/class/input/**                       r,

  # DRI (GPU acceleration)
  /dev/dri/                                 r,
  /dev/dri/*                                rw,

  # Shared memory segments
  /dev/shm/librewolf-*                      rw,
  /{dev,run}/shm/librewolf/                 rwk,
  /{dev,run}/shm/librewolf/**               rwk,

  # Necessary for sandboxed child processes
  /proc/                                    r,
  /proc/[0-9]*/                             r,
  /proc/[0-9]*/net/if_inet6                 r,
  /proc/[0-9]*/net/ipv6_route               r,
  /proc/[0-9]*/stat                         r,
  /proc/[0-9]*/task/                        r,
  /proc/[0-9]*/task/[0-9]*/stat             r,
  /proc/[0-9]*/smaps                        r,
  # Same audit, same session: 66 DENIED for "open /proc/<pid>/mountinfo" (read,
  # from the content-process sandbox and its IndexedDB/QuotaManager IO threads)
  # and 14 DENIED for "open /proc/<pid>/oom_score_adj" (write). The first is how
  # the sandbox introspects its own mount namespace; the second is how the parent
  # sets each content process's OOM priority. Both are owner-scoped so a
  # confined LibreWolf can only reach its own processes, never another user's.
  owner /proc/[0-9]*/mountinfo              r,
  owner /proc/[0-9]*/oom_score_adj          w,
  /proc/sys/kernel/random/uuid              r,
  /proc/sys/kernel/pid_max                  r,
  /proc/sys/kernel/osrelease                r,
  /proc/sys/crypto/fips_enabled             r,
  /proc/version                             r,
  /proc/cpuinfo                             r,
  /proc/meminfo                             r,

  # Kodachi offline documentation site
  # Bookmarked as file:///opt/kodachi/dashboard/hooks/others/site/index.html.
  # Read-only; the sensitive sibling dirs (signkeys/config) are denied below.
  # The recursive ** glob stays within others/site and never crosses into the
  # signkeys/ or config/ sibling subtrees.
  /opt/kodachi/dashboard/hooks/others/site/    r,
  /opt/kodachi/dashboard/hooks/others/site/**  r,

  # Same site when the binary installer fell back off the canonical
  # /opt/kodachi location (kodachi-binary-install.sh get_fallback_hooks_dir:
  # $HOME/dashboard/hooks, $HOME/k900/dashboard/hooks,
  # $HOME/Desktop/dashboard/hooks). AppArmor mediates the dereferenced path,
  # so this also covers the /opt/kodachi bookmark when it is a compatibility
  # symlink into one of these real fallback locations.
  @{HOME}/{,k900/,Desktop/}dashboard/hooks/others/site/     r,
  @{HOME}/{,k900/,Desktop/}dashboard/hooks/others/site/**   r,

  # Block sensitive host paths
  deny /root/**                             rwklx,
  deny /etc/shadow                          rwklx,
  deny /etc/gshadow                         rwklx,
  deny /etc/ssh/**                          rwklx,
  deny /etc/sudoers                         rwklx,
  deny /etc/sudoers.d/**                    rwklx,
  deny /opt/kodachi/dashboard/hooks/signkeys/** rwklx,
  deny /opt/kodachi/dashboard/hooks/config/** wklx,
  deny /var/log/**                          rwklx,

  # Allow file manager coordination
  /usr/bin/xdg-open                         Cx,
  /usr/bin/xdg-mime                         Cx,

  # Child profile for xdg-open helpers
  profile xdg-open /usr/bin/xdg-open {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    /usr/bin/xdg-open                       r,
    /usr/bin/dash                           ix,
    /usr/bin/grep                           ix,
    /usr/bin/sed                            ix,
    /usr/bin/basename                       ix,
    /usr/bin/find                           ix,
    /usr/bin/dbus-send                      ix,
    /etc/**                                 r,
  }
}
